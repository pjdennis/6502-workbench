PUNCT >=
PUNCT <<
PUNCT >>
PUNCT ++
PUNCT --
PUNCT +=
PUNCT -=
PUNCT *=
PUNCT /=
PUNCT &=
PUNCT |=
PUNCT ^=
PUNCT ->
PUNCT &&
EOF

;;; '( ) [ ] { } , . : ; + - * / % & | ^ ~ < > = ! @ ?'
PUNCT (
PUNCT )
PUNCT [
PUNCT ]
PUNCT {
PUNCT }
PUNCT ,
PUNCT .
PUNCT :
EOF

