IDENT b
IDENT c
PUNCT ->
IDENT d
IDENT e
PUNCT .
IDENT f
PUNCT .
IDENT g
IDENT h
PUNCT (
IDENT i
PUNCT ,
IDENT j
PUNCT )
IDENT k
PUNCT [
IDENT l
PUNCT ]
EOF

