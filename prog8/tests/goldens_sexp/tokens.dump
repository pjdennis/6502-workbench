;;; 'if else when while for in to repeat break continue return defer sub asmsub inline const enum struct main and or xor not true false ubyte byte uword bool void  into forth ored xored notable mainline'
KW if
KW else
KW when
KW while
KW for
KW in
KW to
KW repeat
KW break
KW continue
KW return
KW defer
KW sub
KW asmsub
KW inline
KW const
KW enum
KW struct
KW main
KW and
KW or
KW xor
KW not
KW true
KW false
KW ubyte
KW byte
KW uword
KW bool
KW void
IDENT into
IDENT forth
IDENT ored
IDENT xored
IDENT notable
IDENT mainline
EOF

;;; '%address %output %import %target %option %asm'
DIRECTIVE address
DIRECTIVE output
DIRECTIVE import
DIRECTIVE target
DIRECTIVE option
DIRECTIVE asm
EOF

