  (text "Bidirectional SPI interface" (at 186.69 190.5 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 3fccf5bd-b337-4850-a43f-0763d010d290)
  )
  (text "2025-10-04" (at 207.01 194.31 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 7a59768b-2bb8-421f-a2d9-b786db80fbae)
  )
  (text "Supports SPI mode 0 as a master.\n-While E is low, data is loaded on every rising edge of CLK\n-When E goes high, data is clocked out of MOSI and into MISO\n-If E remains high after 8 clocks, received data is output until E goes low\n-If E goes low before 8 clocks then received data is not output"
    (at 179.07 177.8 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid ccda705f-8e96-4323-b6e2-1747c30fd9ee)
  )
