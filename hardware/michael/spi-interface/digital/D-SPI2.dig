1  0x00  1    0  1   0    0      0
0  0x00  1    1  1   0    0      0
#Send some data - 0x83 MSB first: 10000011
0  0x83  1    1  1   0    0      X
0  0x83  1    0  1   0    0      1
1  0x00  1    0  1   0    1      1
0  0x00  1    1  1   0    0      0
