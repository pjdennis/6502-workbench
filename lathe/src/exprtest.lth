; A test of expr (EXPR and STMT): exprtest SCRIPT OBJECT SOURCE runs the commands of a script:
; those of lathe/src/regcmd.lth, which declare variables, functions, function types and the
; types they use, and the commands below, which declare the other names a body can use and run
; EXPR over real source, the file SOURCE, read through LEX and SRC as DECL will: bodies of
; functions, expressions, conditions, constants, types and declarations. It prints what they
; give, the token each hands back, and the code of the functions they end; the object file it
; writes is compared too. lathe/tests/test_src_expr.py runs the same script with expr.py and
; compares. The scripts are in lathe/tests/scripts/expr.txt. With EXPR, GEN and everything below
; them it has about 50 KB of code: it is built banked on Wendy 2 (compiler-bank.env), with the
; small build's capacities.
module exprtest

import cond (wanted_in_carry)
import expr (constant, constant_number, data_region, expression, function, function_body, init,
             test, type_spec, value_type, variable)
import gen (accept, as_value, cpu, function_begin, function_end, init, init_function, jump_false,
            load_result, pend_type, receive, saves_frame, store)
import inlines (init, save)
import kernel (byte_of, C_FLAGS, C_KIND, C_MEMBERS, C_NAME, C_OBJ, C_PARAMS, C_SCOPE, C_TYPE,
               C_VALUE, K_FIELD, K_LOCAL, K_TYPE, keep_argument, local_names, member_type_of,
               module_add, name_top, scope_begin, scope_end, SCOPE_FIELDS, SCOPE_LOCAL,
               SCOPE_MODULE, set_byte, set_word, SF_RECURSIVE, sym_add, sym_count, word_of)
import lex (col, init, line, next, T_NL, tok)
import listing
import reg (CLASS_EITHER, new_slot, object_symbol, SLOT_PARAMETER)
import regcmd
import script (command, end_line, find, more, name, next, NOT_FOUND, number, open, show_byte,
               show_word, small)
import src (init, open_file)
import sys (exit, put_byte)
import typetab (declared, FORM_ENUM, FORM_RECORD, grow, size)

const WORDS = "source first next sym record field enum fbegin param receive body fend expr cond econst cnum type vtype decl save scope send gstore asvalue accept lresult gjump efunc initfn cpu syms module einit setv dregion "

; Set up as regcmd does (a module `m` that imports `util`, its object file, and a function
; `m.f` being generated), and GEN, SRC, LEX, INLINE and EXPR.
func init()
  regcmd.init()
  gen.init()
  gen.function_begin(regcmd.own)
  gen.pend_type = 0               ; as at the start: neither gen.init() nor function_begin() sets it
  cond.wanted_in_carry(false)
  src.init()
  lex.init()
  inlines.init()
  expr.init()
end

func show_token()
  script.show_byte(lex.tok)
  script.show_word(lex.line)
  script.show_word(lex.col)
end

; Pass over line ends to the next token.
func first_token()
  loop
    lex.next()
    if lex.tok != lex.T_NL then
      return
    end
  end
end

; A record type, or an enumeration, called by the next argument.
func declared(form: byte)
  var s: word
  var t: byte
  s = kernel.sym_add(kernel.SCOPE_MODULE, script.name(), kernel.K_TYPE)
  t = typetab.declared(form, s)
  kernel.set_byte(s, kernel.C_TYPE, t)
  script.show_word(s)
  script.show_byte(t)
end

; As decl.add_field(): a field called `name` of type `t` after the others of the record that
; `s` declares.
func add_field(s: word, name: word, t: byte)
  var r: byte
  var f: word
  r = kernel.byte_of(s, kernel.C_TYPE)
  f = kernel.sym_add(kernel.SCOPE_FIELDS + r, name, kernel.K_FIELD)
  kernel.set_byte(f, kernel.C_TYPE, t)
  kernel.set_word(f, kernel.C_VALUE, typetab.grow(r, typetab.size(t)))
  kernel.set_byte(s, kernel.C_PARAMS, kernel.byte_of(s, kernel.C_PARAMS) + 1)
end

; As decl.parameters() declares parameter `i` of function `s`: a slot of the frame and a local
; name, called by the next argument.
func parameter(s: word, i: byte)
  var name: word
  var t: byte
  var p: word
  name = script.name()
  t = kernel.member_type_of(kernel.word_of(s, kernel.C_MEMBERS) + i)
  p = kernel.sym_add(kernel.SCOPE_LOCAL, name, kernel.K_LOCAL)
  kernel.set_byte(p, kernel.C_TYPE, t)
  kernel.set_word(p, kernel.C_VALUE, reg.new_slot(typetab.size(t), reg.CLASS_EITHER, reg.SLOT_PARAMETER, name))
  script.show_word(p)
  script.show_byte(lo(kernel.word_of(p, kernel.C_VALUE)))
end

func show_symbols(first: word)
  var s: word
  for s = first until kernel.sym_count do
    script.show_word(kernel.word_of(s, kernel.C_NAME))
    script.show_byte(kernel.byte_of(s, kernel.C_SCOPE))
    script.show_byte(kernel.byte_of(s, kernel.C_KIND))
    script.show_byte(kernel.byte_of(s, kernel.C_FLAGS))
    script.show_byte(kernel.byte_of(s, kernel.C_TYPE))
    script.show_word(kernel.word_of(s, kernel.C_VALUE))
    script.show_word(kernel.word_of(s, kernel.C_OBJ))
    sys.put_byte(',')
  end
end

forward func run_more(c: byte)

; Run command `c`, a number in WORDS, with its arguments.
func run(c: byte)
  var a: byte
  var b: byte
  var d: byte
  var e: byte
  var s: word
  var v: word
  var i: byte
  case c
  of 0
    if not src.open_file(kernel.keep_argument(2)) then
      sys.exit(2)
    end
  of 1
    first_token()
    show_token()
  of 2
    lex.next()
    show_token()
  of 3
    a = script.small()
    b = script.small()
    d = script.small()
    e = script.small()
    v = script.number()
    s = kernel.sym_add(b, script.name(), a)
    kernel.set_byte(s, kernel.C_FLAGS, d)
    kernel.set_byte(s, kernel.C_TYPE, e)
    kernel.set_word(s, kernel.C_VALUE, v)
    script.show_word(s)
  of 4
    declared(typetab.FORM_RECORD)
  of 5
    s = script.number()
    v = script.name()
    add_field(s, v, script.small())
  of 6
    declared(typetab.FORM_ENUM)
  of 7
    s = script.number()
    gen.function_begin(reg.object_symbol(s))
    gen.saves_frame = kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_RECURSIVE != 0
  of 8
    s = script.number()
    i = 0
    while script.more() do
      parameter(s, i)
      i += 1
    end
  of 9
    gen.receive(script.number())
  of 10
    expr.function_body(script.number())
    show_token()
  of 11
    gen.function_end(script.small())
    listing.show_finished()
  of 12
    expr.expression()
    show_token()
  of 13
    script.show_word(expr.test())
    show_token()
  of 14
    expr.constant(script.small())
    show_token()
  of 15
    script.show_word(expr.constant_number())
    show_token()
  of 16
    script.show_byte(expr.type_spec())
    show_token()
  else
    run_more(c)
  end
end

func run_more(c: byte)
  var a: byte
  var s: word
  var v: word
  var i: byte
  case c
  of 17
    script.show_byte(expr.value_type())
    show_token()
  of 18
    a = script.small()
    expr.variable(script.small(), a)
    show_token()
  of 19
    s = script.number()
    kernel.scope_begin()
    for i = 0 until kernel.byte_of(s, kernel.C_PARAMS) do
      v = kernel.sym_add(kernel.SCOPE_LOCAL, script.name(), kernel.K_LOCAL)
      kernel.set_byte(v, kernel.C_TYPE, kernel.member_type_of(kernel.word_of(s, kernel.C_MEMBERS) + i))
    end
    inlines.save(s)
    kernel.local_names = kernel.name_top
    kernel.scope_end()
    show_token()
  of 20
    kernel.scope_begin()
  of 21
    kernel.scope_end()
  of 22
    gen.store()
  of 23
    gen.as_value()
  of 24
    gen.accept(script.small())
  of 25
    gen.load_result()
  of 26
    script.show_word(gen.jump_false())
  of 27
    script.show_word(expr.function)
  of 28
    s = script.number()
    gen.init_function(s)
    listing.show_finished()
  of 29
    gen.cpu = script.small()
  of 30
    show_symbols(script.number())
  of 31
    script.show_byte(kernel.module_add(script.name()))
  of 32
    expr.init()
  of 33
    s = script.number()
    kernel.set_word(s, kernel.C_VALUE, script.number())
  of 34
    expr.data_region = script.name()
  end
end

pub func main()
  var c: byte
  init()
  script.open()
  while script.next() do
    c = script.find(@WORDS)
    if c == script.NOT_FOUND then
      regcmd.run(script.command(@regcmd.WORDS))
    else
      run(c)
    end
    script.end_line()
  end
  sys.exit(0)
end
