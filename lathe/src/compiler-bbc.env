; The BBC Model B+128 (lathe/env/bbc.env) for the compiler's smallest test programs in the small
; build: lextest, errtest, kerneltest and srctest (lathe/tests/test_bbc_src.py). bbc.env with the
; split between code and variables moved, and SMALL, which makes the twins declare their big
; tables small (lathe/host/README.md, "The small build"). kerneltest, the largest, has 12.9 KB
; of code and constant data and 8.4 KB of variables on the default machine (2026-11-14); the
; split moved from $5200 to $5400 when its test of kernel's accessors made it 133 bytes longer
; (2026-11-15).
cpu       6502
zeropage  $00 $8F
code      $1900 $53FF
data      $5400 $7BFF
more      data $0401 $06FF
exit      return $0400  ; the start-up code keeps S at $0400 (bbc.KEEP), and ends with RTS
output    raw
define    BOARD 3       ; the BBC (lathe/host/driver/boards.py)
define    SMALL 1
define    PORTS 2       ; lathe/src/sys.lth over lathe/rt/bbc.lth
