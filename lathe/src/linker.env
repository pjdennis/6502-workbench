; The emulator's default machine as the test programs of the Lathe-written linker use it
; (lathe/src/lktest*.lth): host.env with the split between code and variables moved, and the
; linker's tables at the capacities of its small build. At full capacities the tables take
; 54,816 bytes, more than the machine has beside the linker's code; LKSMALL takes two fifths of
; those that grow with the program (lathe/host/README.md, "The linker in Lathe"). lktest4 has
; 37.6 KB of code and constant data and 21.9 KB of variables (measured 2026-11-14, with kept
; functions, read-only banks and `exit return ADDR`: the split moved up from $9500, 44 bytes of
; code and 63 of variables to spare). The linker's tables in regions (LKLOCAL, LKCALLS, LKSLOTS,
; for the BBC: lathe/src/linker-bbc.env) are fixed here, and each `with` block costs 12 bytes of
; code: lktest4's code grew by 254 bytes (2026-11-15), so the split moved up to $9A60 and the RAM
; between the host services' routines and the arguments, $F240-$FDFF, holds the variables that
; do not fit below $F000 (lktest4: code to $995D, variables to $E6D1 and $FD30).
cpu       6502
zeropage  $00 $FF
code      $0200 $9A5F
data      $9A60 $EFFF
more      data $F240 $FDFF ; RAM between the host services' routines (to $F23F at most) and the arguments (emulator/stubs.h)
stack     $FF
exit      call $F00F
define    LKSMALL 1
define    LKDYN 1     ; dynamic regions linked (lathe/src/lk_dyn.lth)
define    PORTS 0       ; lathe/src/sys.lth over host.lth, the host services
