; The emulator's default machine as the test programs of the Lathe-written linker use it
; (lathe/src/lktest*.lth): host.env with the split between code and variables moved, and the
; linker's tables at the capacities of its small build. At full capacities the tables take
; 53,952 bytes, more than the machine has beside the linker's code; LKSMALL takes two fifths of
; those that grow with the program (lathe/host/README.md, "The linker in Lathe"). lktest4 has
; 35.9 KB of code and constant data and 23.3 KB of variables.
cpu       6502
zeropage  $00 $FF
code      $0200 $94FF
data      $9500 $EFFF
stack     $FF
exit      call $F00F
define    LKSMALL 1
define    PORTS 0       ; lathe/src/sys.lth over host.lth, the host services
