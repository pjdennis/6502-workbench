; The emulator's default machine as the test programs of the Lathe-written linker use it
; (lathe/src/lktest*.lth): host.env with the split between code and variables moved down, and
; the linker's tables at the capacities of its small build. At full capacities the tables take
; 53,952 bytes, more than the machine has beside the linker's code; LKSMALL halves those that
; grow with the program (lathe/host/README.md, "The linker in Lathe").
cpu       6502
zeropage  $00 $FF
code      $0200 $5FFF
data      $6000 $EFFF
stack     $FF
exit      call $F00F
define    LKSMALL 1
