; Link errors: lathe/host/lk_err.py in Lathe.
;
; Owns the numbered messages, and the one way out when linking fails. A link error is written to
; the error output as `link error N: text`, followed by the names involved, and the linker exits
; with status 1. Nothing catches an error. A message is put together from begin(), the callers'
; own names and separators, and finish(); fail() is the two in one.
;
; The conventions of the linker's twins (lathe/src/lk_*.lth) are those of the compiler's
; (lathe/src/sys.lth, "Pointers"; lathe/src/kernel.lth), and:
;
;   - A Python int is a byte where every value it can hold fits one, else a word. A table of
;     more than 256 rows larger than a byte is declared `rows`; a byte table of more than 256
;     rows is indexed by a word.
;   - A capacity that sizes a table is given twice, under `#if LKSMALL`: the small value is for
;     the test programs, which must fit the emulator's default machine beside the linker's code
;     (lathe/src/linker.env; lathe/host/README.md, "The linker in Lathe"). Some are given a third
;     time, under `#if LKSMALL == 2` before the others: the build for a 32K BBC (lk_tab.lth).
;   - The linker's files are opened by the number of their argument, through lathe/src/sys.lth.
;
; Where the Lathe differs from the Python:
;
;   | Python                                | Lathe                           | Why               |
;   |---------------------------------------|---------------------------------|-------------------|
;   | MESSAGES: one byte string, a line per | two, MESSAGES and MESSAGES2, the | a string or table |
;   | error, ended by LF                    | lines of errors 1 to SECOND - 1 | holds at most     |
;   |                                       | and of the rest                 | 2048 bytes; the   |
;   |                                       |                                 | texts are 2701    |
;   | begin() walks to the line of error n  | the same, in the one that holds | follows from the  |
;   |                                       | it, from its first error        | tables            |
;   | begin(): range(0, len(PREFIX)) by i   | by a byte k; i a word           | the types differ  |
;   | `put_number` divides an int           | a byte: every number it is given| (as left)         |
;   |                                       | is one                          |                   |
;   | MESSAGES in every build               | with `define TEXTS_IN_MODULE 1` | the 128 KB        |
;   |                                       | (the BBC's ROM forms) no texts: | module (lathe/    |
;   |                                       | the module image writes text    | docs/bbc.md)      |
;   |                                       | 255 - n (sys.error_text), packed|                   |
;   |                                       | into it from MESSAGES by lathe/ |                   |
;   |                                       | host/driver/msgpack.py          |                   |
module lk_err

#if PORTS == 2
#if TEXTS_IN_MODULE
import sys (error_text, exit, put_error)
#else
import sys (exit, put_error)
#end
#else
import sys (exit, put_error)
#end

; The BBC's ROM forms of the linker (`define TEXTS_IN_MODULE 1`, linker-bbc.env's `when
; ROMFORM`) hold no texts: begin() asks the module image for text 255 - n (sys.error_text: the
; module writes ": " and the text, packed into it from lathe/host/lk_err.py's MESSAGES by lathe/
; host/driver/msgpack.py; lathe/docs/bbc.md, "The texts in the module"), and the error is its
; number alone if no ROM answers. Every other build has the texts, as the Python has them.
#if PORTS == 2
const IN_MODULE = TEXTS_IN_MODULE
#else
const IN_MODULE = 0
#end

pub const E_USAGE = 1
pub const E_OPEN = 2
pub const E_ENV_ENTRY = 3
pub const E_ENV_MISSING = 4
pub const E_VERSION = 5
pub const E_DAMAGED = 6
pub const E_NEEDS_65C02 = 7
pub const E_OBJECTS = 8
pub const E_SYMBOLS = 9
pub const E_NAMES = 10
pub const E_FUNCTIONS = 11
pub const E_SLOTS = 12
pub const E_CALLS = 13
pub const E_CLASSES = 14
pub const E_COPIES = 15
pub const E_CONTEXTS = 16
pub const E_DUPLICATE = 17
pub const E_UNDEFINED = 18
pub const E_KIND = 19
pub const E_NO_MAIN = 20
pub const E_CYCLE = 21
pub const E_CLASS_CONTEXTS = 22
pub const E_CLASS_DIFFERS = 23
pub const E_MEMBER = 24
pub const E_ZP_FULL = 25
pub const E_DATA_FULL = 26
pub const E_CODE_FULL = 27
pub const E_FIXES = 28
pub const E_FIXUP = 29
pub const E_NOT_ZP = 30
pub const E_NOT_LINKED = 31
pub const E_OVERLAP = 32
pub const E_LOCALS = 33
pub const E_ENV_RANGE = 34
pub const E_MEMBERS = 35
pub const E_DEFS = 36
pub const E_SIZE = 37
pub const E_REFS = 38                         ; no longer reported: what fix-ups name is not held
pub const E_STOP_6502 = 39
pub const E_MEMBER_CYCLE = 40
pub const E_WEIGHTS = 41
pub const E_ENV_UNKNOWN = 42
pub const E_ENV_TWICE = 43
pub const E_PLACE_UNLINKED = 44
pub const E_BANK_FULL = 45
pub const E_NO_FARCALL = 46
pub const E_IRQ_PLACED = 47
pub const E_IRQ_OVERLAY = 48
pub const E_FARCALL_PLACED = 49
pub const E_TWO_WINDOWS = 50
pub const E_NO_FILE = 51
pub const E_OVERLAY_NUMBERS = 52
pub const E_ENV_FULL = 53
pub const E_FARCALL_MISSING = 54
pub const E_WITH_PLACED = 55                    ; no longer reported: such a function is kept fixed
pub const E_WITH_FAR = 56                       ; no longer reported: what such a call reaches is kept fixed
pub const E_WITH_IRQ = 57
pub const E_REGION_WINDOW = 58
pub const E_REGION_NO_FILE = 59
pub const E_REGION_ROM = 60
pub const E_COMMAND_FILE = 61

#if IN_MODULE
#else
; One message per line, in the order of the numbers above: errors 1 to SECOND - 1 in MESSAGES,
; the rest in MESSAGES2.
const SECOND = 30
const MESSAGES = "usage: link ENV MAINMODULE OUT.bin OUT.map OBJECT.lo...\n"
                 "cannot open file\n"
                 "environment file: bad entry\n"
                 "environment file: zeropage, code, data and exit must all be given\n"
                 "unsupported object version: this linker reads version 4\n"
                 "object file is damaged\n"
                 "object file needs a 65C02 and the environment has a 6502\n"
                 "too many object files\n"
                 "too many symbols\n"
                 "too many or too long names\n"
                 "too many functions\n"
                 "too many slots\n"
                 "too many calls\n"
                 "too many pointer classes or class parameters\n"
                 "too many functions and copies of functions\n"
                 "too many interrupt functions\n"
                 "symbol defined twice\n"
                 "undefined symbol\n"
                 "symbol used as two kinds of thing\n"
                 "no main function\n"
                 "recursion through a call or function not marked recursive\n"
                 "pointer class called through pointers from two contexts\n"
                 "pointer class declared with different parameters\n"
                 "function does not have the parameters of its pointer class\n"
                 "zero page is full\n"
                 "variables do not fit in the data range\n"
                 "code does not fit in the code range\n"
                 "too many fix-ups in one function or table\n"
                 "bad fix-up\n"
const MESSAGES2 = "address must be in zero page\n"
                  "call of a function that was not linked\n"
                  "parts of the image overlap\n"
                  "too many symbols in the object files together\n"
                  "environment file: bad address range\n"
                  "too many functions whose address is taken\n"
                  "too many variables and constants\n"
                  "internal error: a function is not the size that was planned\n"
                  "too many symbols named by fix-ups\n"
                  "environment file: exit stop needs cpu 65c02\n"
                  "functions of one pointer class share their parameters: one that calls another must be recursive, as must the one it calls, or the function type it calls through\n"
                  "too many weights for slots of functions not read yet\n"
                  "environment file: no such window, bank, overlay or define\n"
                  "environment file: named twice\n"
                  "a module the environment file places is not linked\n"
                  "code and data do not fit in a bank\n"
                  "the far-call module is not linked, or does not define call and start\n"
                  "an interrupt function cannot be in a window\n"
                  "an interrupt function reaches a function in an overlay\n"
                  "environment file: the far-call module must be in fixed memory\n"
                  "environment file: code is placed in two windows, and far calls serve one\n"
                  "environment file: a module is placed in a bank that has no file\n"
                  "environment file: overlays must be numbered from 1 with none missing\n"
                  "environment file: too many windows, banks, overlays, places or regions, or too many names\n"
                  "environment file: code or a region is placed in a window, and no farcall entry names the module for far calls\n"
                  "a function with a with block cannot be in a window\n"
                  "a call inside a with block reaches a function in a window\n"
                  "an interrupt function reaches a function with a with block\n"
                  "environment file: a region is in an overlay, or in another window than code is\n"
                  "constant data in a region is in a bank that has no file\n"
                  "a variable in a region is in a read-only bank\n"
                  "command file: too many arguments, or too long\n"
#end

const PREFIX: [11]byte = "link error "

; One character of a message.
pub func put(ch: byte)
  sys.put_error(ch)
end

; n in decimal. Error and context numbers are below 1000.
pub func put_number(n: byte)
  if n >= 100 then
    put(48 + n / 100)
  end
  if n >= 10 then
    put(48 + (n / 10) mod 10)
  end
  put(48 + n mod 10)
end

; n, 0 to 65535, in decimal.
pub func put_word(n: word)
  var div: word = 10000
  var started: bool = false
  while div > 1 do
    if started or n >= div then
      put(48 + byte((n / div) mod 10))
      started = true
    end
    div = div / 10
  end
  put(48 + byte(n mod 10))
end

const OVER_TEXT: [5]byte = " over"
const BYTES_TEXT: [6]byte = " bytes"
const WRAP_TEXT: [22]byte = ", more than 64K in all"

; After a message about a range that is too small: by how much, or that what it needs is more
; than 16 bits can count.
pub func over(amount: word, wrapped: bool)
  var i: byte
  var size: byte
  if wrapped then
    for i = 0 until len(WRAP_TEXT) do
      put(WRAP_TEXT[i])
    end
    return
  end
  put(44)
  put(32)
  put_word(amount)
  size = len(BYTES_TEXT)
  if amount == 1 then
    size -= 1
  end
  for i = 0 until size do
    put(BYTES_TEXT[i])
  end
  for i = 0 until len(OVER_TEXT) do
    put(OVER_TEXT[i])
  end
end

; Start error n: `link error N: text`.
pub func begin(n: byte)
  var k: byte
#if IN_MODULE
#else
  var i: word
  var line: byte
#end
  for k = 0 until len(PREFIX) do
    put(PREFIX[k])
  end
  put_number(n)
#if IN_MODULE
  sys.error_text(255 - n)           ; ": " and the text, from the module: its text 255 - n
#else
  put(58)
  put(32)
  i = 0
  if n < SECOND then
    line = 1
    while line < n do
      if MESSAGES[i] == 10 then
        line += 1
      end
      i += 1
    end
    while MESSAGES[i] != 10 do
      put(MESSAGES[i])
      i += 1
    end
    return
  end
  line = SECOND
  while line < n do
    if MESSAGES2[i] == 10 then
      line += 1
    end
    i += 1
  end
  while MESSAGES2[i] != 10 do
    put(MESSAGES2[i])
    i += 1
  end
#end
end

; Separates the text from the first name.
pub func colon()
  put(58)
  put(32)
end

pub func comma()
  put(44)
  put(32)
end

; Separates the functions of a call chain.
pub func arrow()
  put(32)
  put(45)
  put(62)
  put(32)
end

; Finish the message and stop the linker.
pub func finish()
  put(10)
  sys.exit(1)
end

; Report error n, which involves no names.
pub func fail(n: byte)
  begin(n)
  finish()
end
