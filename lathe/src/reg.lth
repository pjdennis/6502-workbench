; REG: operands, the frame and the registers (the lowest of GEN's three files).
; lathe/host/reg.py in Lathe.
;
; Owns
; - the operand stack. Parsing an operand gives a description of it, not code: a constant, a
;   variable, a value now in A or in A and X, a condition now in the flags (docs/codegen.md,
;   "Operands"). The descriptions are columns indexed by the operand's place on the stack;
; - the frame of the function being compiled: its parameters and locals, numbered from 0, and
;   its temporaries, numbered from fbuf.FIRST_TEMP until FBUF moves them behind the locals;
; - which operand owns A (or A and X). Whatever is about to change a register first calls
;   claim(), which stores the owner in a temporary (docs/codegen.md, "Owning a register"). An
;   operation frees its own operands with release() before it starts;
; - what A, X and Y are known to hold, and whether the N and Z flags show a register's value,
;   so that a load or a compare which would change nothing is left out (docs/codegen.md,
;   "Remembering register contents");
; - the instructions that move one byte between an operand and a register, which is where
;   zero page forms, weights and the register memory are dealt with once for all of GEN.
;
; An instruction that takes memory is known here by its opcode in the absolute form. The zero
; page form is ZERO_PAGE_FORM less; the immediate form and the accumulator form are
; IMMEDIATE_FORM less.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | owner: an int, NONE or an operand    | a word; byte(owner) where it      | NONE ($FFFF) is |
;   |                                      | indexes the columns or is passed  | not a byte, and |
;   |                                      | as an operand                     | a short column  |
;   |                                      |                                   | takes a byte    |
;   | columns: ints and bools              | byte where every value fits, else | the type is the |
;   |                                      | word; op_true and op_false words  | storage         |
;   |                                      | (a label, or NONE)                |                 |
;   | weight + amount > 255 (heavier)      | word(weight) + amount > 255       | a byte wraps    |
;   | (op_value >> (8 * k)) & 0xFF         | lo(op_value >> (8 * k))           | (the same)      |
;   | fbuf.op_byte(..., place) of a fixed  | byte(place)                       | the operand is  |
;   | address below $100                   |                                   | a byte          |
;   | range(n + COPY_COUNT - 1, n, -1)     | n + COPY_COUNT - 1 downto n + 1   | (the same)      |
;   | n // COPY_COUNT                      | n / COPY_COUNT                    | (the same)      |
;   | describe, free, copy_entry,         | forward declarations              | declare before  |
;   | same_entry, set_slot, use_slot,      |                                   | use             |
;   | use_variable, heavier, spill, forget,|                                   |                 |
;   | copy_knowledge, shows_memory, point, |                                   |                 |
;   | direct, load_const, load,            |                                   |                 |
;   | load_direct, store_direct,           |                                   |                 |
;   | drop_state, copy_state, meet,        |                                   |                 |
;   | has_copy used before they are defined|                                   |                 |
;   | load_const(Y, (x + n) & 0xFF)        | lo(x + n)                         | (the same)      |
;   | a local `flags` in class_symbol      | the same: it hides the module's   |                 |
;   |                                      | `flags` there, as in the Python   |                 |
module reg

import err
import fbuf
import kernel
import out
import typetab

; ---- Operands ----------------------------------------------------------------------------

const MAX_OPERANDS = 16
pub const NONE = $FFFF          ; no operand; no label

; Operand kinds, and what the columns hold for each
pub const O_CONST = 1           ; op_value: the constant, sign-extended to 16 bits if its type is signed
pub const O_FUNC = 2            ; op_var: the function's symbol in the kernel's table
pub const O_VAR = 3             ; memory. op_symbol, op_slot, op_value: the fix-up that reaches its first
;                                 byte; or op_symbol is kernel.NO_OBJ and op_value is a fixed address
pub const O_A = 4               ; a one-byte value that is in A
pub const O_AX = 5              ; a two-byte value in A (low) and X (high)
pub const O_COND = 6            ; a bool in the flags. op_value: the opcode of the branch taken when it
;                                 is true; op_true, op_false: labels that parts of it already branch to
pub const O_ADDR = 7            ; an address: op_symbol, op_slot and op_value as for O_VAR. Byte k is
;                                 an immediate with a fix-up for its low or high byte

; How a memory operand (O_VAR) is reached: its mode, and its index, which is the description
; at entry i + INDEX (a constant or a byte variable in memory). Byte k of an operand is at
; op_value + k * op_stride: an element of an array stored by column has its bytes N apart.
pub const M_DIRECT = 0          ; absolute, or zero page when known
pub const M_INDEXED = 1         ; an array element: the index in X (in Y for LDX), then absolute,X
pub const M_POINTER = 2         ; what a pointer points at: op_symbol and op_slot are the pointer, in zero
;                                 page; Y is the index plus op_value + k * op_stride, then (zp),Y

pub const F_TEMP = 1            ; the memory is a temporary, free again when the operand is popped
pub const F_ZP = 2              ; the memory is known to be in zero page
pub const F_DATA = 8            ; constant data: it cannot be assigned to (4 is cond.F_COMPARED)
pub const F_WRAPS = 16          ; a number below 0 that `~` or unary `-` made of a number without a type:
;                                 given an unsigned type, it is cut to that type's width

pub const INDEX = MAX_OPERANDS + 1          ; entry i + INDEX describes the index of operand i
const ENTRIES = 2 * INDEX                   ; one more than the stack, for swap(), and their indexes
pub var op_kind: [ENTRIES]byte
pub var op_type: [ENTRIES]byte
pub var op_size: [ENTRIES]word              ; bytes it really has: a byte widened to a word has 1,
;                                             and the bytes above read as 0
pub var op_value: [ENTRIES]word
pub var op_symbol: [ENTRIES]word
pub var op_slot: [ENTRIES]byte
pub var op_flags: [ENTRIES]byte
pub var op_var: [ENTRIES]word               ; the kernel symbol whose weight a use adds to, or NO_SYM
pub var op_true: [ENTRIES]word
pub var op_false: [ENTRIES]word
pub var op_mode: [ENTRIES]byte
pub var op_stride: [ENTRIES]word
pub var depth: byte = 0         ; operands on the stack; the newest is depth - 1
pub var owner: word = NONE      ; the operand that is O_A or O_AX, if there is one

; ---- The frame ---------------------------------------------------------------------------

const MAX_TEMPS = 64
pub const SLOTS = 192           ; parameters and locals below fbuf.FIRST_TEMP, then MAX_TEMPS temporaries
const WEIGHTS: [4]byte = [$01, $04, $10, $40]   ; what one use adds, by how many loops it is inside

pub const CLASS_ZP = 0          ; slot and variable classes (docs/object-format.md)
pub const CLASS_EITHER = 1
pub const CLASS_NOT_ZP = 2
pub const SLOT_PARAMETER = 0    ; slot kinds
pub const SLOT_LOCAL = 1
pub const SLOT_TEMPORARY = 2

pub var slot_size: [SLOTS]word
pub var slot_class: [SLOTS]byte
pub var slot_weight: [SLOTS]byte
pub var slot_kind: [SLOTS]byte
pub var slot_name: [SLOTS]word
pub var slot_busy: [SLOTS]bool          ; a temporary: in use
pub var local_count: byte = 0   ; parameters and locals
pub var temp_count: byte = 0
pub var own: word = 0           ; the object-file symbol of the function being compiled
pub var loop_depth: byte = 0    ; how many loops the code being generated is inside

; ---- Registers ---------------------------------------------------------------------------

pub const A = 0
pub const X = 1
pub const Y = 2
pub const NO_REG = 3
const IN_MEMORY = 4                 ; as `flags`: the flags show a byte of memory, not a register

const COPY_COUNT = 2                ; how many bytes of memory a register is remembered to equal:
;                                     after `x = y`, A is a copy of both

; What the registers hold is a state: state 0 is what they hold now, the others what they
; hold on every way to a label still to be placed that has been branched to so far.
const STATES = 9
var reg_known: [3 * STATES]bool                 ; entry 3 * state + r: register r holds the
var reg_const: [3 * STATES]byte                 ; constant reg_const
var reg_copy: [3 * COPY_COUNT * STATES]bool     ; entry (3 * state + r) * COPY_COUNT + n: register r
var reg_symbol: [3 * COPY_COUNT * STATES]word   ; holds a copy of the byte of memory that the fix-up
var reg_slot: [3 * COPY_COUNT * STATES]byte     ; reg_symbol, reg_slot, reg_offset reaches. The newest
var reg_offset: [3 * COPY_COUNT * STATES]word   ; of a register's entries is its first
var state_busy: [STATES]bool
const NOTHING = 0                   ; as fbuf.label_note: no way to the label is known yet;
const LOST = $FF                    ; nothing is kept for it: a way to it could not be, or it is
;                                     placed and what goes there now is a loop. 1 to STATES - 1:
;                                     the state kept for it
pub var flags: byte = NO_REG        ; the register whose value the N and Z flags show, or
var flags_symbol: word = 0          ; IN_MEMORY for the byte that the fix-up flags_symbol,
var flags_slot: byte = 0            ; flags_slot, flags_offset reaches: the one an INC, DEC or
var flags_offset: word = 0          ; shift has just changed

const ZERO_PAGE_FORM = 8
const IMMEDIATE_FORM = 4
pub const OP_ORA = $0D
pub const OP_ASL = $0E
pub const OP_AND = $2D
pub const OP_ROL = $2E
pub const OP_EOR = $4D
pub const OP_LSR = $4E
pub const OP_ADC = $6D
pub const OP_ROR = $6E
pub const OP_CMP = $CD
pub const OP_DEC = $CE
pub const OP_SBC = $ED
pub const OP_INC = $EE
pub const OP_CLC = $18
pub const OP_SEC = $38
pub const OP_DEX = $CA
pub const OP_INX = $E8
const OP_INY = $C8
const OP_LDX = $AE
pub const INDEXED_FORM = $10        ; absolute,X (absolute,Y for LDX) is the absolute form + this
const POINTER_FORM = 4              ; (zp),Y is the absolute form + this
pub const LOAD_ABSOLUTE: [3]byte = [$AD, $AE, $AC]      ; LDA, LDX, LDY
const LOAD_IMMEDIATE: [3]byte = [$A9, $A2, $A0]
const STORE_ABSOLUTE: [3]byte = [$8D, $8E, $8C]         ; STA, STX, STY
const COMPARE_IMMEDIATE: [3]byte = [$C9, $E0, $C0]      ; CMP, CPX, CPY
const TRANSFERS: [9]byte = [$00, $AA, $A8, $8A, $00, $00, $98, $00, $00]  ; from A, X, Y to A, X, Y: TAX TAY TXA TYA
const C_DOLLAR = $24
const C_ZERO = $30
const C_T = $74

forward func describe(i: byte, kind: byte, t: byte)
forward func free(i: byte)
forward func copy_entry(source: byte, target: byte)
forward func same_entry(i: byte, j: byte): bool
forward func set_slot(n: byte, size: word, zp_class: byte, kind: byte, name: word)
forward func use_slot(n: byte)
forward func use_variable(s: word)
forward func heavier(weight: byte, amount: byte): byte
forward func spill(i: byte)
forward func forget()
forward func copy_knowledge(source: byte, target: byte)
forward func shows_memory(i: byte, k: byte): bool
forward func point(i: byte, k: byte)
forward func direct(opcode: byte, i: byte, k: byte)
forward func load_const(r: byte, value: byte)
forward func load(r: byte, i: byte, k: byte)
forward func load_direct(r: byte, i: byte, k: byte)
forward func store_direct(r: byte, i: byte, k: byte)
forward func drop_state(s: byte)
forward func copy_state(source: byte, target: byte)
forward func meet(target: byte, other: byte)
forward func has_copy(holder_entry: byte, n: byte): bool

; Start the function whose object-file symbol is `symbol`: no operands, an empty frame,
; nothing known about the registers.
pub func begin(symbol: word)
  var n: byte
  depth = 0
  owner = NONE
  local_count = 0
  temp_count = 0
  own = symbol
  loop_depth = 0
  forget()
  for n = 1 until STATES do
    state_busy[n] = false
  end
end

; ---- The operand stack -------------------------------------------------------------------

; Add an operand to the stack. The columns not given start empty.
pub func push(kind: byte, t: byte, value: word)
  if depth == MAX_OPERANDS then
    err.fatal(err.E_OPERANDS_FULL)
  end
  describe(depth, kind, t)
  op_value[depth] = value
  depth += 1
end

; Make entry `i` an operand of this kind and type, with every other column empty.
pub func describe(i: byte, kind: byte, t: byte)
  op_kind[i] = kind
  op_type[i] = t
  op_size[i] = typetab.size(t)
  if kind == O_A then
    op_size[i] = 1
  elif kind == O_AX then
    op_size[i] = 2
  end
  op_value[i] = 0
  op_symbol[i] = kernel.NO_OBJ
  op_slot[i] = fbuf.NO_SLOT
  op_flags[i] = 0
  op_var[i] = kernel.NO_SYM
  op_true[i] = NONE
  op_false[i] = NONE
  op_mode[i] = M_DIRECT
  op_stride[i] = 1
  op_kind[i + INDEX] = 0
end

; Add the memory operand that the fix-up `symbol`, `slot`, `value` reaches (or, with
; kernel.NO_OBJ for the symbol, the one at address `value`). `more` is F_ZP or 0, and
; `variable` the kernel symbol that counts its uses, or kernel.NO_SYM.
pub func push_memory(t: byte, symbol: word, slot: byte, value: word, more: byte, variable: word)
  push(O_VAR, t, value)
  op_symbol[depth - 1] = symbol
  op_slot[depth - 1] = slot
  op_flags[depth - 1] = more
  op_var[depth - 1] = variable
end

; Add an operand for a slot of the function being compiled.
pub func push_slot(t: byte, slot: byte)
  var more: byte = 0
  if slot_class[slot] == CLASS_ZP then
    more = F_ZP
  end
  push_memory(t, own, slot, 0, more, kernel.NO_SYM)
end

; Add an operand for a value of type `t` that is now in A, or in A and X.
pub func push_register(t: byte)
  if typetab.size(t) == 2 then
    push(O_AX, t, 0)
  else
    push(O_A, t, 0)
  end
  owner = depth - 1
end

; Take the newest operand off the stack. Its temporaries, if it has any, are free again.
pub func pop()
  depth -= 1
  if owner == depth then
    owner = NONE
  end
  free(depth)
end

; The temporaries of operand `i`, its own and its index's, are free again.
func free(i: byte)
  if op_flags[i] & F_TEMP != 0 then
    slot_busy[op_slot[i]] = false
  end
  if op_kind[i + INDEX] == O_VAR and op_flags[i + INDEX] & F_TEMP != 0 then
    slot_busy[op_slot[i + INDEX]] = false
  end
end

; Operand `i` is from now on of this kind and type: its value has been moved.
pub func become(i: byte, kind: byte, t: byte)
  free(i)
  if owner == i then
    owner = NONE
  end
  describe(i, kind, t)
  if kind == O_A or kind == O_AX then
    owner = i
  end
end

; Entry `target` describes what entry `source` does, index and all.
pub func copy(source: byte, target: byte)
  copy_entry(source, target)
  copy_entry(source + INDEX, target + INDEX)
end

func copy_entry(source: byte, target: byte)
  op_kind[target] = op_kind[source]
  op_type[target] = op_type[source]
  op_size[target] = op_size[source]
  op_value[target] = op_value[source]
  op_symbol[target] = op_symbol[source]
  op_slot[target] = op_slot[source]
  op_flags[target] = op_flags[source]
  op_var[target] = op_var[source]
  op_true[target] = op_true[source]
  op_false[target] = op_false[source]
  op_mode[target] = op_mode[source]
  op_stride[target] = op_stride[source]
end

; Exchange the two newest operands.
pub func swap()
  copy(depth - 1, MAX_OPERANDS)
  copy(depth - 2, depth - 1)
  copy(MAX_OPERANDS, depth - 2)
  if owner == depth - 1 then
    owner = depth - 2
  elif owner == depth - 2 then
    owner = depth - 1
  end
end

; Remove the operand under the newest one, which holds nothing to give back.
pub func squeeze()
  copy(depth - 1, depth - 2)
  if owner == depth - 1 then
    owner = depth - 2
  end
  depth -= 1
end

; Add a second description of the memory operand `i`.
pub func duplicate(i: byte)
  if depth == MAX_OPERANDS then
    err.fatal(err.E_OPERANDS_FULL)
  end
  copy(i, depth)
  op_flags[depth] = op_flags[depth] & ~F_TEMP
  op_flags[depth + INDEX] = op_flags[depth + INDEX] & ~F_TEMP
  depth += 1
end

; Add the operand described at entry `i`, which is at or above the top of the stack, or
; is an index (whose temporary, if it has one, the new operand takes over).
pub func keep(i: byte)
  if depth == MAX_OPERANDS then
    err.fatal(err.E_OPERANDS_FULL)
  end
  copy_entry(i, depth)
  op_kind[depth + INDEX] = 0
  if i >= INDEX then
    op_kind[i] = 0
  end
  depth += 1
end

; The newest operand, a constant or a byte in memory, becomes the index of operand `i`
; and leaves the stack.
pub func take_index(i: byte)
  depth -= 1
  copy_entry(depth, i + INDEX)
end

; The offset of byte `k` of memory operand `i` from its fix-up or address; for one reached
; through a pointer, the offset added to the index in Y.
pub func offset(i: byte, k: byte): word
  return op_value[i] + k * op_stride[i]
end

pub func in_registers(i: byte): bool
  return op_kind[i] == O_A or op_kind[i] == O_AX
end

; True if byte `k` of operand `i` is known now: a constant, or above a widened byte.
pub func is_const_byte(i: byte, k: byte): bool
  return op_kind[i] == O_CONST or k >= op_size[i]
end

pub func const_byte(i: byte, k: byte): byte
  if op_kind[i] == O_CONST then
    return lo(op_value[i] >> (8 * k))
  end
  return 0
end

; True if operands `i` and `j` are the same memory.
pub func same_place(i: byte, j: byte): bool
  return same_entry(i, j) and op_mode[i] == op_mode[j] and op_stride[i] == op_stride[j] and
      (op_mode[i] == M_DIRECT or same_entry(i + INDEX, j + INDEX))
end

; True if entries `i` and `j` are the same memory, or the same constant.
func same_entry(i: byte, j: byte): bool
  if op_kind[i] == O_CONST then
    return op_kind[j] == O_CONST and op_value[i] == op_value[j]
  end
  return op_kind[i] == O_VAR and op_kind[j] == O_VAR and op_symbol[i] == op_symbol[j] and
      op_slot[i] == op_slot[j] and op_value[i] == op_value[j]
end

; True unless operand `i` is memory reached through an index register.
pub func is_direct(i: byte): bool
  return op_kind[i] != O_VAR or op_mode[i] == M_DIRECT
end

; ---- The frame ---------------------------------------------------------------------------

; Add a parameter or local to the frame. Returns its slot number.
pub func new_slot(size: word, zp_class: byte, kind: byte, name: word): byte
  if local_count == fbuf.FIRST_TEMP then
    err.fatal(err.E_SLOTS_FULL)
  end
  set_slot(local_count, size, zp_class, kind, name)
  local_count += 1
  return local_count - 1
end

func set_slot(n: byte, size: word, zp_class: byte, kind: byte, name: word)
  slot_size[n] = size
  slot_class[n] = zp_class
  slot_weight[n] = 0
  slot_kind[n] = kind
  slot_name[n] = name
  slot_busy[n] = true
end

; The name of temporary `number`: `$t` and the number, which no source name can be.
func temp_name(number: byte): word
  kernel.name_begin()
  kernel.name_add(C_DOLLAR)
  kernel.name_add(C_T)
  if number >= 10 then
    kernel.name_add(C_ZERO + number / 10)
  end
  kernel.name_add(C_ZERO + number mod 10)
  return kernel.name_end()
end

; A temporary of `size` bytes: one that is free again, or a new one. Returns its slot.
pub func temp(size: word): byte
  var n: byte
  for n = fbuf.FIRST_TEMP until fbuf.FIRST_TEMP + temp_count do
    if not slot_busy[n] and slot_size[n] == size then
      slot_busy[n] = true
      return n
    end
  end
  if temp_count == MAX_TEMPS then
    err.fatal(err.E_SLOTS_FULL)
  end
  temp_count += 1
  n = fbuf.FIRST_TEMP + temp_count - 1
  set_slot(n, size, CLASS_EITHER, SLOT_TEMPORARY, temp_name(temp_count))
  return n
end

; Make entry `i` a new temporary for a value of type `t`.
pub func describe_temp(i: byte, t: byte)
  describe(i, O_VAR, t)
  op_symbol[i] = own
  op_slot[i] = temp(op_size[i])
  op_flags[i] = F_TEMP
end

; An instruction uses memory operand `i`: add to the weight of its slot or variable.
pub func use(i: byte)
  if op_symbol[i] == own and op_slot[i] != fbuf.NO_SLOT then
    use_slot(op_slot[i])
  elif op_var[i] != kernel.NO_SYM then
    use_variable(op_var[i])
  end
end

; What one use adds here, by how many loops it is inside.
func use_weight(): byte
  if loop_depth < 3 then
    return WEIGHTS[loop_depth]
  end
  return WEIGHTS[3]
end

; An instruction uses slot `n` of the function being compiled.
pub func use_slot(n: byte)
  slot_weight[n] = heavier(slot_weight[n], use_weight())
end

; An instruction uses the variable that is kernel symbol `s`.
pub func use_variable(s: word)
  kernel.sym_weight[s] = heavier(kernel.sym_weight[s], use_weight())
end

func heavier(weight: byte, amount: byte): byte
  if word(weight) + amount > 255 then
    return 255
  end
  return weight + amount
end

; ---- Owning a register -------------------------------------------------------------------

; Operand `i` is being used up: the registers it is in are free to change.
pub func release(i: byte)
  if owner == i then
    owner = NONE
  end
end

; Register `r` is about to change: if an operand is in it, store that in a temporary.
pub func claim(r: byte)
  if owner != NONE and (r == A or (r == X and op_kind[byte(owner)] == O_AX)) then
    spill(byte(owner))
  end
end

; Store operand `i`, which is in the registers, in a temporary. It becomes a variable.
pub func spill(i: byte)
  var high: bool
  var t: byte
  var size: word
  high = op_kind[i] == O_AX
  t = op_type[i]
  size = op_size[i]
  become(i, O_VAR, t)
  op_size[i] = size
  op_symbol[i] = own
  op_slot[i] = temp(size)
  op_flags[i] = F_TEMP
  store_direct(A, i, 0)
  if high then
    store_direct(X, i, 1)
  end
end

; If operand `i` is in an element or where a pointer points, load it into A, or A and X.
; The index of an element is in X, so its high byte is loaded last, by Y.
pub func take(i: byte)
  var kind: byte
  if is_direct(i) then
    return
  end
  release(i)
  kind = O_A
  if op_size[i] == 2 then
    kind = O_AX
  end
  if kind == O_AX and op_mode[i] == M_POINTER then
    load(X, i, 1)
  end
  load(A, i, 0)
  if kind == O_AX and op_mode[i] == M_INDEXED then
    load(X, i, 1)
  end
  become(i, kind, op_type[i])
end

; Make the byte operand `i`, which is not a constant, a variable that needs no index.
pub func into_memory(i: byte)
  take(i)
  if in_registers(i) then
    spill(i)
  end
end

; Operand `i` is used with operand `j`: if `i` is in A and X and `j` an element, whose
; index needs X, store `i` in a temporary first.
pub func apart(i: byte, j: byte)
  if op_kind[i] == O_AX and op_kind[j] == O_VAR and op_mode[j] == M_INDEXED then
    spill(i)
  end
end

; Operand `i` is stored in memory operand `target`, or used to work out what is. If `i`
; is reached through a pointer that is `target` (`p = p.next`), load it first, into the
; registers if `keep`, else into a temporary: storing the low byte would change the pointer.
pub func unaliased(i: byte, target: byte, keep: bool)
  if op_mode[i] == M_POINTER and op_symbol[i] == op_symbol[target] and op_slot[i] == op_slot[target] and
      op_mode[target] == M_DIRECT then
    take(i)
    if not keep then
      spill(i)
    end
  end
end

; Operand `i` is a temporary or a slot of this function, which must be in zero page (or
; a variable, NO_SLOT, which has no slot to mark: the test scripts make one).
pub func zero_page(i: byte)
  if op_slot[i] != fbuf.NO_SLOT then
    slot_class[op_slot[i]] = CLASS_ZP
  end
  op_flags[i] = op_flags[i] | F_ZP
end

; Operand `i`, a pointer, is to be used through (zp),Y. True if it can be as it is: a
; variable of this module or a slot of this function, which becomes "must be in zero page"
; unless it was declared `nozp`, or another module's variable declared `zp`.
pub func dereferenced(i: byte): bool
  var s: word
  if op_kind[i] != O_VAR or op_mode[i] != M_DIRECT or op_value[i] != 0 or
      op_symbol[i] == kernel.NO_OBJ then
    return false
  end
  if op_flags[i] & F_ZP != 0 then
    return true
  end
  s = op_var[i]
  if op_symbol[i] == own and op_slot[i] != fbuf.NO_SLOT then
    if slot_class[op_slot[i]] == CLASS_NOT_ZP then
      return false
    end
    zero_page(i)
    return true
  end
  if s == kernel.NO_SYM or kernel.sym_flags[s] & kernel.SF_NOZP != 0 or
      (kernel.sym_scope[s] != kernel.SCOPE_MODULE and kernel.sym_scope[s] != kernel.SCOPE_LOCAL) then
    return false
  end
  kernel.sym_flags[s] = kernel.sym_flags[s] | kernel.SF_ZP
  op_flags[i] = op_flags[i] | F_ZP
  return true
end

; A call is about to change every register.
pub func clobber()
  claim(A)
  claim(X)
end

; ---- What the registers hold -------------------------------------------------------------

func forget_register(r: byte)
  var n: byte
  reg_known[r] = false
  for n = r * COPY_COUNT until r * COPY_COUNT + COPY_COUNT do
    reg_copy[n] = false
  end
  if flags == r then
    flags = NO_REG
  end
end

; Nothing is known about the registers or the flags: after a call, and wherever a branch
; can arrive.
pub func forget()
  var r: byte
  for r = 0 until 3 do
    forget_register(r)
  end
  flags = NO_REG
end

; True if entry `n` of the copies says its register holds byte `k` of memory operand `i`,
; or for an element, a byte of the same array, and for what a pointer points at, anything.
func is_copy(n: byte, i: byte, k: byte): bool
  if not reg_copy[n] or op_mode[i] == M_POINTER then
    return reg_copy[n]
  end
  return reg_symbol[n] == op_symbol[i] and reg_slot[n] == op_slot[i] and
      (reg_offset[n] == offset(i, k) or op_mode[i] == M_INDEXED)
end

; True if register `r` is known to hold a copy of byte `k` of memory operand `i`.
func copies(r: byte, i: byte, k: byte): bool
  var n: byte
  for n = r * COPY_COUNT until r * COPY_COUNT + COPY_COUNT do
    if is_copy(n, i, k) then
      return true
    end
  end
  return false
end

; True if register `r` holds byte `k` of operand `i`.
func holds(r: byte, i: byte, k: byte): bool
  if is_const_byte(i, k) then
    return reg_known[r] and reg_const[r] == const_byte(i, k)
  end
  if in_registers(i) then
    return (k == 0 and r == A) or (k == 1 and r == X)
  end
  return op_kind[i] == O_VAR and op_mode[i] == M_DIRECT and copies(r, i, k)
end

; A register that holds byte `k` of operand `i`, or NO_REG.
func holder(i: byte, k: byte): byte
  var r: byte
  for r = 0 until 3 do
    if holds(r, i, k) then
      return r
    end
  end
  return NO_REG
end

; Register `r` now holds a copy of byte `k` of memory operand `i`. A fixed address is
; never remembered: it may be a device. Nor is an element or what a pointer points at.
func remember(r: byte, i: byte, k: byte)
  var n: byte
  var older: byte
  if op_symbol[i] != kernel.NO_OBJ and op_mode[i] == M_DIRECT and not copies(r, i, k) then
    n = r * COPY_COUNT
    for older = n + COPY_COUNT - 1 downto n + 1 do
      copy_knowledge(older - 1, older)
    end
    reg_copy[n] = true
    reg_symbol[n] = op_symbol[i]
    reg_slot[n] = op_slot[i]
    reg_offset[n] = offset(i, k)
  end
end

; Entry `target` of the copies says what entry `source` does.
func copy_knowledge(source: byte, target: byte)
  reg_copy[target] = reg_copy[source]
  reg_symbol[target] = reg_symbol[source]
  reg_slot[target] = reg_slot[source]
  reg_offset[target] = reg_offset[source]
end

; Byte `k` of memory operand `i` has changed: no register holds a copy of it now, except
; `keeper` if that is the register it was stored from, and the flags do not show it. An
; element may be any of its array, and what a pointer points at anything but a constant.
func changed(i: byte, k: byte, keeper: byte)
  var n: byte
  if op_mode[i] != M_DIRECT then
    keeper = NO_REG
    if flags == IN_MEMORY then
      flags = NO_REG
    end
  end
  for n = 0 until 3 * COPY_COUNT do
    if is_copy(n, i, k) and n / COPY_COUNT != keeper then
      reg_copy[n] = false
    end
  end
  if shows_memory(i, k) then
    flags = NO_REG
  end
end

; True if the flags show byte `k` of memory operand `i` because it was just changed.
func shows_memory(i: byte, k: byte): bool
  return flags == IN_MEMORY and op_kind[i] == O_VAR and op_mode[i] == M_DIRECT and
      flags_symbol == op_symbol[i] and flags_slot == op_slot[i] and flags_offset == offset(i, k)
end

; True if the N and Z flags show the value of byte `k` of operand `i`.
func shows(i: byte, k: byte): bool
  if flags == IN_MEMORY then
    return shows_memory(i, k)
  end
  return flags != NO_REG and holds(flags, i, k)
end

; ---- Instructions ------------------------------------------------------------------------

; An instruction without an operand that changes no register: CLC, SEC.
pub func implied(opcode: byte)
  fbuf.op(opcode)
end

; The instruction `opcode` (absolute form) on byte `k` of operand `i`: memory, reached as
; its mode says, or an address, as an immediate. An element's index goes to X (to Y for
; LDX), and the index of what a pointer points at to Y.
func memory(opcode: byte, i: byte, k: byte)
  var r: byte
  if op_kind[i] == O_ADDR then
    fbuf.op_fix(opcode - IMMEDIATE_FORM, fbuf.FIX_LOW + k, op_symbol[i], op_slot[i], op_value[i])
    return
  end
  if op_mode[i] == M_POINTER then
    point(i, k)
    use(i)
    fbuf.op_fix(opcode + POINTER_FORM, fbuf.FIX_ZERO_PAGE, op_symbol[i], op_slot[i], 0)
    return
  end
  if op_mode[i] == M_INDEXED then
    r = X
    if opcode == OP_LDX then
      r = Y
    end
    load_direct(r, i + INDEX, 0)
    opcode += INDEXED_FORM
  end
  direct(opcode, i, k)
end

; Make Y the index of byte `k` of what a pointer points at: its index plus its offset.
func point(i: byte, k: byte)
  var n: word
  var m: word
  n = offset(i, k)
  if op_kind[i + INDEX] == O_CONST then
    load_const(Y, lo(op_value[i + INDEX] + n))
    return
  end
  load_direct(Y, i + INDEX, 0)
  for m = 0 until n do
    fbuf.op(OP_INY)
    forget_register(Y)
    flags = Y
  end
end

; The instruction `opcode` (absolute form, or absolute indexed) on byte `k` of memory
; operand `i`, with the operand's address.
pub func direct(opcode: byte, i: byte, k: byte)
  var place: word
  use(i)
  place = offset(i, k)
  if op_symbol[i] == kernel.NO_OBJ then
    if place < $100 then
      fbuf.op_byte(opcode - ZERO_PAGE_FORM, byte(place))    ; the linker shrinks only fix-ups
    else
      fbuf.op_word(opcode, place)
    end
  elif op_flags[i] & F_ZP != 0 then
    fbuf.op_fix(opcode - ZERO_PAGE_FORM, fbuf.FIX_ZERO_PAGE, op_symbol[i], op_slot[i], place)
  else
    fbuf.op_fix(opcode, fbuf.FIX_ADDRESS, op_symbol[i], op_slot[i], place)
  end
end

; Copy register `source` to register `target`. One of them is A.
pub func transfer(source: byte, target: byte)
  var n: byte
  if source == target then
    return
  end
  if TRANSFERS[source * 3 + target] == 0 then
    err.fatal(err.E_INTERNAL)
  end
  claim(target)
  fbuf.op(TRANSFERS[source * 3 + target])
  reg_known[target] = reg_known[source]
  reg_const[target] = reg_const[source]
  for n = 0 until COPY_COUNT do
    copy_knowledge(source * COPY_COUNT + n, target * COPY_COUNT + n)
  end
  flags = A
end

; True if `source` is a register that `r` can be loaded from.
func from_other(r: byte, source: byte): bool
  return source != NO_REG and (source == A or r == A)
end

; Load register `r` with a constant, whatever is known.
pub func force(r: byte, value: byte)
  claim(r)
  fbuf.op_byte(LOAD_IMMEDIATE[r], value)
  forget_register(r)
  reg_known[r] = true
  reg_const[r] = value
  flags = r
end

; Make register `r` hold the one-byte constant `value`.
pub func load_const(r: byte, value: byte)
  var source: byte
  if reg_known[r] and reg_const[r] == value then
    return
  end
  for source = 0 until 3 do
    if reg_known[source] and reg_const[source] == value and from_other(r, source) then
      transfer(source, r)
      return
    end
  end
  force(r, value)
end

; Make register `r` hold byte `k` of operand `i`. What a pointer points at can only be
; loaded into A, and goes on from there.
pub func load(r: byte, i: byte, k: byte)
  var wanted: byte
  if is_direct(i) or is_const_byte(i, k) then
    load_direct(r, i, k)
    return
  end
  wanted = r
  if op_mode[i] == M_POINTER then
    r = A
  end
  claim(r)
  memory(LOAD_ABSOLUTE[r], i, k)
  forget_register(r)
  flags = r
  transfer(r, wanted)
end

; load() of an operand that needs no index register.
func load_direct(r: byte, i: byte, k: byte)
  var source: byte
  if is_const_byte(i, k) then
    load_const(r, const_byte(i, k))
    return
  end
  if holds(r, i, k) then
    return
  end
  source = holder(i, k)
  if from_other(r, source) then
    transfer(source, r)
    return
  end
  claim(r)
  if op_kind[i] == O_ADDR then
    fbuf.op_fix(LOAD_IMMEDIATE[r], fbuf.FIX_LOW + k, op_symbol[i], op_slot[i], op_value[i])
    forget_register(r)
  elif op_kind[i] == O_VAR then
    direct(LOAD_ABSOLUTE[r], i, k)
    forget_register(r)
    remember(r, i, k)
  else
    err.fatal(err.E_INTERNAL)
  end
  flags = r
end

; Store register `r` in byte `k` of memory operand `i`. Only A is stored in an element
; or through a pointer.
pub func store(r: byte, i: byte, k: byte)
  if not is_direct(i) and r != A then
    transfer(r, A)
    r = A
  end
  memory(STORE_ABSOLUTE[r], i, k)
  changed(i, k, r)
  remember(r, i, k)
end

; store() in a temporary, which needs no index.
func store_direct(r: byte, i: byte, k: byte)
  direct(STORE_ABSOLUTE[r], i, k)
  changed(i, k, r)
  remember(r, i, k)
end

; Store byte `k` of operand `i` in byte `target_k` of memory operand `target`, from
; whichever register holds it already, or else through A. A value in A and X is stored in
; a temporary first if the target is an element, whose index needs X.
pub func put(i: byte, k: byte, target: byte, target_k: byte)
  var r: byte
  if op_kind[i] == O_AX and op_mode[target] == M_INDEXED then
    spill(i)
  end
  r = holder(i, k)
  if r == NO_REG and k == 1 and op_size[i] == 2 and op_kind[i] == O_VAR and is_direct(i) and
      is_direct(target) and owner == NONE then
    load(X, i, k)                   ; A may hold the byte below: keep it there
    r = X
  end
  if r == NO_REG or not is_direct(target) then
    load(A, i, k)
    r = A
  end
  store(r, target, target_k)
end

; Store a constant byte in byte `target_k` of memory operand `target`.
pub func put_const(value: byte, target: byte, target_k: byte)
  var r: byte = A
  var other: byte
  for other = 0 until 3 do
    if reg_known[other] and reg_const[other] == value and is_direct(target) then
      r = other
    end
  end
  load_const(r, value)
  store(r, target, target_k)
end

; ORA, AND, EOR, ADC or SBC of A with a constant.
pub func immediate(opcode: byte, value: byte)
  claim(A)
  fbuf.op_byte(opcode - IMMEDIATE_FORM, value)
  forget_register(A)
  flags = A
end

; ORA, AND, EOR, ADC or SBC of A with byte `k` of operand `i`, which is a constant or
; memory.
pub func alu(opcode: byte, i: byte, k: byte)
  if is_const_byte(i, k) then
    immediate(opcode, const_byte(i, k))
    return
  end
  claim(A)
  memory(opcode, i, k)
  forget_register(A)
  flags = A
end

; CMP of A with a constant.
pub func compare_const(value: byte)
  fbuf.op_byte(OP_CMP - IMMEDIATE_FORM, value)
  flags = NO_REG
end

; CMP of A with byte `k` of operand `i`.
pub func compare(i: byte, k: byte)
  if is_const_byte(i, k) then
    compare_const(const_byte(i, k))
    return
  end
  memory(OP_CMP, i, k)
  flags = NO_REG
end

; ASL, LSR, ROL or ROR of A.
pub func accumulator(opcode: byte)
  claim(A)
  fbuf.op(opcode - IMMEDIATE_FORM)
  forget_register(A)
  flags = A
end

; INC, DEC, ASL, LSR, ROL or ROR of byte `k` of memory operand `i`. The flags then show
; that byte, unless it is at a fixed address, which may be a device, or an element. What a
; pointer points at is changed in A, which has no INC: there that is an ADC, which changes
; the carry flag too.
pub func modify(opcode: byte, i: byte, k: byte)
  if op_mode[i] == M_POINTER then
    load(A, i, k)
    if opcode == OP_INC then
      implied(OP_CLC)
      immediate(OP_ADC, 1)
    elif opcode == OP_DEC then
      implied(OP_SEC)
      immediate(OP_SBC, 1)
    else
      accumulator(opcode)
    end
    store(A, i, k)
    return
  end
  memory(opcode, i, k)
  changed(i, k, NO_REG)
  flags = NO_REG
  if op_symbol[i] != kernel.NO_OBJ and op_mode[i] == M_DIRECT then
    flags = IN_MEMORY
    flags_symbol = op_symbol[i]
    flags_slot = op_slot[i]
    flags_offset = offset(i, k)
  end
end

; INX or DEX.
pub func step_x(opcode: byte)
  fbuf.op(opcode)
  forget_register(X)
end

; Make the N and Z flags show the value of register `r`.
pub func test(r: byte)
  if flags != r then
    fbuf.op_byte(COMPARE_IMMEDIATE[r], 0)
    flags = r
  end
end

; Make the N and Z flags show byte `k` of operand `i`: nothing if they do already,
; otherwise through A.
pub func test_byte(i: byte, k: byte)
  if not shows(i, k) then
    load(A, i, k)
    test(A)
  end
end

; Put a label that only earlier instructions go to here. What the registers hold there
; is what every way in agrees on: each branch and jump to it (arrival() kept that), and the
; code before it, unless that cannot be reached: what it seemed to leave in the registers
; was never there. Nothing is known if a way in was not kept.
pub func label(target: byte)
  var t: byte
  var s: byte
  var falls: bool
  t = fbuf.same(target)
  s = fbuf.label_note[t]
  fbuf.label_note[t] = LOST
  falls = fbuf.runs_on()
  if fbuf.arrive(target) or not falls then      ; else nothing goes there: all is still known
    if s == NOTHING or s == LOST then
      forget()
    elif falls then
      meet(0, s)
    else
      copy_state(s, 0)
    end
    flags = NO_REG
  end
  drop_state(s)
end

; Put a label here that later instructions will go to.
pub func loop_label(target: byte)
  var t: byte
  t = fbuf.same(target)
  drop_state(fbuf.label_note[t])
  fbuf.label_note[t] = LOST
  fbuf.place(target)
  forget()
end

; A branch or jump to `target` is being added: keep what the registers hold now as one
; way into it, unless it is placed already. Without room for that, nothing is known there.
func arrival(target: byte)
  var t: byte
  var s: byte
  var n: byte
  t = fbuf.same(target)
  s = fbuf.label_note[t]
  if s == NOTHING then
    s = LOST
    for n = 1 until STATES do
      if not state_busy[n] and s == LOST then
        s = n
      end
    end
    fbuf.label_note[t] = s
    if s != LOST then
      state_busy[s] = true
      copy_state(0, s)
    end
  elif s != LOST then
    meet(s, 0)
  end
end

; A conditional branch (or BRA) to label `target`.
pub func branch(opcode: byte, target: byte)
  arrival(target)
  fbuf.branch(opcode, target)
end

; A JMP to label `target`.
pub func jump(target: byte)
  arrival(target)
  fbuf.jump(target)
end

; Make label `other`, which has not been placed, the same place as `target`: what is
; known there is what the ways into both agree on.
pub func join(target: byte, other: byte)
  var t: byte
  var o: byte
  var first: byte
  var second: byte
  t = fbuf.same(target)
  o = fbuf.same(other)
  first = fbuf.label_note[t]
  second = fbuf.label_note[o]
  fbuf.join(target, other)
  if t == o or second == NOTHING then
    return
  end
  if first == NOTHING then
    fbuf.label_note[t] = second
    return
  end
  drop_state(second)
  if second == LOST then
    drop_state(first)
    fbuf.label_note[t] = LOST
  elif first != LOST then
    meet(first, second)
  end
end

; State `s`, if it is one, is free again.
func drop_state(s: byte)
  if s != NOTHING and s < STATES then
    state_busy[s] = false
  end
end

; State `target` is what state `source` is.
func copy_state(source: byte, target: byte)
  var r: byte
  var n: byte
  for r = 0 until 3 do
    reg_known[3 * target + r] = reg_known[3 * source + r]
    reg_const[3 * target + r] = reg_const[3 * source + r]
  end
  for n = 0 until 3 * COPY_COUNT do
    copy_knowledge(3 * COPY_COUNT * source + n, 3 * COPY_COUNT * target + n)
  end
end

; State `target` keeps only what state `other` agrees with.
func meet(target: byte, other: byte)
  var r: byte
  var mine: byte
  var theirs: byte
  var n: byte
  for r = 0 until 3 do
    mine = 3 * target + r
    theirs = 3 * other + r
    if not reg_known[theirs] or reg_const[theirs] != reg_const[mine] then
      reg_known[mine] = false
    end
    for n = mine * COPY_COUNT until mine * COPY_COUNT + COPY_COUNT do
      if reg_copy[n] and not has_copy(theirs, n) then
        reg_copy[n] = false
      end
    end
  end
end

; True if entry `holder_entry` of reg_known (a register in a state) has the copy that
; entry `n` of the copies has.
func has_copy(holder_entry: byte, n: byte): bool
  var m: byte
  for m = holder_entry * COPY_COUNT until holder_entry * COPY_COUNT + COPY_COUNT do
    if reg_copy[m] and reg_symbol[m] == reg_symbol[n] and reg_slot[m] == reg_slot[n] and
        reg_offset[m] == reg_offset[n] then
      return true
    end
  end
  return false
end

; ---- Types of operands -------------------------------------------------------------------

; True if a value of type `actual` can be given to something of type `t` as it is: the
; same type, a `byte` where a `word` is wanted, or `nil` where a pointer or a function type is.
pub func accepts(actual: byte, t: byte): bool
  return actual == t or (actual == typetab.BYTE_TYPE and t == typetab.WORD_TYPE) or
      (actual == typetab.NIL_TYPE and (typetab.is_pointer(t) or typetab.is_func(t)))
end

; True if operand `i` is `@f` that has not been given a type yet.
func is_function_address(i: byte): bool
  return op_kind[i] == O_ADDR and op_type[i] == typetab.NO_TYPE
end

; The object-file symbol of the pointer class of function type `s`, the symbol that
; declares it. The first use writes its SYM record and its CLAS record.
pub func class_symbol(s: word): word
  var flags: byte
  var m: word
  if kernel.sym_obj[s] == kernel.NO_OBJ then
    kernel.sym_obj[s] = out.symbol(out.SYM_CLASS, kernel.module_name[kernel.sym_scope[s]], 0,
        kernel.sym_name[s])
    flags = 0
    if typetab.is_recursive(kernel.sym_type[s]) then
      flags = out.CLASS_RECURSIVE
    end
    out.pointer_class(kernel.sym_obj[s], flags, kernel.sym_params[s])
    for m = kernel.sym_members[s] until kernel.sym_members[s] + kernel.sym_params[s] do
      out.class_parameter(typetab.size(kernel.member_type[m]))
    end
  end
  return kernel.sym_obj[s]
end

; Operand `i`, `@f`, is given to something of type `t`, which must be a function type
; with f's parameters and results, and `recursive` only if f is. f then joins the type's
; pointer class: a MEMB record says so.
pub func fit_function(i: byte, t: byte)
  var f: word
  var s: word
  var m: byte
  if not typetab.is_func(t) then
    err.fatal(err.E_FUNC_ADDRESS)
  end
  f = op_var[i]
  s = typetab.base(t)
  if kernel.sym_flags[f] & kernel.SF_ASM != 0 then
    err.fatal(err.E_REGISTER_FUNC)
  end
  if kernel.sym_params[f] != kernel.sym_params[s] or kernel.sym_results[f] != kernel.sym_results[s] then
    err.fatal(err.E_SIGNATURE)
  end
  for m = 0 until kernel.sym_params[f] + kernel.sym_results[f] do
    if kernel.member_type[kernel.sym_members[f] + m] != kernel.member_type[kernel.sym_members[s] + m] or
        kernel.member_value[kernel.sym_members[f] + m] != kernel.member_value[kernel.sym_members[s] + m] then
      err.fatal(err.E_SIGNATURE)
    end
  end
  if typetab.is_recursive(t) and kernel.sym_flags[f] & kernel.SF_RECURSIVE == 0 then
    err.fatal(err.E_NOT_RECURSIVE)
  end
  out.member(class_symbol(s), op_symbol[i])
  op_type[i] = t
end

; Operand `i`, a number without a type, takes type `t`, which it must fit. One that `~` or
; unary `-` made below 0 fits an unsigned type as its bits do, if it is at least -256 for a
; byte: `~$20` is $DF as a byte.
pub func fit(i: byte, t: byte)
  var wraps: bool
  if not typetab.is_number(t) then
    err.fatal(err.E_TYPE)
  end
  wraps = op_flags[i] & F_WRAPS != 0 and op_type[i] == typetab.NEGATIVE_TYPE and not typetab.is_signed(t) and
      (typetab.size(t) == 2 or op_value[i] >= $FF00)
  if not wraps and not typetab.number_fits(op_value[i], op_type[i] == typetab.NEGATIVE_TYPE, t) then
    err.fatal(err.E_RANGE)
  end
  op_type[i] = t
  op_size[i] = typetab.size(t)
  op_value[i] = typetab.narrow(op_value[i], t)
end

; Check that operand `i` can be given to something of type `t`, and give it that type.
; An array cannot: it is not a value.
pub func assignable(i: byte, t: byte)
  if typetab.is_array(t) or typetab.is_array(op_type[i]) then
    err.fatal(err.E_ARRAY_VALUE)
  end
  if is_function_address(i) then
    fit_function(i, t)
  elif typetab.is_untyped(op_type[i]) then
    fit(i, t)
  elif not accepts(op_type[i], t) then
    err.fatal(err.E_TYPE)
  end
  op_type[i] = t
end

; Operand `i`, a `byte`, is used with the number without a type `number`: if that does
; not fit a byte, `i` is widened to a word, as a byte is wherever a word is needed.
func widen(i: byte, number: byte)
  if op_type[i] == typetab.BYTE_TYPE and op_flags[number] & F_WRAPS == 0 and
      not typetab.number_fits(op_value[number], op_type[number] == typetab.NEGATIVE_TYPE, typetab.BYTE_TYPE) then
    op_type[i] = typetab.WORD_TYPE
  end
end

; The type in which an operator works on operands `left` and `right`, which both take
; it. typetab.NUMBER_TYPE if neither has a type: they are then constants.
pub func unify(left: byte, right: byte): byte
  if typetab.is_array(op_type[left]) or typetab.is_array(op_type[right]) then
    err.fatal(err.E_ARRAY_VALUE)
  end
  if typetab.is_record(op_type[left]) or typetab.is_record(op_type[right]) then
    err.fatal(err.E_TYPE)
  end
  if is_function_address(left) then
    fit_function(left, op_type[right])
  elif is_function_address(right) then
    fit_function(right, op_type[left])
  end
  if typetab.is_untyped(op_type[left]) then
    if typetab.is_untyped(op_type[right]) then
      return typetab.NUMBER_TYPE
    end
    widen(right, left)
    fit(left, op_type[right])
  elif typetab.is_untyped(op_type[right]) then
    widen(left, right)
    fit(right, op_type[left])
  elif accepts(op_type[left], op_type[right]) then
    op_type[left] = op_type[right]
  elif accepts(op_type[right], op_type[left]) then
    op_type[right] = op_type[left]
  else
    err.fatal(err.E_TYPE)
  end
  return op_type[left]
end
