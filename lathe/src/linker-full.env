; The Lathe-written linker (lathe/src/link.lth) banked on Wendy 2 run with `--disk DIR`
; (lathe/env/wendy2disk.env) at the full capacities, the ones that link the compiler and the
; linker itself (`LKSMALL 0`): stage 8's gate (lathe/tests/test_src_selflink.py). The code is
; placed as in linker-bank.env, the small build that test_src_link.py tests; here the large tables
; are in regions in two data banks, read and written only through the functions of lk_tab and
; lk_name that map them (lathe/docs/architecture.md, "Memory in the linker"): bank 4 holds the
; work area (lk_tab.work and lk_tab.nodes, 18,000 bytes), bank 5 lk_name.local, the calls and the
; slots' columns (25,248 bytes). What is left in fixed memory is the functions' columns but
; fn_edge, the variables' and constants', the classes', and the small tables.
;
; The functions with `with` blocks are kept in fixed memory by the linker, so the split between
; variables and code is lower than in linker-bank.env.
cpu       65c02
zeropage  $00 $FF
code      $58C0 $7FFF
data      $0200 $58BF
more      data $F810 $FFF9
stack     $FF
exit      stop
output    raw
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 1 $11 LINK1.BIN
bank      WIN 2 $12 LINK2.BIN
bank      WIN 3 $13 LINK3.BIN
bank      WIN 4 $14              ; data only: the work area
bank      WIN 5 $15              ; data only: lk_name.local, the calls and the slots
place     link WIN 1
place     lk_err WIN 1
place     lk_file WIN 1
place     lk_envf WIN 1
place     lk_scan WIN 1
place     lk_name WIN 1
place     lk_graph WIN 2
place     lk_alloc WIN 2
place     lk_op WIN 3
place     lk_win WIN 3
place     lk_boot WIN 3
place     lk_fix WIN 3
place     lk_place WIN 3
place     lk_map WIN 3
place     lk_emit WIN 3
place     lk_out WIN 3
place     lk_dyn WIN 3
region    LKWORK WIN 4           ; lk_tab.work
region    LKNODES WIN 4          ; lk_tab.nodes: the work area's node columns
region    LKLOCAL WIN 5          ; lk_name.local
region    LKCALLS WIN 5          ; lk_tab.edge_word and fn_edge
region    LKSLOTS WIN 5          ; lk_tab.slot_sz, slot_weight, big_slot and big_size
farcall   rt_bank
define    BOARD 2
define    DISK 1
define    PORTS 1     ; sys over the file ports (lathe/rt/disk.lth)
define    LKSMALL 0   ; the linker's tables at full size
define    LKDYN 1     ; dynamic regions linked (lathe/src/lk_dyn.lth)
define    LKROOMS 0   ; the tables' capacities fixed by the build (lathe/src/lk_tab.lth)
