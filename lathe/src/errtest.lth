; A test of err: errtest NUMBER [FILE [LINE COL [PLACE]]] reports error NUMBER, in FILE at LINE
; and COL if they are given, as err.fatal does; with a fifth argument, the place is given as an
; err.Place kept for later (err.position_at). (lathe/tests/test_src_err.py)
module errtest

import err (fatal, init, Place, position, position_at, set_file)
import sys (arg_copy, argc)

var text: [256]byte
var file: [128]byte

func argument(i: byte): word
  var n: word = 0
  var k: byte = 0
  var length: byte
  length = sys.arg_copy(i, @text)
  while k < length do
    n = n * 10 + text[k] - '0'
    k += 1
  end
  return n
end

pub func main()
  var number: word
  var length: byte
  err.init()
  number = argument(0)
  if sys.argc() > 1 then
    length = sys.arg_copy(1, @file)
    err.set_file(@file)
  end
  if sys.argc() > 4 then
    var place: err.Place
    place.line = argument(2)
    place.col = argument(3)
    err.position(0, 0)
    err.position_at(@place)
  elif sys.argc() > 3 then
    err.position(argument(2), argument(3))
  end
  err.fatal(byte(number))
end
