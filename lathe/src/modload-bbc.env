; MODLOAD, the developer's loader of the tools' module (lathe/src/modload.lth; lathe/docs/bbc.md,
; "The developer's cycle"), run with *RUN: lathe/env/bbc.env's machine, all in one, and the
; module's slot. With `define ADFS 1` at ADFS's PAGE and with BBCFS 2 ADFS's names, as the
; developer's machine has them (test_bbc_adfs.adfs_env makes that form of it).
cpu       6502
zeropage  $00 $8F
define    ADFS 0        ; 1: PAGE is ADFS's with the DFS beside it, $1F00 (lathe/docs/bbc.md, "ADFS")
unless    ADFS code $1900 $6BFF
when      ADFS code $1F00 $6BFF
data      $6C00 $7BFF
more      data $0401 $06FF
exit      return $0400  ; the start-up code keeps S at $0400 (bbc.KEEP), and ends with RTS
output    raw
define    BOARD 3       ; the BBC (lathe/host/driver/boards.py)
define    PORTS 2       ; lathe/rt/bbc.lth
define    BBCFS 0       ; file names as given; 1: the DFS's; 2: ADFS's (lathe/rt/bbc/bbcfs.lth)
define    MODULE_SLOT 4 ; the module's slot unless -s gives another (the emulator's --bbc-module-slot)
