; The code the linker makes itself: lathe/host/lk_boot.py in Lathe.
;
; `$start` and `$init`, and with code in a window the stubs and the table of banks or overlays.
;
; `$start` is the first thing in the code range and what the reset vector points at:
;
;     LDX #stack / TXS            if the environment has a `stack` entry
;     CLD
;     LDA #<$banks / LDX #>$banks / JSR FARCALL.start
;                                 if code is placed in a window ($overlays for overlays)
;     JSR $init                   if there is one
;     JSR MAINMODULE.main
;     LDA #$00 / JMP addr         for `exit call addr`; a JMP to itself for `exit loop`;
;                                 RTS for `exit return`; STP ($DB, 65C02) for `exit stop`
;
; `$init` follows it if any module has a function `MODULE.$init`, which is where the compiler puts
; a module's initialisers: one JSR for each, in the order of the object files, and an RTS. A JSR
; of a function in a window, here or in `$start`, is a JSR of its stub. The stubs follow, and then
; the table (lk_win).
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | the lengths: ints                    | start_len, table_len words;       | the type is the |
;   |                                      | init_len a word (3 bytes a module)| storage         |
;   | table_addr >> 8, & 0xFF              | hi(...), lo(...)                  |                 |
;   | entry_size, a bank, the table's i:   | bytes                             |                 |
;   | ints                                 |                                   |                 |
;   | put(lk_envf.stack)                   | put(lo(lk_envf.stack)): a word    | it is at most   |
;   |                                      |                                   | $FF (lk_envf)   |
;   | name_at += text[...] + 1             | word(text[...]) + 1               | a byte would    |
;   |                                      |                                   | wrap            |
;   | range(1, length + 1)                 | for k = 1 to length               | the same        |
module lk_boot

import lk_envf
import lk_name
import lk_out
import lk_scan
import lk_sym
import lk_tab
import lk_win

pub var start_addr: word = 0
pub var start_len: word = 0
pub var init_addr: word = 0
pub var init_len: word = 0      ; 0 if no module has initialisers
pub var table_addr: word = 0    ; $banks or $overlays
pub var table_len: word = 0     ; 0 if no code is placed in a window

; True if function f is some module's `$init`: its name ends in `.$init` (lk_name).
pub func is_init(f: word): bool
  return (lk_tab.fn_flags[f] & lk_tab.F_INIT) != 0
end

; Work out the addresses and sizes of the two. Returns their size together.
pub func plan(): word
  var f: word
  init_len = 0
  for f = 0 until lk_tab.fn_count do
    if is_init(f) then
      init_len += 3
    end
  end
  if init_len != 0 then
    init_len += 1
  end
  start_len = 4                 ; CLD and JSR main
  if lk_envf.has_stack then
    start_len += 3
  end
  table_len = 0
  if lk_envf.placed() then
    start_len += 7
    table_len = lk_win.table_size()
  end
  if init_len != 0 then
    start_len += 3
  end
  if lk_envf.exit_kind == lk_envf.EXIT_CALL then
    start_len += 5
  elif lk_envf.exit_kind == lk_envf.EXIT_LOOP then
    start_len += 3
  else
    start_len += 1              ; RTS or STP
  end
  start_addr = lk_envf.code_lo
  init_addr = start_addr + start_len
  lk_win.stub_base = init_addr + init_len
  table_addr = lk_win.stub_base + lk_win.STUB_SIZE * lk_win.stub_count
  return start_len + init_len + lk_win.STUB_SIZE * lk_win.stub_count + table_len
end

func jsr(addr: word)
  lk_out.put($20)
  lk_out.put_word(addr)
end

; Where fixed code calls function f's copy for context ctx: its stub, if it has one.
func entry(f: word, ctx: byte): word
  var n: word
  n = lk_tab.copy_node(f, ctx)
  if lk_win.has_stub(f) then
    return lk_win.stub_addr(n)
  end
  return lk_tab.work[lk_tab.W_ADDR + n]
end

; The address of the copy of FARCALL.call that a stub for context ctx calls: the copy for ctx, or
; the first if the context makes no far call itself.
func call_copy(ctx: byte): word
  var f: word
  f = lk_sym.row_of(lk_name.fc_call)
  if lk_tab.has_copy(f, ctx) then
    return lk_tab.work[lk_tab.W_ADDR + lk_tab.copy_node(f, ctx)]
  end
  return lk_tab.work[lk_tab.W_ADDR + lk_tab.first_node(f)]
end

; Every stub, in the order of the copies, and the table.
func write_stubs()
  var f: word
  var bank: byte
  var ctx: byte
  var n: word
  var w: byte
  var entry_size: byte
  var name_at: word
  var i: byte
  var b: byte
  var name: word
  var k: byte
  for f = 0 until lk_tab.fn_count do
    if lk_win.has_stub(f) then
      bank = lk_scan.fn_bank(f) - 1
      for ctx = 0 until lk_tab.ctx_count do
        if lk_tab.has_copy(f, ctx) then
          n = lk_tab.copy_node(f, ctx)
          jsr(call_copy(ctx))
          lk_out.put(lk_envf.bank_value[bank])
          lk_out.put_word(lk_tab.work[lk_tab.W_ADDR + n] - 1)
        end
      end
    end
  end
  w = lk_envf.window()
  lk_out.put_word(lk_envf.win_lo[w])
  lk_out.put(lk_win.table_count)
  entry_size = 3
  if lk_envf.is_overlay() then
    entry_size = 2
  end
  name_at = table_addr + 3 + word(entry_size) * lk_win.table_count
  for i = 0 until lk_win.table_count do
    b = lk_win.table_bank(i)
    if not lk_envf.is_overlay() then
      lk_out.put(lk_envf.bank_value[b])
    end
    lk_out.put_word(name_at)
    name_at += word(lk_envf.text[lk_envf.bank_file[b] - 1]) + 1
  end
  for i = 0 until lk_win.table_count do
    name = lk_envf.bank_file[lk_win.table_bank(i)]
    for k = 1 to lk_envf.text[name - 1] do
      lk_out.put(lk_envf.text[name - 1 + k])
    end
    lk_out.put(0)
  end
end

; Write both to the image. main_fn is the program's main function.
pub func write(main_fn: word)
  var f: word
  lk_out.seek(start_addr)
  if lk_envf.has_stack then
    lk_out.put($A2)             ; LDX #stack
    lk_out.put(lo(lk_envf.stack))
    lk_out.put($9A)             ; TXS
  end
  lk_out.put($D8)               ; CLD
  if table_len != 0 then
    lk_out.put($A9)             ; LDA #<table
    lk_out.put(lo(table_addr))
    lk_out.put($A2)             ; LDX #>table
    lk_out.put(hi(table_addr))
    jsr(lk_tab.work[lk_tab.W_ADDR + lk_tab.first_node(lk_sym.row_of(lk_name.fc_start))])
  end
  if init_len != 0 then
    jsr(init_addr)
  end
  jsr(entry(main_fn, 0))
  if lk_envf.exit_kind == lk_envf.EXIT_CALL then
    lk_out.put($A9)             ; LDA #$00
    lk_out.put(0)
    lk_out.put($4C)             ; JMP addr
    lk_out.put_word(lk_envf.exit_addr)
  elif lk_envf.exit_kind == lk_envf.EXIT_LOOP then
    lk_out.put($4C)             ; JMP to this JMP
    lk_out.put_word(start_addr + start_len - 3)
  elif lk_envf.exit_kind == lk_envf.EXIT_STOP then
    lk_out.put($DB)             ; STP
  else
    lk_out.put($60)             ; RTS
  end
  if init_len != 0 then
    for f = 0 until lk_tab.fn_count do
      if is_init(f) then
        jsr(entry(f, 0))
      end
    end
    lk_out.put($60)             ; RTS
  end
  if table_len != 0 then
    write_stubs()
  end
end
