; LEX: characters to tokens. lathe/host/lex.py in Lathe.
;
; Owns the current token (the parser looks one token ahead and no further) and everything the
; lexical rules of docs/language.md say: case folding, numbers, strings, comments, and where a
; line ends. The parser sees one T_NL at the end of each statement and never a blank line: the
; continuation rule is applied here and nowhere else.
;
; Conditional compilation is done here too: the lines of a part that is not compiled never
; become tokens (directive()). A saved token run (src.open_saved()) is read as tokens, not
; characters (saved_token()); the format is at SAVED_LINE. The line mode of `asm` blocks, where whole lines pass through
; until a line whose first word is `end`, is ASM's: it reads the source itself.
;
; Where the Lathe differs from the Python:
;
;   | Python                              | Lathe                              | Why            |
;   |-------------------------------------|------------------------------------|----------------|
;   | KEYWORDS: one byte string           | KEYWORDS: a table of two strings,  | 12 bytes less  |
;   |                                     | each ending with a space; init()   | code than one  |
;   |                                     | walks each to its zero             | table of 262,  |
;   |                                     |                                    | which takes a  |
;   |                                     |                                    | word index     |
;   | 1 << (nesting - 1)                  | NESTING_BIT[nesting - 1]           | 44 bytes less  |
;   |                                     |                                    | than calls of  |
;   |                                     |                                    | rt_math.shl16  |
;   | ~bit & 0xFFFF                       | ~bit                               | a word wraps   |
;   | `while True:` ... `break`           | loop ... end                       |                |
;   | is_digit(): a function              | `inline`; C_0 and C_9 exported     | smaller code   |
module lex

import err
import kernel
import src

; ---- Tokens ------------------------------------------------------------------------------

pub const T_EOF = 0
pub const T_NL = 1              ; the end of a statement's last line
pub const T_NAME = 2            ; value: the name
pub const T_NUMBER = 3          ; value: the number; a character constant is a number
pub const T_STRING = 4          ; the bytes are in `string`

pub const T_LPAREN = 5
pub const T_RPAREN = 6
pub const T_LBRACKET = 7
pub const T_RBRACKET = 8
pub const T_COMMA = 9
pub const T_COLON = 10
pub const T_DOT = 11
pub const T_ADDRESS = 12        ; @
pub const T_TILDE = 13
pub const T_ARROW = 14          ; ->
pub const T_ASSIGN = 15
pub const T_PLUS_ASSIGN = 16
pub const T_MINUS_ASSIGN = 17
pub const T_AND_ASSIGN = 18
pub const T_OR_ASSIGN = 19
pub const T_XOR_ASSIGN = 20
pub const T_SHL_ASSIGN = 21
pub const T_SHR_ASSIGN = 22

; The binary operators that are not words, T_PLUS to T_GE. A line that ends with one continues.
pub const T_PLUS = 23
pub const T_MINUS = 24
pub const T_STAR = 25
pub const T_SLASH = 26
pub const T_AMP = 27
pub const T_BAR = 28
pub const T_CARET = 29
pub const T_SHL = 30
pub const T_SHR = 31
pub const T_EQ = 32
pub const T_NE = 33
pub const T_LT = 34
pub const T_LE = 35
pub const T_GT = 36
pub const T_GE = 37
pub const T_HASH_IF = 38        ; `#if`: the parser works out its condition and calls choose()

; Keywords, numbered in the order of KEYWORDS.
pub const T_AND = 64
pub const T_ASM = 65
pub const T_AT = 66
pub const T_BOOL = 67
pub const T_BREAK = 68
pub const T_BYTE = 69
pub const T_CASE = 70
pub const T_CONST = 71
pub const T_CONTINUE = 72
pub const T_CRITICAL = 73
pub const T_DO = 74
pub const T_DOWNTO = 75
pub const T_ELIF = 76
pub const T_ELSE = 77
pub const T_END = 78
pub const T_ENUM = 79
pub const T_EXTERN = 80
pub const T_FOR = 81
pub const T_FORWARD = 82
pub const T_FUNC = 83
pub const T_IF = 84
pub const T_IMPORT = 85
pub const T_IN = 86
pub const T_INLINE = 87
pub const T_INT = 88
pub const T_INTERRUPT = 89
pub const T_LOOP = 90
pub const T_MOD = 91
pub const T_MODULE = 92
pub const T_NOT = 93
pub const T_NOZP = 94
pub const T_OF = 95
pub const T_OR = 96
pub const T_PUB = 97
pub const T_RECORD = 98
pub const T_RECURSIVE = 99
pub const T_RETURN = 100
pub const T_ROWS = 101
pub const T_SBYTE = 102
pub const T_STATIC = 103
pub const T_THEN = 104
pub const T_TO = 105
pub const T_TYPE = 106
pub const T_UNTIL = 107
pub const T_VAR = 108
pub const T_WHILE = 109
pub const T_WORD = 110
pub const T_ZP = 111
pub const T_LONG = 112          ; reserved for later

const KEYWORDS: [2]^byte = [
  "and asm at bool break byte case const continue critical do downto elif else end enum extern for forward func if import in inline int interrupt loop mod module ",
  "not nozp of or pub record recursive return rows sbyte static then to type until var while word zp long "
]
const ERROR_WORD: [5]byte = "error"     ; the directive #error, which is not a keyword

; ---- Characters --------------------------------------------------------------------------

const C_TAB = $09
const C_LF = $0A
const C_CR = $0D
const C_SPACE = $20
const C_BANG = $21
const C_DQUOTE = $22
const C_HASH = $23
const C_DOLLAR = $24
const C_PERCENT = $25
const C_AMP = $26
const C_QUOTE = $27
const C_LPAREN = $28
const C_RPAREN = $29
const C_STAR = $2A
const C_PLUS = $2B
const C_COMMA = $2C
const C_MINUS = $2D
const C_DOT = $2E
const C_SLASH = $2F
pub const C_0 = $30
pub const C_9 = $39
const C_COLON = $3A
const C_SEMICOLON = $3B
const C_LESS = $3C
const C_EQUALS = $3D
const C_GREATER = $3E
const C_AT = $40
const C_UPPER_A = $41
const C_UPPER_F = $46
const C_UPPER_Z = $5A
const C_LBRACKET = $5B
const C_BACKSLASH = $5C
const C_RBRACKET = $5D
const C_CARET = $5E
const C_UNDERSCORE = $5F
const C_A = $61
const C_F = $66
const C_N = $6E
const C_R = $72
const C_T = $74
const C_X = $78
const C_Z = $7A
const C_BAR = $7C
const C_TILDE = $7E

; A saved token run is, for each token: its token number, its column (one byte, at most 255),
; and for T_NAME the name and for T_NUMBER the value (two bytes each), for T_STRING its length
; (one byte: INLINE does not save a longer string) and its bytes. Before a token on a later
; line than the one before it: SAVED_LINE and how many lines later, one or more times (each at
; most 255). Every token number is below SAVED_LINE.
pub const SAVED_LINE = $7F
pub const MAX_COLUMN = $FF

; ---- The current token -------------------------------------------------------------------

const MAX_STRING = 2048         ; as long as a constant table can be (out.MAX_TABLE)

pub var tok: byte = T_NL        ; T_NL before the first token: a file begins at the start of a line
pub var value: word
pub var line: word              ; where the token's first character is
pub var col: word
pub var string: [MAX_STRING]byte
pub var string_length: word
pub var open_brackets: byte     ; how many ( and [ are open: no line ends inside them
var end_line: word              ; where a line end is that the lexer passed over looking for a
var end_col: word               ; further piece of a string, and must still give as a token; line 0: none

const MAX_NESTING = 16
pub var nesting: byte           ; how many `#if` are open around the line being read
pub var else_parts: word        ; bit n set: the `#if` at depth n + 1 is in its `#else` part

const NESTING_BIT: [MAX_NESTING]word = [
  $0001, $0002, $0004, $0008, $0010, $0020, $0040, $0080,
  $0100, $0200, $0400, $0800, $1000, $2000, $4000, $8000
]

; Give the keywords their tokens. Needs a new name heap.
pub func init()
  var token: byte
  var k: byte
  var p: ^byte
  tok = T_NL
  open_brackets = 0
  end_line = 0
  nesting = 0
  else_parts = 0
  token = T_AND
  kernel.name_begin()
  for k = 0 until len(KEYWORDS) do
    p = KEYWORDS[k]
    while p[0] != 0 do
      if p[0] == C_SPACE then
        kernel.name_set_token(kernel.name_end(), token)
        token += 1
        kernel.name_begin()
      else
        kernel.name_add(p[0])
      end
      p += 1
    end
  end
end

; Report an error at the character being looked at, not at the start of the token.
pub func fail_here(number: byte)
  err.position(src.line, src.col)
  err.fatal(number)
end

; Upper-case letters as lower case; anything else unchanged.
pub func fold(c: byte): byte
  if c >= C_UPPER_A and c <= C_UPPER_Z then
    return c + (C_A - C_UPPER_A)
  end
  return c
end

pub func is_letter(c: byte): bool
  c = fold(c)
  return c >= C_A and c <= C_Z
end

pub inline func is_digit(c: byte): bool
  return c >= C_0 and c <= C_9
end

; The value of `c` as a digit of any base up to 16, and whether it is one.
pub func digit_value(c: byte): byte, bool
  if is_digit(c) then
    return c - C_0, true
  end
  c = fold(c)
  if c >= C_A and c <= C_F then
    return c - C_A + 10, true
  end
  return 0, false
end

; Pass over blanks and comments. Stops at a line end: that may be a token.
func skip_blanks()
  while not src.eof do
    if src.ch == C_SEMICOLON then
      while not src.eof and src.ch != C_LF do
        src.advance()
      end
    elif src.ch == C_SPACE or src.ch == C_TAB or src.ch == C_CR then
      src.advance()
    else
      return
    end
  end
end

; A name or a keyword.
func name_or_keyword()
  var name: word
  kernel.name_begin()
  while is_letter(src.ch) or is_digit(src.ch) or src.ch == C_UNDERSCORE do
    kernel.name_add(fold(src.ch))
    src.advance()
  end
  name = kernel.name_end()
  tok = kernel.name_token(name)
  if tok == 0 then
    tok = T_NAME
    value = name
  end
end

; The value of the digits here, of which there must be one or more.
func number(base: byte): word
  var n: word = 0
  var count: byte = 0
  var digit: byte
  var ok: bool
  loop
    digit, ok = digit_value(src.ch)
    if not ok or digit >= base then
      break
    end
    if n > ($FFFF - digit) / base then
      err.fatal(err.E_NUMBER_RANGE)
    end
    n = n * base + digit
    count += 1
    src.advance()
  end
  if count == 0 then
    err.fatal(err.E_BAD_NUMBER)
  end
  return n
end

; The value of the hexadecimal digit of an escape, which is passed over.
func hex_digit(): byte
  var digit: byte
  var ok: bool
  digit, ok = digit_value(src.ch)
  if not ok then
    err.fatal(err.E_BAD_ESCAPE)
  end
  src.advance()
  return digit
end

; The value of the escape whose backslash is here.
func escape(): byte
  var c: byte
  err.position(src.line, src.col)       ; a bad escape is reported at its backslash
  src.advance()
  c = src.ch
  src.advance()
  if c == C_N then
    c = C_LF
  elif c == C_R then
    c = C_CR
  elif c == C_T then
    c = C_TAB
  elif c == C_0 then
    c = 0
  elif c == C_X then
    c = hex_digit() << 4
    c = c | hex_digit()
  elif c != C_BACKSLASH and c != C_DQUOTE and c != C_QUOTE then
    err.fatal(err.E_BAD_ESCAPE)
  end
  err.position(line, col)
  return c
end

; The value of one character or escape inside a string or character constant.
func literal_char(): byte
  var c: byte
  c = src.ch
  if c == C_BACKSLASH then
    return escape()
  end
  if c < C_SPACE or c > C_TILDE then
    fail_here(err.E_BAD_CHAR)
  end
  src.advance()
  return c
end

; The value of a character constant, after its opening quote.
func character(): byte
  var c: byte
  if src.eof or src.ch == C_LF or src.ch == C_QUOTE then
    err.fatal(err.E_BAD_CHAR_CONST)
  end
  c = literal_char()
  if src.ch != C_QUOTE then
    err.fatal(err.E_BAD_CHAR_CONST)
  end
  src.advance()
  return c
end

; Collect a string, after its opening quote, into `string`, after what is there.
func string_token()
  var c: byte
  while src.ch != C_DQUOTE do
    if src.eof or src.ch == C_LF then
      err.fatal(err.E_OPEN_STRING)
    end
    c = literal_char()
    if string_length == MAX_STRING then
      err.fatal(err.E_STRING_LONG)
    end
    string[string_length] = c
    string_length += 1
  end
  src.advance()
end

; After a string: the strings that follow it, on its line or at the start of later lines,
; with nothing but blanks, comments and line ends between, are joined to it. A line end
; passed over is the next token if no string follows.
func string_pieces()
  loop
    skip_blanks()
    if src.eof or (src.ch != C_DQUOTE and src.ch != C_LF) then
      return
    end
    if src.ch == C_LF and end_line == 0 then
      end_line = src.line
      end_col = src.col
    end
    if src.ch == C_DQUOTE then
      end_line = 0
    end
    src.advance()
    if end_line == 0 then
      string_token()
    end
  end
end

; The word after a `#`, which has been passed over, as a token: T_IF, T_ELSE, T_END or
; another.
func directive_word(): byte
  name_or_keyword()
  return tok
end

; The rest of a directive's line must be blank or a comment: pass over it and its end.
func line_end()
  skip_blanks()
  if not src.eof then
    if src.ch != C_LF then
      fail_here(err.E_DIRECTIVE)
    end
    src.advance()
  end
end

; Pass over the lines of a part that is not compiled, without making tokens of them, up
; to the `#end` that closes it or, if `to_else`, its `#else`; and that directive's line.
; Only a line that starts with `#` is looked at, for the nesting of `#if`. Returns true if
; it stopped at an `#else`.
func skip_part(to_else: bool): bool
  var depth: byte = 0
  var found: byte
  loop
    while src.ch == C_SPACE or src.ch == C_TAB do
      src.advance()
    end
    if src.eof then
      fail_here(err.E_IF_OPEN)
    end
    if src.ch == C_HASH then
      err.position(src.line, src.col)
      src.advance()
      found = directive_word()
      if found == T_IF then
        depth += 1
      elif depth > 0 and found == T_END then
        depth -= 1
      elif depth == 0 and found == T_END then
        line_end()
        return false
      elif depth == 0 and found == T_ELSE then
        if not to_else then
          err.fatal(err.E_NO_IF)        ; a second #else
        end
        line_end()
        return true
      end
    end
    while not src.eof and src.ch != C_LF do
      src.advance()
    end
    src.advance()
  end
end

; The parser has worked out the condition of an `#if` and read its line to the end:
; what follows is compiled if `yes`, and otherwise only its `#else` part, if it has one.
pub func choose(yes: bool)
  if nesting == MAX_NESTING then
    err.fatal(err.E_IF_DEEP)
  end
  nesting += 1
  if not yes then
    if skip_part(true) then
      else_parts = else_parts | NESTING_BIT[nesting - 1]
    else
      nesting -= 1
    end
    tok = T_NL                  ; skip_part() read the directives' words as tokens
  end
end

; True if `name` is `error`, which is not a keyword: it means something only after `#`.
func is_error_word(name: word): bool
  var i: byte
  if kernel.name_length(name) != len(ERROR_WORD) then
    return false
  end
  for i = 0 until len(ERROR_WORD) do
    if kernel.name_char(name, i) != ERROR_WORD[i] then
      return false
    end
  end
  return true
end

; `#error`, with a string after it or nothing, in a part that is compiled: error 181 at the
; `#`, with ": " and the string's text after the error's.
func error_directive()
  var i: word
  skip_blanks()
  string_length = 0
  if not src.eof and src.ch == C_DQUOTE then
    src.advance()
    string_token()
  end
  err.position(line, col)
  err.fatal_start(err.E_ERROR_DIRECTIVE)
  if string_length > 0 then
    err.put_char(C_COLON)
    err.put_char(C_SPACE)
  end
  for i = 0 until string_length do
    err.put_char(string[i])
  end
  err.fatal_end()
end

; A directive, whose `#` has been passed over, which must start its line (docs/language.md,
; "Conditional compilation"). `#if` is a token: the parser works out its condition and calls
; choose(). `#else` ends the part being compiled, and the lines up to its `#end` are passed
; over. `#else` and `#end` leave a T_NL, as a blank line would, so the parser never sees them.
func directive()
  var found: byte
  var bit: word
  if tok != T_NL then
    err.fatal(err.E_DIRECTIVE)
  end
  found = directive_word()
  if found == T_IF then
    tok = T_HASH_IF
    return
  end
  if found == T_NAME and is_error_word(value) then
    error_directive()
  end
  if found != T_ELSE and found != T_END then
    err.fatal(err.E_DIRECTIVE)
  end
  if nesting == 0 then
    err.fatal(err.E_NO_IF)
  end
  bit = NESTING_BIT[nesting - 1]
  if found == T_ELSE and else_parts & bit != 0 then
    err.fatal(err.E_NO_IF)
  end
  line_end()
  if found == T_ELSE then
    skip_part(false)
  end
  nesting -= 1
  else_parts = else_parts & ~bit
  tok = T_NL
end

; `yes` if the next character is `c`, which is then passed over; `no` if it is not.
func followed_by(c: byte, yes: byte, no: byte): byte
  if src.ch == c then
    src.advance()
    return yes
  end
  return no
end

; The operator or punctuation token that starts with `c`, which has been passed over.
func mark(c: byte): byte
  if c == C_LPAREN then
    return T_LPAREN
  end
  if c == C_RPAREN then
    return T_RPAREN
  end
  if c == C_LBRACKET then
    return T_LBRACKET
  end
  if c == C_RBRACKET then
    return T_RBRACKET
  end
  if c == C_COMMA then
    return T_COMMA
  end
  if c == C_COLON then
    return T_COLON
  end
  if c == C_DOT then
    return T_DOT
  end
  if c == C_AT then
    return T_ADDRESS
  end
  if c == C_TILDE then
    return T_TILDE
  end
  if c == C_STAR then
    return T_STAR
  end
  if c == C_SLASH then
    return T_SLASH
  end
  if c == C_PLUS then
    return followed_by(C_EQUALS, T_PLUS_ASSIGN, T_PLUS)
  end
  if c == C_AMP then
    return followed_by(C_EQUALS, T_AND_ASSIGN, T_AMP)
  end
  if c == C_BAR then
    return followed_by(C_EQUALS, T_OR_ASSIGN, T_BAR)
  end
  if c == C_CARET then
    return followed_by(C_EQUALS, T_XOR_ASSIGN, T_CARET)
  end
  if c == C_EQUALS then
    return followed_by(C_EQUALS, T_EQ, T_ASSIGN)
  end
  if c == C_MINUS then
    if src.ch == C_GREATER then
      src.advance()
      return T_ARROW
    end
    return followed_by(C_EQUALS, T_MINUS_ASSIGN, T_MINUS)
  end
  if c == C_LESS then
    if src.ch == C_LESS then
      src.advance()
      return followed_by(C_EQUALS, T_SHL_ASSIGN, T_SHL)
    end
    return followed_by(C_EQUALS, T_LE, T_LT)
  end
  if c == C_GREATER then
    if src.ch == C_GREATER then
      src.advance()
      return followed_by(C_EQUALS, T_SHR_ASSIGN, T_SHR)
    end
    return followed_by(C_EQUALS, T_GE, T_GT)
  end
  if c == C_BANG and src.ch == C_EQUALS then
    src.advance()
    return T_NE
  end
  err.fatal(err.E_BAD_CHAR)
  return T_EOF
end

; Read one token from the saved token run that is the top source. Its end is T_EOF, at the
; place of the token before it.
func saved_token()
  var i: word
  while not src.eof and src.ch == SAVED_LINE do
    src.next_byte()
    src.line += src.next_byte()
  end
  if src.eof then
    tok = T_EOF
    return
  end
  line = src.line
  tok = src.next_byte()
  col = src.next_byte()
  err.position(line, col)
  if tok == T_NAME or tok == T_NUMBER then
    value = src.next_byte()
    value = value | (word(src.next_byte()) << 8)
  elif tok == T_STRING then
    string_length = src.next_byte()
    for i = 0 until string_length do
      string[i] = src.next_byte()
    end
  end
end

; Read one token, taking every line end as a token.
func scan()
  var c: byte
  if src.replaying then
    saved_token()
    return
  end
  if end_line != 0 then
    tok = T_NL
    line = end_line
    col = end_col
    end_line = 0
    err.position(line, col)
    return
  end
  skip_blanks()
  line = src.line
  col = src.col
  err.position(line, col)
  if src.eof then
    if nesting != 0 then
      err.fatal(err.E_IF_OPEN)
    end
    tok = T_EOF
    return
  end
  c = src.ch
  if is_letter(c) then
    name_or_keyword()
    return
  end
  if is_digit(c) then
    tok = T_NUMBER
    value = number(10)
    return
  end
  src.advance()
  if c == C_LF then
    tok = T_NL
  elif c == C_DOLLAR then
    tok = T_NUMBER
    value = number(16)
  elif c == C_PERCENT then
    tok = T_NUMBER
    value = number(2)
  elif c == C_QUOTE then
    tok = T_NUMBER
    value = character()
  elif c == C_DQUOTE then
    tok = T_STRING
    string_length = 0
    string_token()
    string_pieces()
  elif c == C_HASH then
    directive()
  else
    tok = mark(c)
  end
end

; True if a line that ends with `token` continues on the next: binary operators and the comma.
func joins_lines(token: byte): bool
  if token >= T_PLUS and token <= T_GE then
    return true
  end
  return token == T_COMMA or token == T_AND or token == T_OR or token == T_MOD
end

; Make the next token the current one.
pub func next()
  var before: byte
  before = tok
  scan()
  while tok == T_NL and (before == T_NL or open_brackets > 0 or joins_lines(before)) do
    scan()
  end
  if tok == T_EOF and before != T_NL and before != T_EOF then
    tok = T_NL              ; the last line ends even without a newline, and whatever is open
  elif tok == T_LPAREN or tok == T_LBRACKET then
    open_brackets += 1
  elif (tok == T_RPAREN or tok == T_RBRACKET) and open_brackets > 0 then
    open_brackets -= 1
  end
end

; Pass over the current token if it is `token`; if not, that is error `number`.
pub func expect(token: byte, number: byte)
  if tok != token then
    err.fatal(number)
  end
  next()
end

; Make `token`, found at that place, the current token. ASM reads the lines of an `asm`
; block itself and gives back the `end` that closes it, with the source just after it.
pub func resume(token: byte, at_line: word, at_col: word)
  tok = token
  line = at_line
  col = at_col
  err.position(line, col)
end
