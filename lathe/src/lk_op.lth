; What the linker knows about 6502 opcodes: lathe/host/lk_op.py in Lathe.
;
; How long an instruction is, which absolute instructions have a zero page form and what it is,
; and which instructions are relative branches. The linker finds instruction boundaries by
; decoding opcodes (docs/object-format.md, "The size of an instruction"), so OP_LEN covers all
; 256 values. Opcodes the NMOS 6502 does not define have the length the 65C02 gives them, which
; is what an object file for either CPU can contain.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | OP_LEN: a byte string of 256         | a table of 256 numbers            | (the same)      |
;   | can_shrink's `\` continuation        | one condition over two lines      | a line goes on  |
;   |                                      |                                   | after `and`     |
module lk_op

pub const CPU_6502 = 0
pub const CPU_65C02 = 1

const OP_LEN: [256]byte = [
  1, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3,
  3, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3,
  1, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3,
  1, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 2, 1, 1, 3, 3, 3, 3,
  2, 2, 2, 1, 2, 2, 2, 2, 1, 3, 1, 1, 3, 3, 3, 3
]

pub const OP_JSR = $20
pub const OP_JMP = $4C

; Bytes in the instruction that starts with this opcode.
pub func length(op: byte): byte
  return OP_LEN[op]
end

; True if the instruction has a zero page form: an absolute or absolute,X instruction other than
; JMP, JSR and (on the 65C02) JMP (abs,X), or LDX abs,Y. A fix-up of kind 5 must be in one of
; these and a fix-up of kind 1 in none (docs/object-format.md).
pub func can_shrink(op: byte): bool
  var low: byte
  var high: byte
  low = op & $0F
  if low == $0D or low == $0E then
    return true
  end
  if low != $0C then
    return false
  end
  high = op >> 4
  return high != $04 and high != $05 and high != $06 and high != $07 and high != $0D and
    high != $0F
end

; The zero page opcode of an instruction that can_shrink: 8 less, except STZ on the 65C02, whose
; absolute forms are $9C and $9E and zero page forms $64 and $74.
pub func zp_opcode(op: byte): byte
  if op == $9C then
    return $64
  end
  if op == $9E then
    return $74
  end
  return op - 8
end

; True if the last byte of the instruction is a displacement relative to the next one.
pub func is_branch(op: byte, cpu: byte): bool
  if (op & $1F) == $10 then
    return true
  end
  if cpu == CPU_65C02 then
    ; BRA, and BBR/BBS whose third byte is the displacement.
    return op == $80 or (op & $0F) == $0F
  end
  return false
end
