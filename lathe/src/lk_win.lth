; Code in a window: lathe/host/lk_win.py in Lathe.
;
; Which bank or overlay each function and constant is in, the stubs, and the table the far-call
; module's start() reads (configurations.md, section 5).
;
; A module's code is placed by the environment file's `place` entry (lk_scan.obj_bank); every
; function of the module, and every copy of it for a context, goes there. Everything else is fixed.
;
; A stub is six bytes of fixed code, `JSR FARCALL.call` / `.byte VALUE` / `.word f-1`, through
; which code outside f's bank or overlay calls f, and which `@f` means wherever it is taken. A
; function in a window has stubs (lk_tab.F_STUB) if some kept code outside its bank calls it, if
; kept code or constant data takes its address (F_ADDR), or if the start-up code calls it (main, a
; module's `$init`); then each of its copies has one. The stubs follow `$start` and `$init`, in the
; order the copies are placed in, so a stub's place is worked out from the function table, with a
; count per object file (obj_stub), and no table of stubs is kept. The table for start() follows
; them:
;
;     $banks      .word WINDOW, .byte N, then N times .byte VALUE, .word NAME
;     $overlays   .word WINDOW, .byte N, then N times, overlay 1 first, .word NAME
;
; and after it each file's name, zero-terminated: the banks of the window that have a file, in the
; order of their entries; or every overlay.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | obj_stub, stub_count, stub_base:     | words                             | lk_err.lth      |
;   | ints                                 |                                   |                 |
;   | copies, table_count, a bank: ints    | bytes: at most MAX_CONTEXTS,      | the type is the |
;   |                                      | MAX_BANKS                         | storage         |
;   | table_size: entry and size ints      | entry a byte, size a word         |                 |
;   | `i -= 1` on table_bank's parameter   | the same, on a byte               |                 |
;   | table_bank: lk_envf.find_bank        | find_bank, the same loop, here    | lk_envf.lth does|
;   |                                      |                                   | not export it   |
module lk_win

import lk_envf (bank_count, bank_file, bank_n, bank_win, in_window, is_overlay, is_rom, MAX_BANKS,
                placed, text, window)
import lk_err (E_IRQ_OVERLAY, E_IRQ_PLACED)
import lk_name (fail, fail_in, MAX_OBJECTS, obj_fn, object_count)
import lk_scan (crosses, def_bank, fn_bank, object_of, region_of)
import lk_sym (row_of)
import lk_tab (ctx_count, ctx_of, D_CONST, D_FIXED, def_a, def_f, edge_flag, edge_sym, F_ADDR,
               F_INIT, F_INTERRUPT, F_STUB, first_call, fn_count, fn_ctx, fn_flags, fn_ref,
               has_copy, next_call, own_of)

pub const STUB_SIZE = 6

pub var obj_stub: [lk_name.MAX_OBJECTS + 1]word ; the number of the first stub of each object's
                                                ; functions
pub var stub_count: word = 0
pub var stub_base: word = 0     ; where the stubs start: lk_boot places them
pub var table_count: byte = 0   ; banks or overlays in the table

; The bank + 1 that variable or constant d goes in, or 0 for fixed memory: that of its region, if
; it is `in` a region in a bank; else that of its module's code, if no fix-up outside that bank
; names it and none takes its address (lk_graph.note_named). A variable goes in a bank, never an
; overlay, which is loaded again from its file, nor a read-only bank (a region's variable in one
; is an error: lk_place.place_bank_vars).
pub func bank_def(d: word): byte
  var r: byte
  var b: byte
  r = lk_scan.region_of(d)
  if r != 0 then
    return r
  end
  if not lk_envf.placed() or (lk_tab.def_f[d] & lk_tab.D_FIXED) != 0 then
    return 0
  end
  b = lk_scan.def_bank(d)
  if b == 0 or (lk_tab.def_f[d] & lk_tab.D_CONST) != 0 then
    return b
  end
  if lk_envf.is_overlay() or lk_envf.is_rom(b - 1) then
    return 0
  end
  return b
end

; The file constant data d is written to, or where variable d is: 0 the image or fixed memory, or
; its bank + 1. Only once it is placed.
pub func def_dest(d: word): byte
  var r: byte
  if lk_envf.placed() and lk_envf.in_window(lk_tab.def_a[d]) then
    r = lk_scan.region_of(d)
    if r != 0 then
      return r
    end
    return lk_scan.def_bank(d)
  end
  return 0
end

; The number of copies of function f: one per context that reaches it.
pub func copies(f: word): byte
  var count: byte
  var ctx: byte
  count = 0
  for ctx = 0 until lk_tab.ctx_count do
    if lk_tab.has_copy(f, ctx) then
      count += 1
    end
  end
  return count
end

pub func has_stub(f: word): bool
  return (lk_tab.fn_flags[f] & lk_tab.F_STUB) != 0
end

; Function f, if it is in a window, needs stubs.
func needs_stub(f: word)
  if lk_tab.fn_ctx[f] != 0 and lk_scan.fn_bank(f) != 0 then
    lk_tab.fn_flags[f] |= lk_tab.F_STUB
  end
end

; An interrupt function is fixed: it is entered from a vector and ends in RTI, so it cannot be
; entered through a stub. What it calls may be in a bank, because rt_bank's routine is reentrant,
; but not in an overlay: the loader is not, and a file is not loaded in an interrupt
; (configurations.md, "Interrupts").
pub func check_interrupts()
  var ctx: byte
  var h: word
  var f: word
  if not lk_envf.placed() then
    return
  end
  ctx = 0
  for h = 0 until lk_tab.fn_count do
    if (lk_tab.fn_flags[h] & lk_tab.F_INTERRUPT) != 0 then
      ctx += 1
      if lk_scan.fn_bank(h) != 0 then
        lk_name.fail(lk_err.E_IRQ_PLACED, lk_tab.fn_ref(h))
      end
      if lk_envf.is_overlay() then
        for f = 0 until lk_tab.fn_count do
          if lk_tab.has_copy(f, ctx) and lk_scan.fn_bank(f) != 0 then
            lk_name.fail_in(lk_err.E_IRQ_OVERLAY, lk_tab.fn_ref(h), lk_tab.fn_ref(f))
          end
        end
      end
    end
  end
end

; Mark the functions that have stubs, and count the stubs of each object file.
pub func mark_stubs(main_fn: word)
  var f: word
  var r: word
  var e: word
  var target: word
  var obj: byte
  stub_count = 0
  if lk_envf.placed() then              ; else no stubs, and every object's count is 0
    needs_stub(main_fn)
    for f = 0 until lk_tab.fn_count do
      if (lk_tab.fn_flags[f] & (lk_tab.F_ADDR | lk_tab.F_INIT)) != 0 then
        needs_stub(f)
      end
      if lk_tab.fn_ctx[f] != 0 then
        r = lk_tab.fn_ref(f)
        e = lk_tab.first_call(r)
        while e != 0 do
          target = lk_tab.edge_sym(e - 1)
          if lk_scan.crosses(f, target, lk_tab.edge_flag(e - 1)) then
            needs_stub(lk_sym.row_of(target))
          end
          e = lk_tab.next_call(r, e)
        end
      end
    end
  end
  for obj = 0 until lk_name.object_count do
    obj_stub[obj] = stub_count
    for f = lk_name.obj_fn[obj] until lk_name.obj_fn[obj + 1] do
      if has_stub(f) then
        stub_count += copies(f)
      end
    end
  end
  obj_stub[lk_name.object_count] = stub_count
end

; The address of the stub of the function copy that is node n, which has one.
pub func stub_addr(n: word): word
  var f: word
  var obj: byte
  var i: word
  var g: word
  var ctx: byte
  f = lk_tab.own_of(n)
  obj = lk_scan.object_of(f)
  i = obj_stub[obj]
  for g = lk_name.obj_fn[obj] until f do
    if has_stub(g) then
      i += copies(g)
    end
  end
  for ctx = 0 until lk_tab.ctx_of(n) do
    if lk_tab.has_copy(f, ctx) then
      i += 1
    end
  end
  return stub_base + STUB_SIZE * i
end

; True if bank or overlay b is in the table: one of the window code is placed in that has a file
; and is not read-only, which is there already.
func in_table(b: byte): bool
  return lk_envf.bank_win[b] == lk_envf.window() and lk_envf.bank_file[b] != 0 and
         not lk_envf.is_rom(b)
end

; The bytes of the table and its names. Only when lk_envf.placed().
pub func table_size(): word
  var entry: byte
  var size: word
  var b: byte
  entry = 3
  if lk_envf.is_overlay() then
    entry = 2
  end
  size = 3
  table_count = 0
  for b = 0 until lk_envf.bank_count do
    if in_table(b) then
      table_count += 1
      size += entry + lk_envf.text[lk_envf.bank_file[b] - 1] + 1
    end
  end
  return size
end

; lk_envf.find_bank: the bank or overlay n of window w, or MAX_BANKS.
func find_bank(w: byte, n: byte): byte
  var b: byte
  for b = 0 until lk_envf.bank_count do
    if lk_envf.bank_win[b] == w and lk_envf.bank_n[b] == n then
      return b
    end
  end
  return lk_envf.MAX_BANKS
end

; The bank or overlay of entry i of the table, from 0: the banks with a file in the order of their
; entries; the overlays by their number.
pub func table_bank(i: byte): byte
  var b: byte
  if lk_envf.is_overlay() then
    return find_bank(lk_envf.window(), i + 1)
  end
  for b = 0 until lk_envf.bank_count do
    if in_table(b) then
      if i == 0 then
        return b
      end
      i -= 1
    end
  end
  return 0
end
