; The Lathe-written linker (lathe/src/link.lth) on the BBC Model B+128, at the full capacities, the
; ones that link the compiler and the linker itself (LKSMALL 0: lathe/src/lk_tab.lth). This is the
; developer's form, `*RUN LLINK ARGS`, its banks in the module's RAM form (slot 4), loaded by the
; start-up code; bbcrom.rom_env makes the ROM form's environment from it (its banks numbered after
; the compiler's, 6 to 10, read only, the window $8050-$BFDF), started by `*LLINK ARGS` or `*LLINK
; @FILE` from the image that holds the compiler too (lathe/tests/test_bbc_toolchain.py;
; lathe/docs/bbc.md, "Step 5, as built" and "The linker links the compiler").
;
; Fixed in main RAM: what every phase calls many times, lk_tab, lk_rec, lk_sym, sys, bbc and the
; run-time (rt_bbc, rt_math), as on Wendy 2 (linker-bank.env); the functions with `with` blocks,
; which the linker keeps fixed (lk_name's accessors of `local`, those of the work area's node
; columns); and the tables not in a region: the functions' columns but fn_edge, the variables'
; and constants', the classes', lk_envf.text, the command file's words. A bank of the module is
; 16 KB where Wendy 2's are 28: lk_graph and lk_alloc, which share a bank there, are 17.6 KB as
; the linker judges them, so the code takes five banks. Bank 1: link, lk_err (its messages too),
; lk_file, lk_envf. Bank 2, the reading: lk_scan and lk_name. Bank 3: lk_graph, lk_win and
; lk_boot. Bank 4: lk_alloc. Bank 5, placement and output: lk_place, lk_fix, lk_map, lk_emit,
; lk_out and lk_op.
;
; Regions, in three sideways RAM slots (the slots are free while the linker runs: the compiler's
; tables are there only while *LATHE runs, and its constants in slot 13 are copied again at each
; *LATHE), read only through functions with blocks, kept fixed (lk_tab.wk and set_wk, the
; accessors of lk_tab and lk_name, and the readers of the hottest work columns in lk_graph,
; lk_alloc and lk_fix): slot 0, lk_name.local (8,000 bytes) and the slots' columns (8,256);
; slot 1, the calls (8,992) and the work area's node columns (3,600); slot 12, the rest of the
; work area (14,400). Slot 13 is not used.
;
; The split (2026-11-16): one, $4000, for both forms and both BBCFS settings. bbcfs is fixed in
; the developer's form, whose start-up loads the banks through bbc.open, which with BBCFS 1 calls
; bbcfs.map (a bank is not there before it is loaded), and in bank 1 in the ROM form, whose banks
; are always there: the `when ROMFORM` entry is the ROM form's alone, since bbcrom.rom_env
; defines ROMFORM as 1 (lathe/docs/configurations.md, "The environment file").
;
; The 128 KB module (eight banks: lathe/docs/bbc.md, "The 128 KB module"): bbcrom.rom_env with
; eight banks defines ROM128 as 1, and the `when ROM128` and `unless ROM128` entries put the
; linker in three banks, the image's 5 to 7, chosen by the far calls between modules
; (lathe/tests/farcall_matrix.py): bank 1 link, lk_err, lk_file, lk_envf, lk_win, lk_place,
; lk_fix and lk_emit; bank 2 lk_scan, lk_name, lk_boot and lk_map; bank 3 lk_graph and lk_alloc
; (whose calls between them were 1,150,365 of the 1,276,580 far calls of the compiler's link in
; five banks); lk_out and lk_op fixed. As the linker judges them they are 572, 199 and 416 bytes
; over on 2026-11-17, so that form does not link yet (lathe/tests/test_bbc_rom128.py says by how
; much).
cpu       6502
zeropage  $00 $8F
code      $1900 $3FFF
data      $4000 $7BFF
more      data $0401 $06FF
exit      return $0400  ; the start-up code keeps S at $0400 (bbc.KEEP), and ends with RTS
output    raw
define    ROMFORM 0     ; the developer's form; bbcrom.rom_env makes it 1, the ROM form
define    BOARD 3       ; the BBC (lathe/host/driver/boards.py)
define    PORTS 2       ; lathe/src/sys.lth over lathe/rt/bbc.lth
define    BBCFS 0       ; file names as given; 1: the DFS's (lathe/rt/bbc/bbcfs.lth)
define    MODULE_SLOT 4 ; the module's slot: rt_bbc.SLOT, and the emulator's --bbc-module-slot
define    LKSMALL 0     ; the linker's tables at full size (lathe/src/lk_tab.lth)
define    ROM128 0      ; five banks; bbcrom.rom_env makes it 1 for the eight-bank image: three
window    WIN $8000 $BFDF
switch    WIN bank farcall
bank      WIN 1 $81 LLINK1.BIN
bank      WIN 2 $82 LLINK2.BIN
bank      WIN 3 $83 LLINK3.BIN
unless    ROM128 bank WIN 4 $84 LLINK4.BIN
unless    ROM128 bank WIN 5 $85 LLINK5.BIN
bank      WIN 20 $00            ; sideways slot 0: lk_name.local, the slots' columns
bank      WIN 21 $01            ; sideways slot 1: the calls, the work area's node columns
bank      WIN 22 $0C            ; sideways slot 12: the work area
place     link WIN 1
place     lk_err WIN 1
place     lk_file WIN 1
place     lk_envf WIN 1
when      ROMFORM place bbcfs WIN 1 ; bbc.lth's file names with BBCFS 1; fixed in the developer's form
place     lk_scan WIN 2
place     lk_name WIN 2
place     lk_graph WIN 3
unless    ROM128 place lk_win WIN 3
unless    ROM128 place lk_boot WIN 3
unless    ROM128 place lk_alloc WIN 4
unless    ROM128 place lk_op WIN 5
unless    ROM128 place lk_fix WIN 5
unless    ROM128 place lk_place WIN 5
unless    ROM128 place lk_map WIN 5
unless    ROM128 place lk_emit WIN 5
unless    ROM128 place lk_out WIN 5
when      ROM128 place lk_win WIN 1
when      ROM128 place lk_place WIN 1
when      ROM128 place lk_fix WIN 1
when      ROM128 place lk_emit WIN 1
when      ROM128 place lk_boot WIN 2
when      ROM128 place lk_map WIN 2
when      ROM128 place lk_alloc WIN 3
region    LKLOCAL WIN 20         ; lk_name.local
region    LKCALLS WIN 21         ; lk_tab.edge_word and fn_edge
region    LKSLOTS WIN 20         ; lk_tab.slot_sz, slot_weight, big_slot and big_size
region    LKNODES WIN 21         ; lk_tab.nodes: the work area's node columns
region    LKWORK WIN 22          ; lk_tab.work: the rest of the work area
farcall   rt_bbc
