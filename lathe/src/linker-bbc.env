; The Lathe-written linker (lathe/src/link.lth) on the BBC Model B+128, at the BBC's capacities
; (LKSMALL 2: lathe/src/lk_tab.lth). This is the developer's form, `*RUN LLINK ARGS`, its banks in
; the module's RAM form (slot 4), loaded by the start-up code; bbcrom.rom_env makes the ROM form's
; environment from it (its banks numbered after the compiler's, 6 to 10, read only, the window
; $8050-$BFDF), started by `*LLINK ARGS` from the image that holds the compiler too
; (lathe/tests/test_bbc_toolchain.py; lathe/docs/bbc.md, "Step 5, as built").
;
; Fixed in main RAM: what every phase calls many times, lk_tab, lk_rec, lk_sym, sys, bbc and the
; run-time (rt_bbc, rt_math), as on Wendy 2 (linker-bank.env); lk_name's accessors of `local`
; (kept fixed: they have `with` blocks); and the tables not in a region, the work area first. A
; bank of the module is 16 KB where Wendy 2's are 28: lk_graph and lk_alloc, which share a bank
; there, are 17.6 KB as the linker judges them, so the code takes five banks. Bank 1: link,
; lk_err (its messages too), lk_file, lk_envf. Bank 2, the reading: lk_scan and lk_name. Bank 3:
; lk_graph, lk_win and lk_boot. Bank 4: lk_alloc. Bank 5, placement and output: lk_place,
; lk_fix, lk_map, lk_emit, lk_out and lk_op.
;
; Regions, in sideways slot 0 (13,952 bytes; the slots are free while the linker runs: the
; compiler's tables are there only while *LATHE runs): lk_name.local, and lk_tab's calls and
; slots, read only through lk_tab's and lk_name's functions.
;
; The split is set by the developer's form, whose fixed code ($banks, the loading) ends at
; $3A1A; in the ROM form the code ends at $39D3 and the variables fill $3A20-$7BFF and part of
; $0401-$06FF (2026-11-15).
cpu       6502
zeropage  $00 $8F
code      $1900 $3A1F
data      $3A20 $7BFF
more      data $0401 $06FF
exit      return $0400  ; the start-up code keeps S at $0400 (bbc.KEEP), and ends with RTS
output    raw
define    BOARD 3       ; the BBC (lathe/host/driver/boards.py)
define    PORTS 2       ; lathe/src/sys.lth over lathe/rt/bbc.lth
define    MODULE_SLOT 4 ; the module's slot: rt_bbc.SLOT, and the emulator's --bbc-module-slot
define    LKSMALL 2     ; the linker's tables at the BBC's sizes (lathe/src/lk_tab.lth)
window    WIN $8000 $BFDF
switch    WIN bank farcall
bank      WIN 1 $81 LLINK1.BIN
bank      WIN 2 $82 LLINK2.BIN
bank      WIN 3 $83 LLINK3.BIN
bank      WIN 4 $84 LLINK4.BIN
bank      WIN 5 $85 LLINK5.BIN
bank      WIN 20 $00            ; sideways slot 0: the tables in regions
place     link WIN 1
place     lk_err WIN 1
place     lk_file WIN 1
place     lk_envf WIN 1
place     lk_scan WIN 2
place     lk_name WIN 2
place     lk_graph WIN 3
place     lk_win WIN 3
place     lk_boot WIN 3
place     lk_alloc WIN 4
place     lk_op WIN 5
place     lk_fix WIN 5
place     lk_place WIN 5
place     lk_map WIN 5
place     lk_emit WIN 5
place     lk_out WIN 5
region    LKLOCAL WIN 20         ; lk_name.local
region    LKCALLS WIN 20         ; lk_tab.edge_word and fn_edge
region    LKSLOTS WIN 20         ; lk_tab.slot_sz, slot_weight, big_slot and big_size
farcall   rt_bbc
