  "120 an array of at most 256 elements, and a pointer, take a byte index",
  "121 an array is not a value: use a pointer to it, or copy it with a loop",
  "122 has no address: not a variable, or an element of an array stored by column",
  "123 an array of more than 256 elements larger than a byte must be declared rows",
  "124 element size must be a power of two here (1, 2, 4 or 8 through a pointer)",
  "125 only one index can be a variable, and only the first unless the array is declared rows",
  "126 more values than the array has elements",
  "127 not an array or a pointer",
  "128 not a record or a pointer to one",
  "129 the record has no field of this name",
  "130 a record is not a value here: pass a pointer to it",
  "131 a record cannot have an initial value yet",
  "132 a record cannot contain itself: a pointer to it is allowed",
  "133 a record needs a field",
  "134 a record type is written only in a type declaration",
  "135 an imported module uses the types of a module not imported yet: import that one first",
  "136 a record in an array declared rows must be padded to a size that is a power of two; its size is",
  "140 a branch must go to a label of this asm block",
  "141 a label of an asm block can only be the target of a branch or JMP",
  "142 label not defined in this asm block",
  "143 operand out of range",
  "144 addressing mode not available for this instruction",
  "145 directives such as .byte are not allowed in asm",
  "146 unknown instruction",
  "147 cannot be made to be in zero page: declared nozp, or another module's and not zp",
  "150 a function type is written only in a type declaration",
  "151 the function does not have the parameters and results of the function type",
  "152 a recursive function type takes only functions declared recursive",
  "153 the address of a function is a value only where a function type is wanted",
  "154 an asm function cannot be called through a pointer: its parameters are in registers",
  "155 only a function with a body in Lathe can be recursive",
  "156 too many functions taken as function types in one module",
  "165 too many saved tokens of inline functions in this module",
  "166 inline calls nested too deeply",
  "167 an inline function cannot call itself, directly or through other inline functions",
  "168 an inline function cannot have asm, static or #if",
  "169 an inline function has no address",
  "170 an exported inline function can use only exported names of its module",
  "171 inline and interrupt go with neither each other, nor asm, nor a forward declaration",
  "172 an interrupt function has no parameters and no results",
  "173 an interrupt function cannot be called: store its address, @name, where the board wants it",
  "180 the end of a function that has a result can be reached: return a value there",
  "181 #error"
]
const TOOL: [6]byte = "lathec"
const ERROR: [8]byte = ": error "

const C_LF = $0A
const C_SPACE = $20
const C_ZERO = $30
const C_COLON = $3A

const MAX_DIGITS = 5
var digits: [MAX_DIGITS]byte

pub var file: ^byte     ; the name of the file being read; nil before there is one
pub var line: word      ; where the error is: the token or character being looked at; 0 for nowhere
pub var col: word

forward func set_file(name: ^byte)
forward func position(new_line: word, new_col: word)

pub func init()
  set_file(nil)
end

; Name the file errors are in from now on. `name` points to its zero-terminated name.
pub func set_file(name: ^byte)
  file = name
  position(0, 0)
end

; Say where an error found from now on is.
pub func position(new_line: word, new_col: word)
  line = new_line
  col = new_col
end

pub func put_decimal(n: word)
  var count: byte = 0
  var i: byte
  loop
    digits[count] = C_ZERO + byte(n mod 10)
    count += 1
    n = n / 10
  until n == 0
  for i = count - 1 downto 0 do
    sys.put_error(digits[i])
  end
end

pub func put_place()
  var i: ^byte
  var k: byte
  if file == nil then
    for k = 0 until len(TOOL) do
      sys.put_error(TOOL[k])
    end
    return
  end
  i = file
  while i[0] != 0 do
    sys.put_error(i[0])
    i += 1
  end
  if line != 0 then
    sys.put_error(C_COLON)
    put_decimal(line)
    sys.put_error(C_COLON)
    put_decimal(col)
  end
end

; The text of error `number`, or nil if it has none.
pub func message_start(number: byte): ^byte
  var m: byte
  var i: ^byte
  var n: word
  for m = 0 until len(MESSAGES) do
    i = MESSAGES[m]
    n = 0
    while i[0] != C_SPACE do
      n = n * 10 + i[0] - C_ZERO
      i += 1
    end
    i += 1
    if n == number then
      return i
    end
  end
  return nil
end

const NO_VALUE = $FFFF

var shown: word = NO_VALUE    ; a number that fatal() writes after the text of the error

; A character of more text after the error's, between fatal_start() and fatal_end().
pub func put_char(c: byte)
  sys.put_error(c)
end

pub func fatal_end()
  sys.put_error(C_LF)
  sys.exit(1)
end

; fatal(), up to the end of the line it writes: more text can follow (put_char()).
pub func fatal_start(number: byte)
  var i: ^byte
  var k: byte
  put_place()
  for k = 0 until len(ERROR) do
    sys.put_error(ERROR[k])
  end
  put_decimal(number)
  sys.put_error(C_COLON)
  sys.put_error(C_SPACE)
  i = message_start(number)
  while i != nil and i[0] != 0 do
    sys.put_error(i[0])
    i += 1
  end
  if shown != NO_VALUE then
    sys.put_error(C_SPACE)
    put_decimal(shown)
  end
end

; Report error `number` at the current place and end the program.
pub func fatal(number: byte)
  fatal_start(number)
  fatal_end()
end

; fatal(), with the number `value` written after the error's text.
pub func fatal_value(number: byte, value: word)
  shown = value
  fatal(number)
end
