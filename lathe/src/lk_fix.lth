; Fix-ups: lathe/host/lk_fix.py in Lathe.
;
; What address a fix-up stands for, and which instructions of a function shrink.
;
; An instruction shrinks if its fix-up is of kind 5 and the address with the addend is below $100
; (object-format.md, "The size of an instruction"), so a function's fix-ups alone say how much it
; shrinks. Pass 1 counts, for each context, the fix-ups of a function that shrink (count_shrinks).
; Pass 2 holds the fix-ups of one function or one piece of constant data (hold), which come
; before its code or data in the file, and applies them as the bytes go by (lk_emit). A copy of a
; function for another context has other slot addresses, so each held fix-up carries one bit per
; context in which its instruction shrinks.
;
; The fix-ups of one function are the only thing about its code the linker ever holds, and it
; holds at most MAX_FIXES of them, a run: a function with more has its FIX record read again for
; each run after the first, from the place the code has reached and back (next_fix), and what its
; code loses before an offset that the run held does not cover is counted from the record itself
; (removed). Constant data is held whole: the compiler writes at most 256 addresses in a table
; (out.MAX_TABLE_FIXES), and every build holds more.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | e_kind, e_slot, a kind, a slot, the  | bytes; offsets, addends, symbols, | the type is the |
;   | bits of the contexts: ints           | counts, nodes: words              | storage         |
;   | 1 << ctx                             | byte(1) << ctx                    | lk_tab.lth      |
;   | the bits held in FX_ZP: an int       | a word of the work area, whose    | the column is   |
;   |                                      | low byte holds them               | words           |
;   | class_of(row_of(sym)), cp_addr[par + | class_of(byte(row_of(sym))),      | 32- and 128-row |
;   | slot]                                | cp_addr[lo(cls_par[k]) + slot]    | tables take a   |
;   |                                      |                                   | byte (lk_graph) |
;   | address_copy: (n, kept)              | a value and a status              | the same        |
;   | value >> 8                           | hi(value)                         | the same byte   |
;   | target, zp_contexts: `& 0xFFFF`      | the word, which wraps             | the same        |
;   | bank_value: 0x100 for a bad fix-up   | a word                            | above a byte    |
;   | next_fix: is_word(work[FX_KIND...])  | is_word(lo(work[FX_KIND...]))     | a kind is a byte|
;   | zp_contexts used before it is defined| a forward declaration             | declare before  |
;   |                                      |                                   | use             |
module lk_fix

import lk_alloc (slot_addr)
import lk_envf (bank_value)
import lk_err (E_FIXES, E_FIXUP, E_NOT_LINKED, E_NOT_ZP, E_UNDEFINED, E_UNMAPPED, fail)
import lk_name (fail, fail_in, global_sym)
import lk_rec (get_byte, get_word, goto, left, recno)
import lk_scan (fn_bank, region_of)
import lk_sym (CLASS, CONSTANT, FUNCTION, is_defined, kind_of, row_of, VARIABLE)
import lk_tab (class_of, cls_ctx, cls_np, cls_par, cls_reach, copy_node, cp_addr, ctx_count, def_a,
               first_node, fn_ctx, fn_nslots, fn_ref, has_copy, MAX_CONTEXTS, MAX_FIXES,
               member_class, set_wk, W_ADDR, wk, work)
import lk_win (has_stub, stub_addr)

pub const MAX_FIXES = lk_tab.MAX_FIXES
pub const NO_CONTEXT = $FF              ; the context of a fix-up in constant data

; Fix-up kinds.
pub const K_WORD = 1
pub const K_LOW = 2
pub const K_HIGH = 3
pub const K_ZP = 4
pub const K_SHRINK = 5
pub const K_BANK = 6                    ; one byte: the register value of a region's bank (lk_win)
const K_REACH_LOW = 7                   ; K_LOW and K_HIGH of an address formed only to reach a part of
const K_REACH_HIGH = 8                  ; what it names, in code (lk_graph.note_named)

; The entry read last.
var e_at: word = 0
var e_kind: byte = 0
var e_sym: word = 0
var e_slot: byte = 0
var e_add: word = 0

; The fix-ups held, in the order of the file, which is the order of offset: columns of
; lk_tab.work, which nothing else uses while code is written.
pub var fix_count: word = 0
pub const FX_AT = 0                     ; offset in the code as written, or in the data
pub const FX_KIND = MAX_FIXES
pub const FX_SYM = 2 * MAX_FIXES
pub const FX_SLOT = 3 * MAX_FIXES
pub const FX_ADD = 4 * MAX_FIXES
pub const FX_ZP = 5 * MAX_FIXES         ; a bit per context in which the instruction shrinks
pub var cursor: word = 0                ; the next fix-up to apply

; A function of more fix-ups than a run holds (long_fix): where its FIX record is, the record's
; entry that the run's first is, and what the entries before the run lose. Set by hold.
var long_fix: bool
var fix_obj: byte                       ; the object file being written
var fix_recno: word                     ; the number of the FIX record in it
var fix_total: word                     ; the entries of the record
var run_base: word                      ; the entry of the record that held entry 0 is
var run_lost: [lk_tab.MAX_CONTEXTS]word ; bytes each copy loses before the run
var here: word                          ; while the record is read again (away): the record
var rest: word                          ; the code was read in, and the bytes of it left

pub var shrink_count: [lk_tab.MAX_CONTEXTS]word ; pass 1: bytes each copy of cur_fn loses

var mapped: word                        ; pass 2: a bit for each bank a kind 6 fix-up of cur_fn has
                                        ; mapped so far, in the order of its code (bank_value)
pub var cur_fn: word = 0                ; the function whose records are being read
pub var cur_sym: word = 0               ; its symbol, or that of the constant data being written

forward func zp_contexts(sym: word, slot: byte, addend: word): byte
forward func shrunk(ctx: byte): word
forward func removed_before(pos: word, ctx: byte): word

; A fix-up of the current function or constant makes no sense.
pub func bad()
  lk_name.fail(lk_err.E_FIXUP, cur_sym)
end

; Start on function f, which has no fix-up that shrinks until count_shrinks finds some, and has
; mapped no bank.
pub func begin(f: word)
  var ctx: byte
  cur_fn = f
  mapped = 0
  cur_sym = lk_tab.fn_ref(f)
  for ctx = 0 until lk_tab.ctx_count do
    shrink_count[ctx] = 0
  end
end

; Start on the constant data that is symbol sym.
pub func begin_data(sym: word)
  cur_sym = sym
end

; True for the kinds that fill two bytes.
pub func is_word(kind: byte): bool
  return kind == K_WORD or kind == K_SHRINK
end

; Read the next fix-up entry of the record MAIN is in, of object file obj.
func read_entry(obj: byte)
  e_at = lk_rec.get_word()
  e_kind = lk_rec.get_byte()
  e_sym = lk_name.global_sym(obj, lk_rec.get_word())
  e_slot = lk_rec.get_byte()
  e_add = lk_rec.get_word()
end

; MAIN is at cur_fn's FIX record: count, for each context, its fix-ups before written offset
; `pos` that shrink (shrink_count).
func count_before(obj: byte, pos: word)
  var ctx: byte
  var bits: byte
  for ctx = 0 until lk_tab.ctx_count do
    shrink_count[ctx] = 0
  end
  while lk_rec.left() > 0 do
    read_entry(obj)
    if e_at >= pos then
      return
    end
    if e_kind == K_SHRINK then
      bits = zp_contexts(e_sym, e_slot, e_add)
      for ctx = 0 until lk_tab.ctx_count do
        if (bits & (byte(1) << ctx)) != 0 then
          shrink_count[ctx] += 1
        end
      end
    end
  end
end

; Pass 1. MAIN is at cur_fn's FIX record: count, for each context, its fix-ups that shrink.
pub func count_shrinks(obj: byte)
  count_before(obj, $FFFF)
end

; Column `column` of the fix-up held next is v.
func put(column: word, v: word)
  lk_tab.set_wk(column + fix_count, v)
end

; Hold the entries of the record MAIN is in from where it is, as many as a run holds.
func take_run(obj: byte, in_code: bool)
  while lk_rec.left() > 0 and fix_count < MAX_FIXES do
    read_entry(obj)
    put(FX_AT, e_at)
    put(FX_KIND, e_kind)
    put(FX_SYM, e_sym)
    put(FX_SLOT, e_slot)
    put(FX_ADD, e_add)
    put(FX_ZP, 0)
    if in_code and e_kind == K_SHRINK then
      put(FX_ZP, zp_contexts(e_sym, e_slot, e_add))
    end
    fix_count += 1
  end
end

; Nothing is lost before the first run.
func first_run()
  var ctx: byte
  run_base = 0
  for ctx = 0 until lk_tab.ctx_count do
    run_lost[ctx] = 0
  end
end

; Pass 2. MAIN is at a FIX record of cur_fn, or at a DFIX record: hold its entries, or the first
; run of them.
;
; Whether they make sense is checked as they are applied.
pub func hold(obj: byte, in_code: bool)
  fix_count = 0
  cursor = 0
  fix_obj = obj
  fix_recno = lk_rec.recno()
  take_run(obj, in_code)
  fix_total = fix_count + (lk_rec.left() >> 3)
  long_fix = lk_rec.left() > 0
  if long_fix and not in_code then
    lk_err.fail(lk_err.E_FIXES)
  end
  first_run()
end

; Read the FIX record again, from its start, leaving the code where it is (back).
func away()
  here = lk_rec.recno()
  rest = lk_rec.left()
  lk_rec.goto(fix_obj, fix_recno)
end

; Back to where the code was being read.
func back()
  lk_rec.goto(fix_obj, here)
  while lk_rec.left() > rest do
    lk_rec.get_byte()
  end
end

; The bytes the copy for context ctx loses before written offset `pos`, counted from the FIX
; record, read again.
func from_record(pos: word, ctx: byte): word
  away()
  count_before(fix_obj, pos)
  back()
  return shrink_count[ctx]
end

; Hold the run that starts at entry `base` of the FIX record, read again.
func load_run(base: word)
  var i: word
  away()
  for i = 0 until 8 * base do
    lk_rec.get_byte()
  end
  fix_count = 0
  cursor = 0
  take_run(fix_obj, true)
  run_base = base
  back()
end

; No fix-ups are held.
pub func drop()
  fix_count = 0
  cursor = 0
end

; True while some held fix-up is still to be applied.
pub func more(): bool
  return cursor < fix_count
end

; Column `column` of the held fix-up at the cursor.
pub func held(column: word): word
  return lk_tab.wk(column + cursor)
end

; The run held is applied: hold the next one, read again from the record.
func next_run()
  var ctx: byte
  for ctx = 0 until lk_tab.ctx_count do
    run_lost[ctx] += shrunk(ctx)
  end
  load_run(run_base + fix_count)
end

; The fix-up at the cursor is applied: go on to the next, in the next run if it is not held. (The
; order of two fix-ups on either side of the end of a run is checked by the instructions, which
; find a fix-up behind them bad: lk_emit.)
pub func next_fix()
  var after: word
  if held(FX_KIND) < K_WORD or held(FX_KIND) > K_REACH_HIGH then
    bad()
  end
  cursor += 1
  if cursor == fix_count and run_base + fix_count < fix_total then
    next_run()
  elif cursor < fix_count then
    ; Fix-ups are sorted by offset, and do not overlap.
    after = lk_tab.wk(FX_AT + cursor - 1) + 1
    if is_word(lo(lk_tab.wk(FX_KIND + cursor - 1))) then
      after += 1
    end
    if held(FX_AT) < after then
      bad()
    end
  end
end

; Apply the held fix-ups again, to the next copy of the function: from the first run.
pub func rewind()
  cursor = 0
  if run_base != 0 then
    load_run(0)
    first_run()
  end
end

; ---- what a fix-up points at

; The copy of function f that its address means, and whether f was kept at all.
;
; `@f` is the copy in the context that calls through f's class (code-model.md, "Interrupts"); a
; function in no live class is taken from the lowest context that has it.
func address_copy(f: word): word, bool
  var k: byte
  var live: bool
  if lk_tab.fn_ctx[f] == 0 then
    return 0, false
  end
  k, live = lk_tab.member_class(f)
  if live and lk_tab.has_copy(f, lk_tab.cls_ctx[k]) then
    return lk_tab.copy_node(f, lk_tab.cls_ctx[k]), true
  end
  return lk_tab.first_node(f), true
end

; The address a fix-up stands for, before the addend, seen from context ctx.
;
; A function whose address something kept takes is kept itself (lk_graph), so what is left with
; address 0 is storage nothing kept can use: a slot of a dropped function, or a parameter of a
; class that no kept function calls through.
pub func target(ctx: byte, sym: word, slot: byte, is_call: bool): word
  var kind: byte
  var k: byte
  var f: word
  var n: word
  var kept: bool
  kind = lk_sym.kind_of(sym)
  if not lk_sym.is_defined(sym) then
    lk_name.fail(lk_err.E_UNDEFINED, sym)
  end
  if kind == lk_sym.VARIABLE or kind == lk_sym.CONSTANT then
    if slot != $FF then
      bad()
    end
    return lk_tab.def_a[lk_sym.row_of(sym)]
  end
  if kind == lk_sym.CLASS then
    k = lk_tab.class_of(byte(lk_sym.row_of(sym)))
    if slot >= lk_tab.cls_np[k] then
      bad()
    end
    if lk_tab.cls_reach[k] == 0 then
      return 0
    end
    return lk_tab.cp_addr[lo(lk_tab.cls_par[k]) + slot]
  end
  f = lk_sym.row_of(sym)
  if slot == $FF then
    if is_call then
      ; A call goes to the callee's copy in the caller's own context: through its stub if the
      ; callee is in a window and the caller is not in the same bank or overlay.
      if ctx == NO_CONTEXT or not lk_tab.has_copy(f, ctx) then
        lk_name.fail_in(lk_err.E_NOT_LINKED, sym, cur_sym)
      end
      n = lk_tab.copy_node(f, ctx)
      if lk_win.has_stub(f) and lk_scan.fn_bank(f) != lk_scan.fn_bank(cur_fn) then
        return lk_win.stub_addr(n)
      end
      return lk_tab.wk(lk_tab.W_ADDR + n)
    end
    n, kept = address_copy(f)
    if not kept then
      return 0
    end
    ; `@f` of a function in a window is its stub, wherever it is taken.
    if lk_win.has_stub(f) then
      return lk_win.stub_addr(n)
    end
    return lk_tab.wk(lk_tab.W_ADDR + n)
  end
  if slot >= lk_tab.fn_nslots(f) then
    bad()
  end
  if ctx != NO_CONTEXT and lk_tab.has_copy(f, ctx) then
    return lk_alloc.slot_addr(lk_tab.copy_node(f, ctx), slot)
  end
  n, kept = address_copy(f)
  if not kept then
    return 0
  end
  return lk_alloc.slot_addr(n, slot)
end

; The bank + 1 of the region variable or constant data s is in, 0 for fixed memory, or $FF if s
; is not a variable or constant data that is defined.
func bank_of(s: word): byte
  var k: byte
  k = lk_sym.kind_of(s)
  if (k != lk_sym.VARIABLE and k != lk_sym.CONSTANT) or not lk_sym.is_defined(s) then
    return $FF
  end
  return lk_scan.region_of(lk_sym.row_of(s))
end

; What a kind 6 fix-up naming symbol s stands for: the register value of the bank of the region s
; is in, or 0 if the region is in fixed memory. The bank is mapped from here on.
pub func bank_value(s: word): word
  var r: byte
  r = bank_of(s)
  if r == $FF then
    return $100                         ; not a variable or constant data: a bad fix-up
  end
  if r == 0 then
    return 0
  end
  mapped |= word(1) << (r - 1)
  return lk_envf.bank_value[r - 1]
end

; Code of cur_fn names symbol s: if s is a variable or constant data of a region in a bank, a kind
; 6 fix-up of cur_fn must have mapped that bank before (a `with` block's `LDA #bank`). Code
; compiled with the region in fixed memory (-fREGION) has no block, and would read the window as
; whatever is there.
pub func check_mapped(s: word)
  var r: byte
  r = bank_of(s)
  if r != 0 and r != $FF and (mapped & (word(1) << (r - 1))) == 0 then
    lk_name.fail_in(lk_err.E_UNMAPPED, s, cur_sym)
  end
end

; The byte a one-byte fix-up of this kind puts in the code.
pub func part(value: word, kind: byte): byte
  if kind == K_HIGH or kind == K_REACH_HIGH then
    return hi(value)
  end
  if kind == K_ZP and value > $FF then
    ; Only a class 0 slot is always in zero page; the compiler must not ask this of others.
    lk_name.fail_in(lk_err.E_NOT_ZP, held(FX_SYM), cur_sym)
  end
  return lo(value)
end

; ---- what shrinks

; The contexts, as bits, in which the address of a fix-up of cur_fn is below $100.
;
; Code and constant data are never below $100 (lk_envf.check), which is what lets sizes be worked
; out before anything is placed.
func zp_contexts(sym: word, slot: byte, addend: word): byte
  var kind: byte
  var bits: byte
  var ctx: byte
  kind = lk_sym.kind_of(sym)
  if kind == lk_sym.CONSTANT or (kind == lk_sym.FUNCTION and slot == $FF) then
    return 0
  end
  if kind == lk_sym.VARIABLE then
    if lk_tab.def_a[lk_sym.row_of(sym)] + addend < $100 then
      return lk_tab.fn_ctx[cur_fn]
    end
    return 0
  end
  bits = 0
  for ctx = 0 until lk_tab.ctx_count do
    if lk_tab.has_copy(cur_fn, ctx) then
      if target(ctx, sym, slot, false) + addend < $100 then
        bits |= byte(1) << ctx
      end
    end
  end
  return bits
end

; True if the instruction of held fix-up i shrinks in the copy for context ctx.
pub func shrinks(i: word, ctx: byte): bool
  with LKWORK do
    return (lo(lk_tab.work[FX_ZP + i]) & (byte(1) << ctx)) != 0
  end
end

; Bytes the copy for context ctx loses, from the fix-ups held.
pub func shrunk(ctx: byte): word
  var count: word
  var i: word
  count = 0
  for i = 0 until fix_count do
    if shrinks(i, ctx) then
      count += 1
    end
  end
  return count
end

; Bytes the copy for context ctx loses, from all of the function's fix-ups.
pub func lost(ctx: byte): word
  if long_fix then
    return from_record($FFFF, ctx)
  end
  return shrunk(ctx)
end

; How many bytes are removed before written offset `pos` in the copy for context ctx: from the
; run held if it covers `pos` (every entry before the run is before it, every one after the run
; after it), else from the FIX record.
pub func removed(pos: word, ctx: byte): word
  if long_fix and (run_base != 0 and pos < lk_tab.wk(FX_AT)
                   or pos > lk_tab.wk(FX_AT + fix_count - 1)) then
    return from_record(pos, ctx)
  end
  return run_lost[ctx] + removed_before(pos, ctx)
end

; How many bytes are removed before written offset `pos` in the copy for context ctx.
;
; A fix-up is at the offset of an operand's low byte; the byte removed is the one after it.
pub func removed_before(pos: word, ctx: byte): word
  var count: word
  var i: word
  count = 0
  with LKWORK do
    for i = 0 until fix_count do
      if lk_tab.work[FX_AT + i] >= pos then
        return count
      end
      if shrinks(i, ctx) then
        count += 1
      end
    end
  end
  return count
end
