; Regions placed by the program as it starts: lathe/host/lk_dyn.py in Lathe.
;
; `region NAME WIN N dynamic` (configurations.md, "Regions placed at run time"; lathe/docs/bbc.md,
; "One image for every machine with sideways RAM"). A dynamic region is linked as any region in a
; bank is, its variables at their full sizes in the window, so that every check of the link
; holds. Every place that names one of its variables, and every `with` block's call of map and
; unmap, is in fixed code, which on the BBC is copied into main RAM at every command: so the
; program can move the region by changing those places, as it starts. The linker lists them after
; everything else in the code range ($places), and `$start` gives the list to the placer module's
; `place` (the environment's `placer` entry) after FARCALL.start and before `$init`. The list's
; form is in the Python's description.
;
; The places are held while the image is written, in the order they are written, which is the
; order of their addresses, two words each in the work area from W_SITES: an address, and its
; type, variable or region, and low byte; a group (T_GROUP) holds the regions its copy maps.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | a region, a variable's number, a     | bytes; places and addresses: words| the type is the |
;   | type, a count: ints                  |                                   | storage         |
;   | var_of, region_of_sym give NO_GROUP, | the same, as words and bytes      | the same        |
;   | MAX_REGIONS                          |                                   |                 |
;   | `& 0xFFFF`, `& 0xFF`                 | the word, which wraps; lo()       | the same        |
module lk_dyn

import lk_alloc (data_end, more_end, straddles)
import lk_boot (places_addr)
import lk_envf (bank_value, code_hi, code_lo, data_hi, data_lo, has_more, MAX_REGIONS, more_hi,
                more_lo, region_bank, region_count, region_dynamic)
import lk_err (begin, E_CODE_FULL, E_DYNAMIC, E_SITES, fail, finish, over)
import lk_fix (is_word, K_BANK, K_HIGH, K_REACH_HIGH, K_WORD)
import lk_name (fail, fail_in, fc_map, fc_unmap)
import lk_op (OP_JMP, OP_JSR)
import lk_out (base, put, put_word, seek, written)
import lk_scan (MAX_REGION_DEFS, rdef_count, rdef_def, rdef_region)
import lk_sym (CONSTANT, is_defined, kind_of, row_of, VARIABLE)
import lk_tab (D_CONST, def_a, def_b, def_f, def_ref, is_kept_def, is_kept_var, set_wk, W_OWN,
               W_SNAME, wk)

const W_SITES = lk_tab.W_SNAME + 128    ; after the slot names (lk_emit, lk_map): free while the
const MAX_SITES = (lk_tab.W_OWN - W_SITES) / 2  ; image is written, before the map is
const MAX_VARS = 32

const T_WORD = 1                ; the types of a place held, in the top three bits
const T_LOW = 2
const T_HIGH = 3
const T_BANK = 4
const T_GROUP = 5
const T_CALL = 6
const KEEP = $8000              ; a group's copy maps a bank of no dynamic region
const NO_GROUP = $FFFF

var site_count: word            ; begin() sets them
var group: word                 ; the group of the copy being written, if it has one

; True if region r (its entry in lk_envf) is dynamic.
func is_dynamic(r: byte): bool
  return (lk_envf.region_dynamic & (word(1) << r)) != 0
end

; Region r's number among the dynamic regions.
func region_index(r: byte): byte
  var n: byte
  var i: byte
  n = 0
  for i = 0 until r do
    if is_dynamic(i) then
      n += 1
    end
  end
  return n
end

; The entry of variable or constant d among lk_scan's region definitions, or MAX_REGION_DEFS.
func rdef_of(d: word): byte
  var i: byte
  for i = 0 until lk_scan.rdef_count do
    if lk_scan.rdef_def[i] == d then
      return i
    end
  end
  return lk_scan.MAX_REGION_DEFS
end

; True if region definition i is a kept variable of a dynamic region, not in zero page.
func movable(i: byte): bool
  var d: word
  d = lk_scan.rdef_def[i]
  return is_dynamic(lk_scan.rdef_region[i]) and lk_tab.is_kept_var(d) and lk_tab.def_a[d] >= $100
end

; The number of the dynamic variable symbol sym is, or NO_GROUP.
func var_of(sym: word): word
  var k: byte
  var i: byte
  var n: word
  k = lk_sym.kind_of(sym)
  if (k != lk_sym.VARIABLE and k != lk_sym.CONSTANT) or not lk_sym.is_defined(sym) then
    return NO_GROUP
  end
  i = rdef_of(lk_sym.row_of(sym))
  if i == lk_scan.MAX_REGION_DEFS then
    return NO_GROUP
  end
  if not movable(i) then
    return NO_GROUP
  end
  n = 0
  for k = 0 until i do
    if movable(k) then
      n += 1
    end
  end
  return n
end

; The region (its entry in lk_envf) of the variable or constant sym, or MAX_REGIONS.
func region_of_sym(sym: word): byte
  var k: byte
  var i: byte
  k = lk_sym.kind_of(sym)
  if (k != lk_sym.VARIABLE and k != lk_sym.CONSTANT) or not lk_sym.is_defined(sym) then
    return lk_envf.MAX_REGIONS
  end
  i = rdef_of(lk_sym.row_of(sym))
  if i == lk_scan.MAX_REGION_DEFS then
    return lk_envf.MAX_REGIONS
  end
  return lk_scan.rdef_region[i]
end

; Before the image is written: no place held.
pub func begin()
  site_count = 0
  group = NO_GROUP
end

; A function copy is about to be written: its blocks are a group of their own.
pub func begin_copy()
  group = NO_GROUP
end

func add(info: word, addr: word)
  if site_count == MAX_SITES then
    lk_err.fail(lk_err.E_SITES)
  end
  lk_tab.set_wk(W_SITES + 2 * site_count, addr)
  lk_tab.set_wk(W_SITES + 2 * site_count + 1, info)
  site_count += 1
end

; The copy being written has a block: its group, made if new, maps `mask` too.
func add_to_group(mask: word)
  if group == NO_GROUP then
    group = site_count
    add(word(T_GROUP) << 13, 0)
  end
  lk_tab.set_wk(W_SITES + 2 * group, lk_tab.wk(W_SITES + 2 * group) | mask)
end

; The image's byte at `addr` (a word's first byte) is a fix-up of this kind naming sym, which stands
; for `address`, in an instruction `op` (0 in constant data): hold it if it names a dynamic region's
; variable, maps a region's bank, or calls map or unmap.
pub func note(kind: byte, sym: word, addr: word, address: word, op: byte)
  var r: byte
  var v: word
  if kind == lk_fix.K_BANK then
    r = region_of_sym(sym)
    if r != lk_envf.MAX_REGIONS and is_dynamic(r) then
      add_to_group(word(1) << region_index(r))
      add((word(T_BANK) << 13) | (word(region_index(r)) << 8), addr)
    else
      add_to_group(KEEP)
    end
    return
  end
  if kind == lk_fix.K_WORD and (sym == lk_name.fc_map or sym == lk_name.fc_unmap) and
      (op == lk_op.OP_JSR or op == lk_op.OP_JMP) then
    add_to_group(0)
    add(word(T_CALL) << 13, addr)
    return
  end
  v = var_of(sym)
  if v == NO_GROUP then
    return
  end
  if v >= MAX_VARS then
    lk_err.fail(lk_err.E_SITES)
  end
  if lk_fix.is_word(kind) then
    add((word(T_WORD) << 13) | (v << 8), addr)
  elif kind == lk_fix.K_HIGH or kind == lk_fix.K_REACH_HIGH then
    add((word(T_HIGH) << 13) | (v << 8) | lo(address), addr)
  else
    add((word(T_LOW) << 13) | (v << 8), addr)
  end
end

; A fix-up naming sym of this kind is written outside the image (in a bank's file): it may not name
; a dynamic region's variable or map its bank. user is the function or constant it is in.
pub func refuse(kind: byte, sym: word, user: word)
  var r: byte
  r = region_of_sym(sym)
  if r != lk_envf.MAX_REGIONS and is_dynamic(r) then
    if kind == lk_fix.K_BANK or var_of(sym) != NO_GROUP then
      lk_name.fail_in(lk_err.E_DYNAMIC, sym, user)
    end
  end
end

; A dynamic region holds no constant data, which would have to be copied where it goes, and no
; two-byte variable, which must not lie across a page (lk_dyn.py).
func check_constants()
  var i: byte
  var d: word
  for i = 0 until lk_scan.rdef_count do
    d = lk_scan.rdef_def[i]
    if is_dynamic(lk_scan.rdef_region[i]) and lk_tab.is_kept_def(d) and
        (lk_tab.def_f[d] & lk_tab.D_CONST) != 0 then
      lk_name.fail(lk_err.E_DYNAMIC, lk_tab.def_ref(d))
    end
    if movable(i) and lk_alloc.straddles($FF, lk_tab.def_b[d]) then
      lk_name.fail(lk_err.E_DYNAMIC, lk_tab.def_ref(d))
    end
  end
end

; The end of the highest of the ranges of main memory, + 1.
func top(): word
  var t: word
  t = lk_envf.code_hi
  if lk_envf.data_hi > t then
    t = lk_envf.data_hi
  end
  if lk_envf.has_more and lk_envf.more_hi > t then
    t = lk_envf.more_hi
  end
  return t + 1
end

; A place: addr, after `before`. Returns addr.
func put_place(before: word, addr: word): word
  var d: word
  d = addr - before
  if d >= 1 and d <= $FF then
    lk_out.put(lo(d))
  else
    lk_out.put(0)
    lk_out.put_word(addr)
  end
  return addr
end

func site_type(i: word): byte
  return hi(lk_tab.wk(W_SITES + 2 * i + 1)) >> 5
end

func site_addr(i: word): word
  return lk_tab.wk(W_SITES + 2 * i)
end

; The free parts of the code range (from the list on), of `data` and of `more`: each is there if
; it is not empty.
func has_code_area(): bool
  return lk_boot.places_addr <= lk_envf.code_hi
end

func has_data_area(): bool
  return lk_alloc.data_end <= lk_envf.data_hi - lk_envf.data_lo
end

func has_more_area(): bool
  return lk_envf.has_more and lk_alloc.more_end <= lk_envf.more_hi - lk_envf.more_lo
end

func put_areas()
  var n: byte
  n = 0
  if has_code_area() then
    n += 1
  end
  if has_data_area() then
    n += 1
  end
  if has_more_area() then
    n += 1
  end
  lk_out.put(n)
  if has_code_area() then
    lk_out.put_word(lk_boot.places_addr)
    lk_out.put_word(lk_envf.code_hi)
  end
  if has_data_area() then
    lk_out.put_word(lk_envf.data_lo + lk_alloc.data_end)
    lk_out.put_word(lk_envf.data_hi)
  end
  if has_more_area() then
    lk_out.put_word(lk_envf.more_lo + lk_alloc.more_end)
    lk_out.put_word(lk_envf.more_hi)
  end
end

func put_regions()
  var n: byte
  var r: byte
  n = 0
  for r = 0 until lk_envf.region_count do
    if is_dynamic(r) then
      n += 1
    end
  end
  lk_out.put(n)
  for r = 0 until lk_envf.region_count do
    if is_dynamic(r) then
      lk_out.put(lk_envf.bank_value[lk_envf.region_bank[r] - 1])
    end
  end
end

func put_vars()
  var n: byte
  var i: byte
  var d: word
  n = 0
  for i = 0 until lk_scan.rdef_count do
    if movable(i) then
      n += 1
    end
  end
  if n > MAX_VARS then
    lk_err.fail(lk_err.E_SITES)
  end
  lk_out.put(n)
  for i = 0 until lk_scan.rdef_count do
    if movable(i) then
      d = lk_scan.rdef_def[i]
      lk_out.put_word(lk_tab.def_a[d])
      lk_out.put_word(lk_tab.def_b[d])
      lk_out.put(region_index(lk_scan.rdef_region[i]))
    end
  end
end

func put_addresses()
  var before: word
  var i: word
  var t: byte
  var info: word
  before = 0
  for i = 0 until site_count do
    t = site_type(i)
    if t == T_WORD or t == T_LOW or t == T_HIGH then
      info = lk_tab.wk(W_SITES + 2 * i + 1)
      lk_out.put((t << 6) | (hi(info) & $1F))
      before = put_place(before, site_addr(i))
      if t == T_HIGH then
        lk_out.put(lo(info))
      end
    end
  end
  lk_out.put(0)
end

func put_banks()
  var before: word
  var i: word
  before = 0
  for i = 0 until site_count do
    if site_type(i) == T_BANK then
      lk_out.put((hi(lk_tab.wk(W_SITES + 2 * i + 1)) & $1F) + 1)
      before = put_place(before, site_addr(i))
    end
  end
  lk_out.put(0)
end

; How many calls are held from place i up to the next group: at most 255.
func calls_from(i: word): byte
  var n: byte
  n = 0
  while i < site_count and site_type(i) != T_GROUP and n < $FF do
    if site_type(i) == T_CALL then
      n += 1
    end
    i += 1
  end
  return n
end

; Each group's calls, in parts of at most 255 calls, each part with the group's regions.
func put_calls()
  var before: word
  var g: word
  var i: word
  var n: byte
  before = 0
  for g = 0 until site_count do
    if site_type(g) == T_GROUP then
      i = g + 1
      n = calls_from(i)
      while n != 0 do
        lk_out.put(n)
        lk_out.put_word(site_addr(g))
        while n != 0 do
          if site_type(i) == T_CALL then
            before = put_place(before, site_addr(i))
            n -= 1
          end
          i += 1
        end
        n = calls_from(i)
      end
    end
  end
  lk_out.put(0)
end

; After the code in the image: the list ($places).
pub func write_list()
  var last: word
  check_constants()
  lk_out.seek(lk_boot.places_addr)
  lk_out.put_word(lk_envf.code_lo)
  lk_out.put_word(top())
  put_areas()
  put_regions()
  put_vars()
  put_addresses()
  put_banks()
  put_calls()
  last = lk_out.base + lk_out.written - 1     ; the list's last byte
  if last > lk_envf.code_hi then
    lk_err.begin(lk_err.E_CODE_FULL)
    lk_err.over(last - lk_envf.code_hi, false)
    lk_err.finish()
  end
end
