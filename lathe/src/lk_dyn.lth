; Regions placed by the program as it starts: lathe/host/lk_dyn.py in Lathe.
;
; `region NAME WIN N dynamic` (configurations.md, "Regions placed at run time"; lathe/docs/bbc.md,
; "One image for every machine with sideways RAM"). A dynamic region is linked as any region in a
; bank is, its variables at their full sizes in the window, so that every check of the link
; holds. Every place that names one of its variables, and every `with` block's `LDA #bank` of it,
; is in fixed code, which on the BBC is copied into main RAM at every command: so the program can
; move the region, as one block and by whole pages, and change its bank, by changing those places
; as it starts. The linker lists them after everything else in the code range ($places), and
; `$start` gives the list to the placer module's `place` (the environment's `placer` entry) after
; FARCALL.start and before `$init`. The list's form is in the Python's description.
;
; The places are held while the image is written, in the order they are written, which is the
; order of their addresses, two words each in the work area from W_SITES: an address, and its type
; and region.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | a region, its number, a type, a      | bytes; places and addresses: words| the type is the |
;   | count: ints                          |                                   | storage         |
;   | `& 0xFFFF`                           | the word, which wraps             | the same        |
module lk_dyn

import lk_alloc (data_end, more_end)
import lk_boot (places_addr)
import lk_envf (bank_value, code_hi, code_lo, data_hi, data_lo, fail_text, has_more, more_hi,
                more_lo, region_bank, region_count, region_dynamic, region_room, room_ceiling,
                room_floor, room_planes, room_rows, room_want)
import lk_err (begin, E_CODE_FULL, E_DYNAMIC, E_ENV_ENTRY, E_SITES, fail, finish, over)
import lk_fix (cur_sym, FX_ADD, FX_KIND, FX_SYM, held, is_word, K_BANK, K_HIGH, K_REACH_HIGH)
import lk_name (fail, fail_in, room_def)
import lk_out (base, put, put_word, seek, written)
import lk_scan (MAX_REGION_DEFS, rdef_count, rdef_def, rdef_region)
import lk_sym (CONSTANT, is_defined, kind_of, row_of, VARIABLE)
import lk_tab (D_CONST, def_a, def_b, def_f, def_ref, is_kept_def, is_kept_var, NONE, set_wk, W_OWN,
               W_SNAME, wk)

const W_SITES = lk_tab.W_SNAME + 128    ; after the slot names (lk_emit, lk_map): free while the
const MAX_SITES = (lk_tab.W_OWN - W_SITES) / 3  ; image is written, before the map is

const T_ADD = 1                 ; a high byte: the pages moved are added to it
const T_BANK = 2                ; a block's bank
const NO_REGION = $FF

var site_count: word            ; begin() sets it

; True if region r (its entry in lk_envf) is dynamic.
func is_dynamic(r: byte): bool
  return (lk_envf.region_dynamic & (word(1) << r)) != 0
end

; The entry of variable or constant d among lk_scan's region definitions, or MAX_REGION_DEFS.
func rdef_of(d: word): byte
  var i: byte
  for i = 0 until lk_scan.rdef_count do
    if lk_scan.rdef_def[i] == d then
      return i
    end
  end
  return lk_scan.MAX_REGION_DEFS
end

; True if region definition i is a kept variable of a dynamic region, not in zero page.
func movable(i: byte): bool
  var d: word
  d = lk_scan.rdef_def[i]
  return is_dynamic(lk_scan.rdef_region[i]) and lk_tab.is_kept_var(d) and lk_tab.def_a[d] >= $100
end

; The region (its entry in lk_envf) of the variable or constant sym, if that region is dynamic and, unless `bank` (a kind 6 fix-up, which names the region's bank), sym is one
; of its variables not in zero page; else NO_REGION.
func dynamic_of(sym: word, bank: bool): byte
  var k: byte
  var i: byte
  k = lk_sym.kind_of(sym)
  if (k != lk_sym.VARIABLE and k != lk_sym.CONSTANT) or not lk_sym.is_defined(sym) then
    return NO_REGION
  end
  i = rdef_of(lk_sym.row_of(sym))
  if i == lk_scan.MAX_REGION_DEFS then
    return NO_REGION
  end
  if not is_dynamic(lk_scan.rdef_region[i]) then
    return NO_REGION
  end
  if not bank and not movable(i) then
    return NO_REGION
  end
  return lk_scan.rdef_region[i]
end

; Before the image is written: no place held.
pub func begin()
  site_count = 0
end

func add(t: byte, r: byte, addr: word, target: word)
  var entry: word               ; the place's first word
  if site_count == MAX_SITES then
    lk_err.fail(lk_err.E_SITES)
  end
  entry = W_SITES + 3 * site_count
  lk_tab.set_wk(entry, addr)
  lk_tab.set_wk(entry + 1, (word(t) << 8) | r)
  lk_tab.set_wk(entry + 2, target)
  site_count += 1
end

; The fix-up at lk_fix's cursor is applied in the file `dest` (0 the image, or a bank + 1) at the
; place lk_out is at (a word's first byte). In the image: hold it if it is the high byte of a
; dynamic region's variable's address (or the word of one) or a block's bank of a dynamic region.
; Outside it: it may not name either.
pub func site(dest: byte)
  var kind: byte
  var sym: word
  var addr: word
  var target: word
  var r: byte
  kind = lo(lk_fix.held(lk_fix.FX_KIND))
  sym = lk_fix.held(lk_fix.FX_SYM)
  addr = lk_out.base + lk_out.written
  r = dynamic_of(sym, kind == lk_fix.K_BANK)
  if r == NO_REGION then
    return
  end
  if dest != 0 then
    lk_name.fail_in(lk_err.E_DYNAMIC, sym, lk_fix.cur_sym)
  end
  target = lk_tab.def_a[lk_sym.row_of(sym)] + lk_fix.held(lk_fix.FX_ADD)
  if kind == lk_fix.K_BANK then
    add(T_BANK, r, addr, target)
  elif lk_fix.is_word(kind) then
    add(T_ADD, r, addr + 1, target)
  elif kind == lk_fix.K_HIGH or kind == lk_fix.K_REACH_HIGH then
    add(T_ADD, r, addr, target)
  end
end

; A place: addr, after `before`. Returns addr.
func put_place(before: word, addr: word): word
  var d: word
  d = addr - before
  if d >= 1 and d <= $FF then
    lk_out.put(lo(d))
  else
    lk_out.put(0)
    lk_out.put_word(addr)
  end
  return addr
end

; The free parts of the code range (from the list on), of `data` and of `more`, each if it is not
; empty: written after their count.
func put_areas()
  var code_free: bool
  var data_free: bool
  var more_free: bool
  var n: byte
  code_free = lk_boot.places_addr <= lk_envf.code_hi
  data_free = lk_alloc.data_end <= lk_envf.data_hi - lk_envf.data_lo
  more_free = lk_envf.has_more and lk_alloc.more_end <= lk_envf.more_hi - lk_envf.more_lo
  n = 0
  if code_free then
    n += 1
  end
  if data_free then
    n += 1
  end
  if more_free then
    n += 1
  end
  lk_out.put(n)
  if code_free then
    lk_out.put_word(lk_boot.places_addr)
    lk_out.put_word(lk_envf.code_hi)
  end
  if data_free then
    lk_out.put_word(lk_envf.data_lo + lk_alloc.data_end)
    lk_out.put_word(lk_envf.data_hi)
  end
  if more_free then
    lk_out.put_word(lk_envf.more_lo + lk_alloc.more_end)
    lk_out.put_word(lk_envf.more_hi)
  end
end

; The plane of a region of planes of `plane_rows` bytes that byte `offset` of its block is in (the end
; of the block is the plane after the last).
func plane_of(offset: word, plane_rows: word): byte
  var k: byte
  k = 0
  while offset >= plane_rows do
    offset -= plane_rows
    k += 1
  end
  return k
end

; True if variable d is a whole number of planes of `plane_rows` bytes.
func is_planes(d: word, plane_rows: word): bool
  return word(plane_of(lk_tab.def_b[d], plane_rows)) * plane_rows == lk_tab.def_b[d]
end

; The planes of region r, of `plane_rows` bytes, below the byte at `target`: those of the variables
; that end at or before it, and in the one it is in those before its own (the end of the block is
; the plane after the last). A variable that is not whole planes has none.
func planes_below(r: byte, target: word, plane_rows: word): byte
  var i: byte
  var d: word
  var k: byte
  k = 0
  for i = 0 until lk_scan.rdef_count do
    d = lk_scan.rdef_def[i]
    if lk_scan.rdef_region[i] == r and movable(i) and is_planes(d, plane_rows) then
      if lk_tab.def_a[d] + lk_tab.def_b[d] <= target then
        k += plane_of(lk_tab.def_b[d], plane_rows)
      elif lk_tab.def_a[d] <= target then
        k += plane_of(target - lk_tab.def_a[d], plane_rows)
      end
    end
  end
  return k
end

; The places of type t of region r, their count first; with `plane_rows` (a region of planes of that
; many bytes), each followed by its plane (planes_below).
func put_sites(t: byte, r: byte, plane_rows: word)
  var n: word
  var i: word
  var entry: word               ; place i's first word
  var key: word                 ; its second, if it is of type t and region r
  var before: word
  key = (word(t) << 8) | r
  n = 0
  entry = W_SITES
  for i = 0 until site_count do
    if lk_tab.wk(entry + 1) == key then
      n += 1
    end
    entry += 3
  end
  lk_out.put_word(n)
  before = 0
  entry = W_SITES
  for i = 0 until site_count do
    if lk_tab.wk(entry + 1) == key then
      before = put_place(before, lk_tab.wk(entry))
      if plane_rows != 0 then
        lk_out.put(planes_below(r, lk_tab.wk(entry + 2), plane_rows))
      end
    end
    entry += 3
  end
end


; The address of region r's capacity variable, or 0 if it names none. It must be a variable of two
; bytes or more, linked, in main memory and in no region.
func room_of(r: byte): word
  var v: word
  var d: word
  if lk_envf.region_room[r] == 0 then
    return 0
  end
  v = lk_name.room_def[r]
  if v == lk_tab.NONE or lk_sym.kind_of(v) != lk_sym.VARIABLE then
    lk_envf.fail_text(lk_err.E_ENV_ENTRY, lk_envf.region_room[r])
  end
  d = lk_sym.row_of(v)
  if not lk_tab.is_kept_var(d) or lk_tab.def_b[d] < 2 or rdef_of(d) != lk_scan.MAX_REGION_DEFS then
    lk_envf.fail_text(lk_err.E_ENV_ENTRY, lk_envf.region_room[r])
  end
  return lk_tab.def_a[d]
end

; Region r's capacity, its block from `first` to `past`, its last variable at `last`: what the
; variable holds at the least, the least bytes of the block, what a step adds, the steps to the
; most and whether it is planes. Returns the rows of a plane, or 0.
func put_room(r: byte, first: word, past: word, last: word): word
  var plane_rows: word
  var floor: word
  var ceiling: word
  var want: word
  var value: word
  var least: word
  var unit: word
  var steps: word
  var planes: byte
  var whole: bool               ; the variables' planes are what the entry says
  plane_rows = lk_envf.room_rows(r)
  floor = lk_envf.room_floor(r)
  ceiling = lk_envf.room_ceiling(r)
  want = lk_envf.room_want(r)
  if plane_rows != 0 then
    planes = planes_below(r, past, plane_rows)
    if lk_envf.room_planes(r) != 0 then
      whole = word(planes) == lk_envf.room_planes(r)
    else
      whole = word(planes) * plane_rows == past - first
    end
    if past == first or not whole then
      lk_envf.fail_text(lk_err.E_ENV_ENTRY, lk_envf.region_room[r])
    end
    value = plane_rows
    least = past - first
    unit = word(planes) << 8
  else
    if floor == 0 then
      floor = past - last
    end
    value = floor
    least = last - first + floor
    unit = 256
  end
  steps = 255
  if ceiling != 0 then
    steps = (ceiling - value) >> 8
    if steps > 254 then
      lk_envf.fail_text(lk_err.E_ENV_ENTRY, lk_envf.region_room[r])
    end
  end
  lk_out.put_word(value)
  lk_out.put_word(least)
  lk_out.put_word(unit)
  lk_out.put(lo(steps))
  if want != 0 then
    lk_out.put(lo((want - value) >> 8))
  else
    lk_out.put(0)
  end
  if plane_rows != 0 then
    lk_out.put(1)
  else
    lk_out.put(0)
  end
  return plane_rows
end

; Region r (its entry in lk_envf): its bank's value, its block, its capacity variable and its
; places; constant data in a dynamic region is refused, as it would have to be copied where the
; block goes.
func put_region(r: byte)
  var i: byte
  var d: word
  var first: word
  var past: word
  var last: word                ; where its last variable starts
  var room: word
  var plane_rows: word
  var start: word               ; where variable d starts, and the byte after it
  var after: word
  lk_out.put(lk_envf.bank_value[lk_envf.region_bank[r] - 1])
  first = $FFFF
  past = 0
  last = 0
  for i = 0 until lk_scan.rdef_count do
    d = lk_scan.rdef_def[i]
    if lk_scan.rdef_region[i] == r and is_dynamic(r) and lk_tab.is_kept_def(d) and
        (lk_tab.def_f[d] & lk_tab.D_CONST) != 0 then
      lk_name.fail(lk_err.E_DYNAMIC, lk_tab.def_ref(d))
    end
    if lk_scan.rdef_region[i] == r and movable(i) then
      start = lk_tab.def_a[d]
      after = start + lk_tab.def_b[d]
      if start < first then
        first = start
      end
      if after > past then
        past = after
      end
      if start > last then
        last = start
      end
    end
  end
  if past == 0 then
    first = 0
  end
  lk_out.put_word(first)
  lk_out.put_word(past - first)
  room = room_of(r)
  lk_out.put_word(room)
  plane_rows = 0
  if room != 0 then
    plane_rows = put_room(r, first, past, last)
  end
  put_sites(T_ADD, r, plane_rows)
  put_sites(T_BANK, r, 0)
end

; After the code in the image: the list ($places).
pub func write_list()
  var r: byte
  var last: word
  lk_out.seek(lk_boot.places_addr)
  lk_out.put_word(lk_envf.code_lo)
  lk_out.put_word(lk_envf.data_hi + 1)
  put_areas()
  lk_out.put(lk_envf.region_count)
  for r = 0 until lk_envf.region_count do
    put_region(r)
  end
  last = lk_out.base + lk_out.written - 1     ; the list's last byte
  if last > lk_envf.code_hi then
    lk_err.begin(lk_err.E_CODE_FULL)
    lk_err.over(last - lk_envf.code_hi, false)
    lk_err.finish()
  end
end
