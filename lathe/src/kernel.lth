; The kernel: what every phase of the compiler needs. lathe/host/kernel.py in Lathe.
;
; Owns
; - the text memory: what the system must see as zero-terminated text (the program's arguments
;   and the name of the file being opened);
; - streams: bytes read or written in order, from a file or from memory, so that no phase knows
;   which it has;
; - the name heap: every name is stored once and is known everywhere by its offset there;
; - the symbol table: one column per attribute, indexed by symbol number. Module-level symbols
;   come first; the symbols of the function being compiled lie above them and are released when
;   it ends. What the columns mean for each kind of symbol is DECL's business; the other modules
;   reach them only through byte_of(), word_of(), set_byte(), set_word(), member_type_of() and
;   member_value_of();
; - the frozen symbols: the functions, constants and variables an imported module exports, kept
;   in the name heap in a compact form and made symbols (thawed) only when the importer names
;   one. Thawed symbols are numbered down from the top of the table and are never released.
;
; Reports errors through err, which is the kernel's other half. Pointers follow the convention
; at the top of lathe/src/sys.lth.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | text memory is env.mem from TEXT_BASE| the array `text`, TEXT_SIZE bytes,| memory is real: |
;   | $0100, TEXT_SIZE (2048) bytes        | 2048 as the host's (768 in the    | $0100 is the    |
;   |                                      | small build, under `#if SMALL`)   | stack. It holds |
;   |                                      |                                   | the path, the   |
;   |                                      |                                   | arguments and   |
;   |                                      |                                   | file names      |
;   | keep_argument copies, then checks    | the same, so an argument that     | (as left)       |
;   |                                      | does not fit is written past the  |                 |
;   |                                      | array before error 82: it cannot  |                 |
;   |                                      | happen while TEXT_SIZE exceeds    |                 |
;   |                                      | PATH_SIZE + 480                   |                 |
;   | NO_SYM, NO_OBJ declared with the     | declared at the top               | declare before  |
;   | symbol table, used by name_end()     |                                   | use             |
;   | token memory: env.mem from TOKEN_BASE| the array `tokens`, `in TOKENS`;  | in a data bank  |
;   |                                      | token_byte(p) is p[0] in a block; | when banked     |
;   |                                      | get() reads a memory stream inside|                 |
;   |                                      | a block too                       |                 |
;   |                                      | (what it reads may be fixed       |                 |
;   |                                      | memory: the address is p either   |                 |
;   |                                      | way)                              |                 |
;   | path_add_name, put_name: with the    | after the name heap               | declare before  |
;   | text memory and the streams          |                                   | use             |
;   | `low, _ = get(s)`                    | a variable `at_end` for the `_`   | no `_`          |
;   | name_word(): b | (b1 << 8)           | word(b) | (word(b1) << 8)         | bytes stay bytes|
;   | path_length + 1 >= PATH_SIZE         | word(path_length) + 1 >= ...      | PATH_SIZE (256) |
;   |                                      |                                   | is not a byte   |
;   | column widths: ints                  | byte where every value fits (see  | the type is the |
;   |                                      | each column), else word; the      | storage         |
;   |                                      | 384-element word columns `rows`   | (error 123)     |
;   | names: an array                      | `in NAMES`, a region (lathe/docs/ | the name heap is|
;   |                                      | language.md, "Banked data"): used | in a data bank  |
;   |                                      | only inside `with NAMES do ...    | when banked     |
;   |                                      | end`, in the functions that read  | (configurations |
;   |                                      | or write it, one block around a   | .md, step 10)   |
;   |                                      | whole operation                   |                 |
;   | name_word, name_set_word: functions  | `inline`, used only inside blocks | smaller code    |
;   | name_token, name_set_token           | functions with a block, not inline| a block cannot  |
;   |                                      |                                   | be inline       |
;   | name_add()                           | the same, and `pub inline         | LEX maps once   |
;   |                                      | name_put()`, its body without the | around a whole  |
;   |                                      | block, for LEX's block; `names`,  | name; an        |
;   |                                      | name_top, new_length, new_hash,   | exported inline |
;   |                                      | N_TEXT and MAX_NAME exported      | function uses   |
;   |                                      |                                   | exported names  |
;   | name_is_new(n), spelling_hash(n),    | a pointer to the entry, `q[k]`,   | (zp),Y: no      |
;   | same_spelling(a, b), chain_find(...  | passed in by the caller's block;  | 16-bit index; no|
;   | n), freeze, thaw: names[n + k]       | these four have no block of their | block of their  |
;   |                                      | own, and are called only inside   | own to pay for  |
;   |                                      | one                               |                 |
;   | path_add_name, put_name: name_length | the entry read in one block       | one mapping     |
;   | and name_char for each character     |                                   |                 |
;   | sym_bytes, sym_words, member_type,   | the same, `in SYMS`: used only    | on the BBC the  |
;   | member_value                         | inside `with SYMS do ... end` in  | symbols are in a|
;   |                                      | kernel's functions; the other     | sideways bank of|
;   |                                      | modules call byte_of() and the    | their own, apart|
;   |                                      | rest. A function inside a block of| from the names  |
;   |                                      | NAMES reads what it needs there,  | (one window)    |
;   |                                      | and has a block of SYMS after it, |                 |
;   |                                      | or calls one that has its own     |                 |
;   |                                      | (chain_walk(), member_add())      |                 |
module kernel

import err (E_DUPLICATE, E_MEMBERS_FULL, E_MODULES_FULL, E_NAMES_FULL, E_NOT_LISTED, E_PATH_LONG,
            E_STREAMS_FULL, E_SYMS_FULL, E_TEXT_FULL, fatal)
import sys (arg_copy, close, open_in, open_out, read, write)

; ---- Text memory -------------------------------------------------------------------------

#if SMALL
const TEXT_SIZE = 768           ; (SMALL: the test programs' small build)
#else
const TEXT_SIZE = 2048
#end
const PATH_SIZE = 256
#if SMALL
const TOKEN_SIZE = 384          ; (SMALL: the test programs' small build)
#else
const TOKEN_SIZE = 2048         ; bytes of token memory: at least inlines.SAVED_SIZE
#end

var text: [TEXT_SIZE]byte nozp
pub var text_top: ^byte
pub var path: ^byte             ; the file name being built, PATH_SIZE bytes
pub var path_length: byte
var tokens: [TOKEN_SIZE]byte in TOKENS  ; the token memory: INLINE's saved tokens

; Pointer to the token memory, which is read and written only through token_byte(),
; set_token_byte() and memory streams.
pub func token_start(): ^byte
  with TOKENS do
    return @tokens
  end
end

; The byte of token memory at `p`.
pub func token_byte(p: ^byte): byte
  with TOKENS do
    return p[0]
  end
end

pub func set_token_byte(p: ^byte, value: byte)
  with TOKENS do
    p[0] = value
  end
end

; Pointer to `size` bytes of text memory that stay reserved.
pub func text_reserve(size: word): ^byte
  var start: ^byte
  if text_top + size > @text + TEXT_SIZE then
    err.fatal(err.E_TEXT_FULL)
  end
  start = text_top
  text_top += size
  return start
end

; Pointer to program argument `i`, copied into text memory.
pub func keep_argument(i: byte): ^byte
  var start: ^byte
  var length: byte
  start = text_top
  length = sys.arg_copy(i, start)
  if start + length + 1 > @text + TEXT_SIZE then
    err.fatal(err.E_TEXT_FULL)
  end
  text_top += length + 1
  return start
end

pub func path_begin()
  path_length = 0
end

pub func path_add(ch: byte)
  if word(path_length) + 1 >= PATH_SIZE then        ; one byte is kept for the zero at the end
    err.fatal(err.E_PATH_LONG)
  end
  path[path_length] = ch
  path_length += 1
end

pub func path_add_text(t: ^byte)
  while t[0] != 0 do
    path_add(t[0])
    t += 1
  end
end

; Pointer to the finished file name.
pub func path_end(): ^byte
  path[path_length] = 0
  return path
end

; ---- Streams -----------------------------------------------------------------------------

const MAX_STREAMS = 10
pub const STREAM_FREE = 0
pub const STREAM_IN = 1             ; a file being read
pub const STREAM_OUT = 2            ; a file being written
pub const STREAM_MEMORY = 3         ; bytes of memory being read
pub const STREAM_ENDED = 4          ; a file being read whose end has been read: the machine
                                    ; would give its first byte again (the emulator rewinds a
                                    ; file at its end)

var stream_kind: [MAX_STREAMS]byte
var stream_handle: [MAX_STREAMS]byte        ; the system's handle of a file
pub var stream_next: [MAX_STREAMS]^byte     ; memory: pointer to the next byte; a file being
                                            ; read: how many bytes have been read
                                            ; (decl.read_interface())
var stream_limit: [MAX_STREAMS]^byte        ; memory: pointer past the last byte

func stream_new(kind: byte): byte
  var s: byte
  for s = 0 until MAX_STREAMS do
    if stream_kind[s] == STREAM_FREE then
      stream_kind[s] = kind
      return s
    end
  end
  err.fatal(err.E_STREAMS_FULL)
  return 0
end

func open_file(name: ^byte, kind: byte): byte, bool
  var handle: byte
  var s: byte
  if kind == STREAM_IN then
    handle = sys.open_in(name)
  else
    handle = sys.open_out(name)
  end
  if handle == 0 then
    return 0, false
  end
  s = stream_new(kind)
  stream_handle[s] = handle
  stream_next[s] = nil
  return s, true
end

; Open the file whose name is at `name` for reading. Returns the stream and true, or false.
pub func open_in(name: ^byte): byte, bool
  return open_file(name, STREAM_IN)
end

; Create the file whose name is at `name`. Returns the stream and true, or false.
pub func open_out(name: ^byte): byte, bool
  return open_file(name, STREAM_OUT)
end

; A stream that reads memory from `start` up to but not including `limit`.
pub func open_memory(start: ^byte, limit: ^byte): byte
  var s: byte
  s = stream_new(STREAM_MEMORY)
  stream_next[s] = start
  stream_limit[s] = limit
  return s
end

pub func close(s: byte)
  if stream_kind[s] != STREAM_MEMORY then
    sys.close(stream_handle[s])
  end
  stream_kind[s] = STREAM_FREE
end

; The stream's next byte and false, or 0 and true at its end.
pub func get(s: byte): byte, bool
  var p: ^byte
  var b: byte
  var at_end: bool
  if stream_kind[s] == STREAM_MEMORY then
    if stream_next[s] == stream_limit[s] then
      return 0, true
    end
    p = stream_next[s]
    stream_next[s] = p + 1
    with TOKENS do                      ; a stream may read the token memory
      return p[0], false
    end
  end
  if stream_kind[s] == STREAM_ENDED then
    return 0, true
  end
  b, at_end = sys.read(stream_handle[s])
  stream_next[s] = stream_next[s] + 1
  if at_end then
    stream_kind[s] = STREAM_ENDED
  end
  return b, at_end
end

; The next two bytes as a number. Bytes past the end read as zero.
pub func get_word(s: byte): word
  var low: byte
  var high: byte
  var at_end: bool
  low, at_end = get(s)
  high, at_end = get(s)
  return word(low) | (word(high) << 8)
end

; Write one byte.
pub func put(s: byte, value: byte)
  sys.write(stream_handle[s], value)
end

; Write a number as two bytes, low byte first.
pub func put_word(s: byte, value: word)
  put(s, lo(value))
  put(s, hi(value))
end

; ---- The name heap -----------------------------------------------------------------------
;
; An entry is: link to the next name in the same hash bucket (2 bytes), the newest symbol
; with this name (2), a token number (1), the length (1), the characters. A name is known
; by the offset of its entry; 0 is no name.
;
; A name is built in place above the heap's top, one character at a time, and only kept if
; it is new, so looking a name up copies nothing.

#if SMALL
const NAME_HEAP_SIZE = 1536      ; (SMALL: the test programs' small build)
#else
const NAME_HEAP_SIZE = 9216
#end
const NAME_BUCKETS = 64         ; a power of two
pub const MAX_NAME = 31         ; significant characters

const N_LINK = 0
const N_SYMBOL = 2
const N_TOKEN = 4
const N_LENGTH = 5
pub const N_TEXT = 6

pub const NO_SYM = $FFFF        ; (with the symbol table below in the Python)
pub const NO_OBJ = $FFFF

pub var names: [NAME_HEAP_SIZE]byte in NAMES
var name_bucket: [NAME_BUCKETS]word
pub var name_top: word = 1
pub var new_length: byte
pub var new_hash: byte

; Used only inside a block of NAMES.
inline func name_word(offset: word): word
  return word(names[offset]) | (word(names[offset + 1]) << 8)
end

inline func name_set_word(offset: word, value: word)
  names[offset] = lo(value)
  names[offset + 1] = hi(value)
end

; Start building a name.
pub func name_begin()
  if name_top + N_TEXT + MAX_NAME > NAME_HEAP_SIZE then
    err.fatal(err.E_NAMES_FULL)
  end
  new_length = 0
  new_hash = 0
end

; name_add() inside a block of NAMES: LEX maps the bank once around a whole name.
pub inline func name_put(ch: byte)
  if new_length < MAX_NAME then
    names[name_top + N_TEXT + new_length] = ch
    new_length += 1
    new_hash = ((new_hash << 1) | (new_hash >> 7)) ^ ch
  end
end

; Add a character to the name being built. Characters after the 31st are dropped.
pub func name_add(ch: byte)
  with NAMES do
    name_put(ch)
  end
end

; True unless the entry `p` points to spells the name being built, which `q` points to. Both
; point into NAMES: called only inside a block of it.
func name_is_new(p: ^byte, q: ^byte): bool
  var i: byte
  if p[N_LENGTH] != new_length then
    return true
  end
  for i = 0 until new_length do
    if p[N_TEXT + i] != q[N_TEXT + i] then
      return true
    end
  end
  return false
end

; Finish the name being built. Returns the name, the same one for the same spelling.
pub func name_end(): word
  var bucket: byte
  var n: word
  var q: ^byte
  bucket = new_hash & (NAME_BUCKETS - 1)
  n = name_bucket[bucket]
  with NAMES do
    q = @names + name_top
    while n != 0 and name_is_new(@names + n, q) do
      n = name_word(n + N_LINK)
    end
    if n != 0 then
      return n
    end
    n = name_top
    name_set_word(n + N_LINK, name_bucket[bucket])
    name_set_word(n + N_SYMBOL, NO_SYM)
    q[N_TOKEN] = 0
    q[N_LENGTH] = new_length
  end
  name_bucket[bucket] = n
  name_top += N_TEXT + new_length
  return n
end

pub func name_length(n: word): byte
  with NAMES do
    return names[n + N_LENGTH]
  end
end

pub func name_char(n: word, i: byte): byte
  with NAMES do
    return names[n + N_TEXT + i]
  end
end

; The token number LEX gave this name: its keyword, or 0 for an ordinary name.
pub func name_token(n: word): byte
  with NAMES do
    return names[n + N_TOKEN]
  end
end

pub func name_set_token(n: word, token: byte)
  with NAMES do
    names[n + N_TOKEN] = token
  end
end

; Forget every name made since name_top was `mark`. None may still have a symbol.
pub func names_release(mark: word)
  var bucket: byte
  var n: word
  with NAMES do
    for bucket = 0 until NAME_BUCKETS do
      n = name_bucket[bucket]
      while n >= mark do                ; the newest names are first in each bucket
        n = name_word(n + N_LINK)
      end
      name_bucket[bucket] = n
    end
  end
  name_top = mark
end

; (path_add_name() and put_name(), with the text memory and the streams in the Python.)
pub func path_add_name(name: word)
  var i: byte
  var q: ^byte
  with NAMES do
    q = @names + name
    for i = 0 until q[N_LENGTH] do
      path_add(q[N_TEXT + i])
    end
  end
end

; Write a name as a string: its length, then its characters.
pub func put_name(s: byte, name: word)
  var i: byte
  var q: ^byte
  with NAMES do
    q = @names + name
    put(s, q[N_LENGTH])
    for i = 0 until q[N_LENGTH] do
      put(s, q[N_TEXT + i])
    end
  end
end

; ---- The symbol table --------------------------------------------------------------------
;
; Symbols with the same name are chained from the name, newest first, so a name leads
; straight to its symbols and the table needs no hash of its own. The chains are short:
; one symbol per module that has the name, and the local that hides it.

#if SMALL
pub const MAX_SYMS = 264        ; (SMALL: the test programs' small build; above 256, which
const MAX_MEMBERS = 264         ; a word index needs)
#else
pub const MAX_SYMS = 560
const MAX_MEMBERS = 432
#end
pub const MAX_MODULES = 16      ; the module being compiled and those it imports

pub const SCOPE_MODULE = 0      ; the module being compiled; 1 and up are imported modules
pub const SCOPE_FIELDS = $40      ; plus a record type's number: the scope of that record's fields
pub const SCOPE_PREDECLARED = $FE   ; what the language itself declares
pub const SCOPE_LOCAL = $FF     ; the function being compiled

pub const K_MODULE = 1          ; value: the module's number
pub const K_FUNC = 2            ; members: parameters, then results; value: address if extern
pub const K_CONST = 3           ; type and value
pub const K_VAR = 4             ; a variable that lives for the whole program; value: address if SF_AT
pub const K_LOCAL = 5           ; a parameter or local of the function being compiled; value: its slot
pub const K_BUILTIN = 6         ; a function the language declares; value: which one
pub const K_TYPE = 7            ; a named type: type; a function type's also has members, as K_FUNC
pub const K_FIELD = 8           ; a field of a record: type, and value: its offset in the record

pub const SF_PUB = 1            ; exported
pub const SF_EXTERN = 2         ; a routine at a fixed address, parameters and results in registers
pub const SF_FORWARD = 4        ; a function declared `forward` whose body has not come yet
pub const SF_AT = 8             ; a variable at a fixed address
pub const SF_ZP = 16            ; a variable declared `zp`
pub const SF_NOZP = 32          ; a variable declared `nozp`
pub const SF_ASM = 64           ; an `asm` function: parameters and results in registers, no slots
pub const SF_ROWS = 128         ; a variable declared `rows` (while its declaration is read)
pub const SF_RECURSIVE = 128    ; a function declared `recursive` (the bit SF_ROWS has on a variable)
pub const SF_IN = 2             ; a variable or constant table `in REGION` (provisional, 2026-11-14):
                                ; its value is the region's name (the bit SF_EXTERN has on a function)
pub const SF_HIDDEN = 4         ; an imported symbol the importer's list does not name: only the
                                ; bodies of inline functions use it (the bit SF_FORWARD has,
                                ; which no imported symbol has)
pub const SF_LIST = 4           ; a module's symbol: its `import` has a list (the same bit)

; A symbol's columns: the byte columns one after another in sym_bytes, the word columns in
; sym_words, each MAX_SYMS rows; byte_of(), word_of(), set_byte() and set_word() reach them by
; number (C_*) for the other modules.
pub const C_SCOPE = 0           ; the byte columns
pub const C_KIND = 1
pub const C_FLAGS = 2
pub const C_TYPE = 3            ; a type number: typetab has MAX_TYPES = 64
pub const C_WEIGHT = 4          ; a variable: how much it gains from zero page (docs/codegen.md)
pub const C_PARAMS = 5          ; how many members are parameters
pub const C_RESULTS = 6         ; how many more are results
const BYTE_COLUMNS = 7
pub const C_NAME = 0            ; the word columns
pub const C_VALUE = 1
pub const C_OBJ = 2             ; its number in the object file, NO_OBJ until it is used there
pub const C_MEMBERS = 3         ; the first of its members
pub const C_LINK = 4            ; the next older symbol with the same name
const WORD_COLUMNS = 5
const SCOPE_AT = C_SCOPE * MAX_SYMS ; where each column starts
const KIND_AT = C_KIND * MAX_SYMS
const FLAGS_AT = C_FLAGS * MAX_SYMS
const TYPE_AT = C_TYPE * MAX_SYMS
const WEIGHT_AT = C_WEIGHT * MAX_SYMS
const PARAMS_AT = C_PARAMS * MAX_SYMS
const RESULTS_AT = C_RESULTS * MAX_SYMS
const NAME_AT = C_NAME * MAX_SYMS
const VALUE_AT = C_VALUE * MAX_SYMS
const OBJ_AT = C_OBJ * MAX_SYMS
const MEMBERS_AT = C_MEMBERS * MAX_SYMS
const LINK_AT = C_LINK * MAX_SYMS
const SYM_BYTE_SIZE = BYTE_COLUMNS * MAX_SYMS
const SYM_WORD_SIZE = WORD_COLUMNS * MAX_SYMS

var sym_bytes: [SYM_BYTE_SIZE]byte nozp in SYMS
var sym_words: [SYM_WORD_SIZE]word rows in SYMS
var byte_base: [BYTE_COLUMNS]word   ; where each byte column starts in sym_bytes (init())
var word_base: [WORD_COLUMNS]word
pub var sym_count: word
pub var thaw_top: word = MAX_SYMS   ; the lowest thawed symbol: they lie from here to MAX_SYMS - 1
pub var local_base: word        ; the first symbol of the function being compiled
pub var local_names: word       ; name_top when that function began

var member_type: [MAX_MEMBERS]byte nozp in SYMS
var member_value: [MAX_MEMBERS]byte nozp in SYMS    ; a parameter's or result's register
pub var member_count: word

pub var module_name: [MAX_MODULES]word
pub var module_count: byte

var module_frozen: [MAX_MODULES]word    ; each module's first frozen entry, or 0

forward func thaw(scope: byte, f: word, oldest: word): word

; ---- The columns, for the other modules --------------------------------------------------
;
; Other modules read and write the columns of a symbol and of a member only through these
; functions: the columns are in the region SYMS (lathe/docs/architecture.md, "What stays in
; memory"), used only inside blocks of kernel's.

; Byte column `column` (C_SCOPE to C_RESULTS) of symbol `s`.
pub func byte_of(s: word, column: byte): byte
  with SYMS do
    return sym_bytes[byte_base[column] + s]
  end
end

; Word column `column` (C_NAME to C_LINK) of symbol `s`.
pub func word_of(s: word, column: byte): word
  with SYMS do
    return sym_words[word_base[column] + s]
  end
end

pub func set_byte(s: word, column: byte, value: byte)
  with SYMS do
    sym_bytes[byte_base[column] + s] = value
  end
end

pub func set_word(s: word, column: byte, value: word)
  with SYMS do
    sym_words[word_base[column] + s] = value
  end
end

; Member `m`'s type.
pub func member_type_of(m: word): byte
  with SYMS do
    return member_type[m]
  end
end

; Member `m`'s register.
pub func member_value_of(m: word): byte
  with SYMS do
    return member_value[m]
  end
end

; The symbol of `scope` on the chain that starts at symbol `s`, or NO_SYM.
func chain_walk(scope: byte, s: word): word
  with SYMS do
    while s != NO_SYM and sym_bytes[SCOPE_AT + s] != scope do
      s = sym_words[LINK_AT + s]
    end
  end
  return s
end

; The symbol of `scope` on the chain of the name entry `q` points to, or NO_SYM. `q` points
; into NAMES: called only inside a block of it.
func chain_find(scope: byte, q: ^byte): word
  return chain_walk(scope, word(q[N_SYMBOL]) | (word(q[N_SYMBOL + 1]) << 8))
end

; The hash name_add() gives the spelling of the entry `q` points to (into NAMES: called only
; inside a block of it).
func spelling_hash(q: ^byte): byte
  var h: byte = 0
  var i: byte
  for i = 0 until q[N_LENGTH] do
    h = ((h << 1) | (h >> 7)) ^ q[N_TEXT + i]
  end
  return h
end

; True if the name entries `p` and `q` point to spell the same name (into NAMES: called only
; inside a block of it).
func same_spelling(p: ^byte, q: ^byte): bool
  var i: byte
  if p[N_LENGTH] != q[N_LENGTH] then
    return false
  end
  for i = 0 until p[N_LENGTH] do
    if p[N_TEXT + i] != q[N_TEXT + i] then
      return false
    end
  end
  return true
end

; The symbol called `name` in exactly this scope, and whether there is one. A frozen
; symbol of an imported module is thawed: from then on it is a symbol like another.
pub func sym_find(scope: byte, name: word): word, bool
  var s: word
  var n: word
  var before: word = 0
  var f: word
  var q: ^byte
  var oldest: word
  with NAMES do
    q = @names + name
    s = chain_find(scope, q)
    if s != NO_SYM or scope == SCOPE_MODULE or scope >= SCOPE_FIELDS then
      return s, s != NO_SYM
    end
    ; Thawed already, on the chain of another entry with the same spelling (thaw())?
    oldest = name
    n = name_bucket[spelling_hash(q) & (NAME_BUCKETS - 1)]
    while n != 0 do
      if n != name and same_spelling(@names + n, q) then
        s = chain_find(scope, @names + n)
        if s != NO_SYM then
          return s, true
        end
        if n < oldest then
          oldest = n
        end
      end
      n = name_word(n + N_LINK)
    end
    f = module_frozen[scope]
    while f != 0 and not same_spelling(@names + f, q) do
      before = f
      f = name_word(f + N_LINK)
    end
    if f == 0 then
      return NO_SYM, false
    end
    if before == 0 then
      module_frozen[scope] = name_word(f + N_LINK)
    else
      name_set_word(before + N_LINK, name_word(f + N_LINK))
    end
  end
  return thaw(scope, f, oldest), true
end

; The symbol `name` of the module that module symbol `m` stands for, and whether there is one:
; what `m.name` means. Through an `import` with a list (SF_LIST), only what the list names can be
; named (error 101): not what the bodies of inline functions alone need.
pub func module_find(m: word, name: word): word, bool
  var s: word
  var found: bool
  var listed: bool
  listed = byte_of(m, C_FLAGS) & SF_LIST != 0
  s, found = sym_find(byte(word_of(m, C_VALUE)), name)
  if listed and (not found or byte_of(s, C_FLAGS) & SF_HIDDEN != 0) then
    err.fatal(err.E_NOT_LISTED)
  end
  return s, found
end

; The newest symbol called `name`, or NO_SYM: the first on its chain (sym_link).
pub func name_symbol(name: word): word
  with NAMES do
    return name_word(name + N_SYMBOL)
  end
end

; Make `s` the first symbol on the chain of `name`.
func name_set_symbol(name: word, s: word)
  with NAMES do
    name_set_word(name + N_SYMBOL, s)
  end
end

; What a plain `name` means here: a local, else a module-level symbol, else a predeclared
; one. Symbols of imported modules are skipped: those are written module.name.
pub func sym_lookup(name: word): word, bool
  var s: word
  var scope: byte
  s = name_symbol(name)
  while s != NO_SYM do
    scope = byte_of(s, C_SCOPE)
    if scope == SCOPE_LOCAL or scope == SCOPE_MODULE or scope == SCOPE_PREDECLARED then
      break
    end
    s = word_of(s, C_LINK)
  end
  return s, s != NO_SYM
end

; Declare `name` in `scope`. The other columns start empty.
func sym_new(s: word, scope: byte, name: word, kind: byte)
  var c: byte
  set_word(s, C_LINK, name_symbol(name))
  name_set_symbol(name, s)
  set_word(s, C_NAME, name)
  set_byte(s, C_SCOPE, scope)
  set_byte(s, C_KIND, kind)
  for c = C_FLAGS until BYTE_COLUMNS do
    set_byte(s, c, 0)
  end
  set_word(s, C_VALUE, 0)
  set_word(s, C_OBJ, NO_OBJ)
  set_word(s, C_MEMBERS, member_count)
end

pub func sym_add(scope: byte, name: word, kind: byte): word
  var s: word
  var found: bool
  s, found = sym_find(scope, name)
  if found then
    err.fatal(err.E_DUPLICATE)
  end
  if sym_count == thaw_top then
    err.fatal(err.E_SYMS_FULL)
  end
  sym_count += 1
  sym_new(sym_count - 1, scope, name, kind)
  return sym_count - 1
end

; A function begins: symbols and names made from now on are its own.
pub func scope_begin()
  local_base = sym_count
  local_names = name_top
end

; The function ends: release its symbols and the names only it used.
; Release the symbols from `base` up. Their names stay.
pub func sym_release(base: word)
  while sym_count > base do
    sym_count -= 1
    ; Symbols are released newest first, so each is the first on its name's chain.
    name_set_symbol(word_of(sym_count, C_NAME), word_of(sym_count, C_LINK))
  end
end

; The function ends: release its symbols and the names only it used.
pub func scope_end()
  sym_release(local_base)
  names_release(local_names)
end

; Add a member to the newest symbol. Returns the member's number.
pub func member_add(t: byte, value: byte): word
  if member_count == MAX_MEMBERS then
    err.fatal(err.E_MEMBERS_FULL)
  end
  with SYMS do
    member_type[member_count] = t
    member_value[member_count] = value
  end
  member_count += 1
  return member_count - 1
end

; ---- Frozen symbols ----------------------------------------------------------------------
;
; What an imported module exports, but for its types and its inline functions, is not entered
; in the symbol table when the interface is read: each function, constant and variable is a
; frozen entry in the name heap, on a list of its module's (module_frozen). An entry has the
; form of a name entry that is not yet in its hash bucket: its link is the next entry of the
; list, and where a name has its symbol and its token the entry has the symbol's kind, flags
; and type. After the name's characters come its value (2), and for a function its parameters,
; its results and for each member its type and its register. sym_find() thaws an entry when the
; importer first names it: the entry becomes the symbol's name, in its bucket.

const F_KIND = 2                ; from the start of the entry
const F_FLAGS = 3
const F_TYPE = 4
const F_VALUE = 0               ; from the end of the name's characters
const F_SIZE = 2                ; what a constant or a variable has there
const F_PARAMS = 2              ; a function's
const F_RESULTS = 3
const F_MEMBERS = 4             ; the size of what a function has there before its members

; The symbol of `scope` whose name spells the name being built (name_begin(), name_add()), or
; NO_SYM. A frozen entry is not looked at, and nothing is thawed.
pub func built_symbol(scope: byte): word
  var n: word
  var s: word
  var q: ^byte
  with NAMES do
    q = @names + name_top
    n = name_bucket[new_hash & (NAME_BUCKETS - 1)]
    while n != 0 do
      if not name_is_new(@names + n, q) then
        s = chain_find(scope, @names + n)
        if s != NO_SYM then
          return s
        end
      end
      n = name_word(n + N_LINK)
    end
  end
  return NO_SYM
end

; The frozen entry of imported module `scope` that spells the name being built, or 0.
pub func built_frozen(scope: byte): word
  var n: word
  var q: ^byte
  with NAMES do
    q = @names + name_top
    n = module_frozen[scope]
    while n != 0 and name_is_new(@names + n, q) do
      n = name_word(n + N_LINK)
    end
  end
  return n
end

; True if name entry `n` spells the name being built.
pub func built_is(n: word): bool
  with NAMES do
    return not name_is_new(@names + n, @names + name_top)
  end
end

; The hash of name entry `n`'s spelling, as new_hash is of the name being built.
pub func name_hash(n: word): byte
  with NAMES do
    return spelling_hash(@names + n)
  end
end

; True if imported module `scope` has a symbol or a frozen entry that spells the name being
; built. If `show`, the importer can name it from now on (SF_HIDDEN is cleared).
pub func built_loaded(scope: byte, show: bool): bool
  var s: word
  var f: word
  s = built_symbol(scope)
  if s != NO_SYM then
    if show then
      set_byte(s, C_FLAGS, byte_of(s, C_FLAGS) & ~SF_HIDDEN)
    end
    return true
  end
  f = built_frozen(scope)
  if f == 0 then
    return false
  end
  if show then
    with NAMES do
      names[f + F_FLAGS] = names[f + F_FLAGS] & ~SF_HIDDEN
    end
  end
  return true
end

; Declare `name` in imported module `scope` as a thawed symbol, numbered from the top of the
; table: an entry an import list names, whose name the list has made already, is made a symbol
; at once instead of a frozen entry. The other columns start empty. A name the module already
; has is error 41.
pub func sym_thawed(scope: byte, name: word, kind: byte): word
  var s: word
  var found: bool
  s, found = sym_find(scope, name)
  if found then
    err.fatal(err.E_DUPLICATE)
  end
  if thaw_top == sym_count then
    err.fatal(err.E_SYMS_FULL)
  end
  thaw_top -= 1
  sym_new(thaw_top, scope, name, kind)
  return thaw_top
end

; Make the name being built (name_begin(), name_add()) a frozen symbol of imported module
; `scope` with these columns. Its members follow, with freeze_member(). A name the module
; already has is error 41, as sym_add() would give.
pub func freeze(scope: byte, kind: byte, flags: byte, t: byte, value: word, params: byte,
    results: byte)
  var n: word
  var q: ^byte
  var r: ^byte
  var size: word = F_SIZE
  if kind == K_FUNC then
    size = F_MEMBERS + 2 * (word(params) + results)
  end
  if name_top + N_TEXT + new_length + size > NAME_HEAP_SIZE then
    err.fatal(err.E_NAMES_FULL)
  end
  if built_symbol(scope) != NO_SYM or built_frozen(scope) != 0 then
    err.fatal(err.E_DUPLICATE)
  end
  with NAMES do
    q = @names + name_top
    n = name_top
    q[N_LINK] = lo(module_frozen[scope])
    q[N_LINK + 1] = hi(module_frozen[scope])
    q[F_KIND] = kind
    q[F_FLAGS] = flags
    q[F_TYPE] = t
    q[N_LENGTH] = new_length
    module_frozen[scope] = n
    r = q + N_TEXT + new_length
    r[F_VALUE] = lo(value)
    r[F_VALUE + 1] = hi(value)
    name_top = n + N_TEXT + new_length + F_SIZE
    if kind == K_FUNC then
      r[F_PARAMS] = params
      r[F_RESULTS] = results
      name_top = n + N_TEXT + new_length + F_MEMBERS
    end
  end
end

; The next member of the newest frozen symbol.
pub func freeze_member(t: byte, value: byte)
  with NAMES do
    names[name_top] = t
    names[name_top + 1] = value
  end
  name_top += 2
end

; Make frozen entry `f`, taken off its module's list, a symbol of `scope`, numbered from
; the top of the table. `oldest` is the oldest name of its spelling (sym_find()). If that is
; older than the entry (made before the import was read: by an import list, an interface read
; before, or the module itself), it stays the name and the symbol goes on its chain: the entry
; put in its bucket would be ahead of it, and the lexer would give the entry for the spelling.
; Otherwise the entry becomes the name, in its bucket, in its place by age, so that
; names_release() still finds the newest names first.
func thaw(scope: byte, f: word, oldest: word): word
  var s: word
  var name: word
  var q: ^byte
  var r: ^byte
  var i: byte
  var bucket: byte
  var n: word
  var kind: byte
  var flags: byte
  var t: byte
  var value: word
  var params: byte = 0
  var results: byte = 0
  if thaw_top == sym_count then
    err.fatal(err.E_SYMS_FULL)
  end
  thaw_top -= 1
  s = thaw_top
  with NAMES do
    q = @names + f
    r = q + N_TEXT + q[N_LENGTH]
    kind = q[F_KIND]                    ; read before the entry is made a name
    flags = q[F_FLAGS]
    t = q[F_TYPE]
    value = word(r[F_VALUE]) | (word(r[F_VALUE + 1]) << 8)
    if kind == K_FUNC then
      params = r[F_PARAMS]
      results = r[F_RESULTS]
    end
    name = oldest
    if oldest > f then
      name = f
      q[N_SYMBOL] = lo(NO_SYM)
      q[N_SYMBOL + 1] = hi(NO_SYM)
      q[N_TOKEN] = 0
    end
  end
  sym_new(s, scope, name, kind)
  set_byte(s, C_FLAGS, flags)
  set_byte(s, C_TYPE, t)
  set_word(s, C_VALUE, value)
  set_byte(s, C_PARAMS, params)
  set_byte(s, C_RESULTS, results)
  with NAMES do
    q = @names + f
    r = q + N_TEXT + q[N_LENGTH] + F_MEMBERS
    for i = 0 until params + results do
      member_add(r[0], r[1])            ; its block of SYMS comes after r is read
      r += 2
    end
    if oldest < f then
      return s
    end
    bucket = spelling_hash(q) & (NAME_BUCKETS - 1)
    n = name_bucket[bucket]
    if n < f then
      name_set_word(f + N_LINK, n)
      name_bucket[bucket] = f
      return s
    end
    while name_word(n + N_LINK) > f do
      n = name_word(n + N_LINK)
    end
    name_set_word(f + N_LINK, name_word(n + N_LINK))
    name_set_word(n + N_LINK, f)
  end
  return s
end

; Give the next module number to the module called `name`.
pub func module_add(name: word): byte
  if module_count == MAX_MODULES then
    err.fatal(err.E_MODULES_FULL)
  end
  module_name[module_count] = name
  module_count += 1
  return module_count - 1
end

pub func init()
  var s: byte
  var bucket: byte
  text_top = @text
  path = text_reserve(PATH_SIZE)
  for s = 0 until MAX_STREAMS do
    stream_kind[s] = STREAM_FREE
  end
  for bucket = 0 until NAME_BUCKETS do
    name_bucket[bucket] = 0
  end
  name_top = 1
  sym_count = 0
  thaw_top = MAX_SYMS
  local_base = 0
  local_names = name_top
  for s = 0 until MAX_MODULES do
    module_frozen[s] = 0
  end
  member_count = 0
  module_count = 0
  byte_base[C_SCOPE] = SCOPE_AT
  byte_base[C_KIND] = KIND_AT
  byte_base[C_FLAGS] = FLAGS_AT
  byte_base[C_TYPE] = TYPE_AT
  byte_base[C_WEIGHT] = WEIGHT_AT
  byte_base[C_PARAMS] = PARAMS_AT
  byte_base[C_RESULTS] = RESULTS_AT
  word_base[C_NAME] = NAME_AT
  word_base[C_VALUE] = VALUE_AT
  word_base[C_OBJ] = OBJ_AT
  word_base[C_MEMBERS] = MEMBERS_AT
  word_base[C_LINK] = LINK_AT
end
