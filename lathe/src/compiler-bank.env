; The compiler banked on Wendy 2, run with `--disk DIR` (lathe/env/wendy2disk.env), and its test
; programs, at the compiler's full capacities (SMALL 0): code in banks 1, 2, 3 and 5, the big
; tables in the data banks 4 and 6, everything else fixed in $0200-$7FFF and $F810-$FFF9.
; src_support.build_program(..., banked=True) builds with it and runs on the wendy2disk board
; (lathe/host/README.md, "The banked build"); lathe/docs/configurations.md, "Measured on the
; compiler's test programs", has the numbers and the reasons.
;
; Fixed: err, kernel, src, lex, typetab, fbuf, sys and the run-time modules (disk, rt_bank,
; rt_math, rt_frame). Bank 1, the front end: lathec and expr, and for the test programs the
; drivers, script, listing, regcmd and the test's main module, which stand where the front end
; stands: above code generation, calling down into it and into fixed memory, called by nothing
; below. The harness adds the main module's `place` line, and drops those of modules a program
; does not link (an unlinked placed module is link error 44). Bank 2, code generation: gen and
; reg. Bank 3: cond (with cond, bank 2 is judged over 28 KB: the linker judges a bank as
; written, before zero page shrinks it), asmblock, inlines and fold (fixed memory has no room
; for fold beside the full tables). Bank 5: decl and out, because the whole compiler does not
; fit banks 1 to 3 (configurations.md, "The compiler itself, banked").
;
; Data: kernel's name heap alone in bank 4, a bank of variables only (no file), with room for
; the heap to grow to 28 KB; bank 6 holds err's messages (constants: its file, loaded at
; start-up), fbuf's buffer and label tables, lex's string and kernel's token memory (INLINE's
; saved tokens). Each is used only inside `with REGION do ... end` in fixed functions.
;
; The fixed code ends at $7FFF and starts where the variables end; the split is set by exprtest
; and lathec, the largest, which link lex and src as well (lathe/host/README.md, "The banked
; build").
cpu       65c02
zeropage  $00 $FF
code      $4280 $7FFF
data      $0200 $427F
more      data $F810 $FFF9
stack     $FF
exit      stop
output    raw
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 1 $11 LATHE1.BIN
bank      WIN 2 $12 LATHE2.BIN
bank      WIN 3 $13 LATHE3.BIN
bank      WIN 4 $14              ; data only: the name heap
bank      WIN 5 $15 LATHE5.BIN
bank      WIN 6 $16 LATHE6.BIN   ; data: err's messages (constants, loaded at start-up) and tables
place     script WIN 1
place     listing WIN 1
place     regcmd WIN 1
place     decl WIN 5
place     expr WIN 1
place     inlines WIN 3  ; bank 1 holds expr, and decl and lathec when they come
place     gen WIN 2
place     reg WIN 2
place     typetab WIN 2  ; fixed memory has no room for it in exprtest at full capacities
place     slotview WIN 2 ; regcmd's reader of REG's slot columns: they stay in bank 2
place     cond WIN 3     ; placement E: D does not fit (above)
place     asmblock WIN 3
place     fold WIN 3     ; fixed memory has no room for it at full capacities (above)
place     out WIN 5
region    NAMES WIN 4            ; kernel.names
region    MSGS WIN 6             ; err's messages
region    FUNCBUF WIN 6          ; fbuf.buffer, label_offset, label_uses
region    STRING WIN 6           ; lex.string
region    TOKENS WIN 6           ; kernel.tokens: INLINE's saved tokens
farcall   rt_bank
define    BOARD 2
define    DISK 1
define    PORTS 1     ; sys over the file ports (lathe/rt/disk.lth)
define    SMALL 0     ; the tables at full size
