; PARTS: the pieces of EXPR and STMT that parse no expression and call nothing of theirs that
; does. lathe/host/parts.py in Lathe.
;
; Type keywords, names and fields, the operators of each level of precedence and the operands
; they combine, a string as a value, the code of a `for` loop's variable and step, and the code
; of `with` blocks. They are a module of their own, below EXPR (lathe/src/expr.lth), so that
; EXPR's code fits a bank of the BBC (16,300 bytes, lathe/docs/configurations.md, "The symbol
; table in a region"). EXPR and STMT stay one module: they call each other, and Lathe forbids
; import cycles. What is here reaches no cycle of their calls, so it can be below them.
;
; Where the Lathe differs from the Python: as in lathe/src/expr.lth, whose functions these were.
module parts

import err (E_DOT_EXPECTED, E_DUPLICATE, E_ELEMENT_SIZE, E_IN_HERE, E_NAME_EXPECTED, E_NEEDS_ROWS,
            E_NO_FIELD, E_NOT_VAR, E_RECORD_INIT, E_ROWS_RECORD, E_TYPE, E_UNDEFINED, E_USAGE,
            fatal, fatal_value, Place, position, position_at)
import fbuf (FIX_ADDRESS, newest, NO_SLOT, op, op_fix, OP_JSR, unreached)
import fold (ADD, BAND, BOR, BXOR, DIV, EQ, GE, GT, LE, LT, MUL, NE, REM, SHL, SHR, SUB)
import gen (anonymous, binary, compare, field, fixed_name, jump_false, local, OP_BNE, record_of,
            settle, step, test_left, test_right, variable)
import inlines (copies_due, copy_aliases, lookup)
import kernel (C_FLAGS, C_OBJ, C_TYPE, C_VALUE, flags_of, K_CONST, K_LOCAL, K_MODULE, K_VAR,
               kind_of, module_find, module_name, NO_OBJ, SCOPE_FIELDS, set_byte, set_word, SF_AT,
               SF_IN, SF_NOZP, SF_PUB, SF_ZP, sym_add, sym_count, sym_find, type_of, value_of,
               word_of)
import lex (col, expect, line, next, string_byte, string_length, T_AMP, T_BAR, T_BOOL, T_BYTE,
            T_CARET, T_DOT, T_EQ, T_GE, T_GT, T_INT, T_LE, T_LT, T_MINUS, T_MOD, T_NAME, T_NE,
            T_PLUS, T_SBYTE, T_SHL, T_SHR, T_SLASH, T_STAR, T_WORD, tok, value)
import out (call, data, data_byte, imported, NO_OUTER, SYM_FUNCTION, SYM_VARIABLE, symbol)
import reg (branch, CLASS_EITHER, CLASS_NOT_ZP, CLASS_ZP, clobber, depth, duplicate, flags, forget,
            jump, modify, NO_REG, NONE, O_ADDR, O_CONST, OP_INC, op_kind, op_symbol, op_type,
            op_value, own, pop, push, same_region, temp, use_slot)
import typetab (base, BOOL_TYPE, BYTE_TYPE, innermost, INT_TYPE, is_array, is_number, is_record,
                is_rows, is_signed, length, NO_TYPE, pointer_to, SBYTE_TYPE, size, WORD_TYPE)

pub var with_entry: word = reg.NONE ; map_bank(): the buffer entry of its LDA #bank, whose symbol comes later
const FARCALL_MODULE = "rt_with"    ; the far-call module, as the linker resolves it (configurations.md)
const MAP_NAME = "map"              ; map(value: byte in a): byte in a, the old value
const UNMAP_NAME = "unmap"          ; unmap(value: byte in y), which keeps A, X, Y and the flags
var map_symbol: word = kernel.NO_OBJ    ; their object-file symbols, once used
var unmap_symbol: word = kernel.NO_OBJ
const FIX_BANK = 6                  ; fix-up kind 6: the register value of a symbol's region
const OP_LDA_IMMEDIATE = $A9
const OP_STA = $8D
const OP_LDY = $AC
const OP_PHP = $08
const OP_PLP = $28
const MAX_FIXED = 8                 ; regions the command line can say are in fixed memory (-fREGION)
var fixed: [MAX_FIXED]word          ; their names
var fixed_count: byte = 0

; The current token must be a name: if not, that is error E_NAME_EXPECTED.
pub func need_name()
  if lex.tok != lex.T_NAME then
    err.fatal(err.E_NAME_EXPECTED)
  end
end

pub func init()
  map_symbol = kernel.NO_OBJ
  unmap_symbol = kernel.NO_OBJ
  fixed_count = 0
end

; True if the command line said region `region` (a name) is in fixed memory.
pub func is_fixed(region: word): bool
  var i: byte
  for i = 0 until fixed_count do
    if reg.same_region(fixed[i], region) then
      return true
    end
  end
  return false
end

; -fREGION: the region `name` is in fixed memory (the environment says `region NAME fixed`), so a
; `with` block of it maps nothing: it is its body alone (expr.with_statement). A name given twice
; counts once; more than MAX_FIXED regions is the usage error.
pub func fix_region(name: word)
  if is_fixed(name) then
    return
  end
  if fixed_count == MAX_FIXED then
    err.fatal(err.E_USAGE)
  end
  fixed[fixed_count] = name
  fixed_count += 1
end

; The type a type keyword names, or typetab.NO_TYPE.
pub func basic_type(token: byte): byte
  if token == lex.T_BYTE then
    return typetab.BYTE_TYPE
  end
  if token == lex.T_SBYTE then
    return typetab.SBYTE_TYPE
  end
  if token == lex.T_WORD then
    return typetab.WORD_TYPE
  end
  if token == lex.T_INT then
    return typetab.INT_TYPE
  end
  if token == lex.T_BOOL then
    return typetab.BOOL_TYPE
  end
  return typetab.NO_TYPE
end

; name [ "." name ]: the symbol a name means here, or module.name means in that module, which
; must export it (a type that it does not export is in its interface all the same).
pub func named_symbol(): word
  var s: word
  var found: bool
  var m: word
  need_name()
  s, found = inlines.lookup(lex.value)
  if not found then
    err.fatal(err.E_UNDEFINED)
  end
  lex.next()
  if kernel.kind_of(s) == kernel.K_MODULE then
    m = s
    lex.expect(lex.T_DOT, err.E_DOT_EXPECTED)
    need_name()
    s, found = kernel.module_find(m, lex.value)
    if not found or kernel.flags_of(s) & kernel.SF_PUB == 0 then
      err.fatal(err.E_UNDEFINED)
    end
    lex.next()
  end
  return s
end

; The name after the "." at `place`: a field of the record that the newest operand is or
; points to.
pub func field(place: ^err.Place)
  var t: byte
  var f: word
  var found: bool
  need_name()
  err.position_at(place)
  t = gen.record_of()
  err.position(lex.line, lex.col)
  f, found = kernel.sym_find(kernel.SCOPE_FIELDS + t, lex.value)
  if not found then
    err.fatal(err.E_NO_FIELD)
  end
  gen.field(kernel.value_of(f), kernel.type_of(f))
  lex.next()
end

; The string LEX has just read, used as a value: a `^byte` to constant data that holds it, with
; a zero after it. (Here and not in GEN, which then need not import LEX: its names would take
; 2 KB of GEN's name heap.)
pub func string()
  var symbol: word
  var i: word
  gen.settle()
  symbol = gen.anonymous()
  out.data(symbol, lex.string_length + 1)
  for i = 0 until lex.string_length do
    out.data_byte(lex.string_byte(i))
  end
  out.data_byte(0)
  reg.push(reg.O_ADDR, typetab.pointer_to(typetab.BYTE_TYPE), 0)
  reg.op_symbol[reg.depth - 1] = symbol
end

; The operator a token of the `*` level stands for, or 0.
pub func term_operator(token: byte): byte
  if token == lex.T_STAR then
    return fold.MUL
  end
  if token == lex.T_SLASH then
    return fold.DIV
  end
  if token == lex.T_MOD then
    return fold.REM
  end
  if token == lex.T_AMP then
    return fold.BAND
  end
  if token == lex.T_SHL then
    return fold.SHL
  end
  if token == lex.T_SHR then
    return fold.SHR
  end
  return 0
end

; The operator a token of the `+` level stands for, or 0.
pub func sum_operator(token: byte): byte
  if token == lex.T_PLUS then
    return fold.ADD
  end
  if token == lex.T_MINUS then
    return fold.SUB
  end
  if token == lex.T_BAR then
    return fold.BOR
  end
  if token == lex.T_CARET then
    return fold.BXOR
  end
  return 0
end

; The comparison a token stands for, or 0.
pub func relation_operator(token: byte): byte
  if token == lex.T_EQ then
    return fold.EQ
  end
  if token == lex.T_NE then
    return fold.NE
  end
  if token == lex.T_LT then
    return fold.LT
  end
  if token == lex.T_GE then
    return fold.GE
  end
  if token == lex.T_GT then
    return fold.GT
  end
  if token == lex.T_LE then
    return fold.LE
  end
  return 0
end

; Do the operator `op`, which was at `place`, on the two newest operands. Operands of the
; wrong type are reported there.
pub func apply(op: byte, place: ^err.Place)
  err.position_at(place)
  if op >= fold.EQ then
    gen.compare(op)
  else
    gen.binary(op)
  end
  err.position(lex.line, lex.col)
end

; One side of the `and` (`wanted` true) or `or` (false) at `place` is complete.
pub func test_operator(wanted: bool, place: ^err.Place, is_left: bool)
  err.position_at(place)
  if is_left then
    if inlines.copies_due() then
      ; The right side may not be run, so a call in it must not be what copies an argument
      ; waiting for a register, or a variable an inline parameter stands for, to its
      ; temporary: they are copied now, on both ways, keeping the flags, which hold the left
      ; side's test.
      fbuf.op(OP_PHP)
      inlines.copy_aliases()
      fbuf.op(OP_PLP)
      reg.flags = reg.NO_REG
    end
    gen.test_left(wanted)
  else
    gen.test_right()
  end
  err.position(lex.line, lex.col)
end

; Push variable `s`: a local, or one that lives for the whole program.
pub func push_variable(s: word)
  if kernel.kind_of(s) == kernel.K_LOCAL then
    gen.local(kernel.type_of(s), lo(kernel.value_of(s)))
  else
    gen.variable(s)
  end
end

; The name after "for": a variable of a number type. Returns its symbol.
pub func loop_variable(): word
  var s: word
  var found: bool
  need_name()
  s, found = inlines.lookup(lex.value)
  if not found then
    err.fatal(err.E_UNDEFINED)
  end
  if kernel.kind_of(s) != kernel.K_LOCAL and kernel.kind_of(s) != kernel.K_VAR then
    err.fatal(err.E_NOT_VAR)
  end
  if not typetab.is_number(kernel.type_of(s)) then
    err.fatal(err.E_TYPE)
  end
  lex.next()
  return s
end

; Compare the newest operand, the loop variable or its first value, with the limit, operand
; `limit`. Returns the label gone to when the comparison is false.
pub func compare_limit(limit: byte, op: byte): word
  reg.duplicate(limit)
  gen.compare(op)
  return gen.jump_false()
end

; INC or DEC loop variable `s` and go back to `top`. A BNE goes back where the step cannot give
; 0: counting up without a sign, or a byte counting down to a constant from 1 to 127
; (docs/codegen.md, "Statements").
pub func step_back(s: word, down: bool, limit: byte, top: byte)
  var i: byte
  var size: byte
  var back: bool
  push_variable(s)
  i = reg.depth - 1
  size = lo(typetab.size(reg.op_type[i]))
  back = not down and not typetab.is_signed(reg.op_type[i])
  if down then
    back = size == 1 and reg.op_kind[limit] == reg.O_CONST and reg.op_value[limit] != 0 and
        reg.op_value[limit] < $8000
    gen.step(fold.SUB, size, i)
  else
    reg.modify(reg.OP_INC, i, 0)
    if size == 2 then
      reg.branch(gen.OP_BNE, top)
      reg.modify(reg.OP_INC, i, 1)
    end
  end
  if back then
    reg.branch(gen.OP_BNE, top)
  else
    reg.jump(top)
  end
  reg.pop()
end

; Leave `count` `critical` blocks: a PLP for each. The flags then show nothing known.
pub func restore_flags(count: byte)
  var n: byte
  for n = 0 until count do
    fbuf.op(OP_PLP)
  end
  reg.flags = reg.NO_REG
end

; The symbols of rt_with.map and rt_with.unmap, and the IMP record of `rt_with`, which the first
; `with` block of the module writes. The linker gives these names to the environment's far-call
; module, or, with none, to the module `rt_with` that maps nothing.
pub func farcall_symbols()
  var module_name: word
  if map_symbol != kernel.NO_OBJ then
    return
  end
  module_name = gen.fixed_name(@FARCALL_MODULE)
  out.imported(module_name)
  map_symbol = out.symbol(out.SYM_FUNCTION, module_name, 0, gen.fixed_name(@MAP_NAME))
  unmap_symbol = out.symbol(out.SYM_FUNCTION, module_name, 0, gen.fixed_name(@UNMAP_NAME))
end

; LDA #bank(REGION) / JSR rt_with.map / STA temporary: the region's bank in the window, and the
; bank it replaces kept. Returns the temporary; with_entry is the buffer entry of the LDA, whose
; fix-up names a symbol of the region once the block has used one (reg.NONE if the code cannot
; be reached).
pub func map_bank(): byte
  var temp: byte
  farcall_symbols()
  reg.clobber()
  fbuf.op_fix(OP_LDA_IMMEDIATE, FIX_BANK, 0, fbuf.NO_SLOT, 0)
  with_entry = reg.NONE
  if not fbuf.unreached then
    with_entry = fbuf.newest
  end
  fbuf.op_fix(fbuf.OP_JSR, fbuf.FIX_ADDRESS, map_symbol, fbuf.NO_SLOT, 0)
  out.call(map_symbol, 0, out.NO_OUTER)
  temp = reg.temp(1)
  fbuf.op_fix(OP_STA, fbuf.FIX_ADDRESS, reg.own, temp, 0)
  reg.use_slot(temp)
  reg.forget()
  return temp
end

; LDY temporary / JSR rt_with.unmap: the bank that was in the window before the block that kept
; it in `temp`. A, X and the carry are kept, so a result can be on its way.
pub func unmap_bank(temp: byte)
  fbuf.op_fix(OP_LDY, fbuf.FIX_ADDRESS, reg.own, temp, 0)
  reg.use_slot(temp)
  fbuf.op_fix(fbuf.OP_JSR, fbuf.FIX_ADDRESS, unmap_symbol, fbuf.NO_SLOT, 0)
  out.call(unmap_symbol, 0, out.NO_OUTER)
  reg.forget()
end

; The object-file symbol of the first variable or table of `region` that this module declares
; (at module level, or `static` in the function being compiled), or NO_OBJ. A block that uses
; nothing of its region names its bank by it: the linker learns a bank only from a variable or
; table of the region, and the module has no symbol of another module's that it has not used.
pub func region_symbol(region: word): word
  var s: word
  for s = 0 until kernel.sym_count do
    if (kernel.kind_of(s) == kernel.K_VAR or kernel.kind_of(s) == kernel.K_CONST) and
        kernel.flags_of(s) & kernel.SF_IN != 0 and kernel.word_of(s, kernel.C_OBJ) != kernel.NO_OBJ and
        reg.same_region(kernel.value_of(s), region) then
      return kernel.word_of(s, kernel.C_OBJ)
    end
  end
  return kernel.NO_OBJ
end

; ---- Declarations ------------------------------------------------------------------------
;
; Names being declared, a variable's placements and its symbol, and the checks of a type's
; layout: what DECL calls of EXPR's, and what EXPR's `variable` calls. Here, apart from EXPR's
; cycle, so that EXPR fits a bank of the BBC as the linker judges it: before zero page shrinks
; its code (lathe/docs/bbc.md, "Step 4").

pub var placed_at: word = 0     ; the address after "at" in the declaration being parsed
pub var placed_region: word = 0 ; the name after "in" in the declaration being parsed
var in_place: err.Place         ; and where the "in" is (the host: in_line and in_col)

; Where the current token is, into `place`.
pub func mark_place(place: ^err.Place)
  place.line = lex.line
  place.col = lex.col
end

; The name being declared, which `scope` must not have yet. It is passed over.
pub func new_name(scope: byte): word
  var name: word
  var s: word
  var found: bool
  need_name()
  name = lex.value
  s, found = kernel.sym_find(scope, name)
  if found then
    err.fatal(err.E_DUPLICATE)
  end
  lex.next()
  return name
end

; "in" name: the region's name. Where the "in" is is kept for an error.
pub func region_name(): word
  var name: word
  mark_place(@in_place)
  lex.next()
  need_name()
  name = lex.value
  lex.next()
  return name
end

; `in REGION` was given where it is not allowed.
pub func not_in_region()
  err.position_at(@in_place)
  err.fatal(err.E_IN_HERE)
end

; The class of a slot or variable declared with these flags.
pub func zp_class(flags: byte): byte
  if flags & kernel.SF_ZP != 0 then
    return reg.CLASS_ZP
  end
  if flags & kernel.SF_NOZP != 0 then
    return reg.CLASS_NOT_ZP
  end
  return reg.CLASS_EITHER
end

; Declare a variable that is not a slot: one that lives for the whole program, which gets its
; object-file symbol now, or one at a fixed address. A `static` variable is the symbol
; `module.function.name`: `outer` is the function's name, 0 for a variable of the module.
pub func lasting_variable(scope: byte, name: word, t: byte, flags: byte, outer: word): word
  var s: word
  s = kernel.sym_add(scope, name, kernel.K_VAR)
  kernel.set_byte(s, kernel.C_TYPE, t)
  kernel.set_byte(s, kernel.C_FLAGS, flags)
  if flags & kernel.SF_AT != 0 then
    kernel.set_word(s, kernel.C_VALUE, placed_at)
  else
    kernel.set_word(s, kernel.C_OBJ, out.symbol(out.SYM_VARIABLE, kernel.module_name[0], outer, name))
  end
  if flags & kernel.SF_IN != 0 then
    kernel.set_word(s, kernel.C_VALUE, placed_region)
  end
  return s
end

; Something of type `t` is given an initial value: it cannot be a record, or an array of them,
; yet.
pub func no_record(t: byte)
  if typetab.is_record(typetab.innermost(t)) then
    err.fatal(err.E_RECORD_INIT)
  end
end

; Check that the elements of array type `t`, and of the arrays it is made of, can be reached:
; one of more than 256 elements larger than a byte must be stored by row, and an element
; stored by row must have a size that is a power of two.
pub func layout(t: byte)
  var size: word
  while typetab.is_array(t) do
    size = typetab.size(byte(typetab.base(t)))
    if typetab.length(t) > 256 and size > 1 and not typetab.is_rows(t) then
      err.fatal(err.E_NEEDS_ROWS)
    end
    if typetab.is_rows(t) and size & (size - 1) != 0 then
      if typetab.is_record(byte(typetab.base(t))) then
        err.fatal_value(err.E_ROWS_RECORD, size)
      end
      err.fatal(err.E_ELEMENT_SIZE)
    end
    t = byte(typetab.base(t))
  end
end
