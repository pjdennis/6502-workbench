; The emulator's default machine for the test programs that do not fit compiler.env at the
; compiler's full capacities: regtest, condtest and gentest. SMALL makes the twins declare
; their big tables small (the name heap, the symbol rows and members, the function buffer,
; the constant table and its fix-ups, the string being read: lathe/host/README.md, "The small
; build"). gentest, the largest, has 42.8 KB of code and constant data and 15.0 KB of
; variables and slots (2026-11-14): 1.4 KB of the code range and 0.7 KB of the data range
; are left.
cpu       6502
zeropage  $00 $FF
code      $0200 $B2FF
data      $B300 $EFFF
stack     $FF
exit      call $F00F
define    SMALL 1
