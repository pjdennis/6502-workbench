; Multiplication and division of words: a stand-in for the run-time library, which does not
; exist yet (the compiler gives error 54 for `*`, `/` and `mod` unless one operand is a constant
; power of two). Where the Python writes `a * b`, `a // b` or `a % b`, lathe/src/ writes
; num.mul(a, b), num.div(a, b) or num.rem(a, b). This module goes once the compiler calls the
; run-time library itself.
module num

; The low 16 bits of a * b.
pub func mul(a: word, b: word): word
  var r: word = 0
  while b != 0 do
    if lo(b) & 1 != 0 then
      r += a
    end
    a <<= 1
    b >>= 1
  end
  return r
end

var remainder: word         ; what the last divide() left

; a // b, leaving a % b in `remainder`. b must not be 0.
func divide(a: word, b: word): word
  var q: word = 0
  var r: word = 0
  var i: byte
  var top: bool
  for i = 1 to 16 do
    top = r >= $8000            ; r * 2 does not fit: it is then certainly at least b
    r = (r << 1) | (a >> 15)
    a <<= 1
    q <<= 1
    if top or r >= b then
      r -= b                    ; wraps back into range when top is set
      q |= 1
    end
  end
  remainder = r
  return q
end

pub func div(a: word, b: word): word
  return divide(a, b)
end

pub func rem(a: word, b: word): word
  var q: word
  q = divide(a, b)
  return remainder
end
