; ---- Interface files ---------------------------------------------------------------------

const LI_VERSION = 2
const LI_END = 0                ; entry kinds
const LI_FUNC = 1
const LI_CONST = 2
const LI_VAR = 3
const LI_TYPE = 4               ; a named type: flags, then its type
const LI_RECORD = 5             ; a record type declared here: flags, number of fields, each a name and a type
const LI_ENUM = 6               ; an enumeration declared here: flags. Its constants follow as constants
const LI_FUNC_TYPE = 7          ; a function type declared here: flags, then parameters and results
const LI_MODULE = 8             ; a module this one imports, which its exported inline functions can name
const LI_CONST_IN = 9           ; a constant table `in REGION`: as LI_CONST, then the region's name
const LI_USES = 10              ; what the body of an exported inline function names: the function's
;                                 name, how many, and each as a module (string, empty for this one)
;                                 and a name
const LI_PUB = 1                ; flag of those four: exported (the others are there for the types of what is)
const LI_EXTERN = 1             ; function flag: at a fixed address, which follows the flags
const LI_RECURSIVE = 2          ; function and function type flag: declared `recursive`
const LI_ASM = 4                ; function flag: an `asm` function, called like an extern one
const LI_INLINE = 8             ; function flag: an `inline` function, whose saved tokens follow its members
const LI_INTERRUPT = 16         ; function flag: an `interrupt` function, which cannot be called
const LI_AT = 1                 ; what a variable's placement byte can be: at a fixed address, which
const LI_ZP = 2                 ; follows it; declared `zp`; declared `nozp`; or 0
const LI_NOZP = 4
const LI_IN = 8                 ; `in REGION` (and so never in zero page): the region's name follows
const LI_POINTER = $10          ; type: a pointer to the type that follows; a basic type is its number
const LI_ARRAY = $11            ; type: an array, stored by column: its length (2), then its element type
const LI_ROWS = $12             ; the same, stored by row
const LI_NAMED = $13            ; type: a record, an enumeration or a function type, as the name of its
;                                 module and its own name

const MAX_DIRS = 8
const C_SLASH = $2F
const C_UPPER_L = $4C
const C_UPPER_I = $49
const ENDING: [3]byte = ".li"

var directory: [MAX_DIRS]^byte  ; pointers to the names of the directories to look in, in order
var directory_count: byte = 0

; The entry being read, until it is frozen (kernel.freeze()): its name, and its members
const MAX_ENTRY_MEMBERS = 64
var entry_name: [kernel.MAX_NAME]byte
var entry_length: byte = 0
var entry_type: [MAX_ENTRY_MEMBERS]byte
var entry_register: [MAX_ENTRY_MEMBERS]byte
var entry_members: byte = 0

; What the import being read wants of the interfaces it reads (import_line()): the names its list
; gives, and what the bodies of the inline functions read name (read_uses()). A row is a module
; and a name, by their name entries; where a listed name was, for error 102. The rows last while
; one `import` line is read, the interfaces it brings in included.
#if SMALL
const MAX_WANTS = 48            ; (SMALL: the test programs' small build)
#else
const MAX_WANTS = 160
#end
const W_LISTED = 1              ; want_flags: the importer's list names it
const W_FOUND = 2               ; an entry of the interface has its name, or the module had it already
const NO_ROW = $FF
var want_module: [MAX_WANTS]word in WANTS  ; the rows, in the region WANTS: used only inside
var want_name: [MAX_WANTS]word in WANTS    ; the blocks of add_want(), listed(), not_exported(),
var want_hash: [MAX_WANTS]byte in WANTS    ; wanted(), pending() and check_found(). kernel.name_hash()
var want_flags: [MAX_WANTS]byte in WANTS   ; of the name
var want_line: [MAX_WANTS]word in WANTS
var want_col: [MAX_WANTS]word in WANTS
var want_count: byte = 0
var entry_row: byte = NO_ROW    ; the row that wanted() found for the entry being read
var row_name: word = 0          ; and its name

; How each module's interface is read: everything in it (M_WHOLE: an `import` without a list, or
; a module whose functions the compiler calls by itself, WHOLE_MODULES), and whether the importer
; can name all of it (M_SHOWN: an `import` without a list)
const M_WHOLE = 1
const M_SHOWN = 2
var module_read: [kernel.MAX_MODULES]byte
const WHOLE_MODULES: [17]byte = "rt_math rt_frame "   ; gen.math_function() and gen.frame_routines() look these up
const READ_SKIP = 0             ; what wanted() says of an entry: not read;
const READ_FROZEN = 1           ; read as a frozen entry;
const READ_ROW = 2              ; made a symbol at once, with the name of row entry_row;
const READ_SHOWN = 4            ; and with either of those, the importer can name it

; ---- Predeclared names -------------------------------------------------------------------

const REGISTERS: [17]byte = "a x y ax ay xy c "    ; in the order of gen.REG_A to gen.REG_C
const CONSTANTS: [15]byte = "false true nil "      ; the bool constants in the order of their values, nil
const BUILTINS: [17]byte = "lo hi sizeof len "     ; in the order of expr.B_LO to expr.B_LEN
const INIT_NAME: [5]byte = "$init"                 ; no source name can be this
const REGISTER_COUNT = 8
const REGISTER_PARTS: [8]byte = [$00, $01, $02, $04, $03, $05, $06, $08]   ; which of A, X, Y and carry each uses
const C_SPACE = $20
const C_ZERO = $30

var register_name: [REGISTER_COUNT]word
var init_parts: byte = 0        ; how many functions of initial values have been written out early

; Declare what the language declares. Needs the keywords to have their tokens.
pub func init()
  var register: byte
  var i: byte
  var s: word
  var value: word
  directory_count = 0
  init_parts = 0
  register = gen.REG_A
  kernel.name_begin()
  for i = 0 until len(REGISTERS) do
    if REGISTERS[i] == C_SPACE then
      register_name[register] = kernel.name_end()
      register += 1
      kernel.name_begin()
    else
      kernel.name_add(REGISTERS[i])
    end
  end
  value = 0
  for i = 0 until len(CONSTANTS) do
    if CONSTANTS[i] == C_SPACE then
      s = kernel.sym_add(kernel.SCOPE_PREDECLARED, kernel.name_end(), kernel.K_CONST)
      kernel.set_byte(s, kernel.C_TYPE, typetab.BOOL_TYPE)
      kernel.set_word(s, kernel.C_VALUE, value)
      if value == 2 then
        kernel.set_byte(s, kernel.C_TYPE, typetab.NIL_TYPE)
        kernel.set_word(s, kernel.C_VALUE, 0)
      end
      value += 1
      kernel.name_begin()
    else
      kernel.name_add(CONSTANTS[i])
    end
  end
  value = 0
  for i = 0 until len(BUILTINS) do
    if BUILTINS[i] == C_SPACE then
      s = kernel.sym_add(kernel.SCOPE_PREDECLARED, kernel.name_end(), kernel.K_BUILTIN)
      kernel.set_word(s, kernel.C_VALUE, value)
      value += 1
      kernel.name_begin()
    else
      kernel.name_add(BUILTINS[i])
    end
  end
end

; Interfaces are looked for in the directory whose name is at `name`, after those added before.
pub func directory_add(name: ^byte)
  if directory_count == MAX_DIRS then
    err.fatal(err.E_DIRS_FULL)
  end
  directory[directory_count] = name
  directory_count += 1
end

; Pointer to the file name of a module's interface in a directory.
func interface_path(directory_name: ^byte, module_name: word): ^byte
  var i: byte
  kernel.path_begin()
  kernel.path_add_text(directory_name)
  kernel.path_add(C_SLASH)
  kernel.path_add_name(module_name)
  for i = 0 until len(ENDING) do
    kernel.path_add(ENDING[i])
  end
  return kernel.path_end()
end

; ---- Writing the interface ---------------------------------------------------------------

func write_type(stream: byte, t: byte)
  var s: word
  while typetab.is_pointer(t) or typetab.is_array(t) do
    if typetab.is_pointer(t) then
      kernel.put(stream, LI_POINTER)
    else
      kernel.put(stream, LI_ARRAY + typetab.form[t] - typetab.FORM_ARRAY)
      kernel.put_word(stream, typetab.length(t))
    end
    t = byte(typetab.base(t))
  end
  if typetab.is_record(t) or typetab.is_enum(t) or typetab.is_func(t) then
    s = typetab.base(t)
    kernel.put(stream, LI_NAMED)
    kernel.put_name(stream, kernel.module_name[kernel.byte_of(s, kernel.C_SCOPE)])
    kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
  else
    kernel.put(stream, t)
  end
end

forward func write_signature(stream: byte, s: word)

; A type entry: a record, an enumeration or a function type that `s` declares, or another name
; for a type. Every record, enumeration and function type is written, so that what is exported
; can use them; one not `pub` is known to an importer but cannot be named there. Another name
; for a type is written only if it is `pub`.
func write_named_type(stream: byte, s: word)
  var t: byte
  var kind: byte
  var flags: byte
  var f: word
  t = kernel.byte_of(s, kernel.C_TYPE)
  kind = LI_TYPE
  if (typetab.is_record(t) or typetab.is_enum(t) or typetab.is_func(t)) and typetab.base(t) == s then
    kind = LI_RECORD + typetab.form[t] - typetab.FORM_RECORD
  elif kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_PUB == 0 then
    return
  end
  kernel.put(stream, kind)
  kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
  flags = 0
  if kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_PUB != 0 then
    flags = LI_PUB
  end
  if kind == LI_FUNC_TYPE and typetab.is_recursive(t) then
    flags = flags | LI_RECURSIVE
  end
  kernel.put(stream, flags)
  if kind == LI_FUNC_TYPE then
    write_signature(stream, s)
  elif kind == LI_TYPE then
    write_type(stream, t)
  elif kind == LI_RECORD then
    kernel.put(stream, kernel.byte_of(s, kernel.C_PARAMS))
    for f = s + 1 until s + 1 + kernel.byte_of(s, kernel.C_PARAMS) do
      kernel.put_name(stream, kernel.word_of(f, kernel.C_NAME))
      write_type(stream, kernel.byte_of(f, kernel.C_TYPE))
    end
  end
end

func write_members(stream: byte, first: word, count: byte)
  var m: word
  kernel.put(stream, count)
  for m = first until first + count do
    write_type(stream, kernel.member_type_of(m))
    kernel.put(stream, kernel.member_value_of(m))
  end
end

; The parameters and results of function or function type `s`.
func write_signature(stream: byte, s: word)
  write_members(stream, kernel.word_of(s, kernel.C_MEMBERS), kernel.byte_of(s, kernel.C_PARAMS))
  write_members(stream, kernel.word_of(s, kernel.C_MEMBERS) + kernel.byte_of(s, kernel.C_PARAMS), kernel.byte_of(s, kernel.C_RESULTS))
end

func write_function(stream: byte, s: word)
  kernel.put(stream, LI_FUNC)
  kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
  if kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_EXTERN != 0 then
    kernel.put(stream, LI_EXTERN)
    kernel.put_word(stream, kernel.word_of(s, kernel.C_VALUE))
  elif kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_ASM != 0 then
    kernel.put(stream, LI_ASM)
  elif kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_RECURSIVE != 0 then
    kernel.put(stream, LI_RECURSIVE)
  elif kernel.byte_of(s, kernel.C_FLAGS) & inlines.SF_INLINE != 0 then
    kernel.put(stream, LI_INLINE)
  elif kernel.byte_of(s, kernel.C_FLAGS) & inlines.SF_INTERRUPT != 0 then
    kernel.put(stream, LI_INTERRUPT)
  else
    kernel.put(stream, 0)
  end
  write_signature(stream, s)
  if kernel.byte_of(s, kernel.C_FLAGS) & inlines.SF_INLINE != 0 then
    inlines.write(stream, s)
  end
end

func write_constant(stream: byte, s: word)
  if kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_IN != 0 then
    kernel.put(stream, LI_CONST_IN)
    kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
    write_type(stream, kernel.byte_of(s, kernel.C_TYPE))
    kernel.put_word(stream, 0)
    kernel.put_name(stream, kernel.word_of(s, kernel.C_VALUE))
    return
  end
  kernel.put(stream, LI_CONST)
  kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
  write_type(stream, kernel.byte_of(s, kernel.C_TYPE))
  kernel.put_word(stream, kernel.word_of(s, kernel.C_VALUE))
end

func write_variable(stream: byte, s: word)
  kernel.put(stream, LI_VAR)
  kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
  write_type(stream, kernel.byte_of(s, kernel.C_TYPE))
  if kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_AT != 0 then
    kernel.put(stream, LI_AT)
    kernel.put_word(stream, kernel.word_of(s, kernel.C_VALUE))
  elif kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_IN != 0 then
    kernel.put(stream, LI_IN)
    kernel.put_name(stream, kernel.word_of(s, kernel.C_VALUE))
  elif kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_ZP != 0 then
    kernel.put(stream, LI_ZP)
  elif kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_NOZP != 0 then
    kernel.put(stream, LI_NOZP)
  else
    kernel.put(stream, 0)
  end
end

; Write what the module exports to its interface file in the directory named.
pub func write_interface(directory_name: ^byte)
  var stream: byte
  var ok: bool
  var expands: bool
  var s: word
  stream, ok = kernel.open_out(interface_path(directory_name, kernel.module_name[0]))
  if not ok then
    err.fatal(err.E_CREATE)
  end
  kernel.put(stream, C_UPPER_L)
  kernel.put(stream, C_UPPER_I)
  kernel.put(stream, LI_VERSION)
  kernel.put_name(stream, kernel.module_name[0])
  expands = false                       ; an importer may expand an inline function of this one
  for s = 0 until kernel.sym_count do
    if kernel.byte_of(s, kernel.C_SCOPE) == kernel.SCOPE_MODULE and kernel.byte_of(s, kernel.C_KIND) == kernel.K_FUNC and
        kernel.byte_of(s, kernel.C_FLAGS) & (kernel.SF_PUB | inlines.SF_INLINE) == kernel.SF_PUB | inlines.SF_INLINE then
      expands = true
    end
  end
  ; What each exported inline function's body names, newest function first (read_uses()).
  s = kernel.sym_count
  while s > 0 do
    s -= 1
    if kernel.byte_of(s, kernel.C_SCOPE) == kernel.SCOPE_MODULE and kernel.byte_of(s, kernel.C_KIND) == kernel.K_FUNC and
        kernel.byte_of(s, kernel.C_FLAGS) & (kernel.SF_PUB | inlines.SF_INLINE) == kernel.SF_PUB | inlines.SF_INLINE then
      kernel.put(stream, LI_USES)
      kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
      inlines.write_uses(stream, s)
    end
  end
  for s = 0 until kernel.sym_count do
    if kernel.byte_of(s, kernel.C_SCOPE) == kernel.SCOPE_MODULE and kernel.byte_of(s, kernel.C_KIND) == kernel.K_TYPE then
      write_named_type(stream, s)
    elif kernel.byte_of(s, kernel.C_SCOPE) == kernel.SCOPE_MODULE and kernel.byte_of(s, kernel.C_KIND) == kernel.K_MODULE then
      if expands then
        kernel.put(stream, LI_MODULE)
        kernel.put_name(stream, kernel.word_of(s, kernel.C_NAME))
      end
    elif kernel.byte_of(s, kernel.C_SCOPE) == kernel.SCOPE_MODULE and kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_PUB != 0 then
      if kernel.byte_of(s, kernel.C_KIND) == kernel.K_FUNC then
        write_function(stream, s)
      elif kernel.byte_of(s, kernel.C_KIND) == kernel.K_CONST then
        write_constant(stream, s)
      else
        write_variable(stream, s)
      end
    end
  end
  kernel.put(stream, LI_END)
  kernel.close(stream)
end

; ---- Reading an interface ----------------------------------------------------------------

forward func imported_type(stream: byte): byte

func read_type(stream: byte): byte
  var mark: byte
  var t: byte
  var at_end: bool
  mark = typetab.prefix_count
  t, at_end = kernel.get(stream)
  while t == LI_POINTER or t == LI_ARRAY or t == LI_ROWS do
    if t == LI_POINTER then
      typetab.prefix(typetab.FORM_POINTER, 0)
    else
      typetab.prefix(typetab.FORM_ARRAY + t - LI_ARRAY, kernel.get_word(stream))
    end
    t, at_end = kernel.get(stream)
  end
  if t == LI_NAMED then
    t = imported_type(stream)
  elif t < typetab.BYTE_TYPE or t > typetab.NIL_TYPE then
    err.fatal(err.E_BAD_INTERFACE)
  end
  return typetab.build(t, mark)
end

; A record, an enumeration or a function type given by the name of its module and its own: the
; module must have been imported already, and is in a scope of its own number.
func imported_type(stream: byte): byte
  var name: word
  var scope: byte
  var s: word
  var found: bool
  name = inlines.read_name(stream)
  scope = 1
  while scope < kernel.module_count and kernel.module_name[scope] != name do
    scope += 1
  end
  if scope == kernel.module_count then
    err.fatal(err.E_TYPE_MODULE)
  end
  s, found = kernel.sym_find(scope, inlines.read_name(stream))
  if not found or kernel.byte_of(s, kernel.C_KIND) != kernel.K_TYPE then
    err.fatal(err.E_BAD_INTERFACE)
  end
  return kernel.byte_of(s, kernel.C_TYPE)
end

forward func read_signature(stream: byte, s: word)
forward func add_field(s: word, name: word, t: byte)
forward func read_entry_name(stream: byte)
forward func entry_name_begin()
forward func read_entry_members(stream: byte): byte
forward func wanted(number: byte, mark: bool): byte
forward func listed(row: byte): bool
forward func not_exported(row: byte)
forward func hidden(flags: byte, how: byte): byte
forward func skip_named_type(stream: byte, kind: byte)

; A type entry of kind LI_TYPE, LI_RECORD, LI_ENUM or LI_FUNC_TYPE. Every type of the interface
; is read, listed or not, the first time it is read; `again`, it is passed over, but the importer
; can name it from now on if it is listed. A listed type that is not `pub` is error 102.
func read_named_type(stream: byte, scope: byte, kind: byte, again: bool)
  var s: word
  var flags: byte
  var at_end: bool
  var t: byte
  var count: byte
  var i: byte
  var name: word
  var how: byte
  read_entry_name(stream)
  entry_name_begin()
  how = wanted(scope, true)
  flags, at_end = kernel.get(stream)
  if flags & LI_PUB == 0 and listed(entry_row) then
    not_exported(entry_row)
  end
  if again then
    kernel.built_loaded(scope, how & READ_SHOWN != 0)
    skip_named_type(stream, kind)
    return
  end
  s = kernel.sym_add(scope, kernel.name_end(), kernel.K_TYPE)
  if flags & LI_PUB != 0 then
    kernel.set_byte(s, kernel.C_FLAGS, hidden(kernel.SF_PUB, how))
  end
  if kind == LI_TYPE then
    kernel.set_byte(s, kernel.C_TYPE, read_type(stream))
    return
  end
  t = typetab.declared(typetab.FORM_RECORD + kind - LI_RECORD, s)
  kernel.set_byte(s, kernel.C_TYPE, t)
  if kind == LI_FUNC_TYPE then
    if flags & LI_RECURSIVE != 0 then
      typetab.make_recursive(t)
    end
    read_signature(stream, s)
    return
  end
  if kind == LI_ENUM then
    return
  end
  count, at_end = kernel.get(stream)
  for i = 0 until count do
    name = inlines.read_name(stream)
    add_field(s, name, read_type(stream))
  end
end

; What follows the flags of a type entry read before: its types are read again, which makes no
; new type, and nothing else is made.
func skip_named_type(stream: byte, kind: byte)
  var count: byte
  var at_end: bool
  var i: byte
  entry_members = 0
  if kind == LI_TYPE then
    read_type(stream)
  elif kind == LI_FUNC_TYPE then
    read_entry_members(stream)
    read_entry_members(stream)
  elif kind == LI_RECORD then
    count, at_end = kernel.get(stream)
    for i = 0 until count do
      inlines.skip_name(stream)
      read_type(stream)
    end
  end
end

; A field called `name` of type `t` after the others of the record that `s` declares.
func add_field(s: word, name: word, t: byte)
  var r: byte
  var f: word
  r = kernel.byte_of(s, kernel.C_TYPE)
  f = kernel.sym_add(kernel.SCOPE_FIELDS + r, name, kernel.K_FIELD)
  kernel.set_byte(f, kernel.C_TYPE, t)
  kernel.set_word(f, kernel.C_VALUE, typetab.grow(r, typetab.size(t)))
  kernel.set_byte(s, kernel.C_PARAMS, kernel.byte_of(s, kernel.C_PARAMS) + 1)
end

; Read parameters or results as members of the newest symbol. Returns how many.
func read_members(stream: byte): byte
  var count: byte
  var at_end: bool
  var i: byte
  var t: byte
  var register: byte
  count, at_end = kernel.get(stream)
  for i = 0 until count do
    t = read_type(stream)
    register, at_end = kernel.get(stream)
    kernel.member_add(t, register)
  end
  return count
end

; The parameters and results of function or function type `s`, the newest symbol.
func read_signature(stream: byte, s: word)
  kernel.set_byte(s, kernel.C_PARAMS, read_members(stream))
  kernel.set_byte(s, kernel.C_RESULTS, read_members(stream))
end

; The name of an entry, which is not made a name yet: its characters are kept in entry_name, the
; first kernel.MAX_NAME of them, as a name keeps them.
func read_entry_name(stream: byte)
  var length: byte
  var at_end: bool
  var i: byte
  var ch: byte
  length, at_end = kernel.get(stream)
  entry_length = 0
  for i = 0 until length do
    ch, at_end = kernel.get(stream)
    if entry_length < kernel.MAX_NAME then
      entry_name[entry_length] = ch
      entry_length += 1
    end
  end
end

; Build the entry's name in the name heap (kernel.name_begin()).
func entry_name_begin()
  var i: byte
  kernel.name_begin()
  for i = 0 until entry_length do
    kernel.name_add(entry_name[i])
  end
end

; Read parameters or results into the entry's members. Returns how many.
func read_entry_members(stream: byte): byte
  var count: byte
  var at_end: bool
  var i: byte
  var register: byte
  count, at_end = kernel.get(stream)
  for i = 0 until count do
    if entry_members == MAX_ENTRY_MEMBERS then
      err.fatal(err.E_MEMBERS_FULL)
    end
    entry_type[entry_members] = read_type(stream)
    register, at_end = kernel.get(stream)
    entry_register[entry_members] = register
    entry_members += 1
  end
  return count
end

; ---- What an import wants ----------------------------------------------------------------

; A row: the import wants the entry `name` of the module called `owner`, as `flags` say; where
; the current token is, for error 102. A row that is there already is not added again, but a
; name a list gives twice is error 103.
func add_want(owner: word, name: word, flags: byte)
  var i: byte
  var spelling: byte
  spelling = kernel.name_hash(name)
  with WANTS do
    for i = 0 until want_count do
      if want_module[i] == owner and want_name[i] == name then
        if flags & want_flags[i] & W_LISTED != 0 then
          err.fatal(err.E_LISTED_TWICE)
        end
        want_flags[i] = want_flags[i] | flags
        return
      end
    end
    if want_count == MAX_WANTS then
      err.fatal(err.E_WANTS_FULL)
    end
    want_module[want_count] = owner
    want_name[want_count] = name
    want_hash[want_count] = spelling
    want_flags[want_count] = flags
    want_line[want_count] = lex.line
    want_col[want_count] = lex.col
  end
  want_count += 1
end

; True if `row` is one, and the importer's list gave it.
func listed(row: byte): bool
  with WANTS do
    return row != NO_ROW and want_flags[row] & W_LISTED != 0
  end
end

; Error 102, at the name the list gave.
func not_exported(row: byte)
  with WANTS do
    err.position(want_line[row], want_col[row])
  end
  err.fatal(err.E_NOT_EXPORTED)
end

; Symbol flags `flags`, with SF_HIDDEN unless `how` says the importer can name it.
func hidden(flags: byte, how: byte): byte
  if how & READ_SHOWN == 0 then
    return flags | kernel.SF_HIDDEN
  end
  return flags
end

; How the entry of module `number` whose name is being built is read (READ_SKIP, READ_FROZEN or
; READ_ROW, and READ_SHOWN): as the rows that name it say, else as the module is read. entry_row
; is the row, a listed one first, or NO_ROW. If `mark`, the rows are marked found.
func wanted(number: byte, mark: bool): byte
  var i: byte
  var how: byte
  entry_row = NO_ROW
  with WANTS do
    for i = 0 until want_count do
      if want_hash[i] == kernel.new_hash and want_module[i] == kernel.module_name[number] and
          kernel.built_is(want_name[i]) then
        if mark then
          want_flags[i] = want_flags[i] | W_FOUND
        end
        if not listed(entry_row) then
          entry_row = i
        end
      end
    end
    if entry_row != NO_ROW then
      row_name = want_name[entry_row]
    end
  end
  how = READ_SKIP
  if module_read[number] & M_WHOLE != 0 then
    how = READ_FROZEN
  end
  if entry_row != NO_ROW then
    how = READ_ROW
  end
  if module_read[number] & M_SHOWN != 0 or listed(entry_row) then
    how = how | READ_SHOWN
  end
  return how
end

; True if a row wants an entry of module `number`, read before, that it does not have yet. Those
; it has are found now, and those a list gives can be named (error 102 for a type not `pub` or a
; module of its interface).
func pending(number: byte): bool
  var more: bool = false
  var i: byte
  var s: word
  var found: bool
  var waiting: bool
  var name: word
  var kind: byte
  for i = 0 until want_count do
    with WANTS do
      waiting = want_module[i] == kernel.module_name[number] and want_flags[i] & W_FOUND == 0
      name = want_name[i]
    end
    if waiting then
      s, found = kernel.sym_find(number, name)
      if not found then
        more = true
      elif listed(i) then
        kind = kernel.byte_of(s, kernel.C_KIND)
        if kind == kernel.K_MODULE or (kind == kernel.K_TYPE and
            kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_PUB == 0) then
          not_exported(i)
        end
        kernel.set_byte(s, kernel.C_FLAGS, kernel.byte_of(s, kernel.C_FLAGS) & ~kernel.SF_HIDDEN)
      end
      if found then
        with WANTS do
          want_flags[i] = want_flags[i] | W_FOUND
        end
      end
    end
  end
  return more
end

; Error 102 at the first row the importer's list gave that no entry has.
func check_found()
  var i: byte
  with WANTS do
    for i = 0 until want_count do
      if want_flags[i] & (W_LISTED | W_FOUND) == W_LISTED then
        not_exported(i)
      end
    end
  end
end

; True if `name` is that of a module in WHOLE_MODULES.
func whole_module(name: word): bool
  var i: byte = 0
  var k: byte
  var same: bool
  while i < len(WHOLE_MODULES) do
    k = 0
    same = true
    while WHOLE_MODULES[i + k] != C_SPACE do
      if k >= kernel.name_length(name) or kernel.name_char(name, k) != WHOLE_MODULES[i + k] then
        same = false
      end
      k += 1
    end
    if same and k == kernel.name_length(name) then
      return true
    end
    i += k + 1
  end
  return false
end

; The next module number, for the module called `name`, read as `how` (M_WHOLE, M_SHOWN) says,
; and as a whole if the compiler calls its functions itself.
func new_module(name: word, how: byte): byte
  var m: byte
  m = kernel.module_add(name)
  module_read[m] = how
  if whole_module(name) then
    module_read[m] = how | M_WHOLE
  end
  return m
end

; ---- Reading the entries -----------------------------------------------------------------

; The entry read becomes a frozen symbol of module `scope` (kernel.freeze()).
func freeze(scope: byte, kind: byte, flags: byte, t: byte, value: word, params: byte, results: byte)
  var i: byte
  entry_name_begin()
  kernel.freeze(scope, kind, flags, t, value, params, results)
  for i = 0 until entry_members do
    kernel.freeze_member(entry_type[i], entry_register[i])
  end
end

; The function, constant or variable entry read, with these columns and its members, is read as
; `how` says (wanted()): a symbol at once with its row's name, a frozen entry, or nothing.
; `again`, an entry the module has already is only shown if `how` says so.
func enter(scope: byte, how: byte, again: bool, kind: byte, flags: byte, t: byte, value: word,
    params: byte, results: byte)
  var s: word
  var i: byte
  entry_name_begin()
  if again and kernel.built_loaded(scope, how & READ_SHOWN != 0) then
    return
  end
  flags = hidden(flags, how)
  if how & READ_ROW != 0 then
    s = kernel.sym_thawed(scope, row_name, kind)
    kernel.set_byte(s, kernel.C_FLAGS, flags)
    kernel.set_byte(s, kernel.C_TYPE, t)
    kernel.set_word(s, kernel.C_VALUE, value)
    kernel.set_byte(s, kernel.C_PARAMS, params)
    kernel.set_byte(s, kernel.C_RESULTS, results)
    for i = 0 until entry_members do
      kernel.member_add(entry_type[i], entry_register[i])
    end
  elif how & READ_FROZEN != 0 then
    freeze(scope, kind, flags, t, value, params, results)
  end
end

; A function entry: frozen, unless it is `inline`, whose saved tokens are read now if it is
; wanted, or passed over.
func read_function(stream: byte, scope: byte, again: bool)
  var flags: byte
  var at_end: bool
  var s: word
  var symbol_flags: byte
  var value: word
  var params: byte
  var results: byte
  var how: byte
  read_entry_name(stream)
  flags, at_end = kernel.get(stream)
  if flags & LI_INLINE != 0 then
    entry_name_begin()
    how = wanted(scope, true)
    entry_members = 0
    if how == READ_SKIP or again and kernel.built_loaded(scope, how & READ_SHOWN != 0) then
      params = read_entry_members(stream)
      read_entry_members(stream)
      inlines.skip(stream, params)
      return
    end
    s = kernel.sym_add(scope, kernel.name_end(), kernel.K_FUNC)
    kernel.set_byte(s, kernel.C_FLAGS, hidden(kernel.SF_PUB | inlines.SF_INLINE, how))
    read_signature(stream, s)
    inlines.read(stream, s)
    return
  end
  symbol_flags = kernel.SF_PUB
  value = 0
  if flags & LI_EXTERN != 0 then
    symbol_flags = kernel.SF_PUB | kernel.SF_EXTERN
    value = kernel.get_word(stream)
  end
  if flags & LI_ASM != 0 then
    symbol_flags = kernel.SF_PUB | kernel.SF_ASM
  end
  if flags & LI_RECURSIVE != 0 then
    symbol_flags = kernel.SF_PUB | kernel.SF_RECURSIVE
  end
  if flags & LI_INTERRUPT != 0 then
    symbol_flags = kernel.SF_PUB | inlines.SF_INTERRUPT
  end
  entry_members = 0
  params = read_entry_members(stream)
  results = read_entry_members(stream)
  entry_name_begin()
  how = wanted(scope, true)
  enter(scope, how, again, kernel.K_FUNC, symbol_flags, 0, value, params, results)
end

; The name of a region, after an entry read as `how` says: passed over if it is not read.
func region_name(stream: byte, how: byte): word
  if how == READ_SKIP then
    inlines.skip_name(stream)
    return 0
  end
  return inlines.read_name(stream)
end

; A constant entry; `in_region` for a table in a region, whose name follows its value.
func read_constant(stream: byte, scope: byte, in_region: bool, again: bool)
  var t: byte
  var value: word
  var flags: byte
  var how: byte
  read_entry_name(stream)
  t = read_type(stream)
  entry_members = 0
  value = kernel.get_word(stream)
  entry_name_begin()
  how = wanted(scope, true)
  flags = kernel.SF_PUB
  if in_region then
    flags = kernel.SF_PUB | kernel.SF_IN
    value = region_name(stream, how)
  end
  enter(scope, how, again, kernel.K_CONST, flags, t, value, 0, 0)
end

func read_variable(stream: byte, scope: byte, again: bool)
  var t: byte
  var placement: byte
  var at_end: bool
  var symbol_flags: byte
  var value: word
  var how: byte
  read_entry_name(stream)
  t = read_type(stream)
  placement, at_end = kernel.get(stream)
  entry_name_begin()
  how = wanted(scope, true)
  symbol_flags = kernel.SF_PUB
  value = 0
  if placement == LI_AT then
    symbol_flags = kernel.SF_PUB | kernel.SF_AT
    value = kernel.get_word(stream)
  elif placement == LI_ZP then
    symbol_flags = kernel.SF_PUB | kernel.SF_ZP
  elif placement == LI_NOZP then
    symbol_flags = kernel.SF_PUB | kernel.SF_NOZP
  elif placement == LI_IN then
    symbol_flags = kernel.SF_PUB | kernel.SF_NOZP | kernel.SF_IN
    value = region_name(stream, how)
  elif placement != 0 then
    err.fatal(err.E_BAD_INTERFACE)
  end
  entry_members = 0
  enter(scope, how, again, kernel.K_VAR, symbol_flags, t, value, 0, 0)
end

; The module of a name in an LI_USES entry of module `number`'s interface: a string, or an empty
; one for that module itself.
func read_module_name(stream: byte, number: byte): word
  var length: byte
  var at_end: bool
  var i: byte
  var ch: byte
  length, at_end = kernel.get(stream)
  if length == 0 then
    return kernel.module_name[number]
  end
  kernel.name_begin()
  for i = 0 until length do
    ch, at_end = kernel.get(stream)
    kernel.name_add(ch)
  end
  return kernel.name_end()
end

; An LI_USES entry: if the inline function it is for is wanted, a row for each name its body
; names, so that the entries of this module and of the modules it imports are read for it. The
; entries come newest function first, so that a function another one names is wanted by the time
; its own entry is read.
func read_uses(stream: byte, number: byte)
  var how: byte
  var count: byte
  var at_end: bool
  var i: byte
  var owner: word
  read_entry_name(stream)
  entry_name_begin()
  how = wanted(number, false)
  count, at_end = kernel.get(stream)
  for i = 0 until count do
    if how == READ_SKIP then
      inlines.skip_name(stream)
      inlines.skip_name(stream)
    else
      owner = read_module_name(stream, number)
      add_want(owner, inlines.read_name(stream), 0)
    end
  end
end

forward recursive func read_interface(number: byte, again: bool)

; An LI_MODULE entry: a module that the exported inline functions of module `scope` can name. It
; is imported too, if it is not already (or read again for the names the rows want of it), and
; is a name of that module's scope, which the expansions of its inline functions see and the
; importer's own code does not.
recursive func imported_module(stream: byte, scope: byte, again: bool)
  var name: word
  var m: byte
  name = inlines.read_name(stream)
  m = 1
  while m < kernel.module_count and kernel.module_name[m] != name do
    m += 1
  end
  if m == kernel.module_count then
    m = new_module(name, 0)
    read_interface(m, false)
  elif pending(m) then
    read_interface(m, true)
  end
  if not again then
    kernel.set_word(kernel.sym_add(scope, name, kernel.K_MODULE), kernel.C_VALUE, m)
  end
end

; The interface of the module called `name`, from the first directory that has one.
func open_interface(name: word): byte
  var i: byte
  var stream: byte
  var ok: bool
  for i = 0 until directory_count do
    stream, ok = kernel.open_in(interface_path(directory[i], name))
    if ok then
      return stream
    end
  end
  err.fatal(err.E_NO_INTERFACE)
  return 0
end

; Declare what module number `number` exports, as symbols in the scope of that number: its types,
; and of the rest what the rows want (wanted()), or all of it. `again`: it was read before, and
; what it had then is not made again.
recursive func read_interface(number: byte, again: bool)
  var stream: byte
  var letter_l: byte
  var letter_i: byte
  var version: byte
  var at_end: bool
  var kind: byte
  stream = open_interface(kernel.module_name[number])
  letter_l, at_end = kernel.get(stream)
  letter_i, at_end = kernel.get(stream)
  version, at_end = kernel.get(stream)
  if letter_l != C_UPPER_L or letter_i != C_UPPER_I or version != LI_VERSION then
    err.fatal(err.E_BAD_INTERFACE)
  end
  if inlines.read_name(stream) != kernel.module_name[number] then
    err.fatal(err.E_BAD_INTERFACE)
  end
  loop
    kind, at_end = kernel.get(stream)
    if at_end or kind > LI_USES then
      err.fatal(err.E_BAD_INTERFACE)    ; a file cut short has no LI_END
    end
    if kind == LI_END then
      break
    end
    if kind == LI_FUNC then
      read_function(stream, number, again)
    elif kind == LI_CONST or kind == LI_CONST_IN then
      read_constant(stream, number, kind == LI_CONST_IN, again)
    elif kind == LI_VAR then
      read_variable(stream, number, again)
    elif kind == LI_MODULE then
      imported_module(stream, number, again)
    elif kind == LI_USES then
      read_uses(stream, number)
    else
      read_named_type(stream, number, kind, again)
    end
  end
  kernel.close(stream)
end

; ---- The module and its imports ----------------------------------------------------------

; "module" name NL. The name must be the file's.
func module_line()
  lex.expect(lex.T_MODULE, err.E_MODULE_EXPECTED)
  if lex.tok != lex.T_NAME then
    err.fatal(err.E_NAME_EXPECTED)
  end
  if lex.value != kernel.module_name[0] then
    err.fatal(err.E_MODULE_NAME)
  end
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  out.begin_module(gen.cpu, kernel.module_name[0])
end

; "(" [ name { "," name } ] ")", after the module's name: a row for each name.
func import_list(name: word)
  lex.next()
  if lex.tok != lex.T_RPAREN then
    loop
      if lex.tok != lex.T_NAME then
        err.fatal(err.E_NAME_EXPECTED)
      end
      add_want(name, lex.value, W_LISTED)
      lex.next()
      if lex.tok != lex.T_COMMA then
        break
      end
      lex.next()
    end
  end
  lex.expect(lex.T_RPAREN, err.E_RPAREN_EXPECTED)
end

; "import" name [ "(" [ name { "," name } ] ")" ] NL. The module's name becomes a symbol; what
; it exports is declared in a scope of its own and reached as name.member: all of it, or only
; what the list names (with what the inline functions listed need, which the importer cannot
; name). Each name listed must be one the module exports.
func import_line()
  var s: word
  var m: byte
  var name: word
  var line: word
  var col: word
  var how: byte
  lex.next()
  if lex.tok != lex.T_NAME then
    err.fatal(err.E_NAME_EXPECTED)
  end
  name = lex.value
  if name == kernel.module_name[0] then
    err.fatal(err.E_SELF_IMPORT)
  end
  line = lex.line
  col = lex.col
  s = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_MODULE)
  lex.next()
  want_count = 0
  how = M_WHOLE | M_SHOWN
  if lex.tok == lex.T_LPAREN then
    kernel.set_byte(s, kernel.C_FLAGS, kernel.SF_LIST)
    how = 0
    import_list(name)
  end
  err.position(line, col)
  ; An interface read before may have brought the module in, for its inline functions
  ; (imported_module()): that reading serves, and what it has is not made twice.
  m = 1
  while m < kernel.module_count and kernel.module_name[m] != name do
    m += 1
  end
  if m == kernel.module_count then
    m = new_module(name, how)
    read_interface(m, false)
  elif how != 0 then
    module_read[m] = module_read[m] | how
    read_interface(m, true)
  elif pending(m) then
    read_interface(m, true)
  end
  check_found()
  want_count = 0
  kernel.set_word(s, kernel.C_VALUE, m)
  out.imported(name)
  err.position(lex.line, lex.col)
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; ---- Functions ---------------------------------------------------------------------------

; The name after "func": declare it as a function with these flags. If it was declared
; `forward`, that symbol is the one, and what follows must repeat that declaration. Returns the
; symbol and whether it is new.
func function_symbol(flags: byte): word, bool
  var s: word
  var found: bool
  if lex.tok != lex.T_NAME then
    err.fatal(err.E_NAME_EXPECTED)
  end
  s, found = kernel.sym_find(kernel.SCOPE_MODULE, lex.value)
  if found and kernel.byte_of(s, kernel.C_KIND) == kernel.K_FUNC and kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_FORWARD != 0 and
      flags & kernel.SF_FORWARD == 0 then
    if flags & (inlines.SF_INLINE | inlines.SF_INTERRUPT) != 0 then
      err.fatal(err.E_ATTRIBUTES)
    end
    if (kernel.byte_of(s, kernel.C_FLAGS) ^ flags) & kernel.SF_RECURSIVE != 0 then
      err.fatal(err.E_FORWARD)
    end
    kernel.set_byte(s, kernel.C_FLAGS, flags)
    lex.next()
    return s, false
  end
  s = kernel.sym_add(kernel.SCOPE_MODULE, lex.value, kernel.K_FUNC)
  kernel.set_byte(s, kernel.C_FLAGS, flags)
  lex.next()
  return s, true
end

; register = "a" | "x" | "y" | "ax" | "ay" | "xy" | "c". These are not keywords: they are names
; with this meaning only here. Returns the register; the token is not passed over.
func register(): byte
  var r: byte
  if lex.tok == lex.T_NAME then
    for r = gen.REG_A until REGISTER_COUNT do
      if lex.value == register_name[r] then
        return r
      end
    end
  end
  err.fatal(err.E_REGISTER_EXPECTED)
  return gen.REG_NONE
end

; True if a value of type `t` can be in register `r`.
func register_suits(r: byte, t: byte): bool
  if r == gen.REG_C then
    return t == typetab.BOOL_TYPE
  end
  if r <= gen.REG_Y then
    return typetab.size(t) == 1
  end
  return typetab.size(t) == 2
end

; type "in" register: a parameter or result of the newest symbol. `used` says which of A, X, Y
; and carry are taken already; returns that with this member's added.
func bound_member(used: byte): byte
  var t: byte
  var r: byte
  t = expr.value_type()
  lex.expect(lex.T_IN, err.E_IN_EXPECTED)
  r = register()
  if not register_suits(r, t) then
    err.fatal(err.E_REG_TYPE)
  end
  if used & REGISTER_PARTS[r] != 0 then
    err.fatal(err.E_REG_USED)
  end
  lex.next()
  kernel.member_add(t, r)
  return used | REGISTER_PARTS[r]
end

; [ regParam { "," regParam } ] ")", after the "(". regParam = name ":" type "in" register.
; Returns how many.
func register_parameters(): byte
  var count: byte
  var used: byte
  count = 0
  used = 0
  if lex.tok != lex.T_RPAREN then
    loop
      if lex.tok != lex.T_NAME then
        err.fatal(err.E_NAME_EXPECTED)
      end
      lex.next()
      lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
      used = bound_member(used)
      count += 1
      if lex.tok != lex.T_COMMA then
        break
      end
      lex.next()
    end
  end
  lex.expect(lex.T_RPAREN, err.E_RPAREN_EXPECTED)
  return count
end

; [ ":" regResult [ "," regResult ] ]. regResult = type "in" register. Returns how many.
func register_results(): byte
  var used: byte
  if lex.tok != lex.T_COLON then
    return 0
  end
  lex.next()
  used = bound_member(0)
  if lex.tok != lex.T_COMMA then
    return 1
  end
  lex.next()
  bound_member(used)
  return 2
end

; externDecl = "extern" regHead "at" constExpr NL.
func extern_declaration(flags: byte)
  var s: word
  var fresh: bool
  lex.next()
  lex.expect(lex.T_FUNC, err.E_FUNC_EXPECTED)
  s, fresh = function_symbol(flags | kernel.SF_EXTERN)
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  kernel.set_byte(s, kernel.C_PARAMS, register_parameters())
  kernel.set_byte(s, kernel.C_RESULTS, register_results())
  lex.expect(lex.T_AT, err.E_AT_EXPECTED)
  kernel.set_word(s, kernel.C_VALUE, expr.constant_number())
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

forward func object_flags(s: word): byte

; "asm" regHead NL { asmLine NL } "end" NL: a function whose body is assembly, with its
; parameters and results in registers and no slots. It is called like an `extern` function, but
; through its symbol, with a CALL record.
func asm_function_declaration(flags: byte)
  var s: word
  var fresh: bool
  lex.next()
  lex.expect(lex.T_FUNC, err.E_FUNC_EXPECTED)
  s, fresh = function_symbol(flags | kernel.SF_ASM)
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  kernel.set_byte(s, kernel.C_PARAMS, register_parameters())
  kernel.set_byte(s, kernel.C_RESULTS, register_results())
  kernel.scope_begin()                  ; the names of its labels go when it ends
  gen.function_begin(reg.object_symbol(s))
  asmblock.function_body()
  gen.function_end(object_flags(s) | out.FUNC_REGISTERS)
  kernel.scope_end()
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; The flags of function `s` as its FUNC record has them.
func object_flags(s: word): byte
  var flags: byte
  flags = 0
  if kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_PUB != 0 then
    flags = out.FUNC_EXPORTED
  end
  if kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_RECURSIVE != 0 then
    flags = flags | out.FUNC_RECURSIVE
  end
  if kernel.byte_of(s, kernel.C_FLAGS) & inlines.SF_INTERRUPT != 0 then
    flags = flags | out.FUNC_INTERRUPT
  end
  return flags
end

forward func result_register(t: byte): byte

; type: the type of parameter or result number `index` of function `s`, which is in `where`, or
; for a result in the place its type gives it. If the function is not `fresh`, this must be what
; the forward declaration said. Returns the type.
func member(s: word, fresh: bool, index: byte, where: byte): byte
  var line: word
  var col: word
  var t: byte
  line = lex.line
  col = lex.col
  t = expr.value_type()
  if where != gen.REG_NONE then
    where = result_register(t)
  end
  if fresh then
    kernel.member_add(t, where)
  elif index >= kernel.byte_of(s, kernel.C_PARAMS) + kernel.byte_of(s, kernel.C_RESULTS) or
      kernel.member_type_of(kernel.word_of(s, kernel.C_MEMBERS) + index) != t or
      kernel.member_value_of(kernel.word_of(s, kernel.C_MEMBERS) + index) != where then
    err.position(line, col)
    err.fatal(err.E_FORWARD)
  end
  return t
end

; [ param { "," param } ] ")", after the "(". param = name ":" type. Each is a slot of the frame,
; in order, and a local name. Returns how many.
func parameters(s: word, fresh: bool): byte
  var count: byte
  var name: word
  var t: byte
  var p: word
  count = 0
  if lex.tok != lex.T_RPAREN then
    loop
      name = parts.new_name(kernel.SCOPE_LOCAL)
      lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
      t = member(s, fresh, count, gen.REG_NONE)
      p = kernel.sym_add(kernel.SCOPE_LOCAL, name, kernel.K_LOCAL)
      kernel.set_byte(p, kernel.C_TYPE, t)
      kernel.set_word(p, kernel.C_VALUE, reg.new_slot(typetab.size(t), reg.CLASS_EITHER, reg.SLOT_PARAMETER,
          name))
      count += 1
      if lex.tok != lex.T_COMMA then
        break
      end
      lex.next()
    end
  end
  lex.expect(lex.T_RPAREN, err.E_RPAREN_EXPECTED)
  return count
end

; Where a result of type `t` is returned (docs/code-model.md, "Convention").
func result_register(t: byte): byte
  if t == typetab.BOOL_TYPE then
    return gen.REG_C
  end
  if typetab.size(t) == 2 then
    return gen.REG_AX
  end
  return gen.REG_A
end

; [ ":" type [ "," "bool" ] ]: nothing, a value, a status, or a value and a status. They are the
; members of `s` from number `index` on. Returns how many.
func results(s: word, fresh: bool, index: byte): byte
  var t: byte
  if lex.tok != lex.T_COLON then
    return 0
  end
  lex.next()
  t = member(s, fresh, index, gen.REG_A)
  if lex.tok != lex.T_COMMA then
    return 1
  end
  lex.next()
  if t == typetab.BOOL_TYPE or lex.tok != lex.T_BOOL then
    err.fatal(err.E_TYPE)
  end
  member(s, fresh, index + 1, gen.REG_C)
  return 2
end

; funcHead from its "(" on, for function `s`, which is declared for the first time if `fresh`
; and must otherwise repeat its forward declaration.
func head(s: word, fresh: bool)
  var count: byte
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  count = parameters(s, fresh)
  if fresh then
    kernel.set_byte(s, kernel.C_PARAMS, count)
  elif count != kernel.byte_of(s, kernel.C_PARAMS) then
    err.fatal(err.E_FORWARD)
  end
  count = results(s, fresh, count)
  if fresh then
    kernel.set_byte(s, kernel.C_RESULTS, count)
  elif count != kernel.byte_of(s, kernel.C_RESULTS) then
    err.fatal(err.E_FORWARD)
  end
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; Write the VAR record of each variable of `scope` from symbol `first` on that lives for the
; whole program. Its weight is complete: nothing that follows can use it.
func lasting_variables(first: word, scope: byte)
  var s: word
  for s = first until kernel.sym_count do
    if kernel.byte_of(s, kernel.C_KIND) == kernel.K_VAR and kernel.byte_of(s, kernel.C_SCOPE) == scope and
        kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_AT == 0 then
      if kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_IN != 0 then
        out.region(kernel.word_of(s, kernel.C_VALUE))
      end
      out.variable(kernel.word_of(s, kernel.C_OBJ), typetab.size(kernel.byte_of(s, kernel.C_TYPE)),
          parts.zp_class(kernel.byte_of(s, kernel.C_FLAGS)), kernel.byte_of(s, kernel.C_WEIGHT))
    end
  end
end

; funcDecl = funcHead NL body "end" NL, or "forward" funcHead NL if `flags` say so. An interrupt
; function has no parameters and no results (reported at its name), and entry and exit code.
func function_declaration(flags: byte)
  var line: word
  var col: word
  var s: word
  var fresh: bool
  lex.next()
  line = lex.line
  col = lex.col
  s, fresh = function_symbol(flags)
  ; The scope begins once the function's own name is declared and the token after it has been
  ; read: every name made from here on is a parameter's or a local's.
  kernel.scope_begin()
  gen.function_begin(reg.object_symbol(s))
  gen.saves_frame = kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_RECURSIVE != 0
  head(s, fresh)
  if flags & kernel.SF_FORWARD != 0 then
    kernel.scope_end()
    return
  end
  if flags & inlines.SF_INTERRUPT != 0 then
    if kernel.byte_of(s, kernel.C_PARAMS) + kernel.byte_of(s, kernel.C_RESULTS) != 0 then
      err.position(line, col)
      err.fatal(err.E_INTERRUPT_HEAD)
    end
    gen.interrupt_entry()
  end
  gen.receive(s)
  expr.function_body(s)
  if lex.tok != lex.T_END then
    err.fatal(err.E_END_EXPECTED)
  end
  gen.function_end(object_flags(s))
  lasting_variables(kernel.local_base, kernel.SCOPE_LOCAL)
  ; The scope ends before "end" is passed over, so that no token read after it can be taken for
  ; one of the function's own names.
  kernel.scope_end()
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; "inline" funcHead NL body "end" NL, from "func" on. The body is not compiled: INLINE saves its
; tokens, which EXPR replays at each call. The names the declaration made are kept for the whole
; module, because the saved tokens use them; its symbols go as a function's do.
func inline_declaration(flags: byte)
  var s: word
  var fresh: bool
  lex.next()
  s, fresh = function_symbol(flags)
  kernel.scope_begin()
  reg.begin(kernel.NO_OBJ)
  head(s, fresh)
  inlines.save(s)
  kernel.local_names = kernel.name_top
  kernel.scope_end()
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; "inline" or "interrupt", then funcHead NL body "end" NL. Each attribute goes with neither the
; other, nor `recursive`, nor `asm`.
func attributed_declaration(flags: byte)
  if lex.tok == lex.T_INLINE then
    flags = flags | inlines.SF_INLINE
  else
    flags = flags | inlines.SF_INTERRUPT
  end
  lex.next()
  if lex.tok == lex.T_INLINE or lex.tok == lex.T_INTERRUPT or lex.tok == lex.T_RECURSIVE or
      lex.tok == lex.T_ASM then
    err.fatal(err.E_ATTRIBUTES)
  end
  if lex.tok != lex.T_FUNC then
    err.fatal(err.E_FUNC_EXPECTED)
  end
  if flags & inlines.SF_INLINE != 0 then
    inline_declaration(flags)
  else
    function_declaration(flags)
  end
end

; ---- Constants, and what the end of the module writes ------------------------------------

; constDecl = "const" name [ ":" type ] "=" initialiser NL. A constant of an array type, or one
; that is a string, is a table: constant data with the constant's name.
func constant_declaration(flags: byte)
  var name: word
  var t: byte
  var line: word
  var col: word
  var region: word
  var symbol: word
  var s: word
  lex.next()
  name = parts.new_name(kernel.SCOPE_MODULE)
  t = typetab.NO_TYPE
  if lex.tok == lex.T_COLON then
    lex.next()
    line = lex.line
    col = lex.col
    t = expr.type_spec()
    err.position(line, col)
    parts.layout(t)
  end
  region = 0
  if lex.tok == lex.T_IN then
    region = parts.region_name()
  end
  lex.expect(lex.T_ASSIGN, err.E_SYNTAX)
  parts.no_record(t)
  if t == typetab.NO_TYPE and lex.tok == lex.T_STRING then
    t = typetab.array_of(typetab.BYTE_TYPE, lex.string_length + 1, false)
  end
  if typetab.is_array(t) then
    symbol = out.symbol(out.SYM_DATA, kernel.module_name[0], 0, name)
    expr.data_region = region
    expr.table_data(t, symbol)
    expr.data_region = 0
    s = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_CONST)
    kernel.set_byte(s, kernel.C_FLAGS, flags)
    kernel.set_byte(s, kernel.C_TYPE, t)
    kernel.set_word(s, kernel.C_OBJ, symbol)
    if region != 0 then
      kernel.set_byte(s, kernel.C_FLAGS, flags | kernel.SF_IN)
      kernel.set_word(s, kernel.C_VALUE, region)
    end
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
    return
  end
  if region != 0 then
    parts.not_in_region()
  end
  line = lex.line
  col = lex.col
  expr.constant(t)
  if reg.op_kind[reg.depth - 1] != reg.O_CONST then
    err.position(line, col)
    err.fatal(err.E_NOT_CONST)
  end
  s = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_CONST)
  kernel.set_byte(s, kernel.C_FLAGS, flags)
  kernel.set_byte(s, kernel.C_TYPE, reg.op_type[reg.depth - 1])
  kernel.set_word(s, kernel.C_VALUE, reg.op_value[reg.depth - 1])
  reg.pop()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; The object-file symbol of the function of initial values: `module.$init`, or with a number
; after it for one written out early.
func init_symbol(number: byte): word
  var i: byte
  kernel.name_begin()
  for i = 0 until len(INIT_NAME) do
    kernel.name_add(INIT_NAME[i])
  end
  if number >= 10 then
    kernel.name_add(C_ZERO + number / 10)
  end
  if number > 0 then
    kernel.name_add(C_ZERO + number mod 10)
  end
  return out.symbol(out.SYM_FUNCTION, kernel.module_name[0], 0, kernel.name_end())
end

; The list of initial values is getting long: write a function for what it holds now. The next
; such function, or `module.$init` itself, calls it first.
func init_early()
  init_parts += 1
  gen.init_function(init_symbol(init_parts))
end

; Every function declared `forward` must have had its body.
func check_bodies()
  var s: word
  for s = 0 until kernel.sym_count do
    if kernel.byte_of(s, kernel.C_SCOPE) == kernel.SCOPE_MODULE and kernel.byte_of(s, kernel.C_KIND) == kernel.K_FUNC and
        kernel.byte_of(s, kernel.C_FLAGS) & kernel.SF_FORWARD != 0 then
      err.fatal(err.E_NO_BODY)
    end
  end
end

func type_symbol(name: word, flags: byte): word
  var s: word
  s = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_TYPE)
  kernel.set_byte(s, kernel.C_FLAGS, flags)
  return s
end

; "record" NL { name ":" type NL } "end", for the type that `s` declares. Its symbol and type
; exist before the fields are read, so a field can point to the record.
func record_type(s: word)
  var t: byte
  var name: word
  var line: word
  var col: word
  var f: byte
  t = typetab.declared(typetab.FORM_RECORD, s)
  kernel.set_byte(s, kernel.C_TYPE, t)
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  while lex.tok != lex.T_END do
    name = parts.new_name(kernel.SCOPE_FIELDS + t)
    lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
    line = lex.line
    col = lex.col
    f = expr.type_spec()
    err.position(line, col)
    parts.layout(f)
    if typetab.innermost(f) == t then
      err.fatal(err.E_RECORD_SELF)
    end
    add_field(s, name, f)
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  end
  if typetab.size(t) == 0 then
    err.fatal(err.E_EMPTY_RECORD)
  end
  lex.next()
end

; funcType = [ "recursive" ] "func" "(" [ param { "," param } ] ")" [ ":" type [ "," "bool" ] ],
; for the type that `s` declares: its parameters and results are the members of `s`, as a
; function's are. The names of the parameters are only read.
func function_type(s: word)
  var t: byte
  var count: byte
  t = typetab.declared(typetab.FORM_FUNC, s)
  kernel.set_byte(s, kernel.C_TYPE, t)
  if lex.tok == lex.T_RECURSIVE then
    typetab.make_recursive(t)
    lex.next()
    if lex.tok != lex.T_FUNC then
      err.fatal(err.E_FUNC_EXPECTED)
    end
  end
  lex.next()
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  count = 0
  if lex.tok != lex.T_RPAREN then
    loop
      if lex.tok != lex.T_NAME then
        err.fatal(err.E_NAME_EXPECTED)
      end
      lex.next()
      lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
      member(s, true, count, gen.REG_NONE)
      count += 1
      if lex.tok != lex.T_COMMA then
        break
      end
      lex.next()
    end
  end
  lex.expect(lex.T_RPAREN, err.E_RPAREN_EXPECTED)
  kernel.set_byte(s, kernel.C_PARAMS, count)
  kernel.set_byte(s, kernel.C_RESULTS, results(s, true, count))
end

; typeDecl = "type" name "=" ( type | recordType | funcType ) NL.
func type_declaration(flags: byte)
  var name: word
  var line: word
  var col: word
  var t: byte
  lex.next()
  name = parts.new_name(kernel.SCOPE_MODULE)
  lex.expect(lex.T_ASSIGN, err.E_SYNTAX)
  if lex.tok == lex.T_RECORD then
    record_type(type_symbol(name, flags))
  elif lex.tok == lex.T_FUNC or lex.tok == lex.T_RECURSIVE then
    function_type(type_symbol(name, flags))
  else
    line = lex.line
    col = lex.col
    t = expr.type_spec()
    err.position(line, col)
    parts.layout(t)
    kernel.set_byte(type_symbol(name, flags), kernel.C_TYPE, t)
  end
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; enumDecl = "enum" name NL { name [ "=" constExpr ] NL } "end" NL. The constants are numbered on
; from the one before, from 0; each must fit a byte.
func enum_declaration(flags: byte)
  var s: word
  var t: byte
  var value: word
  var line: word
  var col: word
  var name: word
  var c: word
  lex.next()
  s = type_symbol(parts.new_name(kernel.SCOPE_MODULE), flags)
  t = typetab.declared(typetab.FORM_ENUM, s)
  kernel.set_byte(s, kernel.C_TYPE, t)
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  value = 0
  while lex.tok != lex.T_END do
    line = lex.line
    col = lex.col
    name = parts.new_name(kernel.SCOPE_MODULE)
    if lex.tok == lex.T_ASSIGN then
      lex.next()
      line = lex.line
      col = lex.col
      value = expr.constant_number()
    end
    if value > $FF then
      err.position(line, col)
      err.fatal(err.E_RANGE)
    end
    c = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_CONST)
    kernel.set_byte(c, kernel.C_FLAGS, flags)
    kernel.set_byte(c, kernel.C_TYPE, t)
    kernel.set_word(c, kernel.C_VALUE, value)
    value += 1
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  end
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; declaration = [ "pub" ] ( constDecl | typeDecl | enumDecl | varDecl | funcDecl | externDecl |
; asmFunc ) | "forward" funcHead NL.
func declaration()
  var flags: byte
  flags = 0
  if lex.tok == lex.T_FORWARD then
    lex.next()
    if lex.tok == lex.T_RECURSIVE then
      flags = kernel.SF_RECURSIVE
      lex.next()
    end
    if lex.tok != lex.T_FUNC then
      err.fatal(err.E_FUNC_EXPECTED)
    end
    function_declaration(kernel.SF_FORWARD | flags)
    return
  end
  if lex.tok == lex.T_PUB then
    flags = kernel.SF_PUB
    lex.next()
  end
  if lex.tok == lex.T_RECURSIVE then
    lex.next()
    if lex.tok == lex.T_INLINE or lex.tok == lex.T_INTERRUPT then
      err.fatal(err.E_ATTRIBUTES)
    end
    if lex.tok == lex.T_EXTERN or lex.tok == lex.T_ASM then
      err.fatal(err.E_RECURSIVE_BODY)
    end
    if lex.tok != lex.T_FUNC then
      err.fatal(err.E_FUNC_EXPECTED)
    end
    function_declaration(flags | kernel.SF_RECURSIVE)
  elif lex.tok == lex.T_EXTERN then
    extern_declaration(flags)
  elif lex.tok == lex.T_FUNC then
    function_declaration(flags)
  elif lex.tok == lex.T_ASM then
    asm_function_declaration(flags)
  elif lex.tok == lex.T_INLINE or lex.tok == lex.T_INTERRUPT then
    attributed_declaration(flags)
  elif lex.tok == lex.T_CONST then
    constant_declaration(flags)
  elif lex.tok == lex.T_TYPE then
    type_declaration(flags)
  elif lex.tok == lex.T_ENUM then
    enum_declaration(flags)
  elif lex.tok == lex.T_VAR then
    expr.variable(flags, expr.LEVEL_MODULE)
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  elif lex.tok == lex.T_HASH_IF then
    expr.directive()
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  elif lex.tok == lex.T_STATIC then
    err.fatal(err.E_UNSUPPORTED)
  else
    err.fatal(err.E_DECL_EXPECTED)
  end
end

; unit = "module" name NL { "import" name NL } { declaration }. Compiles the source that has just
; been opened, to its end.
pub func unit()
  lex.next()
  module_line()
  while lex.tok == lex.T_IMPORT or lex.tok == lex.T_HASH_IF do
    if lex.tok == lex.T_IMPORT then
      import_line()
    else
      declaration()
    end
  end
  while lex.tok != lex.T_EOF do
    if gen.init_count >= gen.INIT_FLUSH then
      init_early()
    end
    declaration()
  end
  check_bodies()
  lasting_variables(0, kernel.SCOPE_MODULE)
  if gen.init_count > 0 or init_parts > 0 then
    gen.init_function(init_symbol(0))
  end
end
