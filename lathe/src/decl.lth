; DECL: declarations, and interface files. lathe/host/decl.py in Lathe.
;
; Owns the parsing of a module from its first line to its last, apart from what is inside a
; function body (STMT) or a value (EXPR); what the kernel's symbol columns mean for each kind of
; symbol; the names the language declares itself; and the interface file, which is written from
; the symbol table when the module ends and read back into it by `import`. The format of the
; interface file is in lathe/host/README.md.
;
; It also sees to what is written when a function or the module ends: the VAR records of
; variables, whose weights are complete only then, and the function `module.$init`.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | RECURSIVE = ["read_interface"]       | `recursive` on read_interface and | every function  |
;   |                                      | imported_module, which call each  | on a cycle must |
;   |                                      | other, and a forward recursive    | be (link error) |
;   |                                      | declaration                       |                 |
;   | the module `inline`                  | the module `inlines`              | `inline` is a   |
;   |                                      |                                   | keyword         |
;   | ENDING, REGISTERS, CONSTANTS,        | constant tables of bytes, as long | a table is not  |
;   | BUILTINS, INIT_NAME, REGISTER_PARTS: | as the text (no zero after it)    | a value; len()  |
;   | byte strings, and len(text)          |                                   | is the length   |
;   | directory: ints that index env.mem   | ^byte                             | lathe/src/      |
;   |                                      |                                   | sys.lth,        |
;   |                                      |                                   | "Pointers"      |
;   | `x, _ = f()`                         | a variable `at_end`, `found`,     | no `_`          |
;   |                                      | `fresh` or `ok`                   |                 |
;   | typetab.base(t) of a pointer or an   | byte(typetab.base(t))             | it is a word: a |
;   | array: its base type                 |                                   | record's is its |
;   |                                      |                                   | symbol          |
;   | number // 10, number % 10            | number / 10, number mod 10        |                 |
;   | `while True:`                        | `loop`                            |                 |
;   | init(), directory_add(), unit(),     | `pub`; everything else private    | lathec calls    |
;   | write_interface(): module functions  |                                   | them            |
;   | the functions used before they are   | forward declarations              | declare before  |
;   | defined                              |                                   | use             |
;   | `return 0` after err.fatal()         | the same                          | the end of a    |
;   |                                      |                                   | function with a |
;   |                                      |                                   | result must not |
;   |                                      |                                   | be reachable    |
module decl

import asmblock (function_body)
import err (E_AT_EXPECTED, E_ATTRIBUTES, E_BAD_INTERFACE, E_COLON_EXPECTED, E_CREATE,
            E_DECL_EXPECTED, E_DIRS_FULL, E_EMPTY_RECORD, E_END_EXPECTED, E_FORWARD,
            E_FUNC_EXPECTED, E_IN_EXPECTED, E_INTERRUPT_HEAD, E_LISTED_TWICE, E_LPAREN_EXPECTED,
            E_MEMBERS_FULL, E_MODULE_EXPECTED, E_MODULE_NAME, E_NAME_EXPECTED, E_NL_EXPECTED,
            E_NO_BODY, E_NO_INTERFACE, E_NOT_CONST, E_NOT_EXPORTED, E_RANGE, E_RECORD_SELF,
            E_RECURSIVE_BODY, E_REG_TYPE, E_REG_USED, E_REGISTER_EXPECTED, E_RPAREN_EXPECTED,
            E_SELF_IMPORT, E_SYNTAX, E_TYPE, E_TYPE_MODULE, E_UNSUPPORTED, E_WANTS_FULL, fatal,
            position)
import expr (constant, constant_number, data_region, directive, function_body, LEVEL_MODULE,
             table_data, type_spec, value_type, variable)
import gen (cpu, function_begin, function_end, init_count, INIT_FLUSH, init_function,
            interrupt_entry, receive, REG_A, REG_AX, REG_C, REG_NONE, REG_Y, saves_frame)
import inlines (read, read_name, save, SF_INLINE, SF_INTERRUPT, skip, skip_name, write, write_uses)
import kernel (built_is, built_loaded, byte_of, C_FLAGS, C_KIND, C_MEMBERS, C_NAME, C_OBJ, C_PARAMS,
               C_RESULTS, C_SCOPE, C_TYPE, C_VALUE, C_WEIGHT, close, freeze, freeze_member, get,
               get_word, K_BUILTIN, K_CONST, K_FIELD, K_FUNC, K_LOCAL, K_MODULE, K_TYPE, K_VAR,
               local_base, local_names, MAX_MODULES, MAX_NAME, member_add, member_type_of,
               member_value_of, module_add, module_count, module_name, name_add, name_begin,
               name_char, name_end, name_hash, name_length, name_top, new_hash, NO_OBJ, open_in,
               open_out, path_add, path_add_name, path_add_text, path_begin, path_end, put,
               put_name, put_word, scope_begin, scope_end, SCOPE_FIELDS, SCOPE_LOCAL, SCOPE_MODULE,
               SCOPE_PREDECLARED, set_byte, set_word, SF_ASM, SF_AT, SF_EXTERN, SF_FORWARD,
               SF_HIDDEN, SF_IN, SF_LIST, SF_NOZP, SF_PUB, SF_RECURSIVE, SF_ZP, sym_add, sym_count,
               sym_find, sym_thawed, word_of)
