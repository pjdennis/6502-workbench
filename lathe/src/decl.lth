            T_CONST, T_END, T_ENUM, T_EOF, T_EXTERN, T_FORWARD, T_FUNC, T_HASH_IF, T_IMPORT, T_IN,
            T_INLINE, T_INTERRUPT, T_LPAREN, T_MODULE, T_NAME, T_NL, T_PUB, T_RECORD, T_RECURSIVE,
            T_RPAREN, T_STATIC, T_STRING, T_TYPE, T_VAR, tok, value)
