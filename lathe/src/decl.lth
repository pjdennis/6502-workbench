; DECL: declarations, and interface files. lathe/host/decl.py in Lathe.
;
; Owns the parsing of a module from its first line to its last, apart from what is inside a
; function body (STMT) or a value (EXPR); what the kernel's symbol columns mean for each kind of
; symbol; the names the language declares itself; and the interface file, which is written from
; the symbol table when the module ends and read back into it by `import`. The format of the
; interface file is in lathe/host/README.md.
;
; It also sees to what is written when a function or the module ends: the VAR records of
; variables, whose weights are complete only then, and the function `module.$init`.
;
; Where the Lathe differs from the Python:
;
;   | Python                               | Lathe                             | Why             |
;   |--------------------------------------|-----------------------------------|-----------------|
;   | RECURSIVE = ["read_interface"]       | `recursive` on read_interface and | every function  |
;   |                                      | imported_module, which call each  | on a cycle must |
;   |                                      | other, and a forward recursive    | be (link error) |
;   |                                      | declaration                       |                 |
;   | the module `inline`                  | the module `inlines`              | `inline` is a   |
;   |                                      |                                   | keyword         |
;   | ENDING, REGISTERS, CONSTANTS,        | constant tables of bytes, as long | a table is not  |
;   | BUILTINS, INIT_NAME, REGISTER_PARTS: | as the text (no zero after it)    | a value; len()  |
;   | byte strings, and len(text)          |                                   | is the length   |
;   | directory: ints that index env.mem   | ^byte                             | lathe/src/      |
;   |                                      |                                   | sys.lth,        |
;   |                                      |                                   | "Pointers"      |
;   | `x, _ = f()`                         | a variable `at_end`, `found`,     | no `_`          |
;   |                                      | `fresh` or `ok`                   |                 |
;   | typetab.base(t) of a pointer or an   | byte(typetab.base(t))             | it is a word: a |
;   | array: its base type                 |                                   | record's is its |
;   |                                      |                                   | symbol          |
;   | number // 10, number % 10            | number / 10, number mod 10        |                 |
;   | `while True:`                        | `loop`                            |                 |
;   | init(), directory_add(), unit(),     | `pub`; everything else private    | lathec calls    |
;   | write_interface(): module functions  |                                   | them            |
;   | the functions used before they are   | forward declarations              | declare before  |
;   | defined                              |                                   | use             |
;   | `return 0` after err.fatal()         | the same                          | the end of a    |
;   |                                      |                                   | function with a |
;   |                                      |                                   | result must not |
;   |                                      |                                   | be reachable    |
module decl

import asmblock
import err
import expr
import gen
import inlines
import kernel
import lex
import out
import reg
import typetab

; ---- Interface files ---------------------------------------------------------------------

const LI_VERSION = 1
const LI_END = 0                ; entry kinds
const LI_FUNC = 1
const LI_CONST = 2
const LI_VAR = 3
const LI_TYPE = 4               ; a named type: flags, then its type
const LI_RECORD = 5             ; a record type declared here: flags, number of fields, each a name and a type
const LI_ENUM = 6               ; an enumeration declared here: flags. Its constants follow as constants
const LI_FUNC_TYPE = 7          ; a function type declared here: flags, then parameters and results
const LI_MODULE = 8             ; a module this one imports, which its exported inline functions can name
const LI_CONST_IN = 9           ; a constant table `in REGION`: as LI_CONST, then the region's name
const LI_PUB = 1                ; flag of those four: exported (the others are there for the types of what is)
const LI_EXTERN = 1             ; function flag: at a fixed address, which follows the flags
const LI_RECURSIVE = 2          ; function and function type flag: declared `recursive`
const LI_ASM = 4                ; function flag: an `asm` function, called like an extern one
const LI_INLINE = 8             ; function flag: an `inline` function, whose saved tokens follow its members
const LI_INTERRUPT = 16         ; function flag: an `interrupt` function, which cannot be called
const LI_AT = 1                 ; what a variable's placement byte can be: at a fixed address, which
const LI_ZP = 2                 ; follows it; declared `zp`; declared `nozp`; or 0
const LI_NOZP = 4
const LI_IN = 8                 ; `in REGION` (and so never in zero page): the region's name follows
const LI_POINTER = $10          ; type: a pointer to the type that follows; a basic type is its number
const LI_ARRAY = $11            ; type: an array, stored by column: its length (2), then its element type
const LI_ROWS = $12             ; the same, stored by row
const LI_NAMED = $13            ; type: a record, an enumeration or a function type, as the name of its
;                                 module and its own name

const MAX_DIRS = 8
const C_SLASH = $2F
const C_UPPER_L = $4C
const C_UPPER_I = $49
const ENDING: [3]byte = ".li"

var directory: [MAX_DIRS]^byte  ; pointers to the names of the directories to look in, in order
var directory_count: byte = 0

; The entry being read, until it is frozen (kernel.freeze()): its name, and its members
const MAX_ENTRY_MEMBERS = 64
var entry_name: [kernel.MAX_NAME]byte
var entry_length: byte = 0
var entry_type: [MAX_ENTRY_MEMBERS]byte
var entry_register: [MAX_ENTRY_MEMBERS]byte
var entry_members: byte = 0

; ---- Predeclared names -------------------------------------------------------------------

const REGISTERS: [17]byte = "a x y ax ay xy c "    ; in the order of gen.REG_A to gen.REG_C
const CONSTANTS: [15]byte = "false true nil "      ; the bool constants in the order of their values, nil
const BUILTINS: [17]byte = "lo hi sizeof len "     ; in the order of expr.B_LO to expr.B_LEN
const INIT_NAME: [5]byte = "$init"                 ; no source name can be this
const REGISTER_COUNT = 8
const REGISTER_PARTS: [8]byte = [$00, $01, $02, $04, $03, $05, $06, $08]   ; which of A, X, Y and carry each uses
const C_SPACE = $20
const C_ZERO = $30

var register_name: [REGISTER_COUNT]word
var init_parts: byte = 0        ; how many functions of initial values have been written out early

; Declare what the language declares. Needs the keywords to have their tokens.
pub func init()
  var register: byte
  var i: byte
  var s: word
  var value: word
  directory_count = 0
  init_parts = 0
  register = gen.REG_A
  kernel.name_begin()
  for i = 0 until len(REGISTERS) do
    if REGISTERS[i] == C_SPACE then
      register_name[register] = kernel.name_end()
      register += 1
      kernel.name_begin()
    else
      kernel.name_add(REGISTERS[i])
    end
  end
  value = 0
  for i = 0 until len(CONSTANTS) do
    if CONSTANTS[i] == C_SPACE then
      s = kernel.sym_add(kernel.SCOPE_PREDECLARED, kernel.name_end(), kernel.K_CONST)
      kernel.sym_type[s] = typetab.BOOL_TYPE
      kernel.sym_value[s] = value
      if value == 2 then
        kernel.sym_type[s] = typetab.NIL_TYPE
        kernel.sym_value[s] = 0
      end
      value += 1
      kernel.name_begin()
    else
      kernel.name_add(CONSTANTS[i])
    end
  end
  value = 0
  for i = 0 until len(BUILTINS) do
    if BUILTINS[i] == C_SPACE then
      s = kernel.sym_add(kernel.SCOPE_PREDECLARED, kernel.name_end(), kernel.K_BUILTIN)
      kernel.sym_value[s] = value
      value += 1
      kernel.name_begin()
    else
      kernel.name_add(BUILTINS[i])
    end
  end
end

; Interfaces are looked for in the directory whose name is at `name`, after those added before.
pub func directory_add(name: ^byte)
  if directory_count == MAX_DIRS then
    err.fatal(err.E_DIRS_FULL)
  end
  directory[directory_count] = name
  directory_count += 1
end

; Pointer to the file name of a module's interface in a directory.
func interface_path(directory_name: ^byte, module_name: word): ^byte
  var i: byte
  kernel.path_begin()
  kernel.path_add_text(directory_name)
  kernel.path_add(C_SLASH)
  kernel.path_add_name(module_name)
  for i = 0 until len(ENDING) do
    kernel.path_add(ENDING[i])
  end
  return kernel.path_end()
end

; ---- Writing the interface ---------------------------------------------------------------

func write_type(stream: byte, t: byte)
  var s: word
  while typetab.is_pointer(t) or typetab.is_array(t) do
    if typetab.is_pointer(t) then
      kernel.put(stream, LI_POINTER)
    else
      kernel.put(stream, LI_ARRAY + typetab.form[t] - typetab.FORM_ARRAY)
      kernel.put_word(stream, typetab.length(t))
    end
    t = byte(typetab.base(t))
  end
  if typetab.is_record(t) or typetab.is_enum(t) or typetab.is_func(t) then
    s = typetab.base(t)
    kernel.put(stream, LI_NAMED)
    kernel.put_name(stream, kernel.module_name[kernel.sym_scope[s]])
    kernel.put_name(stream, kernel.sym_name[s])
  else
    kernel.put(stream, t)
  end
end

forward func write_signature(stream: byte, s: word)

; A type entry: a record, an enumeration or a function type that `s` declares, or another name
; for a type. Every record, enumeration and function type is written, so that what is exported
; can use them; one not `pub` is known to an importer but cannot be named there. Another name
; for a type is written only if it is `pub`.
func write_named_type(stream: byte, s: word)
  var t: byte
  var kind: byte
  var flags: byte
  var f: word
  t = kernel.sym_type[s]
  kind = LI_TYPE
  if (typetab.is_record(t) or typetab.is_enum(t) or typetab.is_func(t)) and typetab.base(t) == s then
    kind = LI_RECORD + typetab.form[t] - typetab.FORM_RECORD
  elif kernel.sym_flags[s] & kernel.SF_PUB == 0 then
    return
  end
  kernel.put(stream, kind)
  kernel.put_name(stream, kernel.sym_name[s])
  flags = 0
  if kernel.sym_flags[s] & kernel.SF_PUB != 0 then
    flags = LI_PUB
  end
  if kind == LI_FUNC_TYPE and typetab.is_recursive(t) then
    flags = flags | LI_RECURSIVE
  end
  kernel.put(stream, flags)
  if kind == LI_FUNC_TYPE then
    write_signature(stream, s)
  elif kind == LI_TYPE then
    write_type(stream, t)
  elif kind == LI_RECORD then
    kernel.put(stream, kernel.sym_params[s])
    for f = s + 1 until s + 1 + kernel.sym_params[s] do
      kernel.put_name(stream, kernel.sym_name[f])
      write_type(stream, kernel.sym_type[f])
    end
  end
end

func write_members(stream: byte, first: word, count: byte)
  var m: word
  kernel.put(stream, count)
  for m = first until first + count do
    write_type(stream, kernel.member_type[m])
    kernel.put(stream, kernel.member_value[m])
  end
end

; The parameters and results of function or function type `s`.
func write_signature(stream: byte, s: word)
  write_members(stream, kernel.sym_members[s], kernel.sym_params[s])
  write_members(stream, kernel.sym_members[s] + kernel.sym_params[s], kernel.sym_results[s])
end

func write_function(stream: byte, s: word)
  kernel.put(stream, LI_FUNC)
  kernel.put_name(stream, kernel.sym_name[s])
  if kernel.sym_flags[s] & kernel.SF_EXTERN != 0 then
    kernel.put(stream, LI_EXTERN)
    kernel.put_word(stream, kernel.sym_value[s])
  elif kernel.sym_flags[s] & kernel.SF_ASM != 0 then
    kernel.put(stream, LI_ASM)
  elif kernel.sym_flags[s] & kernel.SF_RECURSIVE != 0 then
    kernel.put(stream, LI_RECURSIVE)
  elif kernel.sym_flags[s] & inlines.SF_INLINE != 0 then
    kernel.put(stream, LI_INLINE)
  elif kernel.sym_flags[s] & inlines.SF_INTERRUPT != 0 then
    kernel.put(stream, LI_INTERRUPT)
  else
    kernel.put(stream, 0)
  end
  write_signature(stream, s)
  if kernel.sym_flags[s] & inlines.SF_INLINE != 0 then
    inlines.write(stream, s)
  end
end

func write_constant(stream: byte, s: word)
  if kernel.sym_flags[s] & kernel.SF_IN != 0 then
    kernel.put(stream, LI_CONST_IN)
    kernel.put_name(stream, kernel.sym_name[s])
    write_type(stream, kernel.sym_type[s])
    kernel.put_word(stream, 0)
    kernel.put_name(stream, kernel.sym_value[s])
    return
  end
  kernel.put(stream, LI_CONST)
  kernel.put_name(stream, kernel.sym_name[s])
  write_type(stream, kernel.sym_type[s])
  kernel.put_word(stream, kernel.sym_value[s])
end

func write_variable(stream: byte, s: word)
  kernel.put(stream, LI_VAR)
  kernel.put_name(stream, kernel.sym_name[s])
  write_type(stream, kernel.sym_type[s])
  if kernel.sym_flags[s] & kernel.SF_AT != 0 then
    kernel.put(stream, LI_AT)
    kernel.put_word(stream, kernel.sym_value[s])
  elif kernel.sym_flags[s] & kernel.SF_IN != 0 then
    kernel.put(stream, LI_IN)
    kernel.put_name(stream, kernel.sym_value[s])
  elif kernel.sym_flags[s] & kernel.SF_ZP != 0 then
    kernel.put(stream, LI_ZP)
  elif kernel.sym_flags[s] & kernel.SF_NOZP != 0 then
    kernel.put(stream, LI_NOZP)
  else
    kernel.put(stream, 0)
  end
end

; Write what the module exports to its interface file in the directory named.
pub func write_interface(directory_name: ^byte)
  var stream: byte
  var ok: bool
  var expands: bool
  var s: word
  stream, ok = kernel.open_out(interface_path(directory_name, kernel.module_name[0]))
  if not ok then
    err.fatal(err.E_CREATE)
  end
  kernel.put(stream, C_UPPER_L)
  kernel.put(stream, C_UPPER_I)
  kernel.put(stream, LI_VERSION)
  kernel.put_name(stream, kernel.module_name[0])
  expands = false                       ; an importer may expand an inline function of this one
  for s = 0 until kernel.sym_count do
    if kernel.sym_scope[s] == kernel.SCOPE_MODULE and kernel.sym_kind[s] == kernel.K_FUNC and
        kernel.sym_flags[s] & (kernel.SF_PUB | inlines.SF_INLINE) == kernel.SF_PUB | inlines.SF_INLINE then
      expands = true
    end
  end
  for s = 0 until kernel.sym_count do
    if kernel.sym_scope[s] == kernel.SCOPE_MODULE and kernel.sym_kind[s] == kernel.K_TYPE then
      write_named_type(stream, s)
    elif kernel.sym_scope[s] == kernel.SCOPE_MODULE and kernel.sym_kind[s] == kernel.K_MODULE then
      if expands then
        kernel.put(stream, LI_MODULE)
        kernel.put_name(stream, kernel.sym_name[s])
      end
    elif kernel.sym_scope[s] == kernel.SCOPE_MODULE and kernel.sym_flags[s] & kernel.SF_PUB != 0 then
      if kernel.sym_kind[s] == kernel.K_FUNC then
        write_function(stream, s)
      elif kernel.sym_kind[s] == kernel.K_CONST then
        write_constant(stream, s)
      else
        write_variable(stream, s)
      end
    end
  end
  kernel.put(stream, LI_END)
  kernel.close(stream)
end

; ---- Reading an interface ----------------------------------------------------------------

forward func imported_type(stream: byte): byte

func read_type(stream: byte): byte
  var mark: byte
  var t: byte
  var at_end: bool
  mark = typetab.prefix_count
  t, at_end = kernel.get(stream)
  while t == LI_POINTER or t == LI_ARRAY or t == LI_ROWS do
    if t == LI_POINTER then
      typetab.prefix(typetab.FORM_POINTER, 0)
    else
      typetab.prefix(typetab.FORM_ARRAY + t - LI_ARRAY, kernel.get_word(stream))
    end
    t, at_end = kernel.get(stream)
  end
  if t == LI_NAMED then
    t = imported_type(stream)
  elif t < typetab.BYTE_TYPE or t > typetab.NIL_TYPE then
    err.fatal(err.E_BAD_INTERFACE)
  end
  return typetab.build(t, mark)
end

; A record, an enumeration or a function type given by the name of its module and its own: the
; module must have been imported already, and is in a scope of its own number.
func imported_type(stream: byte): byte
  var name: word
  var scope: byte
  var s: word
  var found: bool
  name = inlines.read_name(stream)
  scope = 1
  while scope < kernel.module_count and kernel.module_name[scope] != name do
    scope += 1
  end
  if scope == kernel.module_count then
    err.fatal(err.E_TYPE_MODULE)
  end
  s, found = kernel.sym_find(scope, inlines.read_name(stream))
  if not found or kernel.sym_kind[s] != kernel.K_TYPE then
    err.fatal(err.E_BAD_INTERFACE)
  end
  return kernel.sym_type[s]
end

forward func read_signature(stream: byte, s: word)
forward func add_field(s: word, name: word, t: byte)

; A type entry of kind LI_TYPE, LI_RECORD, LI_ENUM or LI_FUNC_TYPE.
func read_named_type(stream: byte, scope: byte, kind: byte)
  var s: word
  var flags: byte
  var at_end: bool
  var t: byte
  var count: byte
  var i: byte
  var name: word
  s = kernel.sym_add(scope, inlines.read_name(stream), kernel.K_TYPE)
  flags, at_end = kernel.get(stream)
  if flags & LI_PUB != 0 then
    kernel.sym_flags[s] = kernel.SF_PUB
  end
  if kind == LI_TYPE then
    kernel.sym_type[s] = read_type(stream)
    return
  end
  t = typetab.declared(typetab.FORM_RECORD + kind - LI_RECORD, s)
  kernel.sym_type[s] = t
  if kind == LI_FUNC_TYPE then
    if flags & LI_RECURSIVE != 0 then
      typetab.make_recursive(t)
    end
    read_signature(stream, s)
    return
  end
  if kind == LI_ENUM then
    return
  end
  count, at_end = kernel.get(stream)
  for i = 0 until count do
    name = inlines.read_name(stream)
    add_field(s, name, read_type(stream))
  end
end

; A field called `name` of type `t` after the others of the record that `s` declares.
func add_field(s: word, name: word, t: byte)
  var r: byte
  var f: word
  r = kernel.sym_type[s]
  f = kernel.sym_add(kernel.SCOPE_FIELDS + r, name, kernel.K_FIELD)
  kernel.sym_type[f] = t
  kernel.sym_value[f] = typetab.grow(r, typetab.size(t))
  kernel.sym_params[s] += 1
end

; Read parameters or results as members of the newest symbol. Returns how many.
func read_members(stream: byte): byte
  var count: byte
  var at_end: bool
  var i: byte
  var t: byte
  var register: byte
  count, at_end = kernel.get(stream)
  for i = 0 until count do
    t = read_type(stream)
    register, at_end = kernel.get(stream)
    kernel.member_add(t, register)
  end
  return count
end

; The parameters and results of function or function type `s`, the newest symbol.
func read_signature(stream: byte, s: word)
  kernel.sym_params[s] = read_members(stream)
  kernel.sym_results[s] = read_members(stream)
end

; The name of an entry, which is not made a name yet: its characters are kept in entry_name, the
; first kernel.MAX_NAME of them, as a name keeps them.
func read_entry_name(stream: byte)
  var length: byte
  var at_end: bool
  var i: byte
  var ch: byte
  length, at_end = kernel.get(stream)
  entry_length = 0
  for i = 0 until length do
    ch, at_end = kernel.get(stream)
    if entry_length < kernel.MAX_NAME then
      entry_name[entry_length] = ch
      entry_length += 1
    end
  end
end

; Build the entry's name in the name heap (kernel.name_begin()).
func entry_name_begin()
  var i: byte
  kernel.name_begin()
  for i = 0 until entry_length do
    kernel.name_add(entry_name[i])
  end
end

; Read parameters or results into the entry's members. Returns how many.
func read_entry_members(stream: byte): byte
  var count: byte
  var at_end: bool
  var i: byte
  var register: byte
  count, at_end = kernel.get(stream)
  for i = 0 until count do
    if entry_members == MAX_ENTRY_MEMBERS then
      err.fatal(err.E_MEMBERS_FULL)
    end
    entry_type[entry_members] = read_type(stream)
    register, at_end = kernel.get(stream)
    entry_register[entry_members] = register
    entry_members += 1
  end
  return count
end

; The entry read becomes a frozen symbol of module `scope` (kernel.freeze()).
func freeze(scope: byte, kind: byte, flags: byte, t: byte, value: word, params: byte, results: byte)
  var i: byte
  entry_name_begin()
  kernel.freeze(scope, kind, flags, t, value, params, results)
  for i = 0 until entry_members do
    kernel.freeze_member(entry_type[i], entry_register[i])
  end
end

; A function entry: frozen, unless it is `inline`, whose saved tokens are read now.
func read_function(stream: byte, scope: byte)
  var flags: byte
  var at_end: bool
  var s: word
  var symbol_flags: byte
  var value: word
  var params: byte
  var results: byte
  read_entry_name(stream)
  flags, at_end = kernel.get(stream)
  if flags & LI_INLINE != 0 then
    entry_name_begin()
    s = kernel.sym_add(scope, kernel.name_end(), kernel.K_FUNC)
    kernel.sym_flags[s] = kernel.SF_PUB | inlines.SF_INLINE
    read_signature(stream, s)
    inlines.read(stream, s)
    return
  end
  symbol_flags = kernel.SF_PUB
  value = 0
  if flags & LI_EXTERN != 0 then
    symbol_flags = kernel.SF_PUB | kernel.SF_EXTERN
    value = kernel.get_word(stream)
  end
  if flags & LI_ASM != 0 then
    symbol_flags = kernel.SF_PUB | kernel.SF_ASM
  end
  if flags & LI_RECURSIVE != 0 then
    symbol_flags = kernel.SF_PUB | kernel.SF_RECURSIVE
  end
  if flags & LI_INTERRUPT != 0 then
    symbol_flags = kernel.SF_PUB | inlines.SF_INTERRUPT
  end
  entry_members = 0
  params = read_entry_members(stream)
  results = read_entry_members(stream)
  freeze(scope, kernel.K_FUNC, symbol_flags, 0, value, params, results)
end

; A constant entry; `in_region` for a table in a region, whose name follows its value.
func read_constant(stream: byte, scope: byte, in_region: bool)
  var t: byte
  var value: word
  var flags: byte
  read_entry_name(stream)
  t = read_type(stream)
  entry_members = 0
  value = kernel.get_word(stream)
  flags = kernel.SF_PUB
  if in_region then
    flags = kernel.SF_PUB | kernel.SF_IN
    value = inlines.read_name(stream)
  end
  freeze(scope, kernel.K_CONST, flags, t, value, 0, 0)
end

func read_variable(stream: byte, scope: byte)
  var t: byte
  var placement: byte
  var at_end: bool
  var symbol_flags: byte
  var value: word
  read_entry_name(stream)
  t = read_type(stream)
  placement, at_end = kernel.get(stream)
  symbol_flags = kernel.SF_PUB
  value = 0
  if placement == LI_AT then
    symbol_flags = kernel.SF_PUB | kernel.SF_AT
    value = kernel.get_word(stream)
  elif placement == LI_ZP then
    symbol_flags = kernel.SF_PUB | kernel.SF_ZP
  elif placement == LI_NOZP then
    symbol_flags = kernel.SF_PUB | kernel.SF_NOZP
  elif placement == LI_IN then
    symbol_flags = kernel.SF_PUB | kernel.SF_NOZP | kernel.SF_IN
    value = inlines.read_name(stream)
  elif placement != 0 then
    err.fatal(err.E_BAD_INTERFACE)
  end
  entry_members = 0
  freeze(scope, kernel.K_VAR, symbol_flags, t, value, 0, 0)
end

forward recursive func read_interface(number: byte)

; An LI_MODULE entry: a module that the exported inline functions of module `scope` can name. It
; is imported too, if it is not already, and is a name of that module's scope, which the
; expansions of its inline functions see and the importer's own code does not.
recursive func imported_module(stream: byte, scope: byte)
  var name: word
  var m: byte
  name = inlines.read_name(stream)
  m = 1
  while m < kernel.module_count and kernel.module_name[m] != name do
    m += 1
  end
  if m == kernel.module_count then
    m = kernel.module_add(name)
    read_interface(m)
  end
  kernel.sym_value[kernel.sym_add(scope, name, kernel.K_MODULE)] = m
end

; The interface of the module called `name`, from the first directory that has one.
func open_interface(name: word): byte
  var i: byte
  var stream: byte
  var ok: bool
  for i = 0 until directory_count do
    stream, ok = kernel.open_in(interface_path(directory[i], name))
    if ok then
      return stream
    end
  end
  err.fatal(err.E_NO_INTERFACE)
  return 0
end

; Declare what module number `number` exports, as symbols in the scope of that number.
recursive func read_interface(number: byte)
  var stream: byte
  var letter_l: byte
  var letter_i: byte
  var version: byte
  var at_end: bool
  var kind: byte
  stream = open_interface(kernel.module_name[number])
  letter_l, at_end = kernel.get(stream)
  letter_i, at_end = kernel.get(stream)
  version, at_end = kernel.get(stream)
  if letter_l != C_UPPER_L or letter_i != C_UPPER_I or version != LI_VERSION then
    err.fatal(err.E_BAD_INTERFACE)
  end
  if inlines.read_name(stream) != kernel.module_name[number] then
    err.fatal(err.E_BAD_INTERFACE)
  end
  loop
    kind, at_end = kernel.get(stream)
    if at_end or kind > LI_CONST_IN then
      err.fatal(err.E_BAD_INTERFACE)    ; a file cut short has no LI_END
    end
    if kind == LI_END then
      break
    end
    if kind == LI_FUNC then
      read_function(stream, number)
    elif kind == LI_CONST or kind == LI_CONST_IN then
      read_constant(stream, number, kind == LI_CONST_IN)
    elif kind == LI_VAR then
      read_variable(stream, number)
    elif kind == LI_MODULE then
      imported_module(stream, number)
    else
      read_named_type(stream, number, kind)
    end
  end
  kernel.close(stream)
end

; ---- The module and its imports ----------------------------------------------------------

; "module" name NL. The name must be the file's.
func module_line()
  lex.expect(lex.T_MODULE, err.E_MODULE_EXPECTED)
  if lex.tok != lex.T_NAME then
    err.fatal(err.E_NAME_EXPECTED)
  end
  if lex.value != kernel.module_name[0] then
    err.fatal(err.E_MODULE_NAME)
  end
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  out.begin_module(gen.cpu, kernel.module_name[0])
end

; "import" name NL. The module's name becomes a symbol; what it exports is declared in a scope
; of its own and reached as name.member.
func import_line()
  var s: word
  var m: byte
  lex.next()
  if lex.tok != lex.T_NAME then
    err.fatal(err.E_NAME_EXPECTED)
  end
  if lex.value == kernel.module_name[0] then
    err.fatal(err.E_SELF_IMPORT)
  end
  s = kernel.sym_add(kernel.SCOPE_MODULE, lex.value, kernel.K_MODULE)
  ; An interface read before may have brought the module in, for its inline functions
  ; (imported_module()): that reading serves, and its names are not made twice.
  m = 1
  while m < kernel.module_count and kernel.module_name[m] != lex.value do
    m += 1
  end
  if m == kernel.module_count then
    m = kernel.module_add(lex.value)
    read_interface(m)
  end
  kernel.sym_value[s] = m
  out.imported(lex.value)
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; ---- Functions ---------------------------------------------------------------------------

; The name after "func": declare it as a function with these flags. If it was declared
; `forward`, that symbol is the one, and what follows must repeat that declaration. Returns the
; symbol and whether it is new.
func function_symbol(flags: byte): word, bool
  var s: word
  var found: bool
  if lex.tok != lex.T_NAME then
    err.fatal(err.E_NAME_EXPECTED)
  end
  s, found = kernel.sym_find(kernel.SCOPE_MODULE, lex.value)
  if found and kernel.sym_kind[s] == kernel.K_FUNC and kernel.sym_flags[s] & kernel.SF_FORWARD != 0 and
      flags & kernel.SF_FORWARD == 0 then
    if flags & (inlines.SF_INLINE | inlines.SF_INTERRUPT) != 0 then
      err.fatal(err.E_ATTRIBUTES)
    end
    if (kernel.sym_flags[s] ^ flags) & kernel.SF_RECURSIVE != 0 then
      err.fatal(err.E_FORWARD)
    end
    kernel.sym_flags[s] = flags
    lex.next()
    return s, false
  end
  s = kernel.sym_add(kernel.SCOPE_MODULE, lex.value, kernel.K_FUNC)
  kernel.sym_flags[s] = flags
  lex.next()
  return s, true
end

; register = "a" | "x" | "y" | "ax" | "ay" | "xy" | "c". These are not keywords: they are names
; with this meaning only here. Returns the register; the token is not passed over.
func register(): byte
  var r: byte
  if lex.tok == lex.T_NAME then
    for r = gen.REG_A until REGISTER_COUNT do
      if lex.value == register_name[r] then
        return r
      end
    end
  end
  err.fatal(err.E_REGISTER_EXPECTED)
  return gen.REG_NONE
end

; True if a value of type `t` can be in register `r`.
func register_suits(r: byte, t: byte): bool
  if r == gen.REG_C then
    return t == typetab.BOOL_TYPE
  end
  if r <= gen.REG_Y then
    return typetab.size(t) == 1
  end
  return typetab.size(t) == 2
end

; type "in" register: a parameter or result of the newest symbol. `used` says which of A, X, Y
; and carry are taken already; returns that with this member's added.
func bound_member(used: byte): byte
  var t: byte
  var r: byte
  t = expr.value_type()
  lex.expect(lex.T_IN, err.E_IN_EXPECTED)
  r = register()
  if not register_suits(r, t) then
    err.fatal(err.E_REG_TYPE)
  end
  if used & REGISTER_PARTS[r] != 0 then
    err.fatal(err.E_REG_USED)
  end
  lex.next()
  kernel.member_add(t, r)
  return used | REGISTER_PARTS[r]
end

; [ regParam { "," regParam } ] ")", after the "(". regParam = name ":" type "in" register.
; Returns how many.
func register_parameters(): byte
  var count: byte
  var used: byte
  count = 0
  used = 0
  if lex.tok != lex.T_RPAREN then
    loop
      if lex.tok != lex.T_NAME then
        err.fatal(err.E_NAME_EXPECTED)
      end
      lex.next()
      lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
      used = bound_member(used)
      count += 1
      if lex.tok != lex.T_COMMA then
        break
      end
      lex.next()
    end
  end
  lex.expect(lex.T_RPAREN, err.E_RPAREN_EXPECTED)
  return count
end

; [ ":" regResult [ "," regResult ] ]. regResult = type "in" register. Returns how many.
func register_results(): byte
  var used: byte
  if lex.tok != lex.T_COLON then
    return 0
  end
  lex.next()
  used = bound_member(0)
  if lex.tok != lex.T_COMMA then
    return 1
  end
  lex.next()
  bound_member(used)
  return 2
end

; externDecl = "extern" regHead "at" constExpr NL.
func extern_declaration(flags: byte)
  var s: word
  var fresh: bool
  lex.next()
  lex.expect(lex.T_FUNC, err.E_FUNC_EXPECTED)
  s, fresh = function_symbol(flags | kernel.SF_EXTERN)
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  kernel.sym_params[s] = register_parameters()
  kernel.sym_results[s] = register_results()
  lex.expect(lex.T_AT, err.E_AT_EXPECTED)
  kernel.sym_value[s] = expr.constant_number()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

forward func object_flags(s: word): byte

; "asm" regHead NL { asmLine NL } "end" NL: a function whose body is assembly, with its
; parameters and results in registers and no slots. It is called like an `extern` function, but
; through its symbol, with a CALL record.
func asm_function_declaration(flags: byte)
  var s: word
  var fresh: bool
  lex.next()
  lex.expect(lex.T_FUNC, err.E_FUNC_EXPECTED)
  s, fresh = function_symbol(flags | kernel.SF_ASM)
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  kernel.sym_params[s] = register_parameters()
  kernel.sym_results[s] = register_results()
  kernel.scope_begin()                  ; the names of its labels go when it ends
  gen.function_begin(reg.object_symbol(s))
  asmblock.function_body()
  gen.function_end(object_flags(s) | out.FUNC_REGISTERS)
  kernel.scope_end()
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; The flags of function `s` as its FUNC record has them.
func object_flags(s: word): byte
  var flags: byte
  flags = 0
  if kernel.sym_flags[s] & kernel.SF_PUB != 0 then
    flags = out.FUNC_EXPORTED
  end
  if kernel.sym_flags[s] & kernel.SF_RECURSIVE != 0 then
    flags = flags | out.FUNC_RECURSIVE
  end
  if kernel.sym_flags[s] & inlines.SF_INTERRUPT != 0 then
    flags = flags | out.FUNC_INTERRUPT
  end
  return flags
end

forward func result_register(t: byte): byte

; type: the type of parameter or result number `index` of function `s`, which is in `where`, or
; for a result in the place its type gives it. If the function is not `fresh`, this must be what
; the forward declaration said. Returns the type.
func member(s: word, fresh: bool, index: byte, where: byte): byte
  var line: word
  var col: word
  var t: byte
  line = lex.line
  col = lex.col
  t = expr.value_type()
  if where != gen.REG_NONE then
    where = result_register(t)
  end
  if fresh then
    kernel.member_add(t, where)
  elif index >= kernel.sym_params[s] + kernel.sym_results[s] or
      kernel.member_type[kernel.sym_members[s] + index] != t or
      kernel.member_value[kernel.sym_members[s] + index] != where then
    err.position(line, col)
    err.fatal(err.E_FORWARD)
  end
  return t
end

; [ param { "," param } ] ")", after the "(". param = name ":" type. Each is a slot of the frame,
; in order, and a local name. Returns how many.
func parameters(s: word, fresh: bool): byte
  var count: byte
  var name: word
  var t: byte
  var p: word
  count = 0
  if lex.tok != lex.T_RPAREN then
    loop
      name = expr.new_name(kernel.SCOPE_LOCAL)
      lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
      t = member(s, fresh, count, gen.REG_NONE)
      p = kernel.sym_add(kernel.SCOPE_LOCAL, name, kernel.K_LOCAL)
      kernel.sym_type[p] = t
      kernel.sym_value[p] = reg.new_slot(typetab.size(t), reg.CLASS_EITHER, reg.SLOT_PARAMETER,
          name)
      count += 1
      if lex.tok != lex.T_COMMA then
        break
      end
      lex.next()
    end
  end
  lex.expect(lex.T_RPAREN, err.E_RPAREN_EXPECTED)
  return count
end

; Where a result of type `t` is returned (docs/code-model.md, "Convention").
func result_register(t: byte): byte
  if t == typetab.BOOL_TYPE then
    return gen.REG_C
  end
  if typetab.size(t) == 2 then
    return gen.REG_AX
  end
  return gen.REG_A
end

; [ ":" type [ "," "bool" ] ]: nothing, a value, a status, or a value and a status. They are the
; members of `s` from number `index` on. Returns how many.
func results(s: word, fresh: bool, index: byte): byte
  var t: byte
  if lex.tok != lex.T_COLON then
    return 0
  end
  lex.next()
  t = member(s, fresh, index, gen.REG_A)
  if lex.tok != lex.T_COMMA then
    return 1
  end
  lex.next()
  if t == typetab.BOOL_TYPE or lex.tok != lex.T_BOOL then
    err.fatal(err.E_TYPE)
  end
  member(s, fresh, index + 1, gen.REG_C)
  return 2
end

; funcHead from its "(" on, for function `s`, which is declared for the first time if `fresh`
; and must otherwise repeat its forward declaration.
func head(s: word, fresh: bool)
  var count: byte
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  count = parameters(s, fresh)
  if fresh then
    kernel.sym_params[s] = count
  elif count != kernel.sym_params[s] then
    err.fatal(err.E_FORWARD)
  end
  count = results(s, fresh, count)
  if fresh then
    kernel.sym_results[s] = count
  elif count != kernel.sym_results[s] then
    err.fatal(err.E_FORWARD)
  end
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; Write the VAR record of each variable of `scope` from symbol `first` on that lives for the
; whole program. Its weight is complete: nothing that follows can use it.
func lasting_variables(first: word, scope: byte)
  var s: word
  for s = first until kernel.sym_count do
    if kernel.sym_kind[s] == kernel.K_VAR and kernel.sym_scope[s] == scope and
        kernel.sym_flags[s] & kernel.SF_AT == 0 then
      if kernel.sym_flags[s] & kernel.SF_IN != 0 then
        out.region(kernel.sym_value[s])
      end
      out.variable(kernel.sym_obj[s], typetab.size(kernel.sym_type[s]),
          expr.zp_class(kernel.sym_flags[s]), kernel.sym_weight[s])
    end
  end
end

; funcDecl = funcHead NL body "end" NL, or "forward" funcHead NL if `flags` say so. An interrupt
; function has no parameters and no results (reported at its name), and entry and exit code.
func function_declaration(flags: byte)
  var line: word
  var col: word
  var s: word
  var fresh: bool
  lex.next()
  line = lex.line
  col = lex.col
  s, fresh = function_symbol(flags)
  ; The scope begins once the function's own name is declared and the token after it has been
  ; read: every name made from here on is a parameter's or a local's.
  kernel.scope_begin()
  gen.function_begin(reg.object_symbol(s))
  gen.saves_frame = kernel.sym_flags[s] & kernel.SF_RECURSIVE != 0
  head(s, fresh)
  if flags & kernel.SF_FORWARD != 0 then
    kernel.scope_end()
    return
  end
  if flags & inlines.SF_INTERRUPT != 0 then
    if kernel.sym_params[s] + kernel.sym_results[s] != 0 then
      err.position(line, col)
      err.fatal(err.E_INTERRUPT_HEAD)
    end
    gen.interrupt_entry()
  end
  gen.receive(s)
  expr.function_body(s)
  if lex.tok != lex.T_END then
    err.fatal(err.E_END_EXPECTED)
  end
  gen.function_end(object_flags(s))
  lasting_variables(kernel.local_base, kernel.SCOPE_LOCAL)
  ; The scope ends before "end" is passed over, so that no token read after it can be taken for
  ; one of the function's own names.
  kernel.scope_end()
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; "inline" funcHead NL body "end" NL, from "func" on. The body is not compiled: INLINE saves its
; tokens, which EXPR replays at each call. The names the declaration made are kept for the whole
; module, because the saved tokens use them; its symbols go as a function's do.
func inline_declaration(flags: byte)
  var s: word
  var fresh: bool
  lex.next()
  s, fresh = function_symbol(flags)
  kernel.scope_begin()
  reg.begin(kernel.NO_OBJ)
  head(s, fresh)
  inlines.save(s)
  kernel.local_names = kernel.name_top
  kernel.scope_end()
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; "inline" or "interrupt", then funcHead NL body "end" NL. Each attribute goes with neither the
; other, nor `recursive`, nor `asm`.
func attributed_declaration(flags: byte)
  if lex.tok == lex.T_INLINE then
    flags = flags | inlines.SF_INLINE
  else
    flags = flags | inlines.SF_INTERRUPT
  end
  lex.next()
  if lex.tok == lex.T_INLINE or lex.tok == lex.T_INTERRUPT or lex.tok == lex.T_RECURSIVE or
      lex.tok == lex.T_ASM then
    err.fatal(err.E_ATTRIBUTES)
  end
  if lex.tok != lex.T_FUNC then
    err.fatal(err.E_FUNC_EXPECTED)
  end
  if flags & inlines.SF_INLINE != 0 then
    inline_declaration(flags)
  else
    function_declaration(flags)
  end
end

; ---- Constants, and what the end of the module writes ------------------------------------

; constDecl = "const" name [ ":" type ] "=" initialiser NL. A constant of an array type, or one
; that is a string, is a table: constant data with the constant's name.
func constant_declaration(flags: byte)
  var name: word
  var t: byte
  var line: word
  var col: word
  var region: word
  var symbol: word
  var s: word
  lex.next()
  name = expr.new_name(kernel.SCOPE_MODULE)
  t = typetab.NO_TYPE
  if lex.tok == lex.T_COLON then
    lex.next()
    line = lex.line
    col = lex.col
    t = expr.type_spec()
    err.position(line, col)
    expr.layout(t)
  end
  region = 0
  if lex.tok == lex.T_IN then
    region = expr.region_name()
  end
  lex.expect(lex.T_ASSIGN, err.E_SYNTAX)
  expr.no_record(t)
  if t == typetab.NO_TYPE and lex.tok == lex.T_STRING then
    t = typetab.array_of(typetab.BYTE_TYPE, lex.string_length + 1, false)
  end
  if typetab.is_array(t) then
    symbol = out.symbol(out.SYM_DATA, kernel.module_name[0], 0, name)
    expr.data_region = region
    expr.table_data(t, symbol)
    expr.data_region = 0
    s = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_CONST)
    kernel.sym_flags[s] = flags
    kernel.sym_type[s] = t
    kernel.sym_obj[s] = symbol
    if region != 0 then
      kernel.sym_flags[s] = flags | kernel.SF_IN
      kernel.sym_value[s] = region
    end
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
    return
  end
  if region != 0 then
    expr.not_in_region()
  end
  line = lex.line
  col = lex.col
  expr.constant(t)
  if reg.op_kind[reg.depth - 1] != reg.O_CONST then
    err.position(line, col)
    err.fatal(err.E_NOT_CONST)
  end
  s = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_CONST)
  kernel.sym_flags[s] = flags
  kernel.sym_type[s] = reg.op_type[reg.depth - 1]
  kernel.sym_value[s] = reg.op_value[reg.depth - 1]
  reg.pop()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; The object-file symbol of the function of initial values: `module.$init`, or with a number
; after it for one written out early.
func init_symbol(number: byte): word
  var i: byte
  kernel.name_begin()
  for i = 0 until len(INIT_NAME) do
    kernel.name_add(INIT_NAME[i])
  end
  if number >= 10 then
    kernel.name_add(C_ZERO + number / 10)
  end
  if number > 0 then
    kernel.name_add(C_ZERO + number mod 10)
  end
  return out.symbol(out.SYM_FUNCTION, kernel.module_name[0], 0, kernel.name_end())
end

; The list of initial values is getting long: write a function for what it holds now. The next
; such function, or `module.$init` itself, calls it first.
func init_early()
  init_parts += 1
  gen.init_function(init_symbol(init_parts))
end

; Every function declared `forward` must have had its body.
func check_bodies()
  var s: word
  for s = 0 until kernel.sym_count do
    if kernel.sym_scope[s] == kernel.SCOPE_MODULE and kernel.sym_kind[s] == kernel.K_FUNC and
        kernel.sym_flags[s] & kernel.SF_FORWARD != 0 then
      err.fatal(err.E_NO_BODY)
    end
  end
end

func type_symbol(name: word, flags: byte): word
  var s: word
  s = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_TYPE)
  kernel.sym_flags[s] = flags
  return s
end

; "record" NL { name ":" type NL } "end", for the type that `s` declares. Its symbol and type
; exist before the fields are read, so a field can point to the record.
func record_type(s: word)
  var t: byte
  var name: word
  var line: word
  var col: word
  var f: byte
  t = typetab.declared(typetab.FORM_RECORD, s)
  kernel.sym_type[s] = t
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  while lex.tok != lex.T_END do
    name = expr.new_name(kernel.SCOPE_FIELDS + t)
    lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
    line = lex.line
    col = lex.col
    f = expr.type_spec()
    err.position(line, col)
    expr.layout(f)
    if typetab.innermost(f) == t then
      err.fatal(err.E_RECORD_SELF)
    end
    add_field(s, name, f)
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  end
  if typetab.size(t) == 0 then
    err.fatal(err.E_EMPTY_RECORD)
  end
  lex.next()
end

; funcType = [ "recursive" ] "func" "(" [ param { "," param } ] ")" [ ":" type [ "," "bool" ] ],
; for the type that `s` declares: its parameters and results are the members of `s`, as a
; function's are. The names of the parameters are only read.
func function_type(s: word)
  var t: byte
  var count: byte
  t = typetab.declared(typetab.FORM_FUNC, s)
  kernel.sym_type[s] = t
  if lex.tok == lex.T_RECURSIVE then
    typetab.make_recursive(t)
    lex.next()
    if lex.tok != lex.T_FUNC then
      err.fatal(err.E_FUNC_EXPECTED)
    end
  end
  lex.next()
  lex.expect(lex.T_LPAREN, err.E_LPAREN_EXPECTED)
  count = 0
  if lex.tok != lex.T_RPAREN then
    loop
      if lex.tok != lex.T_NAME then
        err.fatal(err.E_NAME_EXPECTED)
      end
      lex.next()
      lex.expect(lex.T_COLON, err.E_COLON_EXPECTED)
      member(s, true, count, gen.REG_NONE)
      count += 1
      if lex.tok != lex.T_COMMA then
        break
      end
      lex.next()
    end
  end
  lex.expect(lex.T_RPAREN, err.E_RPAREN_EXPECTED)
  kernel.sym_params[s] = count
  kernel.sym_results[s] = results(s, true, count)
end

; typeDecl = "type" name "=" ( type | recordType | funcType ) NL.
func type_declaration(flags: byte)
  var name: word
  var line: word
  var col: word
  var t: byte
  lex.next()
  name = expr.new_name(kernel.SCOPE_MODULE)
  lex.expect(lex.T_ASSIGN, err.E_SYNTAX)
  if lex.tok == lex.T_RECORD then
    record_type(type_symbol(name, flags))
  elif lex.tok == lex.T_FUNC or lex.tok == lex.T_RECURSIVE then
    function_type(type_symbol(name, flags))
  else
    line = lex.line
    col = lex.col
    t = expr.type_spec()
    err.position(line, col)
    expr.layout(t)
    kernel.sym_type[type_symbol(name, flags)] = t
  end
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; enumDecl = "enum" name NL { name [ "=" constExpr ] NL } "end" NL. The constants are numbered on
; from the one before, from 0; each must fit a byte.
func enum_declaration(flags: byte)
  var s: word
  var t: byte
  var value: word
  var line: word
  var col: word
  var name: word
  var c: word
  lex.next()
  s = type_symbol(expr.new_name(kernel.SCOPE_MODULE), flags)
  t = typetab.declared(typetab.FORM_ENUM, s)
  kernel.sym_type[s] = t
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  value = 0
  while lex.tok != lex.T_END do
    line = lex.line
    col = lex.col
    name = expr.new_name(kernel.SCOPE_MODULE)
    if lex.tok == lex.T_ASSIGN then
      lex.next()
      line = lex.line
      col = lex.col
      value = expr.constant_number()
    end
    if value > $FF then
      err.position(line, col)
      err.fatal(err.E_RANGE)
    end
    c = kernel.sym_add(kernel.SCOPE_MODULE, name, kernel.K_CONST)
    kernel.sym_flags[c] = flags
    kernel.sym_type[c] = t
    kernel.sym_value[c] = value
    value += 1
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  end
  lex.next()
  lex.expect(lex.T_NL, err.E_NL_EXPECTED)
end

; declaration = [ "pub" ] ( constDecl | typeDecl | enumDecl | varDecl | funcDecl | externDecl |
; asmFunc ) | "forward" funcHead NL.
func declaration()
  var flags: byte
  flags = 0
  if lex.tok == lex.T_FORWARD then
    lex.next()
    if lex.tok == lex.T_RECURSIVE then
      flags = kernel.SF_RECURSIVE
      lex.next()
    end
    if lex.tok != lex.T_FUNC then
      err.fatal(err.E_FUNC_EXPECTED)
    end
    function_declaration(kernel.SF_FORWARD | flags)
    return
  end
  if lex.tok == lex.T_PUB then
    flags = kernel.SF_PUB
    lex.next()
  end
  if lex.tok == lex.T_RECURSIVE then
    lex.next()
    if lex.tok == lex.T_INLINE or lex.tok == lex.T_INTERRUPT then
      err.fatal(err.E_ATTRIBUTES)
    end
    if lex.tok == lex.T_EXTERN or lex.tok == lex.T_ASM then
      err.fatal(err.E_RECURSIVE_BODY)
    end
    if lex.tok != lex.T_FUNC then
      err.fatal(err.E_FUNC_EXPECTED)
    end
    function_declaration(flags | kernel.SF_RECURSIVE)
  elif lex.tok == lex.T_EXTERN then
    extern_declaration(flags)
  elif lex.tok == lex.T_FUNC then
    function_declaration(flags)
  elif lex.tok == lex.T_ASM then
    asm_function_declaration(flags)
  elif lex.tok == lex.T_INLINE or lex.tok == lex.T_INTERRUPT then
    attributed_declaration(flags)
  elif lex.tok == lex.T_CONST then
    constant_declaration(flags)
  elif lex.tok == lex.T_TYPE then
    type_declaration(flags)
  elif lex.tok == lex.T_ENUM then
    enum_declaration(flags)
  elif lex.tok == lex.T_VAR then
    expr.variable(flags, expr.LEVEL_MODULE)
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  elif lex.tok == lex.T_HASH_IF then
    expr.directive()
    lex.expect(lex.T_NL, err.E_NL_EXPECTED)
  elif lex.tok == lex.T_STATIC then
    err.fatal(err.E_UNSUPPORTED)
  else
    err.fatal(err.E_DECL_EXPECTED)
  end
end

; unit = "module" name NL { "import" name NL } { declaration }. Compiles the source that has just
; been opened, to its end.
pub func unit()
  lex.next()
  module_line()
  while lex.tok == lex.T_IMPORT or lex.tok == lex.T_HASH_IF do
    if lex.tok == lex.T_IMPORT then
      import_line()
    else
      declaration()
    end
  end
  while lex.tok != lex.T_EOF do
    if gen.init_count >= gen.INIT_FLUSH then
      init_early()
    end
    declaration()
  end
  check_bodies()
  lasting_variables(0, kernel.SCOPE_MODULE)
  if gen.init_count > 0 or init_parts > 0 then
    gen.init_function(init_symbol(0))
  end
end
