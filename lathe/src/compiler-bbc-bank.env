; The compiler's test programs banked on the BBC Model B+128 in the small build (SMALL 1):
; lathe/env/bbc-bank.env's machine, code in banks of the module (the developer's form, RAM, in
; slot 4), the big tables in the four sideways RAM slots, everything else fixed in $1900-$7BFF and
; $0401-$06FF. lathe/tests/test_bbc_bank_src.py builds outtest, regtest, condtest and gentest
; with it (bbc_support.bank_env adds the test's main module's `place` line and drops those of
; modules a program does not link), and lathe/docs/bbc.md, "Step 3, as built", has the numbers.
; The split is set by gentest, the largest: its fixed code ends at $4866 and its fixed variables
; at $5CCF (2026-11-15, with the symbol table in slot 0).
;
; Fixed: err, kernel, fbuf, lex and src (most of their code has `with` blocks or runs inside
; one, which the linker would keep fixed anyway: placed, they save 933 bytes of fixed code for
; gentest and cost far calls; bbc_support.bank_env(..., kept=True) places them), sys, bbc, disk
; and the run-time modules (rt_bbc, rt_math, rt_frame). Bank 1, the drivers: the test's main
; module, script, listing and regcmd. Bank 2: gen. Bank 3: reg, typetab and slotview. Bank 4:
; cond and fold. Bank 5: out, decl and asmblock. A bank of the module is 16,352 bytes
; ($8000-$BFDF) where Wendy 2's are 28 KB, so the code generator takes four banks, not two.
;
; Data: kernel's name heap in sideways slot 12 (bank 32, variables only, no file); slot 13 (bank
; 33) holds err's messages (constants: its file, loaded at start-up), fbuf's buffer and label
; tables, lex's string and kernel's token memory; slot 0 (bank 34) kernel's symbol and member
; columns (SYMS), slot 1 (bank 35) out.table and its fix-ups (OUTTAB) and DECL's import rows
; (WANTS). rt_bbc.map has no test for a fixed region's value 0, which is slot 0 here (its
; comment).
cpu       6502
zeropage  $00 $8F
code      $1900 $4BFF
data      $4C00 $7BFF
more      data $0401 $06FF
exit      return $0400  ; the start-up code keeps S at $0400 (bbc.KEEP), and ends with RTS
output    raw
define    BOARD 3       ; the BBC (lathe/host/driver/boards.py)
define    PORTS 2       ; lathe/src/sys.lth over lathe/rt/bbc.lth
define    BBCFS 0       ; file names as given; 1: the DFS's (lathe/rt/bbc/bbcfs.lth)
define    MODULE_SLOT 4 ; the module's slot: rt_bbc.SLOT, and the emulator's --bbc-module-slot
define    SMALL 1
window    WIN $8000 $BFDF
switch    WIN bank farcall
bank      WIN 1 $81 LATHE1.BIN
bank      WIN 2 $82 LATHE2.BIN
bank      WIN 3 $83 LATHE3.BIN
bank      WIN 4 $84 LATHE4.BIN
bank      WIN 5 $85 LATHE5.BIN
bank      WIN 32 $0C            ; sideways slot 12: the name heap
bank      WIN 33 $0D LATHE33.BIN ; sideways slot 13: err's messages (constants) and tables
bank      WIN 34 $00            ; sideways slot 0: kernel's symbol and member columns
bank      WIN 35 $01            ; sideways slot 1: OUT's table and DECL's import rows
place     script WIN 1
place     listing WIN 1
place     regcmd WIN 1
place     gen WIN 2
place     reg WIN 3
place     typetab WIN 3
place     slotview WIN 3
place     parts WIN 3
place     cond WIN 4
place     fold WIN 4
place     out WIN 5
place     decl WIN 5
place     asmblock WIN 5
region    NAMES WIN 32           ; kernel.names
region    MSGS WIN 33            ; err's messages
region    FUNCBUF WIN 33         ; fbuf.buffer, label_offset, label_uses
region    STRING WIN 33          ; lex.string
region    TOKENS WIN 33          ; kernel.tokens: INLINE's saved tokens
region    SYMS WIN 34            ; kernel's symbol and member columns
region    OUTTAB WIN 35          ; out.table and its fix-ups
region    WANTS WIN 35           ; decl's rows of what an import wants
farcall   rt_bbc
