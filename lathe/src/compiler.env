; The emulator's default machine as the Lathe-written compiler uses it: host.env with the
; split between code and variables moved down, because the compiler's tables (the name heap
; and the symbol columns, about 25 KB) do not fit in host.env's 12 KB of data. With FBUF's
; buffer and labels (5 KB) and OUT's tables (4.5 KB) as well, about 35 KB of variables
; (outtest), the split is at $6000. A test program with more than 24 KB of code (regtest,
; condtest, gentest) is the small build instead (compiler-small.env).
cpu       6502
zeropage  $00 $FF
code      $0200 $5FFF
data      $6000 $EFFF
stack     $FF
exit      call $F00F
define    SMALL 0       ; the tables at full size
define    PORTS 0       ; lathe/src/sys.lth over host.lth, the host services
