; The emulator's default machine as the Lathe-written compiler uses it: host.env with the
; split between code and variables moved down, because the compiler's tables (the name heap
; and the symbol columns, about 22 KB) do not fit in host.env's 12 KB of data. With FBUF's
; buffer and labels (10 KB) and OUT's table (4.5 KB) as well, about 37 KB of variables, the
; split is at $5C00.
cpu       6502
zeropage  $00 $FF
code      $0200 $72FF
data      $7300 $EFFF
stack     $FF
exit      call $F00F
