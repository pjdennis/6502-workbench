; The emulator's default machine as the Lathe-written compiler uses it: host.env with the
; split between code and variables moved down, because the compiler's tables (the name heap
; and the symbol columns, about 26 KB) do not fit in host.env's 12 KB of data. With FBUF's
; buffer and labels (5 KB), OUT's tables (4.5 KB) and the text memory (4 KB, which holds
; INLINE's saved tokens) as well, about 39 KB of variables (outtest), the split is at $5000.
; A test program with more than 20 KB of code (regtest, condtest, gentest, inlinetest) is the
; small build instead (compiler-small.env).
cpu       6502
zeropage  $00 $FF
code      $0200 $4FFF
data      $5000 $EFFF
stack     $FF
exit      call $F00F
define    SMALL 0       ; the tables at full size
define    PORTS 0       ; lathe/src/sys.lth over host.lth, the host services
