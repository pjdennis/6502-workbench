; What FBUF finished, printed for the test programs (fbuftest, regtest, condtest): the code,
; then each fix-up (offset, kind, symbol, slot, addend), then each weight (symbol, slot,
; value), in hexadecimal. lathe/tests/script_host.py has its twin.
module listing

import fbuf
import script
import sys

pub func show_finished()
  var i: byte
  var w: byte
  script.show_word(fbuf.code_length)
  sys.put_byte(':')
  fbuf.walk_begin()
  while fbuf.walk_next() do
    for i = 0 until fbuf.piece_length do
      script.show_byte(fbuf.piece[i])
    end
  end
  sys.put_byte('|')
  fbuf.walk_begin()
  while fbuf.walk_next() do
    if fbuf.piece_fixed then
      script.show_word(fbuf.fix_offset)
      script.show_byte(fbuf.fix_kind)
      script.show_word(fbuf.fix_symbol)
      script.show_byte(fbuf.fix_slot)
      script.show_word(fbuf.fix_addend)
      sys.put_byte(',')
    end
  end
  sys.put_byte('|')
  for w = 0 until fbuf.weight_count do
    script.show_word(fbuf.weight_symbol[w])
    script.show_byte(fbuf.weight_slot[w])
    script.show_byte(fbuf.weight_value[w])
    sys.put_byte(',')
  end
end
