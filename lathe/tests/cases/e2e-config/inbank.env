; Wendy 2 with files (wendy2disk.env), with libinbank's code in bank 1 of the window
; $8000-$EFFF, and fixed code below it.
cpu       65c02
zeropage  $00 $FF
code      $4000 $7FFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 1 $11 INBANK.BIN
place     libinbank WIN 1
farcall   rt_bank
