; imported by kept.lth: a module placed in a bank (bank 3, or overlay 1) whose functions with a
; `with` block, and those that run inside one, are kept in fixed memory; the rest stays in the
; bank with the data only it names.
module libkept

import libfco
import libkrom

var table: [8]byte in kwork             ; a region: bank 4, which has no file
const STEPS: [4]byte = [1, 2, 3, 5]     ; read by step(), which is kept: fixed
const HEAD = "t "                       ; read only by show(), in the bank: in the bank
var count: byte nozp = 0                ; used by step(), kept: fixed
var runs: byte nozp = 0                 ; used only by begin(), show() and libkept.$init: in
                                        ; the bank

; Called by next(): it runs inside fill()'s block, so it is kept too.
func step(i: byte): byte
  count += 1
  return STEPS[i & 3]
end

; Called inside a block: kept in fixed memory.
func next(i: byte, sum: byte): byte
  return sum + step(i)
end

; In the bank: called by fill() outside its block, through its stub, a far call from fixed code.
func begin(): byte
  runs += 1
  return 0
end

; Has a block: kept. Calls libkrom.twice inside it, which is kept too.
pub func fill(n: byte)
  var i: byte
  var sum: byte
  sum = begin()
  with kwork do
    for i = 0 to 7 do
      if i < n then
        sum = libkrom.twice(next(i, sum))
        table[i] = sum
      else
        table[i] = 0
      end
    end
  end
end

; Has a block: kept, and called from show() in the bank with a plain JSR.
func get(i: byte): byte
  with kwork do
    return table[i]
  end
end

; Adds the eight bytes at p, a pointer into the region. Kept: tally() calls it, inside sum()'s
; block, so the region is mapped while it runs. Kept only because what a kept function calls is
; kept too; in the bank it would read bank 3 instead.
func add8(p: ^byte): byte
  var i: byte
  var t: byte
  t = 0
  for i = 0 to 7 do
    t += p[i]
  end
  return t
end

; Called inside sum()'s block with a pointer into the region: kept.
func tally(p: ^byte): byte
  return add8(p)
end

; Has a block: kept; its variable is fixed.
var total: byte nozp
func sum(): byte
  with kwork do
    total = tally(@table)
  end
  return total
end

; In the bank.
pub func show()
  var i: byte
  i = 0
  while HEAD[i] != 0 do
    libfco.put(HEAD[i])
    i += 1
  end
  for i = 0 to 7 do
    libfco.hex(get(i))
    libfco.put(' ')
  end
  libfco.put(10)
  libfco.hex(sum())
  libfco.put(' ')
  libfco.hex(count)
  libfco.put(' ')
  libfco.hex(runs)
  libfco.put(10)
end
