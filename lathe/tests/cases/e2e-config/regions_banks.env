; Wendy 2 with files: libreg's region `work` in bank 4, which has no file (variables only), and
; its region `text` in bank 5, whose file start-up loads (constants). No code is placed.
cpu       65c02
zeropage  $00 $FF
code      $4000 $7FFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
define    PORTS 1             ; for libfco
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 4 $14
bank      WIN 5 $15 REGTEXT.BIN
region    work WIN 4
region    text WIN 5
farcall   rt_bank
