; Wendy 2 with files, all in one (farcall_flat.env), and ROMLOAD 0 for kept.lth.
cpu       65c02
zeropage  $00 $FF
code      $4000 $EFFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
define    PORTS 1             ; for libfco
define    ROMLOAD 0
