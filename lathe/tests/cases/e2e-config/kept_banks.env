; Wendy 2 with files: libkept in bank 3, libkrom in bank 2, which is read-only, and the region
; kwork in bank 4, which has no file.
cpu       65c02
zeropage  $00 $FF
code      $4000 $7FFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
define    PORTS 1             ; for libfco
define    ROMLOAD 1           ; kept.lth loads bank 2 itself
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 2 $12 KROM2.BIN
bank      WIN 3 $13 KEPT3.BIN
bank      WIN 4 $14
rom       WIN 2
place     libkrom WIN 2
place     libkept WIN 3
region    kwork WIN 4
farcall   rt_bank
