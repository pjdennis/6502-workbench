; The emulator's default machine with overlays, as spike L5's `ovl-host` was: libfca and
; libfcc in overlay 1 of the window $8000-$9FFF, libfcb in overlay 2, loaded on demand from
; files in the emulator's working directory through the host services.
cpu       6502
zeropage  $00 $FF
code      $0200 $7FFF
data      $C000 $EFFF
stack     $FF
exit      call $F00F
define    PORTS 0             ; for libfco
window    OVL $8000 $9FFF
switch    OVL overlay
overlay   OVL 1 FCOVL1.BIN
overlay   OVL 2 FCOVL2.BIN
place     libfca OVL 1
place     libfcc OVL 1
place     libfcb OVL 2
farcall   rt_ovl
