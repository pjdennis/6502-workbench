; Wendy 2 with files: libfixb in bank 3, the region fwork in fixed memory, and the compiler not
; told: its blocks are compiled and map nothing (rt_bank.map(0)), and the linker keeps their
; functions in fixed memory. Harmless, as fixedblk_fixed.env is; the other way round (the compiler
; told, the region in a bank) is link error 62 (lathe/tests/test_lk_unmapped.py).
cpu       65c02
zeropage  $00 $FF
code      $4000 $7FFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
define    PORTS 1             ; for libfco
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 3 $13 FIXB3.BIN
place     libfixb WIN 3
region    fwork fixed
farcall   rt_bank
