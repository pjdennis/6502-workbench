; Wendy 2 with files (wendy2disk.env), banked as spike L5 was: libfca and libfcc in bank 1
; of the window $8000-$EFFF, libfcb in bank 2; fixed code below the window.
cpu       65c02
zeropage  $00 $FF
code      $4000 $7FFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
define    PORTS 1             ; for libfco
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 1 $11 FCBANK1.BIN
bank      WIN 2 $12 FCBANK2.BIN
place     libfca WIN 1
place     libfcc WIN 1
place     libfcb WIN 2
farcall   rt_bank
