; Wendy 2 with files, with libbkd's code, constants and variable in bank 3.
cpu       65c02
zeropage  $00 $FF
code      $4000 $7FFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
define    PORTS 1             ; for libfco
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 3 $13 BKDATA3.BIN
place     libbkd WIN 3
farcall   rt_bank
