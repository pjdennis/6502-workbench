; config withirq_banks.env
; config farcall_flat.env
; A timer interrupt every 1,000 cycles while the main program is inside a `with` block (stage
; 11, step 9; provisional, 2026-11-14): its variables are in bank 4, and the handler makes a far
; call into bank 2 (libfcb.mark), whose code replaces them in the window until the call
; returns. When the handler returns the mapping must be what it was: every value read back
; inside the block is the one written, and the handler ran at least 100 times.
module withirq

import libfco
import libfcb
import timer

var table: [64]byte in work
var bad_irq: byte

interrupt func handler()
  timer.acknowledge()
  if libfcb.mark() != $B2 then
    bad_irq += 1
  end
end

pub func main()
  var i: byte
  var j: byte
  var bad: byte
  bad = 0
  bad_irq = 0
  timer.start_with(1000, @handler)
  for j = 1 to 100 do
    with work do
      for i = 0 to 63 do
        table[i] = i + j
      end
      for i = 0 to 63 do
        if table[i] != i + j then
          bad += 1
        end
      end
    end
  end
  timer.stop()
  libfco.text("with irq ")
  if bad == 0 and bad_irq == 0 and timer.ticks() >= 100 then
    libfco.text("ok\n")
  else
    libfco.text("fail\n")
  end
end
