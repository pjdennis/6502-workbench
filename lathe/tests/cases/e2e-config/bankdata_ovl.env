; The default machine with libbkd's code and constants in overlay 1.
cpu       6502
zeropage  $00 $FF
code      $0200 $7FFF
data      $C000 $EFFF
stack     $FF
exit      call $F00F
define    PORTS 0             ; for libfco
window    OVL $8000 $9FFF
switch    OVL overlay
overlay   OVL 1 BKOVL1.BIN
place     libbkd OVL 1
farcall   rt_ovl
