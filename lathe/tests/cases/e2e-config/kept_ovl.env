; The default machine with libkept in overlay 1 and libkrom in overlay 2; the region kwork has
; no entry, so it is fixed memory.
cpu       6502
zeropage  $00 $FF
code      $0200 $7FFF
data      $C000 $EFFF
stack     $FF
exit      call $F00F
define    PORTS 0             ; for libfco
define    ROMLOAD 0
window    OVL $8000 $9FFF
switch    OVL overlay
overlay   OVL 1 KEPTOV1.BIN
overlay   OVL 2 KEPTOV2.BIN
place     libkept OVL 1
place     libkrom OVL 2
farcall   rt_ovl
