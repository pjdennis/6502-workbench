; Wendy 2 with files: libfcb's code in bank 2, the region `work` in bank 4, which has no file.
cpu       65c02
zeropage  $00 $FF
code      $4000 $7FFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw
define    BOARD 2
define    DISK 1
define    PORTS 1             ; for libfco
window    WIN $8000 $EFFF
switch    WIN bank $F000 $1F
bank      WIN 2 $12 WIBANK2.BIN
bank      WIN 4 $14
place     libfcb WIN 2
region    work WIN 4
farcall   rt_bank
