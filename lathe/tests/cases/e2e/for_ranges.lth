; `for` over every interesting range of each type of loop variable: empty, one pass, up
; to the largest value and down to the smallest, signed ranges across zero; with constant
; bounds, variables and a limit worked out; with break and continue. Each loop prints
; its number of passes, the sum of the values it saw and the variable afterwards. Made
; by a script from a list of loops, with the expected output from a model in Python.
module for_ranges

import libout

func report(count: word, total: word, last: word)
  libout.hexw(count)
  libout.space()
  libout.hexw(total)
  libout.space()
  libout.hexw(last)
  libout.nl()
end

; byte 0 to 9, const, plain
func t1()
  var i: byte
  var first: byte
  var limit: byte
  var count: word = 0
  var total: word = 0
  for i = 0 to 9 do
    count += 1
    total += i
  end
  report(count, total, i)
end

; byte 0 to 9, var, continue
func t2()
  var i: byte
  var first: byte
  var limit: byte
  var count: word = 0
  var total: word = 0
  first = 0
  limit = 9
  for i = first to limit do
    count += 1
    if lo(i) & 1 == 1 then
      continue
    end
    total += i
  end
  report(count, total, i)
end

; byte 0 to 9, cvar, break
func t3()
  var i: byte
  var first: byte
  var limit: byte
  var count: word = 0
  var total: word = 0
  limit = 9
  for i = 0 to limit do
    count += 1
    total += i
    if count == 3 then
      break
    end
  end
  report(count, total, i)
end

; byte 0 to 9, expr, plain
func t4()
  var i: byte
  var first: byte
  var limit: byte
  var count: word = 0
  var total: word = 0
  first = 0
  limit = 12
  for i = first to limit - 3 do
    count += 1
    total += i
  end
  report(count, total, i)
end

