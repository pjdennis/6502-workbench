; `for` loops inside loops, a limit that is a variable the body changes (it is read at each
; test) or a value worked out (copied once), a parameter as the limit, a module-level loop
; variable, and break and continue in nested loops.
module for_misc

import libout

var g: byte
var total: word

; the number of pairs (i, j) with i <= j <= n
func pairs(n: byte): word
  var i: byte
  var j: byte
  var count: word = 0
  for i = 0 to n do
    for j = i to n do
      count += 1
    end
  end
  return count
end

; a limit that is a variable is read at each test: the body moves it
func moving_limit(): byte
  var i: byte
  var limit: byte = 10
  var count: byte = 0
  for i = 0 to limit do
    count += 1
    if i == 2 then
      limit = 5
    end
  end
  return count
end

; a limit that is worked out is copied: changing what it was worked out from changes nothing
func copied_limit(): byte
  var i: byte
  var limit: byte = 10
  var count: byte = 0
  for i = 0 to limit + 0 - 0 + 1 - 1 do
    count += 1
    limit = 3
  end
  return count
end

; break leaves only the inner loop; continue goes on with the inner loop's next value
func inner_exits(): word
  var i: byte
  var j: byte
  var count: word = 0
  for i = 1 to 10 do
    for j = 1 to 10 do
      if j > i then
        break
      end
      if j == 3 then
        continue
      end
      count += j
    end
  end
  return count
end

; a module-level loop variable, a word sum over a word range made of bytes
func module_level()
  total = 0
  for g = 255 downto 250 do
    total += g
  end
end

; for inside a case inside a for
func mixed(): word
  var i: byte
  var j: byte
  var count: word = 0
  for i = 0 to 5 do
    case i
    of 1, 3
      for j = 0 to i do
        count += 1
      end
    of 4
      continue
    else
      count += 100
    end
  end
  return count
end

pub func main()
  libout.dec(pairs(0))
  libout.space()
  libout.dec(pairs(9))
  libout.space()
  libout.dec(pairs(255))
  libout.nl()
  libout.dec(moving_limit())
  libout.space()
  libout.dec(copied_limit())
  libout.nl()
  libout.dec(inner_exits())
  libout.nl()
  module_level()
  libout.dec(total)
  libout.space()
  libout.dec(g)
  libout.nl()
  libout.dec(mixed())
  libout.nl()
end
