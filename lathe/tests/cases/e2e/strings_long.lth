; Strings: adjacent literals join, on one line and across lines (with blank and comment
; lines between), and a string or byte table may be longer than 255 bytes. A 600-byte
; text table is printed back with its length; lathe/tests/test_operators.py gives the
; output.
module strings_long

import host
import libout

const TEXT: [600]byte = "AHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYF"
  "MTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKR"
  "YFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWD"
  "KRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIP"
  "WDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUB"
  "IPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGN"

  ; a comment between the pieces
  "UBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZ"
  "GNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXEL"
  "SZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQX"
  "ELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJ"
  "QXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOV"
  "CJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAH"

const NAMED = "one" "two" ; a [7]byte

func put_text(p: ^byte)
  while p[0] != 0 do
    host.put_byte(p[0])
    p += 1
  end
end

pub func main()
  var i: word
  for i = 0 until len(TEXT) do
    host.put_byte(TEXT[i])
  end
  libout.nl()
  libout.dec(len(TEXT))
  libout.space()
  libout.dec(len(NAMED))
  libout.nl()
  put_text(@NAMED)
  put_text("abc" "def")
  put_text("ghi"
           "jkl\n")
  put_text("AHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYF"
           "MTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKR"
           "YFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWD"
           "KRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIP"
           "WDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUB"
           "IPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGN"
           "UBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZ"
           "GNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQXEL"
           "SZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJQX"
           "ELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOVCJ"
           "QXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAHOV"
           "CJQXELSZGNUBIPWDKRYFMTAHOVCJQXELSZGNUBIPWDKRYFMTAH")
  libout.nl()
end
