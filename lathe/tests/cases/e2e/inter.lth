; for limits and case selectors that are array elements or pointer targets
module inter
import host

const DIGITS: [16]byte = "0123456789ABCDEF"
var lim: [4]byte = [3, 0, 5, 1]
var sel: [4]byte = [2, 7, 1, 9]
var w: [3]word = [300, 2, 513]

func hex(b: byte)
  host.put_byte(DIGITS[b >> 4])
  host.put_byte(DIGITS[b & 15])
end

func count(j: byte): byte
  var i: byte
  var n: byte
  n = 0
  for i = 1 to lim[j] do
    n += 1
  end
  return n
end

func through(p: ^byte, j: byte): byte
  var i: byte
  var n: byte
  n = 0
  for i = p[j] downto 1 do
    n += i
  end
  return n
end

func pick(j: byte): byte
  case sel[j]
  of 1, 2
    return $A0 + sel[j]
  of 7
    return $B7
  else
    return $EE
  end
end

func pickp(p: ^byte, j: byte): byte
  case p[j]
  of 9
    return $99
  of 2
    return $22
  end
  return $00
end

pub func main()
  var j: byte
  var k: word
  for j = 0 to 3 do
    hex(count(j))
    hex(through(@lim, j))
    hex(pick(j))
    hex(pickp(@sel, j))
    host.put_byte(' ')
  end
  for k = w[1] to w[0] do
  end
  hex(hi(k))
  hex(lo(k))
  host.put_byte(10)
end
