; inline_modules.lth with import lists (lathe/docs/language.md, "Modules"): only the inline
; functions listed are read from libstack's interface, with what their bodies name (libstack's
; items and top, and peek_or's size(), libout's char and hex), which this module cannot name
; itself; libout is imported after libstack brought it in, and read again for nl.
module import_lists

import libstack (push, pop,
                 show, peek_or, size)
import libout (nl)

var top: byte = 99
var items: [2]byte = [1, 2]

pub func main()
  var i: byte
  var v: byte
  var ok: bool
  for i = 1 to 10 do
    if not libstack.push(i + i + i) then
      items[0] += 1
    end
  end
  libstack.show()
  v, ok = libstack.pop()
  libstack.show()
  while libstack.pop() -> v do
    if v == 9 then
      break
    end
  end
  libstack.show()
  if libstack.peek_or(77) == 6 and libstack.size() == 2 then
    libstack.push(top)
  end
  libstack.show()
  while libstack.pop() -> v do
  end
  libstack.push(libstack.peek_or(42))
  libstack.show()
  libstack.show()
  libout.nl()
end
