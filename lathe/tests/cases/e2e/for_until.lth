; `for i = first until limit` on each integer type: empty ranges (first equal to or past the
; limit, and a limit of 0), single and full ranges, a limit that the body changes, `break` and
; `continue`, and the variable after the loop. Each loop prints how often its body ran (and a
; sum where it matters) and the variable after it. lathe/tests/test_operators.py gives the output.
module for_until

import libout

var count: word
var total: word

func show(after: word)
  libout.hexw(count)
  libout.char('/')
  libout.hexw(total)
  libout.char('/')
  libout.hexw(after)
  libout.space()
  count = 0
  total = 0
end

pub func main()
  var i: byte
  var n: byte
  var s: sbyte
  var w: word
  var k: int
  n = 0
  for i = 0 until n do
    count += 1
  end
  show(i)
  for i = 5 until 5 do
    count += 1
  end
  show(i)
  for i = 200 until 100 do
    count += 1
  end
  show(i)
  for i = 7 until 8 do
    count += 1
    total += i
  end
  show(i)
  for i = 0 until 255 do
    count += 1
    total += i
  end
  show(i)
  n = 10
  for i = 0 until n do
    count += 1
    if i == 3 then
      n = 6                     ; a variable limit is read at each test
    end
  end
  show(i)
  for i = 0 until 100 do
    if i & 1 == 0 then
      continue
    end
    if i == 51 then
      break
    end
    count += 1
    total += i
  end
  show(i)
  libout.nl()
  for s = -128 until 127 do
    count += 1
    total += word(int(s))
  end
  show(word(int(s)))
  for s = 3 until -3 do
    count += 1
  end
  show(word(int(s)))
  for s = -1 until 0 do
    count += 1
  end
  show(word(int(s)))
  for s = -10 until 10 do
    if s < 0 then
      continue
    end
    count += 1
    total += word(int(s))
  end
  show(word(int(s)))
  libout.nl()
  for w = 0 until $FFFF do
    count += 1
    total += w
  end
  show(w)
  for w = 300 until 300 do
    count += 1
  end
  show(w)
  for w = $FFFE until $FFFF do
    count += 1
  end
  show(w)
  for w = 250 until 1000 do
    if w == 260 then
      break
    end
    count += 1
  end
  show(w)
  libout.nl()
  for k = -32768 until 32767 do
    count += 1
    total += word(k)
  end
  show(word(k))
  for k = 100 until -100 do
    count += 1
  end
  show(word(k))
  for k = -300 until 300 do
    if k > -298 then
      continue
    end
    count += 1
    total += word(k)
  end
  show(word(k))
  libout.nl()
end
