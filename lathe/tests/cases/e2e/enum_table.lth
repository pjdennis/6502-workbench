; Enumerations: in `case`, as indexes of tables through byte(), converted back from a byte,
; compared and ordered, as fields, parameters and results, and counted through in a loop.
module enum_table

import libout

enum Token
  T_END
  T_NAME
  T_NUMBER
  T_PLUS = 10
  T_MINUS
  T_STAR = 20
end

const LETTERS: [21]byte = "ENU???????+-????????*"
const NEXT: [21]Token = [T_NAME, T_NUMBER, T_PLUS, T_END, T_END, T_END, T_END, T_END, T_END, T_END,
                         T_MINUS, T_STAR]

type Entry = record
  token: Token
  count: byte
end

var counts: [21]Entry
var seen: [6]Token

func classify(t: Token): byte
  case t
  of T_END
    return 'e'
  of T_NAME, T_NUMBER
    return 'v'
  of T_PLUS, T_MINUS
    return 'o'
  else
    return '?'
  end
end

func follow(t: Token): Token
  if t >= T_STAR then
    return T_END
  end
  return NEXT[byte(t)]
end

pub func main()
  var t: Token
  var i: byte
  var b: byte
  t = T_END
  i = 0
  loop
    t = follow(t)
    seen[i] = t
    i += 1
    libout.char(LETTERS[byte(t)])
    libout.char(classify(t))
    counts[byte(t)].token = t
    counts[byte(t)].count += 1
  until t == T_END
  libout.nl()
  for b = 0 to 20 do
    t = Token(b)
    if counts[b].count != 0 and counts[b].token == t then
      libout.dec(b)
      libout.char(classify(t))
      libout.space()
    end
  end
  libout.nl()
  for i = 0 to 5 do
    libout.truth(seen[i] < T_PLUS)
    libout.truth(seen[i] != T_MINUS)
  end
  libout.char(classify(Token(3)))
  libout.dec(byte(T_STAR) - byte(T_MINUS))
  libout.nl()
end
