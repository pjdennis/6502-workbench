; A recursive walk over a tree of records in a `rows` array, which calls a plain callback
; through a function type at each node: the walk saves its frame around its own calls, and
; the call of the callback costs no more than any call through a pointer
; (lathe/docs/code-model.md, "Recursion"). Prints the values in order with their depths, the
; sum of the values and the deepest node, for two trees and two callbacks.
module rec_tree

import libout

type Node = record
  value: byte
  left: byte                    ; the index of a child, 0 for none
  right: byte
  spare: byte                   ; a record in a rows array has a size that is a power of two
end

type Visitor = func(value: byte, depth: byte)

var nodes: [16]Node rows
var total: word
var deepest: byte

recursive func walk(n: byte, depth: byte, visit: Visitor)
  if n == 0 then
    return
  end
  walk(nodes[n].left, depth + 1, visit)
  visit(nodes[n].value, depth)
  walk(nodes[n].right, depth + 1, visit)
end

func show(value: byte, depth: byte)
  libout.hex(value)
  libout.char('/')
  libout.hex(depth)
  libout.space()
end

func count(value: byte, depth: byte)
  total += value
  if depth > deepest then
    deepest = depth
  end
end

func set_node(n: byte, value: byte, left: byte, right: byte)
  nodes[n].value = value
  nodes[n].left = left
  nodes[n].right = right
end

; insert value into the search tree rooted at node 1, as node n
func insert(n: byte, value: byte)
  var here: byte = 1
  set_node(n, value, 0, 0)
  loop
    if value < nodes[here].value then
      if nodes[here].left == 0 then
        nodes[here].left = n
        return
      end
      here = nodes[here].left
    else
      if nodes[here].right == 0 then
        nodes[here].right = n
        return
      end
      here = nodes[here].right
    end
  end
end

const VALUES: [12]byte = [50, 30, 70, 20, 40, 60, 80, 10, 45, 65, 90, 5]

func report(root: byte)
  total = 0
  deepest = 0
  walk(root, 0, @show)
  libout.nl()
  walk(root, 0, @count)
  libout.hexw(total)
  libout.space()
  libout.hex(deepest)
  libout.nl()
end

pub func main()
  var i: byte
  ; a small tree by hand: 2 is the root, with 3 on its left and 4 on its right
  set_node(2, $22, 3, 4)
  set_node(3, $11, 0, 0)
  set_node(4, $33, 0, 5)
  set_node(5, $44, 0, 0)
  report(2)
  set_node(1, VALUES[0], 0, 0)
  for i = 1 to len(VALUES) - 1 do
    insert(i + 1, VALUES[i])
  end
  report(1)
end
