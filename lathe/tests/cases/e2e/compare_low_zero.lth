pub func main()
  var i: byte
  for i = 0 until 15 do
    w_0000(words[i])
    w_0100(words[i])
    w_8000(words[i])
    w_FF00(words[i])
    w_00FF(words[i])
    w_80FF(words[i])
    i_0(ints[i])
    i_256(ints[i])
