; Words and ints compared with a constant whose low byte is 0 compare their high bytes alone
; (lathe/docs/codegen.md, "Comparisons and conditions"): every ordering, the constant on either
; side, in a branch, as a value and as a result in the carry flag, with the constants $0000,
; $0100, $8000, $FF00 and those that become one (> $00FF is >= $0100), for operands either side
; of each boundary. This file and the expected output are made by
; lathe/tests/test_compare_low_zero.py, which works the answers out in Python: a line for each
; operand, and for each constant a word (branches, then values) and a byte (results in the
; carry) of answers, unsigned then signed.
module compare_low_zero

import libout

var words: [15]word = [$0000, $0001, $00FF, $0100, $0101, $01FF, $7FFF, $8000, $8001, $80FF, $8100, $FEFF, $FF00, $FF01, $FFFF]
var ints: [15]int = [0, 1, 255, 256, 257, 511, 32767, -32768, -32767, -32513, -32512, -257, -256, -255, -1]
var flag: bool

func w_0000_c0(x: word): bool
  return x < $0000
end

func w_0000_c1(x: word): bool
  return x <= $0000
end

func w_0000_c2(x: word): bool
  return x > $0000
end

func w_0000_c3(x: word): bool
  return x >= $0000
end

func w_0000_c4(x: word): bool
  return $0000 < x
end

func w_0000_c5(x: word): bool
  return $0000 <= x
end

func w_0000_c6(x: word): bool
  return $0000 > x
end

func w_0000_c7(x: word): bool
  return $0000 >= x
end

func w_0000(x: word)
  var r: word = 0
  var c: byte = 0
  if x < $0000 then
    r |= $0001
  end
  if x <= $0000 then
    r |= $0002
  end
  if x > $0000 then
    r |= $0004
  end
  if x >= $0000 then
    r |= $0008
  end
  if $0000 < x then
    r |= $0010
  end
  if $0000 <= x then
    r |= $0020
  end
  if $0000 > x then
    r |= $0040
  end
  if $0000 >= x then
    r |= $0080
  end
  flag = x < $0000
  if flag then
    r |= $0100
  end
  flag = x <= $0000
  if flag then
    r |= $0200
  end
  flag = x > $0000
  if flag then
    r |= $0400
  end
  flag = x >= $0000
  if flag then
    r |= $0800
  end
  flag = $0000 < x
  if flag then
    r |= $1000
  end
  flag = $0000 <= x
  if flag then
    r |= $2000
  end
  flag = $0000 > x
  if flag then
    r |= $4000
  end
  flag = $0000 >= x
  if flag then
    r |= $8000
  end
  if w_0000_c0(x) then
    c |= $01
  end
  if w_0000_c1(x) then
    c |= $02
  end
  if w_0000_c2(x) then
    c |= $04
  end
  if w_0000_c3(x) then
    c |= $08
  end
  if w_0000_c4(x) then
    c |= $10
  end
  if w_0000_c5(x) then
    c |= $20
  end
  if w_0000_c6(x) then
    c |= $40
  end
  if w_0000_c7(x) then
    c |= $80
  end
  libout.hexw(r)
  libout.hex(c)
  libout.space()
end

