; A store into an element whose index X does not hold is STA absolute,Y, which leaves X to the
; loads: copies between arrays at two indexes, bytes and words by column and fields of records,
; over arrays of 200 bytes, so that base + index crosses a page for some indexes wherever the
; linker puts them, and an element stored through Y and then read through X.
module store_y

import libout

type Pair = record
  lo: byte
  hi: word
end

var a: [200]byte
var b: [200]byte
var w: [100]word
var v: [100]word
var pairs: [50]Pair
var i: byte
var j: byte
var sum: word

pub func main()
  for i = 0 until 200 do
    a[i] = i * 3 + 1
  end
  j = 199
  for i = 0 until 200 do
    b[j] = a[i]                         ; LDX i / LDA a,X / LDY j / STA b,Y
    j -= 1
  end
  for i = 0 until 100 do
    w[i] = word(b[i]) * 257 + word(i)
  end
  j = 99
  for i = 0 until 100 do
    v[j] = w[i]                         ; both bytes through Y, X kept for w
    v[j] += w[i]
    j -= 1
  end
  for i = 0 until 50 do
    j = 49 - i
    pairs[j].lo = a[i]
    pairs[j].hi = v[i]
  end
  sum = 0
  for i = 0 until 200 do
    sum += word(b[i]) * word(i + 1)
  end
  libout.hexw(sum)
  libout.nl()
  sum = 0
  for i = 0 until 100 do
    sum += v[i] ^ word(i)
  end
  libout.hexw(sum)
  libout.nl()
  sum = 0
  for i = 0 until 50 do
    sum += word(pairs[i].lo) + pairs[i].hi
  end
  libout.hexw(sum)
  libout.nl()
  libout.hex(b[0])
  libout.hex(b[199])
  libout.hex(a[0])
  libout.hexw(v[0])
  libout.hexw(v[99])
  libout.hexw(pairs[0].hi)
  libout.nl()
end
