; Numbers without a type at the width they are used (docs/language.md, "Type rules"): `~` and
; unary `-` of such a number fit an unsigned type by their bits, and a number that does not
; fit a byte widens the byte it is used with to a word.
module const_width

const BIT = $20

var b: byte
var w: word
var digit: byte
var s: sbyte
var i: int
var a: [4]byte

func f()
  b = ~$20
  b = b & ~BIT
  b = ~(BIT | $01)
  b = ~$20 & ~$40
  b = -1
  b = b + -2
  b = ~0 - b
  a[~$FC] = 7
  w = ~$20
  w = -1
  s = ~$20
  i = ~$20
  w = $FFFF - digit
  w = digit + 1000
  w = 300 * digit
  if digit < 300 then
    b = 1
  end
end
