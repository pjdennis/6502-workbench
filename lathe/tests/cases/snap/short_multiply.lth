; A byte variable times 3 is a shift and an add, never larger than a call of rt_math.mul8
; (docs/codegen.md, "Bytes"); other constants, a value in A, an element, a word, and a byte
; that may be a device are calls.
module short_multiply

var a: byte
var b: byte
var s: sbyte
var tab: [8]byte
var port: byte at $D000
var p: ^byte
var w: word

func f(i: byte)
  a = a * 3
  a = 5 * b
  a = b * 6
  a = b * 7
  a = b * 9
  a = b * 10
  a = b * 12
  s = s * 3
  a = tab[i] * 10
  a = (a + b) * 5
  a = b * 11
  a = b * 14
  a = port * 3
  a = p[i] * 3
  w = w * 3
end
