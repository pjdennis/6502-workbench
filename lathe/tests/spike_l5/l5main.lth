; Spike L5 with the far-call routine compiled from lathe/rt/rt_bank.lth (OVERLAYS=0) or
; rt_ovl.lth (OVERLAYS=1): the Lathe part of the fixed memory, linked by the real linker at
; $4000. l5build.py assembles the rest of the spike around it at $0400, with the stubs and the
; table written by hand where the linker of stage 11 will write them
; (lathe/tests/test_farcall.py).
;
; It does what the start-up code will do: start() with the table's address (but after the
; initial values are set, not before); then it enters the spike's main program, which never
; returns. Passing the address of call(), which only the stubs call, keeps it in the link.
; Both imports are compiled, whatever OVERLAYS is (build.py finds an import inside #if).
module l5main

#if OVERLAYS
import rt_ovl
#else
import rt_bank
#end

var table: ^byte at $0406                           ; the table's address, in the spike's image
extern func spike(far_call: word in ax) at $0403    ; the spike's m_main

pub func main()
#if OVERLAYS
  rt_ovl.start(table)
  spike(word(@rt_ovl.call))
#else
  rt_bank.start(table)
  spike(word(@rt_bank.call))
#end
end
