; Wendy 2 (wendy2c) run with `--disk DIR`: the board of wendy2.env, and the emulator's file
; ports at $F800-$F80F, behind which are the files of the host directory DIR
; (emulator/chips/syscall_ports.h). lathe/docs/boards.md has the recipe.
;
; The program is preloaded with `--wendy2-prog FILE --load 4000`, as with wendy2.env, and runs
; flat, in bank configuration $01: no banks yet. lathe/rt/disk.lth gives it files through the
; ports, with the interface of lathe/rt/host.lth: its arguments come from the file `args` in
; DIR, one a line; what it writes to standard output goes to the file `out`, its error output to
; `errors`; and disk.exit(code) writes the code to the file `status`, because the emulator gives
; no exit status on this machine. It ends with STP, which ends the run.
cpu       65c02
zeropage  $00 $FF
code      $4000 $EFFF
data      $0200 $3FFF
stack     $FF
exit      stop
output    raw         ; the file is the code from $4000, and the load address is $start
define    BOARD 2     ; which board, for lathe/rt/board.lth: 1 Michael, 2 Wendy 2
define    DISK 1      ; the file ports are there (lathe/rt/disk.lth)
