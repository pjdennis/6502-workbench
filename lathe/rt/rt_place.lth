; The placer of a BBC program's dynamic regions (lathe/docs/bbc.md, "One image for every machine
; with sideways RAM"; configurations.md, "Regions placed at run time"): the environment's
; `placer rt_place`. `$start` calls place() with the linker's list of the places of the dynamic
; regions (lathe/host/lk_dyn.py has its form) after rt_bbc.start and before `$init`, so before
; anything uses a region. The list and every place it names are in main RAM, where the module
; copied the program's resident part at the command; this module itself may be in a bank of the
; module (it only reads the list and writes main RAM). It is written in assembly for the room of
; the 128 KB image.
;
; What it does:
;
; 1. Reads PAGE and HIMEM (OSBYTE 131 and 132). PAGE above the fixed part's first address (the
;    code range's) is refused, `PAGE too high`, and HIMEM below the end of the program's ranges,
;    `Mode 7 needed`: MOS errors raised from $0100, as a sideways ROM's must be.
; 2. Knows the free main RAM: from PAGE to the fixed part, what the link left free (the code range
;    from the list on, since the list is not needed once read, and `data` and `more` after their
;    variables), and from the end of the program's ranges to HIMEM (a shadow screen's kilobyte).
; 3. Puts each dynamic region, in the order of the environment's entries, in main RAM if its block
;    fits in a free area at an address with the same low byte as where it is linked (a region
;    moves by whole pages, lk_dyn.py); a region that does not fit stays in its slot.
; 4. For a region it moved: adds the pages moved to each high byte the list names, and makes each
;    of its blocks' banks the module's own slot (nothing that runs inside a block reads the
;    window, so any slot does, and this one leaves the window as it was).
;
; With every region where it is linked nothing is written. The zero page it uses is the MOS's
; workspace for * commands, $A8-$AF, not the program's.
module rt_place

import rt_bbc (mslot)

const LIST = $A8                    ; the list, as it is read
const PTR = $AA                     ; a place being changed, or an area's first address
const SIZE = $AC                    ; the size of the block being placed, or an area's last

const MAX_AREAS = 6

var code_lo: word                   ; the fixed part's first address
var top: word                       ; the end of the program's ranges, + 1
var page: word
var himem: word
var before: word                    ; the place read last
var linked: word                    ; where the region's block is linked
var goes: word                      ; where a block would go
var end_at: word                    ; and the last byte it would take
var areas: byte                     ; the free areas of main RAM, first to last
var first_lo: [MAX_AREAS]byte
var first_hi: [MAX_AREAS]byte
var last_lo: [MAX_AREAS]byte
var last_hi: [MAX_AREAS]byte
var regions: byte
var pages: byte                     ; the pages the region moves, 0 if it stays
var number: word                    ; a list's places

const ERRORS: [28]byte = "PAGE too high\0Mode 7 needed\0"
const PAGE_TOO_HIGH = 0             ; offsets in ERRORS
const MODE_7_NEEDED = 14

; The next byte of the list, in A; the Z flag as it. Y is lost.
asm func next_byte(): byte in a
  LDY #0
  LDA (LIST),Y
  INC LIST
  BNE .next_byte_end
  INC LIST+1
.next_byte_end
  CMP #0
end

; The next word of the list, in A (low) and X (high).
asm func next_word(): word in ax
  JSR next_byte
  PHA
  JSR next_byte
  TAX
  PLA
end

; The next place: `before` the distance in the byte, or the word after a byte 0; in before and
; PTR.
asm func next_place()
  JSR next_byte
  BEQ .place_word
  CLC
  ADC before
  STA before
  BCC .place_set
  INC before+1
  JMP .place_set
.place_word
  JSR next_word
  STA before
  STX before+1
.place_set
  LDA before
  STA PTR
  LDA before+1
  STA PTR+1
end

; A free area from PTR to SIZE, if there is room for it and it is not empty.
asm func add_area()
  LDX areas
  CPX #MAX_AREAS
  BCS .add_end
  LDA SIZE                          ; last < first: empty
  CMP PTR
  LDA SIZE+1
  SBC PTR+1
  BCC .add_end
  LDA PTR
  STA first_lo,X
  LDA PTR+1
  STA first_hi,X
  LDA SIZE
  STA last_lo,X
  LDA SIZE+1
  STA last_hi,X
  INC areas
.add_end
end

; SIZE bytes at an address with the low byte of `linked`, from the first free area that holds
; them: the address in `goes`, the carry clear; the carry set if none does.
asm func take()
  LDX #0
.take_area
  CPX areas
  BCS .take_none
  LDA linked                        ; the area's first page, at linked's low byte
  STA goes
  LDA first_hi,X
  STA goes+1
  LDA goes                          ; below the area's first: a page on
  CMP first_lo,X
  BCS .take_end
  INC goes+1
  BEQ .take_next                    ; past $FFFF
.take_end
  LDA goes                          ; the last byte it takes: at + SIZE - 1
  CLC
  ADC SIZE
  STA end_at
  LDA goes+1
  ADC SIZE+1
  STA end_at+1
  BCS .take_next
  LDA end_at
  SEC
  SBC #1
  STA end_at
  BCS .take_fits
  DEC end_at+1
.take_fits
  LDA last_lo,X                     ; at most the area's last
  CMP end_at
  LDA last_hi,X
  SBC end_at+1
  BCC .take_next
  LDA end_at                        ; taken: the area starts after it
  CLC
  ADC #1
  STA first_lo,X
  LDA end_at+1
  ADC #0
  STA first_hi,X
  CLC
  RTS
.take_next
  INX
  JMP .take_area
.take_none
  SEC
end

; The next list of places: their number, in `number`.
asm func next_count()
  JSR next_word
  STA number
  STX number+1
end

; One place fewer in `number`: Z set when none is left before it.
asm func count_down()
  LDA number
  ORA number+1
  BEQ .counted
  LDA number
  BNE .low
  DEC number+1
.low
  DEC number
  LDA #1                            ; Z clear: a place to read
.counted
end

; Raise the MOS error at ERRORS + X from $0100: BRK, number 0, its text, 0.
asm func refuse(offset: byte in x)
  LDY #0
  STY $0100
  STY $0101
.refuse_copy
  LDA ERRORS,X
  STA $0102,Y
  BEQ .raise
  INX
  INY
  BNE .refuse_copy
.raise
  JMP $0100
end

pub asm func place(places: ^byte in ax)
  STA LIST
  STX LIST+1
  JSR next_word
  STA code_lo
  STX code_lo+1
  JSR next_word
  STA top
  STX top+1
  LDA #$83                          ; OSBYTE 131: PAGE, in X and Y
  JSR $FFF4
  STX page
  STY page+1
  LDA code_lo                       ; PAGE above the fixed part: refused
  CMP page
  LDA code_lo+1
  SBC page+1
  BCS .page_low
  LDX #PAGE_TOO_HIGH
  JMP refuse
.page_low
  LDA #$84                          ; OSBYTE 132: HIMEM
  JSR $FFF4
  STX himem
  STY himem+1
  CPX top                           ; HIMEM below the end of the ranges: refused
  TYA
  SBC top+1
  BCS .himem_high
  LDX #MODE_7_NEEDED
  JMP refuse
.himem_high
; The free areas: PAGE to the fixed part, the list's, HIMEM's.
  LDA #0
  STA areas
  LDA page
  STA PTR
  LDA page+1
  STA PTR+1
  LDA code_lo
  SEC
  SBC #1
  STA SIZE
  LDA code_lo+1
  SBC #0
  STA SIZE+1
  JSR add_area
  JSR next_byte
  STA regions
.areas
  LDA regions
  BEQ .areas_read
  DEC regions
  JSR next_word
  STA PTR
  STX PTR+1
  JSR next_word
  STA SIZE
  STX SIZE+1
  JSR add_area
  JMP .areas
.areas_read
  LDA top
  STA PTR
  LDA top+1
  STA PTR+1
  LDA himem
  SEC
  SBC #1
  STA SIZE
  LDA himem+1
  SBC #0
  STA SIZE+1
  JSR add_area
; Each region: its bank's value (not used yet), its block, its high bytes, its blocks' banks.
  JSR next_byte
  STA regions
.region
  LDA regions
  BEQ .done
  DEC regions
  JSR next_byte                     ; the bank's value
  JSR next_word
  STA linked
  STX linked+1
  JSR next_word
  STA SIZE
  STX SIZE+1
  LDA #0
  STA pages
  LDA SIZE
  ORA SIZE+1
  BEQ .moved                        ; nothing to move
  JSR take
  BCS .moved                        ; no room: it stays in its slot
  LDA goes+1                          ; the pages it moves
  SEC
  SBC linked+1
  STA pages
.moved
  LDA #0
  STA before
  STA before+1
  JSR next_count
.high
  JSR count_down
  BEQ .highs_done
  JSR next_place
  LDA pages
  BEQ .high
  CLC
  LDY #0
  ADC (PTR),Y
  STA (PTR),Y
  JMP .high
.highs_done
  LDA #0
  STA before
  STA before+1
  JSR next_count
.bank
  JSR count_down
  BEQ .region
  JSR next_place
  LDA pages
  BEQ .bank
  LDA rt_bbc.mslot                  ; in main RAM: the module's own slot
  LDY #0
  STA (PTR),Y
  JMP .bank
.done
end
