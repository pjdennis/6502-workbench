; A periodic interrupt from the VIA's timer 1, counted (lathe/docs/boards.md, "The VIA timer").
;
; tick() is the handler: an `interrupt` function, so it saves the registers, gets storage of its
; own for whatever it calls, and returns with RTI. It acknowledges the interrupt and counts it,
; which is what acknowledge() does. start() installs it with board.set_irq(@tick).
;
; A program that wants more done on each interrupt writes its own interrupt function, which calls
; acknowledge() (so the count, and ticks(), go on as before), and starts the timer with
; start_with(period, @its_handler).
;
; Uses timer 1 and its interrupt only: the other bits of ACR and IER are left as they were.
module timer

import board
import via

; Interrupts since start(), written by the handler. It is exported only because acknowledge(),
; which is expanded in the modules that call it, adds to it: read it with ticks().
pub var count: word

; Acknowledge timer 1's interrupt and count it. Call it from an interrupt function only.
pub inline func acknowledge()
  via.ifr = via.IRQ_T1              ; writing the flag clears it
  count += 1
end

interrupt func tick()
  acknowledge()
end

asm func disable_interrupts()
  SEI
end

asm func enable_interrupts()
  CLI
end

; Start an interrupt every `period` CPU cycles (3 to 65537; 2000 is 1 ms on Michael, about
; 0.2 ms on Wendy 2), handled by `handler`, the address of an interrupt function that calls
; acknowledge(); set the count to 0 and enable interrupts. Timer 1 runs free: it counts down
; from its latch, which is period - 2, interrupts at the end and reloads.
pub func start_with(period: word, handler: ^byte)
  var latch: word = period - 2
  disable_interrupts()
  board.set_irq(handler)
  count = 0
  via.acr = (via.acr & ~via.ACR_T1_MASK) | via.ACR_T1_FREE_RUN
  via.t1cl = lo(latch)
  via.t1ch = hi(latch)              ; loads the counter from the latch and starts it
  via.ier = via.IER_SET | via.IRQ_T1
  enable_interrupts()
end

; Start counting an interrupt every `period` CPU cycles, with tick() as the handler.
pub func start(period: word)
  start_with(period, @tick)
end

; Stop the interrupts. The count stays as it is; interrupts stay enabled for anything else.
pub func stop()
  via.ier = via.IRQ_T1              ; without IER_SET: disables timer 1's interrupt
  via.ifr = via.IRQ_T1              ; and drops one that is pending
end

; The number of interrupts since start(). The two bytes are read with interrupts disabled, so
; the handler cannot change the count between them.
pub func ticks(): word
  var t: word
  critical
    t = count
  end
  return t
end
